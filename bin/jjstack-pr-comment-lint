#!/usr/bin/env bash
# jjstack-pr-comment-lint — enforce the safety, brevity and voice rules on a PR
# review comment BEFORE it is posted, mechanically.
#
# Two jobs, in this order.
#
# 1. SAFETY. A PR comment is public and permanent. The review's own security lens
#    is what surfaces credentials, and the voice rules mandate a one-line
#    `file:line` claim that renders the evidence inline, so the natural output of
#    a good review is a comment quoting the key it just found. Editing the
#    comment afterwards does not remove the value from the API's edit history.
#    The secret rules therefore fail CLOSED: they cannot be silenced by --quiet
#    and they carry their own exit code.
#
# 2. BREVITY AND VOICE. A review nobody reads is a review that did not happen.
#    The failure mode is not a wrong finding, it is 400 lines of correct findings
#    that a human scrolls past. Prose instructions to "be concise" lose to a
#    model's pull toward completeness on every single run, so the budget is
#    enforced by code instead of by asking.
#
# Every rule here is one a machine can decide. Voice judgement stays in the
# skill; only the checkable half lives in this script.
#
# Rules enforced (from the Jesper Jurcenoks Voice DNA, Executive register):
#   - no credential literal anywhere in the body  (fails closed, exit 4)
#   - hard size budget: lines and characters
#   - at most N findings inline, counted as OCCURRENCES not lines
#   - a link to a report that EXISTS on disk
#   - a declared residual: "N blocking, M total" plus "M-shown more"
#   - no emdash "—"            (hard rule, the critical differentiator)
#   - no superlatives used to sell
#   - no meta-commentary openers ("In this review, we will…")
#   - no sentence longer than 180 chars (the tweet-length compression test)
#   - no softening qualifiers that blunt a point
#   - warn on "but" (the voice restructures instead of overriding)
#
# Usage:
#   jjstack-pr-comment-lint <file> [--max-lines N] [--max-chars N]
#                                  [--max-findings N] [--quiet]
# Exit: 0 clean, 1 rule violations found, 2 usage, 3 file missing,
#       4 a credential literal was found (never post; redact first).
#
# No color red anywhere — unreadable on the target terminal.
set -uo pipefail

YEL="\033[33m"; CYA="\033[96m"; GRN="\033[32m"; RST="\033[0m"

HERE="${BASH_SOURCE[0]%/*}"
# Sourced for review_need_value, the family's ONE argument guard. `--flag` with
# no value used to spin forever here: bash's `shift 2` is a NO-OP when fewer than
# two arguments remain, and `set -e` is off, so the while loop re-read the same
# flag until killed (rc=124 under `timeout 5`). This tool was the one member of
# the family outside that shared guard, which is how a closed class reopened.
# shellcheck source=/dev/null
. "$HERE/jjstack-review-vocab.sh" || exit 3

# A budget that cannot be evaluated is not a budget. `${2:-}` accepted an empty
# string, `[ "" -gt 12 ]` printed "integer expression expected" and returned
# non-zero, and a non-zero `[` does not increment the violation count — so 41
# lines against a 12-line budget reported `clean`, rc=0. A hard gate that treats
# an unevaluatable check as a pass is not a gate. Validate at parse time instead,
# for every numeric flag, against every non-numeric shape.
need_int() {   # need_int FLAG VALUE
  case "$2" in
    ''|*[![:digit:]]*)
      echo -e "${CYA}error${RST} $1 needs a non-negative integer, got '$2'" >&2; exit 2 ;;
  esac
}

# Budget is deliberately brutal. A PR comment is a DOORBELL, not the delivery:
# verdict, the blocking findings, a link. Everything else is already committed
# to {repo}/jjstack/ and does not need re-typing into a scroll box.
# 12 lines / 900 chars is about six seconds of reading. That is the whole point.
SRC=""; MAX_LINES=12; MAX_CHARS=900; MAX_FINDINGS=3; QUIET=0
while [ $# -gt 0 ]; do
  case "$1" in
    --max-lines)    review_need_value "$1" $# || exit 2; need_int "$1" "$2"; MAX_LINES="$2";    shift 2 ;;
    --max-chars)    review_need_value "$1" $# || exit 2; need_int "$1" "$2"; MAX_CHARS="$2";    shift 2 ;;
    --max-findings) review_need_value "$1" $# || exit 2; need_int "$1" "$2"; MAX_FINDINGS="$2"; shift 2 ;;
    --quiet)     QUIET=1; shift ;;
    -h|--help)   sed -n '2,42p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo -e "${CYA}error${RST} unknown flag: $1" >&2; exit 2 ;;
    *)  [ -z "$SRC" ] && SRC="$1" || { echo -e "${CYA}error${RST} unexpected arg: $1" >&2; exit 2; }
        shift ;;
  esac
done
[ -z "$SRC" ] && { echo -e "${CYA}error${RST} usage: $(basename "$0") <file> [--max-lines N] [--max-chars N] [--max-findings N]" >&2; exit 2; }
[ -f "$SRC" ] || { echo -e "${CYA}error${RST} no such file: $SRC" >&2; exit 3; }

viol=0
secrets=0
say() { [ "$QUIET" -eq 1 ] || echo -e "$1"; }
fail() { viol=$((viol + 1)); say "  ${YEL}$1${RST}  $2"; }
# Fails CLOSED: always printed, to stderr, whatever --quiet says. A caller that
# silenced this would be silencing the one rule that prevents a public leak.
hard() { viol=$((viol + 1)); secrets=$((secrets + 1)); echo -e "  ${YEL}$1${RST}  $2" >&2; }

n_lines=$(wc -l < "$SRC" | tr -d ' ')
n_chars=$(wc -c < "$SRC" | tr -d ' ')

# --- SAFETY: no credential literal reaches a public PR ------------------------
# The class is "a credential literal", not "a vendor whose token shape someone
# added a row for". Three rounds of review added the next vendor each time and
# the round after found the next one: an eleven-row list matched by eleven
# fixtures is an enumeration of its own test data. The round that broke it was
# the smallest possible step - the rule was named `aws key id` and matched the
# 20-character IDENTIFIER, while `AWS_SECRET_ACCESS_KEY=wJalr...`, the half that
# actually is secret, had no row and posted clean.
#
# So the rules are now a fast path, and the CLASS is closed by three property
# scans that do not know any vendor's name:
#
#   1. an ASSIGNMENT of a high-entropy value to a secret-ish name. The property
#      is structural - `<name containing key|token|secret|password|...> = <20+
#      characters that do not look like English or a path>` - so a vendor
#      nobody has heard of is caught on the day they launch. "Does not look like
#      English" is decided arithmetically: three character classes, or a long
#      hex run, or Shannon entropy over 4.5 bits/char. A 40-character lowercase
#      file path scores about 4.0 and is not flagged; a 40-character base64
#      secret scores about 5.0 and is;
#   2. the same scans over the body with line breaks and spaces REMOVED, because
#      every rule here is a single-line grep and a key wrapped across two lines
#      walked between them;
#   3. the same scans over the base64-DECODED content of every base64-looking
#      token, because that is how a Kubernetes Secret stores one, and a review
#      quoting `data.password` from a manifest is quoting a credential.
#
# The message names the RULE, the LINE and at most the VARIABLE NAME, never the
# match. A linter that echoes the key has moved the leak into the terminal and
# the run log instead of stopping it. The fix the message teaches is the one the
# voice already wants: cite `file:line`, leave the value in the committed report.
#
# `grep -E --` because a PEM header STARTS with dashes: without the terminator
# grep reads the pattern as its own options and that rule silently never fires.
SCRATCH=$(mktemp -d) || { echo -e "${CYA}error${RST} cannot create a scratch dir" >&2; exit 3; }
trap 'rm -rf "$SCRATCH"' EXIT

secret_rules() {
  cat <<'SECRETS'
aws key id|(AKIA|ASIA|ABIA|ACCA|AGPA|AIDA|AIPA|ANPA|ANVA|AROA)[0-9A-Z]{16}
github token|gh[pousr]_[A-Za-z0-9]{36,}
github fine-grained pat|github_pat_[A-Za-z0-9_]{22,}
openai-style key|sk-[A-Za-z0-9_-]{20,}
slack token|xox[baprs]-[A-Za-z0-9-]{10,}
private key block|-----BEGIN [A-Z ]*PRIVATE KEY-----
google api key|AIza[0-9A-Za-z_-]{35}
stripe key|[srp]k_(live|test)_[A-Za-z0-9]{16,}
json web token|eyJ[A-Za-z0-9_-]{8,}\.eyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}
credential in a url|[a-zA-Z][a-zA-Z0-9+.-]*://[^/:@[:space:]]+:[^/@[:space:]]{6,}@
SECRETS
}

# The structural rule. Deliberately NOT a vendor pattern: it keys on the SHAPE
# of a secret assignment, so it fires on a token format that does not exist yet.
#
# The scan is a LOOP inside awk rather than a `grep -o`, and that is not a
# style choice. grep's leftmost-longest match swallows the whole tail of
# `... committed: AWS_SECRET_ACCESS_KEY=wJalr...` into one match keyed on
# `committed`, and the real assignment inside it is never offered to the filter.
# Advancing past the SEPARATOR instead of past the value means every assignment
# on a line is examined, including the ones nested inside another one's value.
#
# No `{20,}` interval anywhere in the pattern: length is tested in code. An awk
# without interval support would treat the braces literally and the rule would
# match nothing, which is the silent-inert failure this file keeps re-learning.
#
# The arithmetic half. A long value is not a secret; a long value with no
# structure a human would write is. Three independent tests, any one of which
# is enough, so a shape none of them was written for still has two more chances:
#   * three character classes (lower + upper + digit) - the shape almost every
#     issued token has and almost no English phrase or file path has;
#   * 32+ characters of pure hex - a digest-shaped secret, only two classes;
#   * Shannon entropy over 4.5 bits/char - the catch-all for anything else.
IFS='' read -r -d '' GEN_AWK <<'AWKEOF'
function classes(v,   i, c, lo, up, di) {
  lo = 0; up = 0; di = 0
  for (i = 1; i <= length(v); i++) {
    c = substr(v, i, 1)
    if (c ~ /[a-z]/) lo = 1
    else if (c ~ /[A-Z]/) up = 1
    else if (c ~ /[0-9]/) di = 1
  }
  return lo + up + di
}
function entropy(v,   i, c, n, e, p) {
  n = length(v); if (n == 0) return 0
  delete FQ
  for (i = 1; i <= n; i++) { c = substr(v, i, 1); FQ[c]++ }
  e = 0
  for (c in FQ) { p = FQ[c] / n; e -= p * log(p) / log(2) }
  return e
}
function credentialish(v) {
  if (classes(v) >= 3) return 1
  if (length(v) >= 32 && v ~ /^[0-9a-fA-F]+$/) return 1
  if (entropy(v) > 4.5) return 1
  return 0
}
{
  line = $0
  while (match(line, /[A-Za-z_][A-Za-z0-9_.-]*[ \t]*["']?[ \t]*[:=][ \t]*["']?[A-Za-z0-9+\/_=~.-]+/)) {
    start = RSTART
    mtch = substr(line, RSTART, RLENGTH)
    if (!match(mtch, /[:=]/)) { line = substr(line, start + 1); continue }
    sep = RSTART
    key = substr(mtch, 1, sep - 1)
    val = substr(mtch, sep + 1)
    # Advance past the SEPARATOR, not past the value: an assignment nested
    # inside another one's value is the exact shape that reopened this rule.
    line = substr(line, start + sep)
    gsub(/^[ \t]+/, "", key); gsub(/[ \t"]+$/, "", key)
    sub(/^[ \t]*/, "", val); sub(/^["]/, "", val); sub(/^[ \t]*/, "", val)
    if (length(val) < 20) continue
    if (tolower(key) !~ /(secret|token|password|passwd|pwd|key|credential|cred|auth|bearer|session|signature|salt|nonce|cert)/) continue
    if (!credentialish(val)) continue
    print FNR "\t" key
  }
}
AWKEOF

# One announcement per rule and per variable name, however many of the three
# scans found it. The same key reported three times reads as three leaks.
declare -A _SEC_SEEN=()

scan_text() {   # scan_text FILE MODE   (MODE: line | joined | b64)
  local f="$1" mode="$2" label pat hits ln key where
  while IFS='|' read -r label pat; do
    [ -n "$label" ] || continue
    hits=$(grep -nE -- "$pat" "$f" 2>/dev/null | cut -d: -f1 | tr '\n' ',' | sed 's/,$//')
    [ -n "$hits" ] || continue
    [ -n "${_SEC_SEEN[rule:$label]:-}" ] && continue
    _SEC_SEEN[rule:$label]=1
    case "$mode" in
      line)   where="on line(s) $hits" ;;
      joined) where="split across a line break - the unwrapped body matches" ;;
      b64)    where="inside a base64-encoded value, decoded and rescanned" ;;
    esac
    hard "secret" "$label $where. Cite file:line only - the value never goes in a public comment, and a later edit does not remove it from the API's edit history."
  done < <(secret_rules)
  while IFS=$'\t' read -r ln key; do
    [ -n "$key" ] || continue
    [ -n "${_SEC_SEEN[key:$key]:-}" ] && continue
    _SEC_SEEN[key:$key]=1
    case "$mode" in
      line)   where="on line $ln" ;;
      joined) where="split across a line break" ;;
      b64)    where="inside a base64-encoded value, decoded and rescanned" ;;
    esac
    hard "secret" "a high-entropy value is assigned to \`$key\` $where. Cite file:line only - the value never goes in a public comment, and a later edit does not remove it from the API's edit history."
  done < <(LC_ALL=C awk "$GEN_AWK" "$f" 2>/dev/null)
}

scan_text "$SRC" line

# Scans 2 and 3 run only when scan 1 found nothing. They exist to catch what a
# per-line plaintext read cannot see, and once the comment is already blocked a
# second announcement of the same value under a fused variable name (the join
# glues `credential committed` into one token) is noise on top of a stop. The
# operator redacts and re-runs; the next scan then has its turn.
if [ "$secrets" -eq 0 ]; then
# 2. the wrapped key. Every rule above is a single-line grep, so a value broken
#    over two lines - by a hard wrap, by a markdown table, by an editor - walked
#    between them untouched.
  LC_ALL=C tr -d '\n' < "$SRC" | LC_ALL=C tr -d ' \t' > "$SCRATCH/joined"
  printf '\n' >> "$SCRATCH/joined"
  scan_text "$SCRATCH/joined" joined

# 3. the encoded key. A Kubernetes Secret stores its values base64-encoded, so a
#    review quoting `data.password` from a manifest is quoting a credential that
#    no plaintext rule can see. Decode every base64-looking token and rescan.
#    Padding is restored first: an unpadded token is the common way one arrives.
  : > "$SCRATCH/b64"
  grep -oE '[A-Za-z0-9+/]{16,}={0,2}' "$SRC" 2>/dev/null | head -200 | while IFS= read -r tok; do
    case $(( ${#tok} % 4 )) in
      2) tok="$tok==" ;;
      3) tok="$tok=" ;;
    esac
    printf '%s' "$tok" | base64 -d 2>/dev/null | LC_ALL=C tr -c '[:print:]' ' '
    printf '\n'
  done >> "$SCRATCH/b64"
  scan_text "$SCRATCH/b64" b64
fi

# --- how many findings this comment shows -------------------------------------
# Counted as OCCURRENCES, not lines. `grep -c` OVERRIDES `-o` in GNU grep, so
# five findings on one physical line counted as one and the comment passed clean.
# (A ugrep shim counts occurrences, which is why this survives a hand check.)
#
# THE TOKEN LIST IS NOT WRITTEN HERE. It is read from bin/jjstack-review-vocab.tsv,
# the same file jjstack-review-normalize now reads and the same list
# skills/review/SKILL.md's finding-struct table declares in prose - and
# test/smoke.sh asserts the TSV and that declaration name the same tokens. Three
# rounds of review each handed this function the next severity spelling it did
# not know; the third round found HIGH/MEDIUM/LOW, which the skill had DECLARED
# all along while the cap had never been told. A hand-copied list drifts from
# the declaration it copies, silently, in the direction of letting findings
# through. Adding a word to the declaration without a TSV row is now a red test;
# adding a TSV row widens the cap here with no edit to this file at all.
#
# Two shapes, because a severity is written two ways:
#   * P-tokens (P0..P3) - matched on the DECORATION-STRIPPED text, so `**P0**`,
#     `[P0]`, `(P0)`, `"P0"`, `- P0`, `1. P0` and `| P0 |` all count without
#     enumerating them. Case-insensitive: `p0` is the same claim as `P0`, and
#     the case-sensitive match let a lowercase comment past the cap entirely.
#   * spelled words (CRITICAL, HIGH, MEDIUM, LOW ...) - these are ordinary
#     English, so they count only in LABEL POSITION: at the head of a line
#     (after any list or quote decoration) followed by a label marker, or
#     wrapped in a strong marker anywhere on the line (`**HIGH**`, `[Major]`).
#     "the critical path" in prose is not a finding; "(confidence: low)" is not
#     a finding; "**HIGH** `a.py:1` ..." is.
if ! sev_all=$(vocab_severity_tokens); then
  echo -e "${CYA}error${RST} the review vocabulary would not load; the finding cap cannot be built" >&2
  exit 3
fi
SEV_P=""; SEV_WORD=""
for _t in $sev_all; do
  case "$_t" in
    P[0-9]) SEV_P="${SEV_P:+$SEV_P|}$_t" ;;
    *)      SEV_WORD="${SEV_WORD:+$SEV_WORD|}$(printf '%s' "$_t" | tr 'A-Z' 'a-z')" ;;
  esac
done
# An empty alternation would silently match nothing, which reads exactly like a
# comment with no findings — the failure mode this whole rule exists to stop.
[ -n "$SEV_P" ] || { echo -e "${CYA}error${RST} the vocabulary declares no P-token severities" >&2; exit 3; }

IFS='' read -r -d '' SEV_AWK <<'AWKEOF'
{
  line = tolower($0)
  # strip one leading list marker / blockquote / ordinal, so `- **High**` and
  # `2. Critical:` are read the same way as a bare label.
  sub(/^[ \t]*([-*>+]+[ \t]*|[0-9]+[.)][ \t]*)?/, "", line)
  head = "^(\\*\\*|__|\\[|\\(|\")?(" words ")(\\*\\*|__|\\]|\\)|\"|:)"
  if (match(line, head)) { c++; line = substr(line, RSTART + RLENGTH) }
  strong = "(\\*\\*(" words ")\\*\\*|__(" words ")__|\\[(" words ")\\])"
  while (match(line, strong)) { c++; line = substr(line, RSTART + RLENGTH) }
}
END { print c + 0 }
AWKEOF

count_findings() {   # count_findings FILE
  local f="$1" a b
  a=$(sed 's/[][*_`(){}<>"]/ /g' "$f" | grep -owiE "$SEV_P" 2>/dev/null | wc -l | tr -d ' ')
  b=0
  [ -n "$SEV_WORD" ] && b=$(LC_ALL=C awk -v words="$SEV_WORD" "$SEV_AWK" "$f" 2>/dev/null)
  echo $(( ${a:-0} + ${b:-0} ))
}
n_find=$(count_findings "$SRC")

# --- the budget scales with the verdict, because the information does ---
# One budget for every verdict was wrong. Twelve lines is right for a REJECT
# carrying two blocking findings. For an APPROVE with nothing to report it is
# four times too generous, and a model fills whatever ceiling it is given: a
# real clean review spent ~25 lines - posture, coverage, five evidence bullets -
# proving it had nothing to say. On a clean PR the author wants the verdict, not
# the audit trail that produced it. The evidence is already in the report.
#
# Detected, not declared, so no caller has to remember to pass a flag. It reads
# the SAME count as the cap: when the count under-reads a finding shape, the
# comment is both under-capped and mis-classified as clean, and the second error
# is silent. One counter, one place to fix.
VERDICT="findings"
if [ "$n_find" -eq 0 ] && grep -qE '\b(APPROVE|LGTM)\b' "$SRC"; then
  VERDICT="approve"
  MAX_LINES=3
  MAX_CHARS=250
fi

[ "$n_lines" -gt "$MAX_LINES" ] && {
  if [ "$VERDICT" = "approve" ]; then
    fail "too-long" "$n_lines lines for a clean approve (budget $MAX_LINES). Nothing was found: say so and link the report. The evidence for why it is clean belongs in the report, not the comment."
  else
    fail "too-long" "$n_lines lines (budget $MAX_LINES). Cut findings, do not cut evidence: link instead."
  fi
}
[ "$n_chars" -gt "$MAX_CHARS" ] && \
  fail "too-long" "$n_chars chars (budget $MAX_CHARS, verdict=$VERDICT)."

# --- finding count: the real cause of a wall of text ---
# Length is the symptom. The cause is pasting every finding into the comment.
# Cap what appears inline; the rest stays in the committed report.
[ "$n_find" -gt "$MAX_FINDINGS" ] && \
  fail "too-many" "$n_find findings inline (max $MAX_FINDINGS). Show the blocking ones, link the rest."

# --- the link: proof that findings were MOVED, not deleted ---
# Without this, "be brief" degrades into "drop findings", which is the one
# failure this whole skill exists to prevent.
#
# THREE rounds of this rule were satisfiable without a report, each time through
# a branch the previous round had not touched. First any ".md" substring counted,
# so a finding whose own subject was `docs/setup.md:12` passed. Then a bare
# `https://` counted. Then a named PATH was stat'd - and the URL branch beside it
# still was not, so `https://github.com/o/r/blob/main/docs/setup.md#L12` linted
# clean with no report linked at all. Two branches, one of them checked.
#
# So there are no longer two branches. Every reference in the comment - bare
# path or URL - is reduced to a repo-relative path by ONE function, tested
# against ONE report shape, and resolved by ONE stat. A URL cannot be treated
# more leniently than a path because there is no separate code path in which to
# be lenient.
report_path_of() {   # report_path_of REF -> a repo-relative report path, or empty
  local r="$1"
  case "$r" in
    http://*|https://*)
      r="${r#*://}"; r="${r#*/}"          # drop scheme and host
      r="${r%%#*}"; r="${r%%\?*}"         # drop fragment and query
      # a forge blob/raw URL carries owner/repo/<view>/<ref>/ before the repo path
      r=$(printf '%s\n' "$r" | sed -E 's#^[^/]+/[^/]+/(-/)?(blob|blame|raw|tree|src)/[^/]+/##')
      ;;
  esac
  printf '%s\n' "$r" \
    | grep -oE '(jjstack/[A-Za-z0-9_./-]*\.md|review-[0-9]{4}-[0-9]{2}-[0-9]{2}\.md)' | head -1
}

report_ref=""
while IFS= read -r ref; do
  [ -n "$ref" ] || continue
  cand_ref=$(report_path_of "$ref")
  [ -n "$cand_ref" ] && { report_ref="$cand_ref"; break; }
done < <(grep -oE '(https?://[^)>[:space:]`"'"'"']+|[A-Za-z0-9_./-]+\.md)' "$SRC" 2>/dev/null)

report_file=""
if [ -z "$report_ref" ]; then
  fail "no-link" "no link to the full report. A finding's own subject file is not a report link, and neither is a URL that merely ends in .md: brevity moves evidence, it never deletes it."
else
  # Resolve against the repo the comment lives in, then against the comment's own
  # directory, then one level up: {OUTPUT_DIR} is normally {repo}/jjstack, so
  # both "jjstack/review-DATE.md" and a bare "review-DATE.md" have to land.
  src_dir=$(cd "$(dirname "$SRC")" && pwd)
  root=$(git -C "$src_dir" rev-parse --show-toplevel 2>/dev/null || true)
  for cand in "${root:+$root/$report_ref}" "$src_dir/$report_ref" "$src_dir/../$report_ref" "$src_dir/$(basename "$report_ref")"; do
    [ -n "$cand" ] && [ -f "$cand" ] && { report_file="$cand"; break; }
  done
  [ -n "$report_file" ] || \
    fail "no-report" "the comment links \`$report_ref\`, and no such file exists. Commit the report first (Phase 6.2), then link it: a link to nothing is the same as no link."
fi

# --- the residual: the count that proves nothing was dropped ---
# "N blocking, M total" lived only as prose in the voice reference, so a comment
# could show three findings, declare nothing, and pass clean. That is precisely
# how "be brief" turns into "drop findings". The arithmetic is checkable, so it
# is checked: M-N must be stated, and it must equal total minus shown.
if [ "$VERDICT" = "approve" ]; then
  grep -qiE '(no findings|\b0 total\b)' "$SRC" || \
    fail "no-residual" "an approve must say what it found: \"no findings\". A verdict with no count is a claim with no shape."
else
  decl=$(grep -oiE '[0-9]+ blocking,[[:space:]]*[0-9]+ total' "$SRC" 2>/dev/null | head -1)
  if [ -z "$decl" ]; then
    fail "no-residual" "no \"N blocking, M total\" declared. Without the total, a reader cannot tell a short comment from a dropped finding."
  else
    n_block=$(echo "$decl" | grep -oE '^[0-9]+')
    n_total=$(echo "$decl" | grep -oE '[0-9]+ total' | grep -oE '^[0-9]+')
    if [ "$n_total" -lt "$n_block" ]; then
      fail "bad-residual" "$decl: the total cannot be smaller than the blocking count."
    elif [ "$n_total" -gt "$n_find" ]; then
      want=$((n_total - n_find))
      got=$(grep -oiE '[0-9]+ more\b' "$SRC" 2>/dev/null | head -1 | grep -oE '^[0-9]+')
      [ "${got:-x}" = "$want" ] || \
        fail "bad-residual" "$n_total total, $n_find shown: say \"$want more\" and link the report. Findings move into the report, they never disappear."
    fi
    # --- and the declared total is checked against the REPORT, not just itself.
    # The linter already resolved the report path and then never opened the file.
    # So "1 blocking, 1 total" linking a report holding 40 findings linted clean:
    # every count in the comment agreed with every other count in the comment,
    # which is what a self-consistent lie looks like. Phase 5f DECLARES the
    # report's header line - "**Posture:** <profile> - <active count> active, ..."
    # - so the number is there to be read, and the comment's M has to equal it.
    if [ -n "$report_file" ] && [ -s "$report_file" ]; then
      posture=$(grep -m1 -oiE '\*\*Posture:\*\*.*' "$report_file" 2>/dev/null)
      if [ -z "$posture" ]; then
        say "  ${YEL}advisory${RST}  the linked report has no \`**Posture:**\` line, so \"$n_total total\" could not be checked against it (Phase 5f defines that line)."
      else
        n_report=$(printf '%s\n' "$posture" | grep -oiE '[0-9]+ active' | grep -oE '^[0-9]+')
        if [ -n "$n_report" ] && [ "$n_report" != "$n_total" ]; then
          fail "residual-mismatch" "the comment declares $n_total total; the report it links declares $n_report active. The comment's count is a claim about the report, so the two are one number, not two."
        fi
      fi
    fi
  fi
fi

# --- emdash: hard rule, the single most recognisable tell ---
if grep -q '—' "$SRC"; then
  fail "emdash" "found '—'. Use the short dash '-' instead."
fi

# --- superlatives used to sell ---
SUPER='amazing|incredible|groundbreaking|revolutionary|game.chang|world.class|cutting.edge|seamless|robust|powerful|comprehensive|delightful'
if grep -qiE "$SUPER" "$SRC"; then
  hit=$(grep -ioE "$SUPER" "$SRC" | sort -u | tr '\n' ' ')
  fail "superlative" "$hit- an inherently good finding does not need selling."
fi

# --- meta-commentary: the reader did not ask what the comment is about ---
META='^[[:space:]]*(in this (review|comment|analysis)|this (comment|review) (will|covers|summarizes)|below (you will find|is a summary)|i (will|have) (now )?(reviewed|analyzed))'
if grep -qiE "$META" "$SRC"; then
  fail "meta" "meta-commentary opener. State the finding, not the intent to state it."
fi

# --- softening qualifiers that blunt a sharp point ---
SOFT='\b(a bit|sort of|kind of|somewhat|arguably|it seems like|i guess|perhaps maybe|just a little)\b'
if grep -qiE "$SOFT" "$SRC"; then
  hit=$(grep -ioE "$SOFT" "$SRC" | sort -u | tr '\n' ' ')
  fail "softener" "$hit- sharpen or drop."
fi

# --- tweet-length compression test, per sentence ---
# Split on sentence enders; ignore code fences and table rows, where long lines
# are structural rather than prose.
long=$(awk '
  /^```/ { infence = !infence; next }
  infence { next }
  /^[[:space:]]*\|/ { next }
  { gsub(/`[^`]*`/, "CODE") }
  {
    n = split($0, s, /(\. |\? |! )/)
    for (i = 1; i <= n; i++) if (length(s[i]) > 180) c++
  }
  END { print c + 0 }' "$SRC")
[ "$long" -gt 0 ] && \
  fail "long-sentence" "$long sentence(s) over 180 chars. Every sentence should survive as a tweet."

# --- "but" — the voice holds contradictions with "and" ---
# grep -c PRINTS 0 and EXITS 1 on no match, so `|| echo 0` would emit "0\n0"
# and the numeric test below would blow up. Swallow the status, keep the count.
# -o then wc, not -c: -c would count LINES and under-report two "but"s on one.
n_but=$(grep -oiwE 'but' "$SRC" 2>/dev/null | wc -l | tr -d ' ')
[ "${n_but:-0}" -gt 0 ] && \
  say "  ${YEL}advisory${RST}  'but' x$n_but. Consider restructuring: 'it is not blue, it is green'."

if [ "$secrets" -gt 0 ]; then
  echo -e "${YEL}$secrets credential literal(s)${RST} - redact before posting. This comment must not be published." >&2
  exit 4
fi
if [ "$viol" -eq 0 ]; then
  say "${GRN}clean${RST}    $n_lines lines, $n_chars chars - within budget and in voice."
  exit 0
fi
say "${YEL}$viol rule violation(s)${RST} - fix before posting."
exit 1
