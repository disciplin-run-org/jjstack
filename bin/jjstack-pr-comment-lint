#!/usr/bin/env bash
# jjstack-pr-comment-lint — enforce the safety, brevity and voice rules on a PR
# review comment BEFORE it is posted, mechanically.
#
# Two jobs, in this order.
#
# 1. SAFETY. A PR comment is public and permanent. The review's own security lens
#    is what surfaces credentials, and the voice rules mandate a one-line
#    `file:line` claim that renders the evidence inline, so the natural output of
#    a good review is a comment quoting the key it just found. Editing the
#    comment afterwards does not remove the value from the API's edit history.
#    The secret rules therefore fail CLOSED: they cannot be silenced by --quiet
#    and they carry their own exit code.
#
# 2. BREVITY AND VOICE. A review nobody reads is a review that did not happen.
#    The failure mode is not a wrong finding, it is 400 lines of correct findings
#    that a human scrolls past. Prose instructions to "be concise" lose to a
#    model's pull toward completeness on every single run, so the budget is
#    enforced by code instead of by asking.
#
# THE COMMENT HAS TWO PARTS, and the rules know which is which. The VISIBLE
# part is the doorbell: attribution, verdict, the blocking findings, the
# residual count. The full report rides in the same comment, collapsed under a
# `<details>` block, so the reader who wants the evidence expands it and the
# reader who wants the verdict never scrolls past it. The report used to be a
# file committed to the reviewed repository and linked from the comment. Three
# consecutive lint rounds were spent on that link - missing, then pointing at
# the reviewer's scratchpad, then on a side branch because the reviewer would
# not push to the author's branch - and every one was the same defect: the
# delivery was stored somewhere the reader was not. The comment is where the
# reader is. Budget rules judge the visible part; safety rules read the whole
# body, because all of it is public.
#
# Every rule here is one a machine can decide. Voice judgement stays in the
# skill; only the checkable half lives in this script.
#
# Rules enforced (from the Jesper Jurcenoks Voice DNA, Executive register):
#   - the attribution line FIRST, so a reader knows a machine wrote it
#   - a resolved/clean verdict is ONE visible line, in a fixed form
#   - no credential literal anywhere in the body  (fails closed, exit 4)
#   - no local machine path anywhere in the body (report included)
#   - hard size budget on the VISIBLE part: lines and characters
#   - at most N findings visible, counted as OCCURRENCES not lines
#   - a findings comment, or a resolved approve, carries exactly one collapsed
#     `<details>` report block, closed, not `open`, and not empty
#   - a declared residual: "N blocking, M total" plus "M-shown more"
#   - no emdash "—"            (hard rule, the critical differentiator)
#   - a whole-body cap under GitHub's comment limit
#
# Voice beyond that - superlatives, meta-commentary, sentence length, softening
# qualifiers - is JUDGEMENT and lives in references/pr-comment-voice.md. A
# grep cannot tell "robust" in a finding's quoted code from "robust" used to
# sell, and a linter that argues about prose is a linter people stop running.
#
# Usage:
#   jjstack-pr-comment-lint <file> [--max-lines N] [--max-chars N]
#                                  [--max-findings N] [--max-total-chars N]
#                                  [--quiet]
# Exit: 0 clean, 1 rule violations found, 2 usage, 3 file missing,
#       4 a credential literal was found (never post; redact first).
#
# No color red anywhere — unreadable on the target terminal.
set -uo pipefail

YEL="\033[33m"; CYA="\033[96m"; GRN="\033[32m"; RST="\033[0m"

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# review_need_value: the family's ONE argument guard. `--flag` with no value
# spins forever otherwise - bash's `shift 2` is a NO-OP when fewer than two
# arguments remain, and `set -e` is off, so the loop re-reads the same flag
# until something kills it (rc=124 under `timeout 5`).
# shellcheck source=/dev/null
. "$HERE/jjstack-review-argcheck.sh" || exit 3

# A budget that cannot be evaluated is not a budget. `${2:-}` accepted an empty
# string, `[ "" -gt 12 ]` printed "integer expression expected" and returned
# non-zero, and a non-zero `[` does not increment the violation count — so 41
# lines against a 12-line budget reported `clean`, rc=0. A hard gate that treats
# an unevaluatable check as a pass is not a gate. Validate at parse time instead,
# for every numeric flag, against every non-numeric shape.
need_int() {   # need_int FLAG VALUE
  case "$2" in
    ''|*[![:digit:]]*)
      echo -e "${CYA}error${RST} $1 needs a non-negative integer, got '$2'" >&2; exit 2 ;;
  esac
}

# Budget is deliberately brutal. A PR comment is a DOORBELL, not the delivery:
# verdict, the blocking findings, and the rest one click away in the collapsed
# block beneath. 12 lines / 900 chars visible is about six seconds of reading.
# That is the whole point.
#
# The whole-body cap is GitHub's, not ours: the API refuses a comment body over
# 65536 characters, and a post that fails there fails AFTER the lint said
# clean. Refuse it here, with margin, and name the real problem.
SRC=""; MAX_LINES=12; MAX_CHARS=900; MAX_FINDINGS=3; MAX_TOTAL=60000; QUIET=0
while [ $# -gt 0 ]; do
  case "$1" in
    --max-lines)       review_need_value "$1" $# || exit 2; need_int "$1" "$2"; MAX_LINES="$2";    shift 2 ;;
    --max-chars)       review_need_value "$1" $# || exit 2; need_int "$1" "$2"; MAX_CHARS="$2";    shift 2 ;;
    --max-findings)    review_need_value "$1" $# || exit 2; need_int "$1" "$2"; MAX_FINDINGS="$2"; shift 2 ;;
    --max-total-chars) review_need_value "$1" $# || exit 2; need_int "$1" "$2"; MAX_TOTAL="$2";    shift 2 ;;
    --quiet)     QUIET=1; shift ;;
    -h|--help)   show_help "$0"; exit 0 ;;
    -*) echo -e "${CYA}error${RST} unknown flag: $1" >&2; exit 2 ;;
    *)  [ -z "$SRC" ] && SRC="$1" || { echo -e "${CYA}error${RST} unexpected arg: $1" >&2; exit 2; }
        shift ;;
  esac
done
[ -z "$SRC" ] && { echo -e "${CYA}error${RST} usage: $(basename "$0") <file> [--max-lines N] [--max-chars N] [--max-findings N] [--max-total-chars N]" >&2; exit 2; }
[ -f "$SRC" ] || { echo -e "${CYA}error${RST} no such file: $SRC" >&2; exit 3; }
# PCRE is a HARD REQUIREMENT, checked once, before anything is read.
#
# The shape rule needs lookaheads (the digit-and-uppercase entropy gate) and
# lookbehinds (the "not a .md path" exclusion); neither exists in ERE, and the
# rule cannot be rewritten without losing the property that keeps
# `architrix/adr/AR-1.md` from reading as a credential.
#
# The first attempt at this degraded to `grep -E` instead, and degraded WRONG in
# both halves: `grep -qP "" /dev/null` returns 1 on a machine WITH full PCRE
# (an empty file has no line to match), so the fallback fired on every platform;
# and the substitution that was supposed to strip the lookahead searched for a
# character class without `/` while the pattern contains one, so it changed
# nothing and handed PCRE syntax to `grep -E`, which errored into /dev/null.
# Measured consequence under a grep that rejects -P: an AWS secret access key
# lints CLEAN and the `&&` chain posts it. The eleven vendor rows kept working,
# so the failure was invisible - it silently reverted to "we catch only the
# vendors we listed", which is the round-3 defect this rule exists to fix.
#
# A credential gate may not degrade. Exit 2 here stops the `&&` chain before
# `gh pr comment`, so an unsupported grep means "will not post", never "posts
# your key".
# The probe must MATCH something, and must exercise a lookahead. `grep -qP ''`
# against empty input returns 1 on a machine with full PCRE - no line to match -
# so it reports "no PCRE" everywhere. Give it a line, and a construct that only
# PCRE can parse.
if ! printf 'a1\n' | grep -qP '(?=.*[0-9])a' 2>/dev/null; then
  echo -e "${CYA}error${RST} this lint requires a grep with -P (PCRE); refusing to run" >&2
  echo -e "${YEL}why${RST}   the credential rules use lookaround and cannot degrade safely" >&2
  exit 2
fi

viol=0
secrets=0
say() { [ "$QUIET" -eq 1 ] || echo -e "$1"; }
fail() { viol=$((viol + 1)); say "  ${YEL}$1${RST}  $2"; }
# Fails CLOSED: always printed, to stderr, whatever --quiet says. A caller that
# silenced this would be silencing the one rule that prevents a public leak.
hard() { viol=$((viol + 1)); secrets=$((secrets + 1)); echo -e "  ${YEL}$1${RST}  $2" >&2; }


# --- SAFETY: no credential literal reaches a public PR ------------------------
# The class is "a credential literal", not "an AWS key" and not a list of
# vendors. Enumerating vendors is how the round-3 leak happened: the rule was
# named `aws key id`, matched the 20-char identifier, and let the 40-char SECRET
# access key through. So rule 1 is SHAPE-based - anything that reads like a
# credential being assigned to a credential-shaped name.
#
# The per-vendor rows below are NOT redundant with it and must not be pruned
# into it: a bare token quoted inside a finding - `hardcoded JWT \`eyJ...\`` -
# carries no `name = value` shape at all, so the shape rule cannot see it.
# Collapsing nine rows to three let a JWT, a Google key, a Stripe key and a
# fine-grained PAT lint clean and publish.
#
# `/` MUST stay in the value class: an AWS secret access key
# (`wJalrXUtnFEMI/K7MDENG/bPx...`) has only 13 characters before its first
# slash, so removing `/` let the single most important secret shape through.
# It is the entropy conjuncts, not the character class, that keep
# `Credentials: docs/research/vendor-lessons-aikido.md` from reading as a
# credential: a value must carry BOTH a digit and an uppercase letter, and must
# not end in a source or document extension. Issued tokens are mixed-case with
# digits; kebab-case paths and English identifiers are neither.
#
# `(?![A-Za-z0-9/+_.~-])` before the extension lookbehinds is load-bearing.
# Without it the greedy `{16,}` simply backtracks one character: the 21-char
# `architrix/adr/AR-1.md` failed the `.md` check, matched its first 20
# characters instead, and fired anyway. A false positive
# here is as bad as a leak - exit 4 is unsilenceable, so it would block a
# correct finding with no override.
#
# The NAME half is an enumeration too, and it is widened rather than trusted:
# Azure's `AccountKey=`, a GCP `private_key`, a bare `signing_key` carry none
# of the original six words. `=>` is accepted beside `=` and `:` because a
# Ruby or PHP hashrocket is the same assignment.
#
# The message names the RULE and the LINE, never the match. A linter that echoes
# the key has moved the leak into the terminal and the run log instead of
# stopping it. The fix the message teaches is the one the voice already wants:
# cite `file:line` and the kind; the value goes nowhere public, report included.
#
# `grep -E --` because a PEM header STARTS with dashes: without the terminator
# grep reads the pattern as its own options and that rule silently never fires.
while IFS='|' read -r label pat; do
  [ -n "$label" ] || continue
  hits=$(grep -nPi -- "$pat" "$SRC" 2>/dev/null | cut -d: -f1 | tr '\n' ',' | sed 's/,$//')
  [ -n "$hits" ] && hard "secret" "$label on line(s) $hits. Cite file:line only - the value never goes in a public comment, and a later edit does not remove it from the API's edit history."
done <<'SECRETS'
assigned credential|(api[_-]?key|secret|token|password|passwd|credential|auth|sig|salt|private[_-]?key|access[_-]?key|account[_-]?key|signing[_-]?key)[A-Za-z0-9_-]*["']?[[:space:]]*(=>|[=:])[[:space:]]*["']?([A-Za-z][A-Za-z0-9_-]{0,15}[[:space:]]+)?["']?(?=[A-Za-z0-9/+_.~-]*[0-9])(?=[A-Za-z0-9/+_.~-]*[A-Z])[A-Za-z0-9/+_.~-]{16,}(?![A-Za-z0-9/+_.~-])(?<!\.md)(?<!\.txt)(?<!\.json)(?<!\.yaml)(?<!\.yml)(?<!\.sh)(?<!\.py)(?<!\.js)
private key block|-----BEGIN [A-Z ]*PRIVATE KEY-----
credential in a url|[a-zA-Z][a-zA-Z0-9+.-]*://[^/:@[:space:]]*:[^/@[:space:]]{6,}@
aws key id|(AKIA|ASIA|ABIA|ACCA|AGPA|AIDA|AIPA|ANPA|ANVA|AROA)[0-9A-Z]{16}
github token|gh[pousr]_[A-Za-z0-9]{36,}
github fine-grained pat|github_pat_[A-Za-z0-9_]{22,}
openai-style key|sk-[A-Za-z0-9_-]{20,}
slack token|xox[baprs]-[A-Za-z0-9-]{10,}
google api key|AIza[0-9A-Za-z_-]{35}
stripe key|[srp]k_(live|test)_[A-Za-z0-9]{16,}
json web token|eyJ[A-Za-z0-9_-]{8,}\.eyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}
azure connection string|AccountKey=[A-Za-z0-9+/=]{20,}
SECRETS

# --- the split: what the reader sees, and the report collapsed beneath it ---
# One `<details>` block, opened on its own line (the `<summary>` may share it),
# closed on its own line. Everything outside it is VISIBLE and is what the
# budget rules judge. Everything inside is the report. The safety rules above
# and below read the whole file: a credential or a local path is public
# whether or not it is behind a click.
#
# GitHub renders a bare `<details>` collapsed and a `<details open>` expanded.
# The whole point of the block is that the reader sees the verdict, not the
# report, so `open` is refused: it is forty lines of correct findings the
# author scrolls past, in a new costume.
n_open=$(grep -cE '^[[:space:]]*<details([[:space:]]|>)' "$SRC")
n_close=$(grep -cE '^[[:space:]]*</details>[[:space:]]*$' "$SRC")
VIS=$(mktemp "${TMPDIR:-/tmp}/pcl-vis.XXXXXX"); REP=$(mktemp "${TMPDIR:-/tmp}/pcl-rep.XXXXXX")
trap 'rm -f "$VIS" "$REP"' EXIT
awk -v vis="$VIS" -v rep="$REP" '
  BEGIN { inb = 0 }
  /^[[:space:]]*<details([[:space:]]|>)/ { inb = 1; next }
  /^[[:space:]]*<\/details>[[:space:]]*$/ { inb = 0; next }
  { if (inb) print > rep; else print > vis }
' "$SRC"
n_lines=$(wc -l < "$VIS" | tr -d ' ')
n_chars=$(wc -c < "$VIS" | tr -d ' ')
n_total=$(wc -c < "$SRC" | tr -d ' ')


# --- how many findings the VISIBLE part shows ---------------------------------
# Counted as OCCURRENCES, not lines. `grep -c` OVERRIDES `-o` in GNU grep, so
# five findings on one physical line counted as one and the comment passed clean.
# (A ugrep shim counts occurrences, which is why this survives a hand check.)
#
# And the token class is the SEVERITY, not the one decoration that had a fixture.
# Round 1 widened the prefix class to list markers and blockquotes; `[` was not
# in it, and a spelled-out severity carries no P-token at all. Both evaded the
# cap. Strip the decorations first, then match the token: that covers `**P0**`,
# `[P0]`, `(P0)`, `"P0"`, `- P0`, `1. P0` and `| P0 |` without enumerating them.
#
# Spelled-out severities are matched on the UNstripped text and must carry a
# label marker (a colon, a closing bracket, a bold close). "the critical path"
# in prose is not a finding; "Critical:" is. `P0` matching is case-insensitive
# because `p0` evaded a case-sensitive match.
#
# HIGH, MEDIUM and LOW are deliberately NOT in the list. SKILL.md's finding
# struct sanctions P0-P3 only, and those three words are ordinary English: a
# one-line `APPROVE - no findings, risk is **low**` counted as a finding,
# stopped being an approve, and was then refused for declaring no residual.
# The `\<` boundary is kept for the same class - `LOW` matched inside `below:`.
#
# The report inside the block carries every finding by design, so it is
# counted on the VISIBLE part only; the cap is on what the reader is made to
# read, not on what the review found.
count_findings() {   # count_findings FILE
  local f="$1" a b
  a=$(sed 's/[][*_`(){}<>"]/ /g' "$f" | grep -owiE 'P[0-3]' 2>/dev/null | wc -l | tr -d ' ')
  b=$(grep -oiE '(\*\*|__|\[|\()?\<(CRITICAL|BLOCKER|SEVERE|MAJOR|MINOR|SEV[0-3])(\*\*|__|\]|\)|:)' "$f" 2>/dev/null | wc -l | tr -d ' ')
  echo $(( ${a:-0} + ${b:-0} ))
}
n_find=$(count_findings "$VIS")

# --- the budget scales with the verdict, because the information does ---
# One budget for every verdict was wrong. Twelve lines is right for a REJECT
# carrying two blocking findings. For an APPROVE with nothing to report it is
# four times too generous, and a model fills whatever ceiling it is given: a
# real clean review spent ~25 lines - posture, coverage, five evidence bullets -
# proving it had nothing to say. On a clean PR the author wants the verdict, not
# the audit trail that produced it. The evidence is in the collapsed report.
#
# Detected, not declared, so no caller has to remember to pass a flag. It reads
# the SAME count as the cap: when the count under-reads a finding shape, the
# comment is both under-capped and mis-classified as clean, and the second error
# is silent. One counter, one place to fix.
VERDICT="findings"
if [ "$n_find" -eq 0 ] && grep -qiE '\b(APPROVE|APPROVED|LGTM)\b' "$VIS"; then
  VERDICT="approve"
fi

# --- attribution: the comment must say a machine wrote it ---
# It posts under a human's GitHub account, because that is whose token `gh`
# holds. Without this line a reader cannot tell the review from something its
# apparent author wrote, and every comment this skill has posted so far read
# as Jesper's own words.
ATTRIB='Claude jjstack/skills/review/SKILL.md'
# FIRST, not merely present. A footer is read last or not at all; the reader
# has already taken the verdict as the account holder's opinion by the time
# they reach it. The first thing on the screen says who wrote this - so it is
# the first non-blank line of the WHOLE file: a `<details>` block above it
# would put a collapsed "Full report" on top of the byline.
first_line=$(sed -e '/^[[:space:]]*$/d' "$SRC" | head -1)
case "$first_line" in
  "$ATTRIB"*) ;;
  *) if grep -qF "$ATTRIB" "$SRC"; then
       fail "attribution-not-first" "\"$ATTRIB\" is in the comment but not on its FIRST line. Move it to the top; the verdict follows it."
     else
       fail "no-attribution" "the comment does not carry \"$ATTRIB\". It posts under a human account; say a machine wrote it - on the first line."
     fi ;;
esac

# --- the report block: proof that findings were MOVED, not deleted ---
# Without this, "be brief" degrades into "drop findings", which is the one
# failure this whole skill exists to prevent. The report used to be a linked
# file, and three rounds of this rule were satisfiable without one: any ".md"
# substring counted, then any URL, then a path nobody stat'd, then a path that
# existed on the reviewer's machine and nowhere else. A block IN the comment
# cannot point at nothing - but it can be empty, be two blocks, be left open,
# or be rendered expanded. Each of those has a fixture.
#
# The anti-vacuity floor is the report's own heading. `<details>` around a
# blank line satisfies every structural check and carries nothing; requiring
# the `## /review:` line the report template opens with means the block holds
# a report, not a placeholder.
if [ "$n_open" -ne "$n_close" ]; then
  fail "report-shape" "$n_open <details> against $n_close </details>. The report block opens once, on its own line, and closes once, on its own line."
elif [ "$n_open" -gt 1 ]; then
  fail "report-shape" "$n_open report blocks. One comment, one collapsed report; the visible part carries the rest."
elif [ "$n_open" -eq 1 ]; then
  o_ln=$(grep -nE '^[[:space:]]*<details([[:space:]]|>)' "$SRC" | head -1 | cut -d: -f1)
  c_ln=$(grep -nE '^[[:space:]]*</details>[[:space:]]*$' "$SRC" | head -1 | cut -d: -f1)
  [ "$c_ln" -gt "$o_ln" ] || fail "report-shape" "</details> comes before <details>."
  grep -qE '^[[:space:]]*<details[[:space:]]+open\b' "$SRC" && \
    fail "report-expanded" "<details open> renders the whole report expanded. The reader gets the verdict; the report is one click away - drop \`open\`."
  grep -qE '^## /review:' "$REP" || \
    fail "empty-report" "the collapsed block does not carry a report: no \`## /review:\` heading inside it. Put the full report there (Phase 4's file, verbatim)."
fi

# --- a resolved or clean verdict is exactly one visible line, in a fixed form ---
# Not "short": FIXED. A budget alone leaves room to fill, and it got filled -
# 25 lines of evidence proving a review had nothing to say, then an eleven-
# paragraph reply restating three findings that were already closed.
if [ "$VERDICT" = "approve" ]; then
  # `lgtm` verbatim: it is the human idiom, and a model left to itself writes
  # "Looks good to me!" or "LGTM ✅" instead. Disclosure is the attribution
  # line's job; the prose does not also have to sound like a machine.
  #
  # A RESOLVED verdict carries its report, collapsed; a CLEAN one has nothing
  # to carry. "All issues resolved" asserts findings existed and were fixed,
  # and without the report a PR that closed eleven findings over three rounds
  # renders identically to one that was clean on sight - the one place brevity
  # deleted evidence, on the very comment telling the reader not to worry.
  want_resolved="$ATTRIB: all issues resolved - lgtm - approved"
  want_clean="$ATTRIB: no findings - lgtm - approved"
  # The WHOLE visible part, not its first line: appending prose after the
  # canonical line would otherwise pass this check and be caught only by the
  # length budget, which names the wrong problem.
  body_vis=$(sed -e '/^[[:space:]]*$/d' "$VIS")
  if [ "$body_vis" = "$want_resolved" ]; then
    [ "$n_open" -eq 1 ] || \
      fail "no-report" "a resolved verdict carries its report: \"$want_resolved\" and then the full report in one collapsed <details> block. Without it, eleven closed findings render like a PR that was clean on sight."
  elif [ "$body_vis" = "$want_clean" ]; then
    [ "$n_open" -eq 0 ] || \
      fail "not-canonical" "a first clean review is ONE line and nothing else: nothing was found, so there is nothing to carry. Use the resolved form if findings were closed."
  else
    fail "not-canonical" "a resolved verdict is one visible line: \"$want_resolved\" (or \"$want_clean\" when nothing was ever found), with the report collapsed beneath it. Nothing else."
  fi
else
  [ "$n_open" -eq 1 ] || \
    fail "no-report" "no collapsed report block. A findings comment shows the blocking findings and carries the full report in one <details> block beneath them: brevity moves evidence, it never deletes it."
fi

[ "$n_lines" -gt "$MAX_LINES" ] && {
  if [ "$VERDICT" = "approve" ]; then
    fail "too-long" "$n_lines visible lines for a clean approve (budget $MAX_LINES). Nothing was found: say so. The evidence for why it is clean belongs in the report, not the comment."
  else
    fail "too-long" "$n_lines visible lines (budget $MAX_LINES). Cut findings from the visible part, not from the report: the block beneath carries them."
  fi
}
[ "$n_chars" -gt "$MAX_CHARS" ] && \
  fail "too-long" "$n_chars visible chars (budget $MAX_CHARS, verdict=$VERDICT)."
[ "$n_total" -gt "$MAX_TOTAL" ] && \
  fail "too-long" "$n_total chars in the whole body (cap $MAX_TOTAL; GitHub refuses a comment over 65536). Trim the report's expansions, not its findings."

# --- finding count: the real cause of a wall of text ---
# Length is the symptom. The cause is pasting every finding into the visible
# part. Cap what appears there; the rest stay in the collapsed report.
[ "$n_find" -gt "$MAX_FINDINGS" ] && \
  fail "too-many" "$n_find findings visible (max $MAX_FINDINGS). Show the blocking ones; the report beneath carries the rest."

# --- no local machine path anywhere, report included ---
# It names a machine a reader of the PR cannot reach, and the pre-flight
# artifacts the report is built from print `repo: /home/...` lines by design:
# a report pasted in whole carries them unless the reviewer strips them.
localp=$(grep -oE '(^|[[:space:]`(])(/tmp/|/home/|/Users/|~/)[^[:space:]`)]*' "$SRC" 2>/dev/null | head -1 | sed 's/^[[:space:]`(]//')
[ -n "$localp" ] && fail "local-path" "\`$localp\` is a path on the reviewer's machine. Nothing local goes in a public comment, above or below the fold; cite repo-relative paths."

# --- the residual: the count that proves nothing was dropped ---
# "N blocking, M total" lived only as prose in the voice reference, so a comment
# could show three findings, declare nothing, and pass clean. That is precisely
# how "be brief" turns into "drop findings". The arithmetic is checkable, so it
# is checked: M-N must be stated, and it must equal total minus shown.
# The report is in the same file now, so the visible half is answerable to it.
# Before the fold this check COULD not see the report; now it can, and until
# this fix it still did not. A one-line "all issues resolved - lgtm - approved"
# over a report reading REJECT with two unfixed P0s linted clean and posted:
# the author reads the top of the comment and merges, with the blocking
# findings one click below, unread.
# The report's findings are its TABLE ROWS, not its P-tokens. Phase 4's
# template puts each finding in a row and expands it beneath, so a token sweep
# counts every finding at least twice and a Guardrails line mentioning P0
# counts a third. Floored against that, a comment declaring its true total was
# REFUSED and only an inflated one passed - the rule exists so a reader is
# never told there are fewer findings than there are, and it made the reviewer
# tell them there are more. Introduced by the fix for the opposite defect, and
# invisible to every fixture, because a fixture of flat bullets carries one
# token per finding and the two counts coincide.
n_rep=$(sed -n '/^### Findings/,/^### /p' "$REP" 2>/dev/null | grep -cE '^\|[[:space:]]*P[0-3][[:space:]]*\|')
# ANTI-VACUITY FLOOR. The range above is anchored on a literal heading, so a
# report that lists its findings anywhere else yields an empty range, n_rep=0,
# and every declared total clears a floor of nothing - five findings declared
# as one, clean, posted. The repo's own rule names the class: an assertion that
# scopes its own input needs a floor beside it, or empty input passes
# unconditionally. So count the lines that OPEN with a severity, which is what
# one finding looks like in EITHER shape, and take the larger.
#
# Anchored, deliberately. A Guardrails sentence reading "while no P0 is added"
# mentions a severity mid-line and is not a finding; counting those is the
# over-count the table rule replaced.
n_anch=$(grep -cE '^([-*+][[:space:]]+|[0-9]+\.[[:space:]]+)?(\*\*|__|\[|\()?P[0-3]\b' "$REP" 2>/dev/null)
[ "${n_anch:-0}" -gt "${n_rep:-0}" ] && n_rep="$n_anch"
if [ "$VERDICT" = "approve" ]; then
  # A resolved or clean verdict may not sit on a report that still blocks.
  if grep -qE '^\*\*Verdict:\*\*[[:space:]]*(REJECT|CAUTION|STOP)' "$REP" 2>/dev/null; then
    fail "verdict-contradicts-report" "the visible line approves while the report beneath it does not. The reader takes the top of the comment as the answer and never opens the block."
  fi
else
  decl=$(grep -oiE '[0-9]+ blocking,[[:space:]]*[0-9]+ total' "$VIS" 2>/dev/null | head -1)
  if [ -z "$decl" ]; then
    fail "no-residual" "no \"N blocking, M total\" declared. Without the total, a reader cannot tell a short comment from a dropped finding."
  else
    n_block=$(echo "$decl" | grep -oE '^[0-9]+')
    n_tot=$(echo "$decl" | grep -oE '[0-9]+ total' | grep -oE '^[0-9]+')
    if [ "$n_tot" -lt "$n_block" ]; then
      fail "bad-residual" "$decl: the total cannot be smaller than the blocking count."
    elif [ "$n_rep" -gt "$n_tot" ]; then
      # The declared total is a FLOOR, not a free variable. It may exceed what
      # the report enumerates, but never fall below it: that is a finding the
      # reader is never told exists.
      fail "bad-residual" "$n_tot declared, but the report beneath carries $n_rep. The declared total is what the reader trusts; it cannot be smaller than the report it sits on."
    elif [ "$n_tot" -gt "$n_find" ]; then
      want=$((n_tot - n_find))
      got=$(grep -oiE '[0-9]+ more\b' "$VIS" 2>/dev/null | head -1 | grep -oE '^[0-9]+')
      [ "${got:-x}" = "$want" ] || \
        fail "bad-residual" "$n_tot total, $n_find shown: say \"$want more\" and point at the report beneath. Findings move into the report, they never disappear."
    fi
  fi
fi

# --- emdash: hard rule, the single most recognisable tell ---
# Whole body: the report is posted too, under the same account.
if grep -q '—' "$SRC"; then
  fail "emdash" "found '—'. Use the short dash '-' instead - in the report as well, it is public now."
fi

if [ "$secrets" -gt 0 ]; then
  echo -e "${YEL}$secrets credential literal(s)${RST} - redact before posting. This comment must not be published." >&2
  exit 4
fi
if [ "$viol" -eq 0 ]; then
  say "${GRN}clean${RST}    $n_lines visible lines, $n_chars visible chars, $n_total total - within budget and in voice."
  exit 0
fi
say "${YEL}$viol rule violation(s)${RST} - fix before posting."
exit 1
