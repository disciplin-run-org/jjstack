#!/usr/bin/env bash
# jjstack-pr-comment-lint — enforce the safety, brevity and voice rules on a PR
# review comment BEFORE it is posted, mechanically.
#
# Two jobs, in this order.
#
# 1. SAFETY. A PR comment is public and permanent. The review's own security lens
#    is what surfaces credentials, and the voice rules mandate a one-line
#    `file:line` claim that renders the evidence inline, so the natural output of
#    a good review is a comment quoting the key it just found. Editing the
#    comment afterwards does not remove the value from the API's edit history.
#    The secret rules therefore fail CLOSED: they cannot be silenced by --quiet
#    and they carry their own exit code.
#
# 2. BREVITY AND VOICE. A review nobody reads is a review that did not happen.
#    The failure mode is not a wrong finding, it is 400 lines of correct findings
#    that a human scrolls past. Prose instructions to "be concise" lose to a
#    model's pull toward completeness on every single run, so the budget is
#    enforced by code instead of by asking.
#
# Every rule here is one a machine can decide. Voice judgement stays in the
# skill; only the checkable half lives in this script.
#
# Rules enforced (from the Jesper Jurcenoks Voice DNA, Executive register):
#   - the attribution line, so a reader knows a machine wrote it
#   - a resolved/clean verdict is ONE line, in a fixed form
#   - no credential literal anywhere in the body  (fails closed, exit 4)
#   - hard size budget: lines and characters
#   - at most N findings inline, counted as OCCURRENCES not lines
#   - a link to a report that EXISTS on disk
#   - a declared residual: "N blocking, M total" plus "M-shown more"
#   - no emdash "—"            (hard rule, the critical differentiator)
#
# Voice beyond that - superlatives, meta-commentary, sentence length, softening
# qualifiers - is JUDGEMENT and lives in references/pr-comment-voice.md. A
# grep cannot tell "robust" in a finding's quoted code from "robust" used to
# sell, and a linter that argues about prose is a linter people stop running.
#
# Usage:
#   jjstack-pr-comment-lint <file> [--max-lines N] [--max-chars N]
#                                  [--max-findings N] [--quiet]
# Exit: 0 clean, 1 rule violations found, 2 usage, 3 file missing,
#       4 a credential literal was found (never post; redact first).
#
# No color red anywhere — unreadable on the target terminal.
set -uo pipefail

YEL="\033[33m"; CYA="\033[96m"; GRN="\033[32m"; RST="\033[0m"

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# review_need_value: the family's ONE argument guard. `--flag` with no value
# spins forever otherwise - bash's `shift 2` is a NO-OP when fewer than two
# arguments remain, and `set -e` is off, so the loop re-reads the same flag
# until something kills it (rc=124 under `timeout 5`).
# shellcheck source=/dev/null
. "$HERE/jjstack-review-argcheck.sh" || exit 3

# A budget that cannot be evaluated is not a budget. `${2:-}` accepted an empty
# string, `[ "" -gt 12 ]` printed "integer expression expected" and returned
# non-zero, and a non-zero `[` does not increment the violation count — so 41
# lines against a 12-line budget reported `clean`, rc=0. A hard gate that treats
# an unevaluatable check as a pass is not a gate. Validate at parse time instead,
# for every numeric flag, against every non-numeric shape.
need_int() {   # need_int FLAG VALUE
  case "$2" in
    ''|*[![:digit:]]*)
      echo -e "${CYA}error${RST} $1 needs a non-negative integer, got '$2'" >&2; exit 2 ;;
  esac
}

# Budget is deliberately brutal. A PR comment is a DOORBELL, not the delivery:
# verdict, the blocking findings, a link. Everything else is already committed
# to {repo}/jjstack/ and does not need re-typing into a scroll box.
# 12 lines / 900 chars is about six seconds of reading. That is the whole point.
SRC=""; MAX_LINES=12; MAX_CHARS=900; MAX_FINDINGS=3; QUIET=0
while [ $# -gt 0 ]; do
  case "$1" in
    --max-lines)    review_need_value "$1" $# || exit 2; need_int "$1" "$2"; MAX_LINES="$2";    shift 2 ;;
    --max-chars)    review_need_value "$1" $# || exit 2; need_int "$1" "$2"; MAX_CHARS="$2";    shift 2 ;;
    --max-findings) review_need_value "$1" $# || exit 2; need_int "$1" "$2"; MAX_FINDINGS="$2"; shift 2 ;;
    --quiet)     QUIET=1; shift ;;
    -h|--help)   show_help "$0"; exit 0 ;;
    -*) echo -e "${CYA}error${RST} unknown flag: $1" >&2; exit 2 ;;
    *)  [ -z "$SRC" ] && SRC="$1" || { echo -e "${CYA}error${RST} unexpected arg: $1" >&2; exit 2; }
        shift ;;
  esac
done
[ -z "$SRC" ] && { echo -e "${CYA}error${RST} usage: $(basename "$0") <file> [--max-lines N] [--max-chars N] [--max-findings N]" >&2; exit 2; }
[ -f "$SRC" ] || { echo -e "${CYA}error${RST} no such file: $SRC" >&2; exit 3; }

# PCRE is a HARD REQUIREMENT, checked once, before anything is read.
#
# The shape rule needs lookaheads (the digit-and-uppercase entropy gate) and
# lookbehinds (the "not a .md path" exclusion); neither exists in ERE, and the
# rule cannot be rewritten without losing the property that keeps
# `architrix/adr/AR-1.md` from reading as a credential.
#
# The first attempt at this degraded to `grep -E` instead, and degraded WRONG in
# both halves: `grep -qP "" /dev/null` returns 1 on a machine WITH full PCRE
# (an empty file has no line to match), so the fallback fired on every platform;
# and the substitution that was supposed to strip the lookahead searched for a
# character class without `/` while the pattern contains one, so it changed
# nothing and handed PCRE syntax to `grep -E`, which errored into /dev/null.
# Measured consequence under a grep that rejects -P: an AWS secret access key
# lints CLEAN and the `&&` chain posts it. The eleven vendor rows kept working,
# so the failure was invisible - it silently reverted to "we catch only the
# vendors we listed", which is the round-3 defect this rule exists to fix.
#
# A credential gate may not degrade. Exit 2 here stops the `&&` chain before
# `gh pr comment`, so an unsupported grep means "will not post", never "posts
# your key".
# The probe must MATCH something, and must exercise a lookahead. `grep -qP ''`
# against empty input returns 1 on a machine with full PCRE - no line to match -
# so it reports "no PCRE" everywhere. Give it a line, and a construct that only
# PCRE can parse.
if ! printf 'a1\n' | grep -qP '(?=.*[0-9])a' 2>/dev/null; then
  echo -e "${CYA}error${RST} this lint requires a grep with -P (PCRE); refusing to run" >&2
  echo -e "${YEL}why${RST}   the credential rules use lookaround and cannot degrade safely" >&2
  exit 2
fi

viol=0
secrets=0
say() { [ "$QUIET" -eq 1 ] || echo -e "$1"; }
fail() { viol=$((viol + 1)); say "  ${YEL}$1${RST}  $2"; }
# Fails CLOSED: always printed, to stderr, whatever --quiet says. A caller that
# silenced this would be silencing the one rule that prevents a public leak.
hard() { viol=$((viol + 1)); secrets=$((secrets + 1)); echo -e "  ${YEL}$1${RST}  $2" >&2; }

n_lines=$(wc -l < "$SRC" | tr -d ' ')
n_chars=$(wc -c < "$SRC" | tr -d ' ')

# --- SAFETY: no credential literal reaches a public PR ------------------------
# The class is "a credential literal", not "an AWS key" and not a list of
# vendors. Enumerating vendors is how the round-3 leak happened: the rule was
# named `aws key id`, matched the 20-char identifier, and let the 40-char SECRET
# access key through. So rule 1 is SHAPE-based - anything that reads like a
# credential being assigned to a credential-shaped name.
#
# The per-vendor rows below are NOT redundant with it and must not be pruned
# into it: a bare token quoted inside a finding - `hardcoded JWT \`eyJ...\`` -
# carries no `name = value` shape at all, so the shape rule cannot see it.
# Collapsing nine rows to three let a JWT, a Google key, a Stripe key and a
# fine-grained PAT lint clean and publish.
#
# `/` MUST stay in the value class: an AWS secret access key
# (`wJalrXUtnFEMI/K7MDENG/bPx...`) has only 13 characters before its first
# slash, so removing `/` let the single most important secret shape through.
# It is the entropy conjuncts, not the character class, that keep
# `Credentials: docs/research/vendor-lessons-aikido.md` from reading as a
# credential: a value must carry BOTH a digit and an uppercase letter, and must
# not end in a source or document extension. Issued tokens are mixed-case with
# digits; kebab-case paths and English identifiers are neither.
#
# `(?![A-Za-z0-9/+_.~-])` before the extension lookbehinds is load-bearing.
# Without it the greedy `{16,}` simply backtracks one character: the 21-char
# `architrix/adr/AR-1.md` failed the `.md` check, matched its first 20
# characters instead, and fired anyway. A false positive
# here is as bad as a leak - exit 4 is unsilenceable, so it would block a
# correct finding with no override.
#
# The NAME half is an enumeration too, and it is widened rather than trusted:
# Azure's `AccountKey=`, a GCP `private_key`, a bare `signing_key` carry none
# of the original six words. `=>` is accepted beside `=` and `:` because a
# Ruby or PHP hashrocket is the same assignment.
#
# The message names the RULE and the LINE, never the match. A linter that echoes
# the key has moved the leak into the terminal and the run log instead of
# stopping it. The fix the message teaches is the one the voice already wants:
# cite `file:line`, leave the value in the committed report.
#
# `grep -E --` because a PEM header STARTS with dashes: without the terminator
# grep reads the pattern as its own options and that rule silently never fires.
while IFS='|' read -r label pat; do
  [ -n "$label" ] || continue
  hits=$(grep -nPi -- "$pat" "$SRC" 2>/dev/null | cut -d: -f1 | tr '\n' ',' | sed 's/,$//')
  [ -n "$hits" ] && hard "secret" "$label on line(s) $hits. Cite file:line only - the value never goes in a public comment, and a later edit does not remove it from the API's edit history."
done <<'SECRETS'
assigned credential|(api[_-]?key|secret|token|password|passwd|credential|auth|sig|salt|private[_-]?key|access[_-]?key|account[_-]?key|signing[_-]?key)[A-Za-z0-9_-]*["']?[[:space:]]*(=>|[=:])[[:space:]]*["']?(?=[A-Za-z0-9/+_.~-]*[0-9])(?=[A-Za-z0-9/+_.~-]*[A-Z])[A-Za-z0-9/+_.~-]{16,}(?![A-Za-z0-9/+_.~-])(?<!\.md)(?<!\.txt)(?<!\.json)(?<!\.yaml)(?<!\.yml)(?<!\.sh)(?<!\.py)(?<!\.js)
private key block|-----BEGIN [A-Z ]*PRIVATE KEY-----
credential in a url|[a-zA-Z][a-zA-Z0-9+.-]*://[^/:@[:space:]]+:[^/@[:space:]]{6,}@
aws key id|(AKIA|ASIA|ABIA|ACCA|AGPA|AIDA|AIPA|ANPA|ANVA|AROA)[0-9A-Z]{16}
github token|gh[pousr]_[A-Za-z0-9]{36,}
github fine-grained pat|github_pat_[A-Za-z0-9_]{22,}
openai-style key|sk-[A-Za-z0-9_-]{20,}
slack token|xox[baprs]-[A-Za-z0-9-]{10,}
google api key|AIza[0-9A-Za-z_-]{35}
stripe key|[srp]k_(live|test)_[A-Za-z0-9]{16,}
json web token|eyJ[A-Za-z0-9_-]{8,}\.eyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}
azure connection string|AccountKey=[A-Za-z0-9+/=]{20,}
SECRETS

# --- how many findings this comment shows -------------------------------------
# Counted as OCCURRENCES, not lines. `grep -c` OVERRIDES `-o` in GNU grep, so
# five findings on one physical line counted as one and the comment passed clean.
# (A ugrep shim counts occurrences, which is why this survives a hand check.)
#
# And the token class is the SEVERITY, not the one decoration that had a fixture.
# Round 1 widened the prefix class to list markers and blockquotes; `[` was not
# in it, and a spelled-out severity carries no P-token at all. Both evaded the
# cap. Strip the decorations first, then match the token: that covers `**P0**`,
# `[P0]`, `(P0)`, `"P0"`, `- P0`, `1. P0` and `| P0 |` without enumerating them.
#
# Spelled-out severities are matched on the UNstripped text and must carry a
# label marker (a colon, a closing bracket, a bold close). "the critical path"
# in prose is not a finding; "Critical:" is. `P0` matching is case-insensitive
# because `p0` evaded a case-sensitive match.
#
# HIGH, MEDIUM and LOW are deliberately NOT in the list. SKILL.md's finding
# struct sanctions P0-P3 only, and those three words are ordinary English: a
# one-line `APPROVE - no findings, risk is **low**` counted as a finding,
# stopped being an approve, and was then refused for declaring no residual.
# The `\<` boundary is kept for the same class - `LOW` matched inside `below:`.
count_findings() {   # count_findings FILE
  local f="$1" a b
  a=$(sed 's/[][*_`(){}<>"]/ /g' "$f" | grep -owiE 'P[0-3]' 2>/dev/null | wc -l | tr -d ' ')
  b=$(grep -oiE '(\*\*|__|\[|\()?\<(CRITICAL|BLOCKER|SEVERE|MAJOR|MINOR|SEV[0-3])(\*\*|__|\]|\)|:)' "$f" 2>/dev/null | wc -l | tr -d ' ')
  echo $(( ${a:-0} + ${b:-0} ))
}
n_find=$(count_findings "$SRC")

# --- the budget scales with the verdict, because the information does ---
# One budget for every verdict was wrong. Twelve lines is right for a REJECT
# carrying two blocking findings. For an APPROVE with nothing to report it is
# four times too generous, and a model fills whatever ceiling it is given: a
# real clean review spent ~25 lines - posture, coverage, five evidence bullets -
# proving it had nothing to say. On a clean PR the author wants the verdict, not
# the audit trail that produced it. The evidence is already in the report.
#
# Detected, not declared, so no caller has to remember to pass a flag. It reads
# the SAME count as the cap: when the count under-reads a finding shape, the
# comment is both under-capped and mis-classified as clean, and the second error
# is silent. One counter, one place to fix.
VERDICT="findings"
if [ "$n_find" -eq 0 ] && grep -qiE '\b(APPROVE|APPROVED|LGTM)\b' "$SRC"; then
  # No separate budget for an approve: the canonical-form check below is an
  # exact match on the whole body, which is strictly stricter than any line or
  # character count. Setting one here was dead code - reverting it to the old
  # 3-line/250-char budget changed no assertion.
  VERDICT="approve"
fi

# --- attribution: the comment must say a machine wrote it ---
# It posts under a human's GitHub account, because that is whose token `gh`
# holds. Without this line a reader cannot tell the review from something its
# apparent author wrote, and every comment this skill has posted so far read
# as Jesper's own words.
ATTRIB='Claude jjstack/skills/review/SKILL.md'
grep -qF "$ATTRIB" "$SRC" || \
  fail "no-attribution" "the comment does not carry \"$ATTRIB\". It posts under a human account; say a machine wrote it."

# --- a resolved or clean verdict is exactly one line, in a fixed form ---
# Not "short": FIXED. A budget alone leaves room to fill, and it got filled -
# 25 lines of evidence proving a review had nothing to say, then an eleven-
# paragraph reply restating three findings that were already closed.
if [ "$VERDICT" = "approve" ]; then
  # `lgtm` verbatim: it is the human idiom, and a model left to itself writes
  # "Looks good to me!" or "LGTM ✅" instead. Disclosure is the attribution
  # line's job; the prose does not also have to sound like a machine.
  # A resolved verdict carries its report; a clean one has nothing to carry.
  # Without the path, a PR that closed eleven findings over three rounds renders
  # identically to one that was clean on sight - and this is the lint that says
  # "brevity moves evidence, it never deletes it" twenty lines further down. The
  # approve path was the one place where brevity deleted it, on the very comment
  # telling the reader not to worry.
  want_resolved_re="^$ATTRIB: all issues resolved - lgtm - approved - [A-Za-z0-9_./-]+\.md$"
  want_clean="$ATTRIB: no findings - lgtm - approved"
  # The WHOLE body, not its first line: appending prose after the canonical
  # line would otherwise pass this check and be caught only by the length
  # budget, which names the wrong problem.
  body_all=$(sed -e '/^[[:space:]]*$/d' "$SRC")
  if ! grep -qE "$want_resolved_re" <<<"$body_all" && [ "$body_all" != "$want_clean" ]; then
    fail "not-canonical" "a resolved verdict is one line: \"$ATTRIB: all issues resolved - lgtm - approved - <report>.md\" (or \"$want_clean\" when nothing was ever found). Nothing else."
  elif grep -qE "$want_resolved_re" <<<"$body_all"; then
    # The path is not decoration: it must exist, for the same reason the
    # no-report rule stats a link. A pointer to nothing is no pointer.
    rr=$(sed -E "s/.* - ([A-Za-z0-9_.\/-]+\.md)$/\1/" <<<"$body_all")
    sd=$(cd "$(dirname "$SRC")" && pwd)
    rt=$(git -C "$sd" rev-parse --show-toplevel 2>/dev/null || true)
    fnd=0
    for c in "${rt:+$rt/$rr}" "$sd/$rr" "$sd/../$rr" "$sd/$(basename "$rr")"; do
      [ -n "$c" ] && [ -f "$c" ] && { fnd=1; break; }
    done
    [ "$fnd" -eq 1 ] || \
      fail "no-report" "the resolved line names \`$rr\` and no such file exists. Commit the report first, then approve."
  fi
fi

[ "$n_lines" -gt "$MAX_LINES" ] && {
  if [ "$VERDICT" = "approve" ]; then
    fail "too-long" "$n_lines lines for a clean approve (budget $MAX_LINES). Nothing was found: say so and link the report. The evidence for why it is clean belongs in the report, not the comment."
  else
    fail "too-long" "$n_lines lines (budget $MAX_LINES). Cut findings, do not cut evidence: link instead."
  fi
}
[ "$n_chars" -gt "$MAX_CHARS" ] && \
  fail "too-long" "$n_chars chars (budget $MAX_CHARS, verdict=$VERDICT)."

# --- finding count: the real cause of a wall of text ---
# Length is the symptom. The cause is pasting every finding into the comment.
# Cap what appears inline; the rest stays in the committed report.
[ "$n_find" -gt "$MAX_FINDINGS" ] && \
  fail "too-many" "$n_find findings inline (max $MAX_FINDINGS). Show the blocking ones, link the rest."

# --- the link: proof that findings were MOVED, not deleted ---
# Without this, "be brief" degrades into "drop findings", which is the one
# failure this whole skill exists to prevent.
#
# Two rounds of this rule were satisfiable without a report. First any ".md"
# substring counted, so a finding whose own subject was `docs/setup.md:12`
# passed. Then a bare `https://` counted, so a finding citing any URL passed.
# And a named report path was never stat'd: `jjstack/does-not-exist-anywhere.md`
# returned clean. So: the reference must LOOK like a report, and if it names a
# path it must BE there. A link to nothing is the same as no link.
report_ref=$(grep -oE '(jjstack/[A-Za-z0-9_./-]*\.md|review-[0-9]{4}-[0-9]{2}-[0-9]{2}\.md)' "$SRC" 2>/dev/null | head -1)
url_ref=$(grep -oE 'https?://[^)>[:space:]`"'"'"']+' "$SRC" 2>/dev/null \
  | grep -E '(\.md([?#].*)?$|/jjstack/|review-[0-9]{4}-[0-9]{2}-[0-9]{2})' | head -1)

if [ "$VERDICT" = "approve" ]; then
  : # the canonical resolved line carries no link: there is nothing to move
elif [ -z "$report_ref" ] && [ -z "$url_ref" ]; then
  fail "no-link" "no link to the full report. A finding's own subject file is not a report link, and neither is a bare URL inside a citation: brevity moves evidence, it never deletes it."
elif [ -n "$report_ref" ]; then
  # Resolve against the repo the comment lives in, then against the comment's own
  # directory, then one level up: {OUTPUT_DIR} is normally {repo}/jjstack, so
  # both "jjstack/review-DATE.md" and a bare "review-DATE.md" have to land.
  src_dir=$(cd "$(dirname "$SRC")" && pwd)
  root=$(git -C "$src_dir" rev-parse --show-toplevel 2>/dev/null || true)
  found=0
  for cand in "${root:+$root/$report_ref}" "$src_dir/$report_ref" "$src_dir/../$report_ref" "$src_dir/$(basename "$report_ref")"; do
    [ -n "$cand" ] && [ -f "$cand" ] && { found=1; break; }
  done
  [ "$found" -eq 1 ] || \
    fail "no-report" "the comment links \`$report_ref\`, and no such file exists. Commit the report first (Phase 5), then link it: a link to nothing is the same as no link."
fi

# --- the residual: the count that proves nothing was dropped ---
# "N blocking, M total" lived only as prose in the voice reference, so a comment
# could show three findings, declare nothing, and pass clean. That is precisely
# how "be brief" turns into "drop findings". The arithmetic is checkable, so it
# is checked: M-N must be stated, and it must equal total minus shown.
if [ "$VERDICT" = "approve" ]; then
  : # the canonical one-line form above already states the outcome
else
  decl=$(grep -oiE '[0-9]+ blocking,[[:space:]]*[0-9]+ total' "$SRC" 2>/dev/null | head -1)
  if [ -z "$decl" ]; then
    fail "no-residual" "no \"N blocking, M total\" declared. Without the total, a reader cannot tell a short comment from a dropped finding."
  else
    n_block=$(echo "$decl" | grep -oE '^[0-9]+')
    n_total=$(echo "$decl" | grep -oE '[0-9]+ total' | grep -oE '^[0-9]+')
    if [ "$n_total" -lt "$n_block" ]; then
      fail "bad-residual" "$decl: the total cannot be smaller than the blocking count."
    elif [ "$n_total" -gt "$n_find" ]; then
      want=$((n_total - n_find))
      got=$(grep -oiE '[0-9]+ more\b' "$SRC" 2>/dev/null | head -1 | grep -oE '^[0-9]+')
      [ "${got:-x}" = "$want" ] || \
        fail "bad-residual" "$n_total total, $n_find shown: say \"$want more\" and link the report. Findings move into the report, they never disappear."
    fi
  fi
fi

# --- emdash: hard rule, the single most recognisable tell ---
if grep -q '—' "$SRC"; then
  fail "emdash" "found '—'. Use the short dash '-' instead."
fi

if [ "$secrets" -gt 0 ]; then
  echo -e "${YEL}$secrets credential literal(s)${RST} - redact before posting. This comment must not be published." >&2
  exit 4
fi
if [ "$viol" -eq 0 ]; then
  say "${GRN}clean${RST}    $n_lines lines, $n_chars chars - within budget and in voice."
  exit 0
fi
say "${YEL}$viol rule violation(s)${RST} - fix before posting."
exit 1
