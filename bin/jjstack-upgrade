#!/usr/bin/env bash
# jjstack-upgrade — pull the latest jjstack from GitHub.
#
# Safe preconditions (all required; skips with a reason otherwise):
#   - The jjstack working tree is clean (no uncommitted changes).
#   - The current branch is main (or whatever remote HEAD points at).
#   - Local is not ahead of origin — the pull would be a fast-forward.
#
# On a successful pull, also:
#   - Writes the pre-upgrade version to ~/.jjstack/just-upgraded-from so
#     the next jjstack-update-check run reports JUST_UPGRADED <old> <new>.
#   - Re-runs the setup step that re-symlinks skills and refreshes hooks,
#     so a new skill introduced in the pulled commits becomes active
#     without the user having to re-run ./setup manually.
#
# Usage:
#   jjstack-upgrade              # safe auto-pull with preconditions
#   jjstack-upgrade --check      # dry-run: only report what WOULD happen

set -euo pipefail

JJSTACK_DIR="${JJSTACK_DIR:-$(cd "$(dirname "$0")/.." && pwd)}"
STATE_DIR="${JJSTACK_STATE_DIR:-$HOME/.jjstack}"

# UPGRADE THE CLONE, NOT THE TREE WE WERE REACHED THROUGH.
#
# The normal way to run this is through the served link, and the served tree is
# a DETACHED worktree. Every precondition below wants a branch, so reached that
# way the script aborted with "on branch 'DETACHED'" and a pinned install could
# never be upgraded at all - including by /jjstack-repair, whose whole job is
# to fix an install without the user knowing where the clone lives.
PINBIN="$(dirname "$0")/jjstack-skills-pin"
if [ -x "$PINBIN" ]; then
  SOURCE_DIR="$(JJSTACK_DIR="$JJSTACK_DIR" "$PINBIN" --source 2>/dev/null || echo "$JJSTACK_DIR")"
else
  SOURCE_DIR="$JJSTACK_DIR"
fi
[ -n "$SOURCE_DIR" ] || SOURCE_DIR="$JJSTACK_DIR"
if [ "$SOURCE_DIR" != "$JJSTACK_DIR" ]; then
  echo "note: reached through a pinned worktree; upgrading the clone at $SOURCE_DIR"
fi
JJSTACK_DIR="$SOURCE_DIR"
MARKER_FILE="$STATE_DIR/just-upgraded-from"
VERSION_FILE="$JJSTACK_DIR/VERSION"

CHECK_ONLY=false
for arg in "$@"; do
  case "$arg" in
    --check) CHECK_ONLY=true ;;
    -h|--help)
      sed -n '2,/^set/p' "$0" | sed 's/^# //; s/^#//' | head -n -1
      exit 0 ;;
    *)
      echo "unknown arg: $arg (use --help)" >&2
      exit 2 ;;
  esac
done

cd "$JJSTACK_DIR"

# ─── Precondition: inside a git repo ──────────────────────────
if ! git rev-parse --git-dir >/dev/null 2>&1; then
  echo "ABORT: $JJSTACK_DIR is not a git repo"
  exit 1
fi

# ─── Precondition: working tree clean ─────────────────────────
if ! git diff-index --quiet HEAD -- 2>/dev/null; then
  echo "ABORT: working tree has uncommitted changes. Commit or stash first."
  git status --short
  exit 1
fi

# ─── Precondition: on the default branch ──────────────────────
DEFAULT_BRANCH="$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##' || echo main)"
CURRENT_BRANCH="$(git symbolic-ref --short HEAD 2>/dev/null || echo DETACHED)"
if [ "$CURRENT_BRANCH" != "$DEFAULT_BRANCH" ]; then
  echo "ABORT: on branch '$CURRENT_BRANCH', not '$DEFAULT_BRANCH'. Switch branches first."
  exit 1
fi

# ─── Fetch latest refs ────────────────────────────────────────
git fetch --quiet origin "$DEFAULT_BRANCH" || {
  echo "ABORT: git fetch failed"
  exit 1
}

# ─── Precondition: fast-forward only ──────────────────────────
LOCAL_SHA=$(git rev-parse HEAD)
REMOTE_SHA=$(git rev-parse "origin/$DEFAULT_BRANCH")

# Advancing the served tree is not part of "did the clone move". A pin can be
# behind a current clone - that is exactly the state after installing this
# change, or after any manual `git pull` - so this runs on the up-to-date path
# too, and the message says which of the two it is talking about.
sync_served_tree() {
  [ -x "$PINBIN" ] || return 0
  # A DRY RUN MAY NOT WRITE. The guard lives in the function rather than at the
  # call sites, because the defect was a call site that forgot it: the
  # equal-sha exit ran the sync before --check was ever consulted, so
  # `jjstack-upgrade --check` advanced the pin and moved the root and skill
  # links. Guarding here covers the call sites that exist and the ones added
  # later, which is the difference between fixing the instance and the class.
  if [ "$CHECK_ONLY" = true ]; then
    local _cur _want
    _cur="$("$PINBIN" --status 2>/dev/null || true)"
    _want="$(git rev-parse --short "$1" 2>/dev/null || echo "$1")"
    echo "WOULD_SYNC served tree to $_want (currently: ${_cur:-unknown})"
    return 0
  fi
  JJSTACK_DIR="$JJSTACK_DIR" "$PINBIN" "$1" || \
    echo "WARNING: skills pin not advanced; sessions still load the previous release"
  # The root link is how references/ and bin/ are reached and fix-symlinks
  # skips it by name, so it is moved here or by nothing.
  JJSTACK_DIR="$JJSTACK_DIR" "$PINBIN" --link || \
    echo "WARNING: root link not moved; sessions still load the previous tree"
  if [ -x "$JJSTACK_DIR/bin/jjstack-fix-symlinks" ]; then
    JJSTACK_DIR="$JJSTACK_DIR" JJSTACK_REPIN_LINKS=1 \
      "$JJSTACK_DIR/bin/jjstack-fix-symlinks" >/dev/null 2>&1 || true
  fi
}

if [ "$LOCAL_SHA" = "$REMOTE_SHA" ]; then
  echo "clone already up-to-date"
  sync_served_tree "$REMOTE_SHA"
  exit 0
fi

# Local should be an ancestor of remote (fast-forward). If not, the local
# branch has commits not on origin — merge/push is the maintainer's job.
if ! git merge-base --is-ancestor "$LOCAL_SHA" "$REMOTE_SHA"; then
  echo "ABORT: local $DEFAULT_BRANCH is ahead of origin or diverged. Resolve manually."
  exit 1
fi

# ─── Dry-run mode: show what would happen, exit ───────────────
if [ "$CHECK_ONLY" = true ]; then
  COMMITS_BEHIND=$(git rev-list --count "${LOCAL_SHA}..${REMOTE_SHA}")
  echo "WOULD_UPGRADE $COMMITS_BEHIND commits ($LOCAL_SHA → $REMOTE_SHA)"
  exit 0
fi

# ─── Stash the pre-upgrade version for the JUST_UPGRADED marker ─
OLD_VERSION=""
if [ -f "$VERSION_FILE" ]; then
  OLD_VERSION="$(cat "$VERSION_FILE" 2>/dev/null | tr -d '[:space:]')"
fi

# ─── Fast-forward pull ────────────────────────────────────────
git pull --ff-only --quiet origin "$DEFAULT_BRANCH"

NEW_VERSION=""
if [ -f "$VERSION_FILE" ]; then
  NEW_VERSION="$(cat "$VERSION_FILE" 2>/dev/null | tr -d '[:space:]')"
fi

# Drop the marker so the next update-check can say "JUST_UPGRADED"
mkdir -p "$STATE_DIR"
if [ -n "$OLD_VERSION" ]; then
  echo "$OLD_VERSION" > "$MARKER_FILE"
fi

# ─── Advance the served tree to what was just pulled ──────────
# The pull moved this clone; the live tree is a separate pinned worktree and
# does not move with it. Without this an upgrade would report success and
# change nothing any session loads.
sync_served_tree "$REMOTE_SHA"

# Also refresh the statusline path (handles relocated clones)
if [ -x "$JJSTACK_DIR/bin/jjstack-statusline-install" ]; then
  "$JJSTACK_DIR/bin/jjstack-statusline-install" >/dev/null 2>&1 || true
fi

if [ -n "$OLD_VERSION" ] && [ -n "$NEW_VERSION" ] && [ "$OLD_VERSION" != "$NEW_VERSION" ]; then
  echo "UPGRADED $OLD_VERSION → $NEW_VERSION"
else
  echo "UPGRADED (version unchanged — doc-only or chore commits)"
fi
