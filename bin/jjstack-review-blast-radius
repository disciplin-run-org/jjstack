#!/usr/bin/env bash
# jjstack-review-blast-radius — deterministic cross-file impact map for a diff.
#
# The one mechanic in Greptile's pitch that survives scrutiny is repo-wide
# context: a reviewer that only sees the unified diff cannot see the callers of
# the function the diff just changed, so it structurally cannot catch the
# "signature changed, three call sites elsewhere now wrong" class of defect.
# Greptile solves that with a hosted index. We do not need one — for the
# specific question "who else references the definitions this diff touched?",
# grep over the working tree is exact, free, and auditable.
#
# So this script extracts every identifier whose DEFINITION the diff adds,
# removes or rewrites, then lists every reference to it in files the diff did
# NOT touch. Those sites are the un-reviewed ripple surface. Pure mechanics —
# parsing, matching and counting — which is why it is a script and not a
# paragraph of prompt: /review's model spends its judgment on "is this call
# site now broken?", never on running grep.
#
# Usage:
#   jjstack-review-blast-radius [--repo DIR] [--base REF] [--diff-file FILE|-]
#                               [--max-refs N] [--generic-threshold N]
#
#   --repo               repo root (default: git rev-parse --show-toplevel)
#   --base               diff base ref (default: first of origin/main,
#                        origin/master, main, master that exists)
#   --diff-file          read a unified diff from FILE instead of git ("-" = stdin)
#   --max-refs           reference sites listed per symbol (default 10)
#   --generic-threshold  above this many hits a symbol is called too generic to
#                        map and its sites are not listed (default 40)
#   --also-repo          additional repo root to search for references
#                        (repeatable; sites are prefixed "(reponame) ").
#                        The cheap half of Greptile's "Repo Clusters": a shared
#                        module's callers usually live in a sibling repo, and a
#                        review that never looks there cannot see them break.
#
# Writes a markdown report to stdout; status and errors go to stderr.
# Exit: 0 report produced (an empty diff is still a 0), 2 usage error,
#       3 no usable repo or diff source.
#
# No color red anywhere — unreadable on the target terminal.
set -uo pipefail

YEL="\033[33m"; CYA="\033[96m"; RST="\033[0m"

REPO=""; BASE=""; DIFF_FILE=""; MAX_REFS=10; GENERIC=40
ALSO=()

while [ $# -gt 0 ]; do
  case "$1" in
    --repo)               REPO="${2:-}"; shift 2 ;;
    --base)               BASE="${2:-}"; shift 2 ;;
    --diff-file)          DIFF_FILE="${2:-}"; shift 2 ;;
    --max-refs)           MAX_REFS="${2:-}"; shift 2 ;;
    --generic-threshold)  GENERIC="${2:-}"; shift 2 ;;
    --also-repo)
      if [ -d "${2:-}" ]; then ALSO+=("${2%/}")
      else echo -e "${YEL}warn${RST}  --also-repo not a directory, skipped: ${2:-}" >&2; fi
      shift 2 ;;
    -h|--help)
      sed -n '2,38p' "$0" | sed 's/^# \{0,1\}//'
      exit 0 ;;
    -*) echo -e "${CYA}error${RST} unknown flag: $1" >&2; exit 2 ;;
    *)  echo -e "${CYA}error${RST} unexpected arg: $1" >&2; exit 2 ;;
  esac
done

case "$MAX_REFS" in ''|*[!0-9]*) echo -e "${CYA}error${RST} --max-refs must be a number" >&2; exit 2 ;; esac
case "$GENERIC"  in ''|*[!0-9]*) echo -e "${CYA}error${RST} --generic-threshold must be a number" >&2; exit 2 ;; esac

[ -z "$REPO" ] && REPO="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$REPO" ] || [ ! -d "$REPO" ]; then
  echo -e "${YEL}warn${RST}  no repo root: pass --repo or run inside a git repo" >&2
  exit 3
fi
REPO="${REPO%/}"

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT
DIFF="$TMP/diff"
SOURCE=""

if [ -n "$DIFF_FILE" ]; then
  if [ "$DIFF_FILE" = "-" ]; then
    cat > "$DIFF"; SOURCE="stdin"
  elif [ -f "$DIFF_FILE" ]; then
    cp "$DIFF_FILE" "$DIFF"; SOURCE="$DIFF_FILE"
  else
    echo -e "${YEL}warn${RST}  diff file not found: $DIFF_FILE" >&2
    exit 3
  fi
else
  if [ -z "$BASE" ]; then
    for c in origin/main origin/master main master; do
      if git -C "$REPO" rev-parse --verify --quiet "$c" >/dev/null 2>&1; then BASE="$c"; break; fi
    done
  fi
  if [ -z "$BASE" ]; then
    echo -e "${YEL}warn${RST}  no base ref found; pass --base or --diff-file" >&2
    exit 3
  fi
  git -C "$REPO" diff "$BASE...HEAD" > "$DIFF" 2>/dev/null \
    || git -C "$REPO" diff "$BASE" > "$DIFF" 2>/dev/null
  SOURCE="git diff $BASE"
fi

echo "# Cross-file blast radius"
echo
echo "Every identifier whose *definition* this diff adds, removes or rewrites, and"
echo "every reference to it in files the diff did NOT touch. Those sites are the"
echo "ripple surface a diff-only review structurally cannot see."
echo

if [ ! -s "$DIFF" ]; then
  echo "Empty diff — nothing to map."
  exit 0
fi

# Files this diff touches: they are the reviewed surface, so references inside
# them are not "elsewhere" and must not pad the map.
grep -E '^\+\+\+ ' "$DIFF" \
  | sed -E 's/^\+\+\+ [ab]\///; s/^\+\+\+ //' \
  | grep -v '^/dev/null$' | sort -u > "$TMP/touched"

# Definition-site extraction. Added AND removed lines both count: a deleted
# definition is exactly the case where out-of-diff callers break hardest.
awk '
function emit(n) {
  if (length(n) < 3) return
  if (n in kwnoise) return
  if (n in seen) return
  seen[n] = 1
  print n
}
# Definition keywords are LANGUAGE-scoped, not global. A global keyword set
# looks harmless until "--type fixed" in a shell script yields the symbol
# `fixed`, or English prose yields `whose`. Each language only contributes the
# keywords it actually uses; anything unrecognised gets a conservative set.
function kwfor(p) {
  if (p ~ /\.py$/)                       return "def|class"
  if (p ~ /\.go$/)                       return "func|type|struct|interface"
  if (p ~ /\.rs$/)                       return "fn|struct|trait|enum|impl|type"
  if (p ~ /\.(js|jsx|mjs|cjs|ts|tsx)$/)  return "function|class|interface|type|enum"
  if (p ~ /\.(java|kt|kts|scala|cs)$/)   return "class|interface|enum|record"
  if (p ~ /\.rb$/)                       return "def|class|module"
  if (p ~ /\.(c|h|cc|cpp|hpp|hh)$/)      return "struct|class|enum|typedef"
  if (p ~ /\.(php|swift|dart)$/)         return "function|class|func|struct|enum"
  if (isshell(p))                        return ""
  return "def|class|func|fn|function"
}
# Extensionless files are executables (bin/foo), which here means shell.
function isshell(p,  b) {
  b = p; sub(/.*\//, "", b)
  return (p ~ /\.(sh|bash|zsh|ksh)$/) || (b !~ /\./)
}
function isjs(p) { return (p ~ /\.(js|jsx|mjs|cjs|ts|tsx)$/) }
BEGIN {
  # Keyword-capture misfires and shell names that are never worth tracing.
  split("def class func fn function interface struct type trait enum module " \
        "impl record typedef " \
        "if else for while return true false null nil none new self this " \
        "IFS PATH HOME PWD OLDPWD SHELL USER LANG TERM EOF TMPDIR RANDOM LC_ALL", k, " ")
  for (i in k) kwnoise[k[i]] = 1
  skip = 1; kw = ""
}
# Prose is not code. Those keywords ("the type whose…", "a class of…") match
# English constantly, so extracting definitions from markdown and data files
# buries the real symbols. Track the file each hunk belongs to.
/^\+\+\+ / {
  p = substr($0, 5); sub(/^[ab]\//, "", p)
  skip = (p ~ /\.(md|markdown|txt|rst|adoc|json|ya?ml|toml|ini|cfg|csv|tsv|lock|svg|html?|xml|po|pot)$/)
  kw = kwfor(p); shellfile = isshell(p); jsfile = isjs(p)
  next
}
/^--- / { next }
/^[+-]/ {
  if (skip) next
  line = substr($0, 2)

  # keyword-introduced definitions, in the languages that use these keywords
  if (kw != "") {
    rest = line
    while (match(rest, "(^|[^A-Za-z0-9_])(" kw ")[ \t]+[A-Za-z_][A-Za-z0-9_]*")) {
      m = substr(rest, RSTART, RLENGTH)
      sub("^[^A-Za-z_]*", "", m)
      sub("^(" kw ")[ \t]+", "", m)
      emit(m)
      rest = substr(rest, RSTART + RLENGTH)
    }
  }

  # shell function:  name() {
  if (shellfile && match(line, "^[ \t]*[A-Za-z_][A-Za-z0-9_]*[ \t]*\\(\\)")) {
    m = substr(line, RSTART, RLENGTH); gsub(/[ \t()]/, "", m); emit(m)
  }

  # js/ts binding:  const NAME =   /  let NAME =  /  var NAME =
  if (jsfile && match(line, "(^|[^A-Za-z0-9_])(const|let|var)[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]*=")) {
    m = substr(line, RSTART, RLENGTH)
    sub("^[^A-Za-z_]*", "", m); sub("^(const|let|var)[ \t]+", "", m)
    sub("[ \t]*=$", "", m); emit(m)
  }

  # Env-contract constant:  LONG_NAME=. Deliberately narrow — a bare shell
  # VAR= is a local (TMP, SRC, DEST) and mapping those is pure noise. Requiring
  # an underscore and 6+ chars targets the names that actually cross files.
  if (match(line, "(^|[^A-Za-z0-9_])[A-Z][A-Z0-9]*_[A-Z0-9_]*=")) {
    m = substr(line, RSTART, RLENGTH); sub("^[^A-Z]*", "", m); sub("=$", "", m)
    if (length(m) >= 6) emit(m)
  }
}
' "$DIFF" | sort -u > "$TMP/symbols"

TOUCHED_N=$(wc -l < "$TMP/touched" | tr -d ' ')
SYM_N=$(wc -l < "$TMP/symbols" | tr -d ' ')

echo "- repo: \`$REPO\`"
echo "- diff source: \`$SOURCE\`"
echo "- changed files: $TOUCHED_N"
echo "- definition symbols extracted: $SYM_N"
echo

if [ "$SYM_N" -eq 0 ]; then
  echo "No definition-shaped changes in this diff — the blast radius is the diff itself."
  exit 0
fi

EXCL=(--exclude-dir=.git --exclude-dir=node_modules --exclude-dir=vendor
      --exclude-dir=dist --exclude-dir=build --exclude-dir=target
      --exclude-dir=.venv --exclude-dir=venv --exclude-dir=__pycache__
      --exclude-dir=.next --exclude-dir=coverage --exclude-dir=.mypy_cache
      --exclude=*.diff --exclude=*.patch --exclude=*.lock --exclude=*.min.js)

i=0
: > "$TMP/index"; : > "$TMP/generic"; : > "$TMP/contained"
while read -r sym; do
  [ -n "$sym" ] || continue
  i=$((i + 1))
  grep -rnwIF "${EXCL[@]}" --binary-files=without-match -e "$sym" "$REPO" 2>/dev/null \
    | sed "s|^$REPO/||" \
    | awk -F: -v tf="$TMP/touched" 'BEGIN{while((getline l < tf) > 0) t[l]=1} !($1 in t)' \
    > "$TMP/h.$i"
  # Sibling repos: every hit is out-of-diff by construction, so no touched-file
  # filter — but label the repo so a site is never mistaken for a local path.
  for extra in ${ALSO+"${ALSO[@]}"}; do
    grep -rnwIF "${EXCL[@]}" --binary-files=without-match -e "$sym" "$extra" 2>/dev/null \
      | sed "s|^$extra/|($(basename "$extra")) |" >> "$TMP/h.$i"
  done
  refs=$(wc -l < "$TMP/h.$i" | tr -d ' ')
  if [ "$refs" -eq 0 ]; then
    printf '%s\n' "$sym" >> "$TMP/contained"
  elif [ "$refs" -gt "$GENERIC" ]; then
    printf '%s\t%s\n' "$sym" "$refs" >> "$TMP/generic"
  else
    files=$(cut -d: -f1 "$TMP/h.$i" | sort -u | wc -l | tr -d ' ')
    printf '%s\t%s\t%s\t%s\n' "$refs" "$files" "$i" "$sym" >> "$TMP/index"
  fi
done < "$TMP/symbols"

MAPPED=$(wc -l < "$TMP/index" | tr -d ' ')
if [ "$MAPPED" -gt 0 ]; then
  echo "## Symbols with out-of-diff references"
  echo
  sort -rn -k1,1 "$TMP/index" | while IFS=$'\t' read -r refs files idx sym; do
    echo "### \`$sym\` — $refs reference(s) in $files file(s)"
    head -n "$MAX_REFS" "$TMP/h.$idx" | cut -d: -f1,2 | sed 's/^/- /'
    if [ "$refs" -gt "$MAX_REFS" ]; then
      echo "- (+$((refs - MAX_REFS)) more; raise --max-refs to list them)"
    fi
    echo
  done
fi

if [ -s "$TMP/generic" ]; then
  echo "## Too generic to map"
  echo
  echo "Above the generic threshold ($GENERIC hits) — listing every site would be"
  echo "noise. If the change to one of these is behavioural, grep it by hand."
  echo
  awk -F'\t' '{ printf "- `%s` — %s hits\n", $1, $2 }' "$TMP/generic"
  echo
fi

if [ -s "$TMP/contained" ]; then
  CN=$(wc -l < "$TMP/contained" | tr -d ' ')
  echo "## Contained — no out-of-diff references ($CN)"
  echo
  echo "These definitions are referenced only inside the changed files. That is"
  echo "evidence of containment, not proof: dynamic dispatch, reflection, string"
  echo "keys and cross-language callers are invisible to a textual match."
  echo
  awk '{ printf "%s`%s`", (NR > 1 ? ", " : "- "), $0 } END { print "" }' "$TMP/contained"
  echo
fi

echo "---"
echo
echo "Each site above is an out-of-diff caller. For every one, ask: does the"
echo "changed definition still satisfy this call? A site that no longer holds is"
echo "a P0 the diff alone cannot show. Absence of a site is weak evidence, never"
echo "proof — this map is textual, so it misses dynamic dispatch, reflection,"
echo "string-keyed lookup and cross-language callers."
exit 0
