#!/usr/bin/env bash
# jjstack-review-blast-radius — deterministic cross-file impact map for a diff.
#
# The one mechanic in Greptile's pitch that survives scrutiny is repo-wide
# context: a reviewer that only sees the unified diff cannot see the callers of
# the function the diff just changed, so it structurally cannot catch the
# "signature changed, three call sites elsewhere now wrong" class of defect.
# Greptile solves that with a hosted index. We do not need one — for the
# specific question "who else references the definitions this diff touched?",
# grep over the working tree is exact, free, and auditable.
#
# So this script extracts every identifier whose DEFINITION the diff adds,
# removes or rewrites, then lists every reference to it in files the diff did
# NOT touch. Those sites are the un-reviewed ripple surface. Pure mechanics —
# parsing, matching and counting — which is why it is a script and not a
# paragraph of prompt: /review's model spends its judgment on "is this call
# site now broken?", never on running grep.
#
# Usage:
#   jjstack-review-blast-radius [--repo DIR] [--base REF] [--diff-file FILE|-]
#                               [--max-refs N] [--generic-threshold N]
#                               [--out DIR] [--max-symbols N] [--dry-run]
#
#   --repo               repo root (default: git rev-parse --show-toplevel)
#   --base               diff base ref (default: first of origin/main,
#                        origin/master, main, master that exists). The diff is
#                        taken from the merge base to the WORKING TREE, so
#                        uncommitted and staged edits are mapped too.
#   --diff-file          read a unified diff from FILE instead of git ("-" = stdin)
#   --out DIR            write DIR/blast-radius.md instead of stdout
#   --max-symbols        stop after N extracted symbols (default 200); the
#                        report says so when it truncates
#   --dry-run            with --out, print what would be written and exit
#   --max-refs           reference sites listed per symbol (default 10)
#   --generic-threshold  above this many hits a symbol is called too generic to
#                        map and its sites are not listed (default 40)
#   --also-repo          additional repo root to search for references
#                        (repeatable; sites are prefixed "(reponame) ").
#                        The cheap half of Greptile's "Repo Clusters": a shared
#                        module's callers usually live in a sibling repo, and a
#                        review that never looks there cannot see them break.
#
# Writes a markdown report to stdout; status and errors go to stderr.
# Exit: 0 report produced (an empty diff is still a 0), 2 usage error,
#       3 no usable repo or diff source.
#
# No color red anywhere — unreadable on the target terminal.
set -uo pipefail

YEL="\033[33m"; CYA="\033[96m"; RST="\033[0m"

REPO=""; BASE=""; DIFF_FILE=""; MAX_REFS=10; GENERIC=40
OUT=""; DRY_RUN=0; MAX_SYMBOLS=200
ALSO=()

while [ $# -gt 0 ]; do
  case "$1" in
    --repo)               REPO="${2:-}"; shift 2 ;;
    --base)               BASE="${2:-}"; shift 2 ;;
    --diff-file)          DIFF_FILE="${2:-}"; shift 2 ;;
    --max-refs)           MAX_REFS="${2:-}"; shift 2 ;;
    --generic-threshold)  GENERIC="${2:-}"; shift 2 ;;
    --out)                OUT="${2:-}"; shift 2 ;;
    --dry-run)            DRY_RUN=1; shift ;;
    --max-symbols)        MAX_SYMBOLS="${2:-}"; shift 2 ;;
    --also-repo)
      if [ -d "${2:-}" ]; then ALSO+=("${2%/}")
      else echo -e "${YEL}warn${RST}  --also-repo not a directory, skipped: ${2:-}" >&2; fi
      shift 2 ;;
    -h|--help)
      sed -n '2,47p' "$0" | sed 's/^# \{0,1\}//'
      exit 0 ;;
    -*) echo -e "${CYA}error${RST} unknown flag: $1" >&2; exit 2 ;;
    *)  echo -e "${CYA}error${RST} unexpected arg: $1" >&2; exit 2 ;;
  esac
done

case "$MAX_REFS" in ''|*[!0-9]*) echo -e "${CYA}error${RST} --max-refs must be a number" >&2; exit 2 ;; esac
case "$GENERIC"  in ''|*[!0-9]*) echo -e "${CYA}error${RST} --generic-threshold must be a number" >&2; exit 2 ;; esac
case "$MAX_SYMBOLS" in ''|*[!0-9]*) echo -e "${CYA}error${RST} --max-symbols must be a number" >&2; exit 2 ;; esac

[ -z "$REPO" ] && REPO="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$REPO" ] || [ ! -d "$REPO" ]; then
  echo -e "${YEL}warn${RST}  no repo root: pass --repo or run inside a git repo" >&2
  exit 3
fi
REPO="${REPO%/}"

# An explicitly named --base MUST resolve, and the check happens here — before
# the --out redirect, so a bad ref leaves no artifact behind to be read as a
# result. A typo like `orgin/main` otherwise made merge-base fail, `git diff`
# fail with its stderr discarded and its rc ignored, and the report render
# "Empty diff — nothing to map" at exit 0: a green pre-flight row over a map
# that was never built. An unresolvable ref is a usage error, and it is named.
if [ -n "$BASE" ] && [ -z "$DIFF_FILE" ]; then
  if ! git -C "$REPO" rev-parse --verify --quiet "${BASE}^{commit}" >/dev/null 2>&1; then
    echo -e "${CYA}error${RST} --base '$BASE' does not resolve to a commit in $REPO" >&2
    echo -e "${YEL}hint${RST}  check the spelling and that the ref is fetched:" >&2
    echo -e "${YEL}hint${RST}    git -C '$REPO' rev-parse --verify '$BASE'" >&2
    exit 2
  fi
fi

# --out adapter. Phase 0's jjstack-review-preflight calls this with `--out DIR`
# and then reads DIR/blast-radius.md; stdout is the default so the tool stays
# usable by hand. --dry-run must not create the directory: the pre-flight pack
# advertises a dry run as writing nothing, and a stray empty dir is a write.
if [ -n "$OUT" ]; then
  if [ "$DRY_RUN" = "1" ]; then
    echo -e "${YEL}dry-run${RST} would write $OUT/blast-radius.md" >&2
    exit 0
  fi
  mkdir -p "$OUT" || { echo -e "${CYA}error${RST} cannot create $OUT" >&2; exit 3; }
  exec > "$OUT/blast-radius.md"
fi

TMP="$(mktemp -d)"

# The pre-flight index used to render row 2 from this script's exit code alone,
# so "ran — map built" appeared over an empty map. It now reads these facts, on
# the same principle rows 1 and 5 already follow: no row may claim more than the
# artifact beneath it. Written on every exit path, from the EXIT trap.
BLAST_STATUS="error"; BLAST_SYMBOLS=0; BLAST_MAPPED=0
BLAST_CONTAINED=0; BLAST_GENERIC=0; BLAST_TRUNCATED=0
write_blast_status() {
  [ -n "$OUT" ] && [ -d "$OUT" ] || return 0
  {
    echo "# machine-readable; consumed by jjstack-review-preflight. Do not edit."
    echo "BLAST_STATUS=$BLAST_STATUS"
    echo "BLAST_SYMBOLS=$BLAST_SYMBOLS"
    echo "BLAST_MAPPED=$BLAST_MAPPED"
    echo "BLAST_CONTAINED=$BLAST_CONTAINED"
    echo "BLAST_GENERIC=$BLAST_GENERIC"
    echo "BLAST_TRUNCATED=$BLAST_TRUNCATED"
  } > "$OUT/blast-status.env"
}
trap 'write_blast_status; rm -rf "$TMP"' EXIT
DIFF="$TMP/diff"
SOURCE=""
SCOPE=""

if [ -n "$DIFF_FILE" ]; then
  if [ "$DIFF_FILE" = "-" ]; then
    cat > "$DIFF"; SOURCE="stdin"
  elif [ -f "$DIFF_FILE" ]; then
    cp "$DIFF_FILE" "$DIFF"; SOURCE="$DIFF_FILE"
  else
    echo -e "${YEL}warn${RST}  diff file not found: $DIFF_FILE" >&2
    exit 3
  fi
  SCOPE="whatever the supplied diff covers — this script did not choose it"
else
  if [ -z "$BASE" ]; then
    for c in origin/main origin/master main master; do
      if git -C "$REPO" rev-parse --verify --quiet "$c" >/dev/null 2>&1; then BASE="$c"; break; fi
    done
  fi
  if [ -z "$BASE" ]; then
    echo -e "${YEL}warn${RST}  no base ref found; pass --base or --diff-file" >&2
    exit 3
  fi
  # Two-dot, from the merge base, against the WORKING TREE.
  #
  # This used to be `git diff "$BASE...HEAD"` with a `|| git diff "$BASE"`
  # fallback, and the fallback was dead code: a three-dot diff that matches
  # nothing still exits 0. So the map saw COMMITTED work only, and the
  # flagship scenario as an uncommitted edit — symbol renamed, out-of-diff
  # caller left stale — printed "Empty diff — nothing to map". Pre-pass 1
  # sweeps the working tree, so a committed-only map also put two different
  # diff scopes in one evidence pack without saying so. Reviewing
  # staged-but-uncommitted work is the ordinary pre-landing moment; it is the
  # case that must work, not the exception.
  MB="$(git -C "$REPO" merge-base "$BASE" HEAD 2>/dev/null)"
  [ -n "$MB" ] || MB="$BASE"
  # rc was discarded here, so a failed diff and a genuinely empty one were the
  # same thing to every caller. They are not: one is a gap, the other a fact.
  if ! git -C "$REPO" diff "$MB" > "$DIFF" 2>"$TMP/differr"; then
    echo -e "${CYA}error${RST} git diff against '$MB' failed in $REPO" >&2
    sed 's/^/  /' "$TMP/differr" >&2
    exit 3
  fi
  SOURCE="git diff \$(git merge-base $BASE HEAD)"
  SCOPE="working tree vs the merge base of \`$BASE\` and HEAD — committed AND uncommitted changes to tracked files. Untracked files are invisible to \`git diff\`, so a brand-new file's symbols are not mapped."
fi

echo "# Cross-file blast radius"
echo
echo "Every identifier whose *definition* this diff adds, removes or rewrites, and"
echo "every reference to it in files the diff did NOT touch. Those sites are the"
echo "ripple surface a diff-only review structurally cannot see."
echo

if [ ! -s "$DIFF" ]; then
  echo "- diff source: \`$SOURCE\`"
  echo "- diff scope: $SCOPE"
  echo
  echo "Empty diff — nothing to map. Read that as \"this scope contains no"
  echo "change\", not as \"the change is contained\": anything outside the scope"
  echo "named above was never looked at."
  BLAST_STATUS="empty"
  exit 0
fi

# Files this diff touches: they are the reviewed surface, so references inside
# them are not "elsewhere" and must not pad the map.
grep -E '^\+\+\+ ' "$DIFF" \
  | sed -E 's/^\+\+\+ [ab]\///; s/^\+\+\+ //' \
  | grep -v '^/dev/null$' | sort -u > "$TMP/touched"

# Definition-site extraction. Added AND removed lines both count: a deleted
# definition is exactly the case where out-of-diff callers break hardest.
awk '
function emit(n) {
  if (length(n) < 3) return
  if (n in kwnoise) return
  if (n in seen) return
  seen[n] = 1
  print n
}
# Definition keywords are LANGUAGE-scoped, not global. A global keyword set
# looks harmless until "--type fixed" in a shell script yields the symbol
# `fixed`, or English prose yields `whose`. Each language only contributes the
# keywords it actually uses; anything unrecognised gets a conservative set.
function kwfor(p) {
  if (p ~ /\.py$/)                       return "def|class"
  if (p ~ /\.go$/)                       return "func|type|struct|interface"
  if (p ~ /\.rs$/)                       return "fn|struct|trait|enum|impl|type"
  if (p ~ /\.(js|jsx|mjs|cjs|ts|tsx)$/)  return "function|class|interface|type|enum"
  if (p ~ /\.(java|kt|kts|scala|cs)$/)   return "class|interface|enum|record"
  if (p ~ /\.rb$/)                       return "def|class|module"
  if (p ~ /\.(c|h|cc|cpp|hpp|hh)$/)      return "struct|class|enum|typedef"
  if (p ~ /\.(php|swift|dart)$/)         return "function|class|func|struct|enum"
  if (isshell(p))                        return ""
  return "def|class|func|fn|function"
}
# Extensionless files are executables (bin/foo), which here means shell.
function isshell(p,  b) {
  b = p; sub(/.*\//, "", b)
  return (p ~ /\.(sh|bash|zsh|ksh)$/) || (b !~ /\./)
}
function isjs(p) { return (p ~ /\.(js|jsx|mjs|cjs|ts|tsx)$/) }
# A WHOLE-LINE comment declares nothing, in any language. Without this the
# keyword scan mines `# class Foo` and `// class Foo` exactly as if they were
# definitions — and the reference doc already promised it did not. The filter
# is deliberately restricted to lines that are ONLY a comment: stripping a
# trailing `#` would cut into shell strings and URLs, and over-collecting a
# real symbol costs one empty grep while dropping one costs a bug.
function cmtre(p) {
  if (p ~ /\.(py|rb|pl|r|tf)$/)          return "^[ \t]*#"
  if (p ~ /\.(js|jsx|mjs|cjs|ts|tsx|go|rs|java|kt|kts|scala|cs|c|h|cc|cpp|hpp|hh|php|swift|dart)$/)
                                        return "^[ \t]*(//|/\\*|\\*[ \t]|\\*$)"
  if (p ~ /\.(sql|lua|hs|elm|adb|ads)$/) return "^[ \t]*--"
  if (isshell(p))                       return "^[ \t]*#"
  return "^[ \t]*(#|//|--)"
}
BEGIN {
  # Keyword-capture misfires and shell names that are never worth tracing.
  split("def class func fn function interface struct type trait enum module " \
        "impl record typedef " \
        "if else for while return true false null nil none new self this " \
        "IFS PATH HOME PWD OLDPWD SHELL USER LANG TERM EOF TMPDIR RANDOM LC_ALL", k, " ")
  for (i in k) kwnoise[k[i]] = 1
  skip = 1; kw = ""
}
# Prose is not code. Those keywords ("the type whose…", "a class of…") match
# English constantly, so extracting definitions from markdown and data files
# buries the real symbols. Track the file each hunk belongs to.
/^\+\+\+ / {
  p = substr($0, 5); sub(/^[ab]\//, "", p)
  skip = (p ~ /\.(md|markdown|txt|rst|adoc|json|ya?ml|toml|ini|cfg|csv|tsv|lock|svg|html?|xml|po|pot)$/)
  kw = kwfor(p); shellfile = isshell(p); jsfile = isjs(p); cre = cmtre(p)
  next
}
/^--- / { next }

# A new hunk resets the enclosing-definition tracker.
/^@@/ {
  encsym = ""; encind = -1
  # git often names the enclosing function in the hunk header itself
  # ("@@ -1,5 +1,9 @@ class OrderStatus:"). When it does, that is the most
  # reliable enclosing signal available and costs nothing to read.
  if (!skip && kw != "" && match($0, "@@.*@@[ \t]*")) {
    tail = substr($0, RSTART + RLENGTH)
    if (match(tail, "(^|[^A-Za-z0-9_])(" kw ")[ \t]+[A-Za-z_][A-Za-z0-9_]*")) {
      m = substr(tail, RSTART, RLENGTH)
      sub("^[^A-Za-z_]*", "", m); sub("^(" kw ")[ \t]+", "", m)
      pending_hdr = m
    }
  }
  next
}

# CONTEXT lines (unchanged, leading space). The enclosing-definition case:
# a change INSIDE a class/enum/function body while the definition line itself
# is untouched. Nothing on a +/- line names the thing whose contract changed,
# so pattern-on-changed-lines extraction is blind to it — and that is exactly
# the gstack "enum completeness" case, the one category it says needs
# out-of-diff reading. Remember the definition seen as context, then emit it
# only if a changed line in this hunk is indented INSIDE it.
/^ / {
  if (skip || kw == "") next
  line = substr($0, 2)
  if (cre != "" && line ~ cre) next
  if (match(line, "^[ \t]*") && RLENGTH >= 0) ind = RLENGTH
  if (match(line, "(^|[^A-Za-z0-9_])(" kw ")[ \t]+[A-Za-z_][A-Za-z0-9_]*")) {
    m = substr(line, RSTART, RLENGTH)
    sub("^[^A-Za-z_]*", "", m); sub("^(" kw ")[ \t]+", "", m)
    encsym = m; encind = ind
  }
  next
}

/^[+-]/ {
  if (skip) next
  line = substr($0, 2)

  # Changed line sits inside a definition whose own line never changed.
  if (match(line, "^[ \t]*")) chind = RLENGTH; else chind = 0
  if (encsym != "" && chind > encind) { emit(encsym); encsym = "" }
  if (pending_hdr != "") { emit(pending_hdr); pending_hdr = "" }

  # A changed comment is still a change inside the enclosing definition (above),
  # but the comment line itself declares nothing — never mine it for symbols.
  if (cre != "" && line ~ cre) next

  # keyword-introduced definitions, in the languages that use these keywords
  if (kw != "") {
    rest = line
    while (match(rest, "(^|[^A-Za-z0-9_])(" kw ")[ \t]+[A-Za-z_][A-Za-z0-9_]*")) {
      m = substr(rest, RSTART, RLENGTH)
      sub("^[^A-Za-z_]*", "", m)
      sub("^(" kw ")[ \t]+", "", m)
      emit(m)
      rest = substr(rest, RSTART + RLENGTH)
    }
  }

  # shell function:  name() {
  if (shellfile && match(line, "^[ \t]*[A-Za-z_][A-Za-z0-9_]*[ \t]*\\(\\)")) {
    m = substr(line, RSTART, RLENGTH); gsub(/[ \t()]/, "", m); emit(m)
  }

  # js/ts binding:  const NAME =   /  let NAME =  /  var NAME =
  if (jsfile && match(line, "(^|[^A-Za-z0-9_])(const|let|var)[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]*=")) {
    m = substr(line, RSTART, RLENGTH)
    sub("^[^A-Za-z_]*", "", m); sub("^(const|let|var)[ \t]+", "", m)
    sub("[ \t]*=$", "", m); emit(m)
  }

  # Env-contract constant:  LONG_NAME=. Deliberately narrow — a bare shell
  # VAR= is a local (TMP, SRC, DEST) and mapping those is pure noise. Requiring
  # an underscore and 6+ chars targets the names that actually cross files.
  if (match(line, "(^|[^A-Za-z0-9_])[A-Z][A-Z0-9]*_[A-Z0-9_]*=")) {
    m = substr(line, RSTART, RLENGTH); sub("^[^A-Z]*", "", m); sub("=$", "", m)
    if (length(m) >= 6) emit(m)
  }
}
' "$DIFF" | sort -u > "$TMP/symbols"

TOUCHED_N=$(wc -l < "$TMP/touched" | tr -d ' ')
SYM_N=$(wc -l < "$TMP/symbols" | tr -d ' ')

echo "- repo: \`$REPO\`"
echo "- diff source: \`$SOURCE\`"
echo "- diff scope: $SCOPE"
echo "- changed files: $TOUCHED_N"
echo "- definition symbols extracted: $SYM_N"
# --max-symbols was parsed and validated but never applied, so the loop below
# was unbounded and the flag was a promise the code did not keep.
BLAST_SYMBOLS="$SYM_N"
if [ "$SYM_N" -gt "$MAX_SYMBOLS" ]; then
  head -n "$MAX_SYMBOLS" "$TMP/symbols" > "$TMP/symbols.cap"
  mv "$TMP/symbols.cap" "$TMP/symbols"
  BLAST_TRUNCATED=1
  echo "- **TRUNCATED**: only the first $MAX_SYMBOLS of $SYM_N symbols were"
  echo "  mapped (\`--max-symbols\`). The rest were NOT checked — a known gap,"
  echo "  not a clean result. Raise the limit to map them."
fi
echo

if [ "$SYM_N" -eq 0 ]; then
  echo "No definition-shaped changes in this diff — the blast radius is the diff itself."
  BLAST_STATUS="nosymbols"
  exit 0
fi

EXCL=(--exclude-dir=.git --exclude-dir=node_modules --exclude-dir=vendor
      --exclude-dir=dist --exclude-dir=build --exclude-dir=target
      --exclude-dir=.venv --exclude-dir=venv --exclude-dir=__pycache__
      --exclude-dir=.next --exclude-dir=coverage --exclude-dir=.mypy_cache
      --exclude=*.diff --exclude=*.patch --exclude=*.lock --exclude=*.min.js)

i=0
: > "$TMP/index"; : > "$TMP/generic"; : > "$TMP/contained"
while read -r sym; do
  [ -n "$sym" ] || continue
  i=$((i + 1))
  # Prefix-strip and touched-file filter in ONE awk, with every path handed
  # over through the ENVIRONMENT rather than spliced into a program.
  #
  # This was `sed "s|^$REPO/||"`. A repo path holding a sed metacharacter — a
  # `[`, a `|`, a `\` — aborted the strip for EVERY symbol, so refs fell to 0
  # and the report affirmatively printed "Contained — no out-of-diff
  # references" for a symbol with a live stale caller. That is worse than no
  # map at all: containment presented as evidence. ENVIRON values are literal
  # text — no regex, no escape processing, nothing left to quote.
  grep -rnwIF "${EXCL[@]}" --binary-files=without-match -e "$sym" "$REPO" 2>/dev/null \
    | BR_PREFIX="$REPO/" BR_TOUCHED="$TMP/touched" awk '
        BEGIN { pre = ENVIRON["BR_PREFIX"]; plen = length(pre)
                tf  = ENVIRON["BR_TOUCHED"]
                while ((getline l < tf) > 0) t[l] = 1 }
        { if (substr($0, 1, plen) == pre) $0 = substr($0, plen + 1)
          c = index($0, ":"); if (c == 0) next
          if (substr($0, 1, c - 1) in t) next
          print }' \
    > "$TMP/h.$i"
  # Sibling repos: every hit is out-of-diff by construction, so no touched-file
  # filter — but label the repo so a site is never mistaken for a local path.
  # Same treatment: the sibling path AND its label were both spliced into one
  # sed expression, on the search and the replacement side respectively.
  for extra in ${ALSO+"${ALSO[@]}"}; do
    grep -rnwIF "${EXCL[@]}" --binary-files=without-match -e "$sym" "$extra" 2>/dev/null \
      | BR_PREFIX="$extra/" BR_LABEL="($(basename "$extra")) " awk '
          BEGIN { pre = ENVIRON["BR_PREFIX"]; plen = length(pre)
                  lab = ENVIRON["BR_LABEL"] }
          { if (substr($0, 1, plen) == pre) $0 = substr($0, plen + 1)
            print lab $0 }' >> "$TMP/h.$i"
  done
  refs=$(wc -l < "$TMP/h.$i" | tr -d ' ')
  if [ "$refs" -eq 0 ]; then
    printf '%s\n' "$sym" >> "$TMP/contained"
  elif [ "$refs" -gt "$GENERIC" ]; then
    printf '%s\t%s\n' "$sym" "$refs" >> "$TMP/generic"
  else
    files=$(cut -d: -f1 "$TMP/h.$i" | sort -u | wc -l | tr -d ' ')
    printf '%s\t%s\t%s\t%s\n' "$refs" "$files" "$i" "$sym" >> "$TMP/index"
  fi
done < "$TMP/symbols"

MAPPED=$(wc -l < "$TMP/index" | tr -d ' ')
BLAST_STATUS="mapped"
BLAST_MAPPED="$MAPPED"
BLAST_CONTAINED=$(wc -l < "$TMP/contained" | tr -d ' ')
BLAST_GENERIC=$(wc -l < "$TMP/generic" | tr -d ' ')
if [ "$MAPPED" -gt 0 ]; then
  echo "## Symbols with out-of-diff references"
  echo
  sort -rn -k1,1 "$TMP/index" | while IFS=$'\t' read -r refs files idx sym; do
    echo "### \`$sym\` — $refs reference(s) in $files file(s)"
    head -n "$MAX_REFS" "$TMP/h.$idx" | cut -d: -f1,2 | sed 's/^/- /'
    if [ "$refs" -gt "$MAX_REFS" ]; then
      echo "- (+$((refs - MAX_REFS)) more; raise --max-refs to list them)"
    fi
    echo
  done
fi

if [ -s "$TMP/generic" ]; then
  echo "## Too generic to map"
  echo
  echo "Above the generic threshold ($GENERIC hits) — listing every site would be"
  echo "noise. If the change to one of these is behavioural, grep it by hand."
  echo
  awk -F'\t' '{ printf "- `%s` — %s hits\n", $1, $2 }' "$TMP/generic"
  echo
fi

if [ -s "$TMP/contained" ]; then
  CN=$(wc -l < "$TMP/contained" | tr -d ' ')
  echo "## Contained — no out-of-diff references ($CN)"
  echo
  echo "These definitions are referenced only inside the changed files. That is"
  echo "evidence of containment, not proof: dynamic dispatch, reflection, string"
  echo "keys and cross-language callers are invisible to a textual match."
  echo
  awk '{ printf "%s`%s`", (NR > 1 ? ", " : "- "), $0 } END { print "" }' "$TMP/contained"
  echo
fi

echo "---"
echo
echo "Each site above is an out-of-diff caller. For every one, ask: does the"
echo "changed definition still satisfy this call? A site that no longer holds is"
echo "a P0 the diff alone cannot show. Absence of a site is weak evidence, never"
echo "proof — this map is textual, so it misses dynamic dispatch, reflection,"
echo "string-keyed lookup and cross-language callers."
exit 0
