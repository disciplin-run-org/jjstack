#!/usr/bin/env python3
"""jjstack-review-daemon - open a review session for every PR review request.

Polls GitHub as the reviewer account, ai-assistant-2026, every two minutes.
A review request, or an @-mention by an account with write access, on a PR in
a repo whose owner is on the allowlist gets its own Claude Code worker session,
in a new terminal window. A notification is only a hint: the daemon confirms
the request behind it, because GitHub also moves a thread on merges and
comments.
The daemon checks that the session runs on Opus, then sends it
`/review <owner>/<repo> pr <N>`. A re-request or a new mention on the same PR
goes to the same session, so the next round knows what the last one found.
When the PR is merged or closed, or has been idle for --idle-days, the daemon
sends that session `/save-and-exit`. It never kills a session.

Run it in the foreground from the reviewer directory. That directory's .env
points gh at the reviewer's credentials:

  cd ~/PycharmProjects/Code-Review
  jjstack-review-daemon                     poll until Ctrl-C
  jjstack-review-daemon --once --dry-run    show what one poll would do
  jjstack-review-daemon --status            list the PRs it is tracking

Options:
  --interval SECONDS    time between polls (default 120, never below GitHub's X-Poll-Interval)
  --max-sessions N      sessions open at once; later requests wait in a queue (default 4)
  --idle-days N         end a session after N days with no activity on its PR (default 7)
  --owners A,B          repo owners whose requests are accepted
                        (default JesperJurcenoks,disciplin-run-org)
  --reconcile-every N   also sweep pending review requests every N polls (default 15)
  --model M             model for new sessions (default opus[1m])
  --retry-model M       model for the one retry after a wrong model (default claude-opus-5[1m])
  --cwd DIR             the reviewer directory (default: the current directory)
  --hub-url URL         the tubemail hub (default http://localhost:8001)
  --once                poll once, then exit
  --dry-run             print what would happen and change nothing
  --status              print what the ledger tracks, then exit

State lives in <cwd>/.review-daemon/: ledger.json, history.jsonl, ignored.jsonl
and daemon.log. The console shows only what happened. A poll with nothing to do
writes one line to daemon.log and nothing to the console. A request from an
owner who is not on the allowlist goes to ignored.jsonl and nowhere else.

Exit codes: 0 stopped, 2 usage error, 3 wrong GitHub identity. The identity is
wrong when GH_TOKEN or GITHUB_TOKEN is set, when GH_CONFIG_DIR is unset, or
when gh is not logged in as ai-assistant-2026.

Never red: warnings are yellow, errors bright magenta, notes bright cyan.
The contract is references/review-daemon.md.
"""

from __future__ import annotations

import argparse
import asyncio
import json
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.request
import uuid as uuidlib
from dataclasses import dataclass
from datetime import datetime, timezone

REVIEWER = "ai-assistant-2026"
DEFAULT_OWNERS = ("JesperJurcenoks", "disciplin-run-org")
TRIGGER_REASONS = ("review_requested", "mention")
REASON_WORDS = {"review_requested": "review requested", "mention": "mentioned",
                "reconcile": "pending review request"}
# The hub refuses any other worker name; a '#' in it never registers.
WORKER_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9 _.-]{0,63}$")
ROLE_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
PR_URL_RE = re.compile(
    r"^https://(?:api\.github\.com/repos|github\.com)/([^/\s]+)/([^/\s]+)/pulls?/(\d+)$")
EXIT_IDENTITY = 3
DAY = 86400.0
# Anyone may @-mention an account on a public repo; only a writer may request
# its review. A mention counts only from an author GitHub says can write.
WRITE_PERMISSIONS = ("admin", "write")
# A mention is what GitHub itself renders as one: a user-mention link in the
# body_html it returns under HTML_ACCEPT. GitHub's rendering gets code, quotes
# and CRLF right by definition, where a hand-written markdown reader did not,
# and a scan that never crosses a '<' is linear, so a stranger's comment
# cannot stall the daemon.
HTML_ACCEPT = "Accept: application/vnd.github.html+json"
_USER_MENTION_RE = re.compile(r'<a\s[^<>]*?\bclass="[^"<>]*\buser-mention\b[^"<>]*"[^<>]*>', re.IGNORECASE)
_HREF_RE = re.compile(r'\bhref="https://github\.com/([^"/?#<>]+)"', re.IGNORECASE)

# ── palette: no red. Ever. ────────────────────────────────────────────────
RESET = "\033[0m"
YELLOW = "\033[93m"
MAGENTA = "\033[95m"
CYAN = "\033[96m"
LEVEL_COLOR = {"info": "", "note": CYAN, "warn": YELLOW, "error": MAGENTA}
_FORBIDDEN_SGR = {"31", "91", "41", "101"}
_SGR_RE = re.compile(r"\033\[([0-9;]*)m")


def scrub_red(text):
    """Strip red SGR parameters, so no path can print red on a black terminal."""
    def _fix(m):
        params = [p for p in m.group(1).split(";") if p not in _FORBIDDEN_SGR]
        return "\033[" + ";".join(params) + "m" if params else ""
    return _SGR_RE.sub(_fix, text)


def render(level, text, color):
    if not color:
        return _SGR_RE.sub("", text)
    code = LEVEL_COLOR.get(level, "")
    text = scrub_red(text)
    return code + text + RESET if code else text


def _color_on():
    if os.environ.get("NO_COLOR") is not None:
        return False
    return sys.stdout.isatty()


# ── small pure helpers ────────────────────────────────────────────────────

class GHError(Exception):
    pass


class HubError(Exception):
    pass


class IdentityError(Exception):
    pass


class LedgerError(Exception):
    pass


def parse_iso(s):
    return datetime.fromisoformat(s.replace("Z", "+00:00")).timestamp()


def iso(t):
    return datetime.fromtimestamp(t, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def parse_env_file(path):
    """KEY=value lines; the same grammar claude-tm reads, so both agree on .env."""
    out = {}
    try:
        text = open(path, encoding="utf-8").read()
    except OSError:
        return out
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, val = line.partition("=")
        key, val = key.strip(), val.strip()
        if len(val) >= 2 and val[0] == val[-1] and val[0] in "\"'":
            val = val[1:-1]
        if key:
            out[key] = val
    return out


def load_env(cwd, environ, home):
    """The real environment wins; then <cwd>/.env; then the tubemail .env."""
    env = dict(environ)
    for path in (os.path.join(cwd, ".env"), os.path.join(home, ".config", "tubemail", ".env")):
        for k, v in parse_env_file(path).items():
            env.setdefault(k, v)
    return env


def parse_gh_include(text):
    """Split `gh api -i` output into (status, headers, body).

    gh 2.4.0 exits 1 on a 304 but still prints the headers, so the status
    line is the answer and the exit code is not.
    """
    head, _, body = text.replace("\r\n", "\n").partition("\n\n")
    lines = head.split("\n")
    m = re.match(r"HTTP/\S+\s+(\d{3})", lines[0].strip()) if lines else None
    if not m:
        raise GHError("gh -i printed no HTTP status line")
    headers = {}
    for ln in lines[1:]:
        k, sep, v = ln.partition(":")
        if sep:
            headers[k.strip().lower()] = v.strip()
    return int(m.group(1)), headers, body


def parse_pr_url(url):
    m = PR_URL_RE.match(url or "")
    return (m.group(1), m.group(2), int(m.group(3))) if m else None


def is_allowlisted(owner, owners):
    return (owner or "").lower() in {o.lower() for o in owners}


def role_name(repo, number):
    role = "%s-pr%d" % (repo, int(number))
    if not ROLE_RE.match(role):
        raise ValueError("repo name %r cannot be part of a worker name" % repo)
    return role


def worker_name(base, repo, number):
    name = "%s-%s-tm" % (base, role_name(repo, number))
    if "#" in name or not WORKER_RE.match(name):
        raise ValueError("worker name %r is not one the hub accepts (64 chars, no '#')" % name)
    return name


def record_key(owner, repo, number):
    return ("%s/%s#%d" % (owner, repo, int(number))).lower()


def _pr_name(item):
    return "%s/%s#%d" % (item["owner"], item["repo"], item["number"])


label_of = _pr_name


def dispatch_text(owner, repo, number):
    return "/review %s/%s pr %d" % (owner, repo, number)


def handshake_text(owner, repo, number):
    return ("review-daemon handshake: jjstack-review-daemon opened this session to review "
            "%s/%s PR %d. Reply with the single word READY and nothing else. "
            "The review command follows in its own message." % (owner, repo, number))


def select_triggers(threads, owners):
    """Unread PR threads whose reason is a review request or a mention.

    Returns (triggers, ignored): ignored are the same shape from owners off
    the allowlist. Any other reason, an Issue, or a read thread is dropped.
    """
    triggers, ignored = [], []
    for t in threads:
        if t.get("unread") is False:
            continue
        subject = t.get("subject") or {}
        if subject.get("type") != "PullRequest" or t.get("reason") not in TRIGGER_REASONS:
            continue
        parsed = parse_pr_url(subject.get("url"))
        if not parsed:
            continue
        owner, repo, number = parsed
        item = {"owner": owner, "repo": repo, "number": number,
                "thread_id": str(t.get("id")), "reason": t["reason"],
                "updated_at": t.get("updated_at"), "last_read_at": t.get("last_read_at")}
        (triggers if is_allowlisted(owner, owners) else ignored).append(item)
    return triggers, ignored


def parse_search(payload, owners):
    """search/issues items as triggers with reason `reconcile` and no thread."""
    triggers, ignored = [], []
    for it in payload.get("items") or []:
        parsed = parse_pr_url((it.get("pull_request") or {}).get("url")) or \
            parse_pr_url(it.get("html_url"))
        if not parsed:
            continue
        owner, repo, number = parsed
        item = {"owner": owner, "repo": repo, "number": number, "thread_id": None,
                "reason": "reconcile", "updated_at": None}
        (triggers if is_allowlisted(owner, owners) else ignored).append(item)
    return triggers, ignored


def transcript_path(home, cwd, session_uuid):
    return os.path.join(home, ".claude", "projects", re.sub(r"[^A-Za-z0-9]", "-", cwd),
                        "%s.jsonl" % session_uuid)


def latest_model(path, since=None):
    """The model of the newest main-chain assistant line, or None.

    Sidechain lines are subagents on their own models. `<synthetic>` lines are
    Claude Code placeholders, not a model. With `since`, only lines stamped at
    or after it count: the answer to the handshake, not an older turn.
    """
    try:
        fh = open(path, encoding="utf-8")
    except OSError:
        return None
    found = None
    with fh:
        for raw in fh:
            if '"assistant"' not in raw:
                continue
            try:
                rec = json.loads(raw)
            except ValueError:
                continue
            if rec.get("type") != "assistant" or rec.get("isSidechain"):
                continue
            model = (rec.get("message") or {}).get("model")
            if not model or model.startswith("<"):
                continue
            if since is not None:
                ts = rec.get("timestamp")
                if not ts or parse_iso(ts) < since:
                    continue
            found = model
    return found


def is_opus(model):
    return bool(model) and model.startswith("claude-opus")


def mentions_reviewer(html):
    """True when GitHub's rendered body_html links a user-mention to the reviewer.
    Raw markdown is never read: a handle in code renders as code, not a link."""
    if not html:
        return False
    for tag in _USER_MENTION_RE.finditer(html):
        href = _HREF_RE.search(tag.group(0))
        if href and href.group(1).lower() == REVIEWER:
            return True
    return False


def parse_json_stream(text):
    """Every value in `text`, flattened into one list.

    gh 2.4.0 `--paginate` prints one JSON array per page, back to back, with
    nothing between them, so json.loads on the whole output fails.
    """
    dec = json.JSONDecoder()
    out, i, n = [], 0, len(text)
    while True:
        while i < n and text[i].isspace():
            i += 1
        if i >= n:
            return out
        value, i = dec.raw_decode(text, i)
        if isinstance(value, list):
            out.extend(value)
        else:
            out.append(value)


def find_session_for_worker(home, cwd, worker):
    """Session id of the newest transcript whose agent-name line is `worker`."""
    proj = os.path.dirname(transcript_path(home, cwd, "x"))
    try:
        names = [n for n in os.listdir(proj) if n.endswith(".jsonl")]
    except OSError:
        return None
    names.sort(key=lambda n: os.path.getmtime(os.path.join(proj, n)), reverse=True)
    for n in names:
        try:
            with open(os.path.join(proj, n), encoding="utf-8") as fh:
                for _, raw in zip(range(20), fh):
                    try:
                        rec = json.loads(raw)
                    except ValueError:
                        continue
                    if rec.get("type") == "agent-name" and rec.get("agentName") == worker:
                        return n[: -len(".jsonl")]
        except OSError:
            continue
    return None


def spawn_argv(cfg, worker, role, model, session_uuid, resume):
    # "$0" "$@" runs claude-tm with its arguments verbatim; `exec bash` keeps
    # the window open after the session exits, as the desktop launcher does.
    return [cfg.terminal, "--window", "--title=%s" % worker,
            "--working-directory=%s" % cfg.cwd, "--",
            "bash", "-c", '"$0" "$@"; exec bash',
            cfg.claude_tm, "--role=%s" % role, "--model", model,
            "--resume" if resume else "--session-id", session_uuid]


def check_identity(env, gh):
    """Refuse to run as anyone but the reviewer. A token in the environment
    overrides GH_CONFIG_DIR, so it is refused before gh is asked anything."""
    for k in ("GH_TOKEN", "GITHUB_TOKEN"):
        if env.get(k):
            raise IdentityError(
                "%s is set. It overrides GH_CONFIG_DIR, so reviews would post as whoever "
                "owns that token. Unset it and start again." % k)
    if not env.get("GH_CONFIG_DIR"):
        raise IdentityError(
            "GH_CONFIG_DIR is not set. Run from the reviewer directory, whose .env "
            "points gh at the reviewer's credentials.")
    try:
        login = gh.login()
    except GHError as e:
        raise IdentityError("gh could not read the logged-in user: %s" % e)
    if login.lower() != REVIEWER:
        raise IdentityError("gh is logged in as %r, not %s." % (login, REVIEWER))


# ── adapters: the only code that touches the outside ─────────────────────

class GH:
    def __init__(self, env):
        self.env = env

    def _run(self, argv):
        try:
            return subprocess.run(argv, capture_output=True, text=True, env=self.env, timeout=60)
        except (OSError, subprocess.TimeoutExpired) as e:
            raise GHError(str(e))

    def login(self):
        p = self._run(["gh", "api", "user", "--jq", ".login"])
        if p.returncode != 0:
            raise GHError(p.stderr.strip() or "gh exited %d" % p.returncode)
        return p.stdout.strip()

    def api(self, path, method="GET", fields=(), headers=(), include=False, paginate=False):
        argv = ["gh", "api"]
        if include:
            argv.append("-i")
        if paginate:
            argv.append("--paginate")  # read the output with parse_json_stream
        if method != "GET" or fields:
            argv += ["-X", method]  # gh 2.4.0 turns -f into a POST unless told GET
        for h in headers:
            argv += ["-H", h]
        for f in fields:
            argv += ["-f", f]
        argv.append(path)
        p = self._run(argv)
        if include:
            try:
                return parse_gh_include(p.stdout)
            except GHError:
                raise GHError(p.stderr.strip() or "gh -i printed no status line")
        if p.returncode != 0:
            raise GHError(p.stderr.strip() or "gh exited %d" % p.returncode)
        return 200, {}, p.stdout


class Hub:
    """The tubemail hub roster, over its REST route."""

    def __init__(self, url, secret):
        self.url = url.rstrip("/") + "/api/workers"
        self.secret = secret

    def workers(self):
        req = urllib.request.Request(self.url, headers={"Authorization": "Bearer " + self.secret})
        try:
            with urllib.request.urlopen(req, timeout=10) as r:
                data = json.load(r)
        except (urllib.error.URLError, OSError, ValueError) as e:
            raise HubError(str(e))
        return {row["name"]: row for row in data.get("workers", []) if "name" in row}


class HubMCP:
    """tm_send over the hub's MCP endpoint. fastmcp is imported only here,
    so the tests and CI never need it."""

    def __init__(self, url):
        self.url = url.rstrip("/") + "/mcp/"

    def send(self, worker, text):
        try:
            from fastmcp import Client
        except ImportError as e:
            raise HubError("fastmcp is not installed: %s" % e)

        async def go():
            async with Client(self.url) as c:
                r = await c.call_tool("tm_send", {"worker": worker, "message": text})
                return getattr(r, "structured_content", None) or {}
        try:
            return asyncio.run(go())
        except Exception as e:  # any transport failure is a hub failure here
            raise HubError("tm_send to %s failed: %s" % (worker, e))


class Spawner:
    def __init__(self, cwd, pid_dir="/tmp"):
        self.cwd = cwd
        self.pid_dir = pid_dir

    def spawn(self, argv):
        subprocess.Popen(argv, cwd=self.cwd, stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)

    def pid_alive(self, worker):
        path = os.path.join(self.pid_dir, "claude-tm-%s.pid" % worker)
        try:
            pid = int(open(path).read().strip())
        except (OSError, ValueError):
            return False
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            return False
        except PermissionError:
            return True
        return True


class Clock:
    def now(self):
        return time.time()


class Ledger:
    """Everything the daemon must remember across restarts, in one JSON file."""

    SEEN_CAP = 2000

    def __init__(self, state_dir):
        self.dir = state_dir
        self.path = os.path.join(state_dir, "ledger.json")
        self._ignored = None
        try:
            with open(self.path, encoding="utf-8") as fh:
                data = json.load(fh)
        except FileNotFoundError:
            data = {}
        except ValueError as e:
            raise LedgerError("%s is not valid JSON (%s); refusing to forget the sessions "
                              "it tracks. Fix or move it." % (self.path, e))
        self.records = data.get("records", {})
        self.seen_threads = data.get("seen_threads", {})
        self.last_modified = data.get("last_modified")

    def save(self):
        seen = list(self.seen_threads.items())[-self.SEEN_CAP:]
        text = json.dumps({"version": 1, "records": self.records,
                           "seen_threads": dict(seen), "last_modified": self.last_modified},
                          indent=1, sort_keys=True)
        os.makedirs(self.dir, exist_ok=True)
        tmp = self.path + ".tmp"
        with open(tmp, "w", encoding="utf-8") as fh:
            fh.write(text)
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmp, self.path)

    def _append(self, name, obj):
        os.makedirs(self.dir, exist_ok=True)
        with open(os.path.join(self.dir, name), "a", encoding="utf-8") as fh:
            fh.write(json.dumps(obj, sort_keys=True) + "\n")

    def append_history(self, rec):
        self._append("history.jsonl", rec)

    def append_ignored(self, entry):
        """Append once per (thread, update); True when it was new."""
        if self._ignored is None:
            self._ignored = set()
            try:
                for raw in open(os.path.join(self.dir, "ignored.jsonl"), encoding="utf-8"):
                    try:
                        e = json.loads(raw)
                    except ValueError:
                        continue
                    self._ignored.add((e.get("thread_id"), e.get("updated_at")))
            except OSError:
                pass
        key = (entry.get("thread_id"), entry.get("updated_at"))
        if key in self._ignored:
            return False
        self._ignored.add(key)
        self._append("ignored.jsonl", entry)
        return True

    def log_line(self, text):
        os.makedirs(self.dir, exist_ok=True)
        with open(os.path.join(self.dir, "daemon.log"), "a", encoding="utf-8") as fh:
            fh.write(text + "\n")


# ── the daemon ────────────────────────────────────────────────────────────

@dataclass
class Config:
    owners: tuple = DEFAULT_OWNERS
    cwd: str = "."
    home: str = os.path.expanduser("~")
    claude_tm: str = "claude-tm"
    terminal: str = "gnome-terminal"
    model: str = "opus[1m]"
    retry_model: str = "claude-opus-5[1m]"
    max_sessions: int = 4
    idle_days: float = 7
    reconcile_every: int = 15
    interval: int = 120
    dry_run: bool = False
    spawn_timeout: float = 300
    exit_resend_after: float = 900
    note_every: float = 3600
    long_review_after: float = 3600
    max_spawn_attempts: int = 3


class Daemon:
    """One poll = read GitHub, read the hub roster, then move each PR record
    one step: queued -> active -> ending -> gone (into history.jsonl)."""

    def __init__(self, cfg, gh, hub, mcp, spawner, ledger, clock, out):
        self.cfg, self.gh, self.hub, self.mcp = cfg, gh, hub, mcp
        self.spawner, self.ledger, self.clock, self.out = spawner, ledger, clock, out
        self.base = os.path.basename(os.path.abspath(cfg.cwd))
        self.poll_count = 0
        self.poll_interval = 0
        self.hub_down = False
        self.warned = set()
        self.actions = 0
        self._perm_cache = {}

    # console ------------------------------------------------------------
    def say(self, level, text):
        self.actions += 1
        self.out(level, ("[dry-run] " if self.cfg.dry_run else "") + text)

    def warn_once(self, key, text):
        if key not in self.warned:
            self.warned.add(key)
            self.say("warn", text)

    def note_every(self, rec, key, now, level, text):
        notes = rec.setdefault("notes", {})
        last = notes.get(key)
        if last is None or now - last >= self.cfg.note_every:
            notes[key] = now
            self.say(level, text)

    def note_once(self, rec, key, level, text):
        notes = rec.setdefault("notes", {})
        if key not in notes:
            notes[key] = True
            self.say(level, text)

    # the poll -----------------------------------------------------------
    def poll_once(self):
        self.poll_count += 1
        self.actions = 0
        self._perm_cache = {}  # a permission is only trusted for the poll that read it
        now = self.clock.now()
        notif = self._ingest_notifications(now)
        if self.poll_count == 1 or self.poll_count % self.cfg.reconcile_every == 0:
            self._reconcile(now)
        self._check_prs(now)
        roster = self._roster()
        if roster is not None:
            self._transitions(now, roster)
        if not self.cfg.dry_run:
            self.ledger.save()
            counts = {}
            for r in self.ledger.records.values():
                counts[r["status"]] = counts.get(r["status"], 0) + 1
            self.ledger.log_line("%s poll=%d notifications=%s hub=%s %s actions=%d" % (
                iso(now), self.poll_count, notif, "down" if roster is None else "up",
                " ".join("%s=%d" % kv for kv in sorted(counts.items())) or "records=0",
                self.actions))

    # GitHub -------------------------------------------------------------
    def _ingest_notifications(self, now):
        headers = []
        if self.ledger.last_modified:
            headers.append("If-Modified-Since: " + self.ledger.last_modified)
        try:
            status, hdrs, body = self.gh.api("notifications?per_page=100", headers=headers,
                                             include=True)
        except GHError as e:
            self.warn_once("gh-notifications", "could not read GitHub notifications: %s" % e)
            return "error"
        self.warned.discard("gh-notifications")
        try:
            self.poll_interval = int(hdrs.get("x-poll-interval", "0"))
        except ValueError:
            pass
        if status == 304:
            return "304"
        if status != 200:
            self.warn_once("gh-status", "GitHub notifications answered HTTP %d" % status)
            return str(status)
        try:
            threads = json.loads(body)
        except ValueError:
            self.warn_once("gh-json", "GitHub notifications were not JSON")
            return "bad-json"
        if hdrs.get("last-modified"):
            self.ledger.last_modified = hdrs["last-modified"]
        triggers, ignored = select_triggers(threads, self.cfg.owners)
        for t in triggers:
            if self.ledger.seen_threads.get(t["thread_id"]) == t["updated_at"]:
                continue
            try:
                self._handle_trigger(t, now)
            except (GHError, ValueError) as e:
                self.warn_once("act:%s:%s" % (t["thread_id"], t["updated_at"]),
                               "%s/%s#%d: could not act on the request: %s" % (
                                   t["owner"], t["repo"], t["number"], e))
                self.ledger.last_modified = None  # re-list next poll; the thread stays unread
                continue
            if not self.cfg.dry_run:
                try:
                    self.gh.api("notifications/threads/%s" % t["thread_id"], method="PATCH")
                except GHError as e:
                    self.say("warn", "could not mark notification %s read: %s" % (t["thread_id"], e))
            self.ledger.seen_threads[t["thread_id"]] = t["updated_at"]
        if not self.cfg.dry_run:
            for i in ignored:
                self.ledger.append_ignored(dict(i, pr=_pr_name(i), seen_at=iso(now)))
        return "200"

    def _reconcile(self, now):
        q = "is:pr is:open review-requested:%s" % REVIEWER
        try:
            _, _, body = self.gh.api("search/issues", fields=("q=" + q, "per_page=100"))
            payload = json.loads(body)
        except (GHError, ValueError) as e:
            self.warn_once("gh-search", "could not sweep pending review requests: %s" % e)
            return
        self.warned.discard("gh-search")
        triggers, ignored = parse_search(payload, self.cfg.owners)
        for t in triggers:
            try:
                self._handle_trigger(t, now)
            except (GHError, ValueError) as e:
                self.say("warn", "%s/%s#%d: could not act on the pending request: %s" % (
                    t["owner"], t["repo"], t["number"], e))
        if not self.cfg.dry_run:
            for i in ignored:
                self.ledger.append_ignored(dict(i, pr=_pr_name(i), thread_id="search:" + _pr_name(i),
                                                seen_at=iso(now)))

    def _pull(self, owner, repo, number):
        # HTML_ACCEPT adds body_html, the description as GitHub renders it,
        # which is the only form a mention is read from.
        _, _, body = self.gh.api("repos/%s/%s/pulls/%d" % (owner, repo, number), headers=(HTML_ACCEPT,))
        return json.loads(body)

    def _handle_trigger(self, t, now):
        key = record_key(t["owner"], t["repo"], t["number"])
        label = "%s/%s#%d" % (t["owner"], t["repo"], t["number"])
        why = REASON_WORDS.get(t["reason"], t["reason"])
        rec = self.ledger.records.get(key)
        if rec is not None:
            if t["reason"] == "reconcile":
                return  # the notification feed already brought this one in
            ok, note, strangers = self._confirm(t, rec, None)
            if not ok:
                self._not_a_request(t, label, why, note, strangers, now)
                return
            if rec["status"] == "ending":
                self.say("info", "%s: %s, ignored: the session is closing (%s)" % (
                    label, why, rec.get("end_reason")))
                return
            rec["pending_dispatch"] = True
            rec["last_request_at"] = now
            if t["thread_id"] and t["thread_id"] not in rec["threads"]:
                rec["threads"].append(t["thread_id"])
            self.say("info", "%s: %s again; next round goes to %s" % (label, why, rec["worker"]))
            return
        pr = self._pull(t["owner"], t["repo"], t["number"])
        if pr.get("state") != "open":
            self.say("info", "%s: %s, skipped: the PR is already %s" % (
                label, why, "merged" if pr.get("merged") else "closed"))
            return
        ok, note, strangers = self._confirm(t, None, pr)
        if not ok:
            self._not_a_request(t, label, why, note, strangers, now)
            return
        worker = worker_name(self.base, t["repo"], t["number"])
        self.ledger.records[key] = {
            "owner": t["owner"], "repo": t["repo"], "number": t["number"],
            "worker": worker, "role": role_name(t["repo"], t["number"]),
            "status": "queued", "pending_dispatch": True,
            "requested_at": now, "last_request_at": now,
            "threads": [t["thread_id"]] if t["thread_id"] else [],
            "session_uuid": None, "spawned_at": None, "spawn_attempts": 0,
            "model_flag": self.cfg.model, "model": None, "handshake_at": None,
            "last_dispatch_at": None, "last_review_id": None, "last_review_at": None,
            "head_sha": (pr.get("head") or {}).get("sha"),
            "pr_updated_at": parse_iso(pr["updated_at"]) if pr.get("updated_at") else None,
            "end_reason": None, "exit_sent_at": None, "exit_sends": 0,
            "model_retried": False, "respawn": None, "blocked": None, "notes": {},
        }
        self.say("info", "%s: %s; queued as %s" % (label, why, worker))

    # is this thread update a request? -------------------------------------
    def _get_list(self, path, headers=()):
        _, _, body = self.gh.api(path, headers=headers, paginate=True)
        return parse_json_stream(body)

    def _permission(self, owner, repo, login):
        """GitHub's permission for `login` on the repo. A failed lookup is
        returned as 'unknown', never cached, and never counts as write."""
        if login.lower() == owner.lower():
            return "admin"
        key = (owner.lower(), repo.lower(), login.lower())
        if key not in self._perm_cache:
            try:
                _, _, body = self.gh.api("repos/%s/%s/collaborators/%s/permission" % (owner, repo, login))
                self._perm_cache[key] = json.loads(body).get("permission") or "none"
            except (GHError, ValueError) as e:
                if "HTTP 404" in str(e):
                    # Not an account GitHub knows (a bot name, a deleted user):
                    # a permanent answer, so it is refused, not retried forever.
                    self._perm_cache[key] = "none"
                    return "none"
                return "unknown: %s" % e
        return self._perm_cache[key]

    def _mentions_since(self, owner, repo, number, floor, pr):
        """(time, author) of each mention of the reviewer written after `floor`,
        in a comment, a review comment, a review, or the PR description."""
        base = "repos/%s/%s" % (owner, repo)
        query = "per_page=100" + ("&since=%s" % iso(floor) if floor else "")
        found = []
        for path, stamp in (("%s/issues/%d/comments?%s" % (base, number, query), "created_at"),
                            ("%s/pulls/%d/comments?%s" % (base, number, query), "created_at"),
                            ("%s/pulls/%d/reviews?per_page=100" % (base, number), "submitted_at")):
            for item in self._get_list(path, headers=(HTML_ACCEPT,)):
                if "body_html" not in item and item.get("body"):
                    self.warn_once("no-body-html", "GitHub sent no body_html, so no mention can be "
                                   "read and none counts; is the %s header still honoured?" % HTML_ACCEPT)
                if item.get(stamp) and mentions_reviewer(item.get("body_html")):
                    found.append((parse_iso(item[stamp]), (item.get("user") or {}).get("login") or ""))
        if pr.get("created_at") and mentions_reviewer(pr.get("body_html")):
            found.append((parse_iso(pr["created_at"]), (pr.get("user") or {}).get("login") or ""))
        return [(at, who) for at, who in found if at > floor and who and who.lower() != REVIEWER]

    def _confirm(self, t, rec, pr):
        """Is there a real request behind this thread update? GitHub moves a
        thread on a merge or a comment too, with the reason unchanged.

        Returns (ok, note, strangers): strangers are (login, permission) pairs
        whose mention was refused for want of write access.
        """
        owner, repo, number = t["owner"], t["repo"], t["number"]
        last_round = (rec or {}).get("last_dispatch_at") or 0
        if t["reason"] == "reconcile":
            return True, "", []  # the search lists only requests still pending
        if t["reason"] == "review_requested":
            if rec is None:
                wanted = {((u or {}).get("login") or "").lower() for u in pr.get("requested_reviewers") or []}
                if REVIEWER in wanted:
                    return True, "", []
                return False, "%s is no longer a requested reviewer" % REVIEWER, []
            if not last_round:
                return True, "", []  # nothing sent yet; the round is still owed
            asked = [parse_iso(e["created_at"]) for e in self._get_list(
                "repos/%s/%s/issues/%d/events?per_page=100" % (owner, repo, number))
                if e.get("event") == "review_requested" and e.get("created_at")
                and ((e.get("requested_reviewer") or {}).get("login") or "").lower() == REVIEWER]
            if asked and max(asked) > last_round:
                return True, "", []
            return False, "no review request newer than the last round", []
        floor = max(last_round, parse_iso(t["last_read_at"]) if t.get("last_read_at") else 0)
        if pr is None:
            pr = self._pull(owner, repo, number)
        found = self._mentions_since(owner, repo, number, floor, pr)
        if not found:
            return False, "no mention of @%s since the last round" % REVIEWER, []
        strangers, undecided = [], []
        for login in sorted({who for _, who in found}):
            perm = self._permission(owner, repo, login)
            if perm in WRITE_PERMISSIONS:
                return True, "", []
            if perm.startswith("unknown"):
                undecided.append(login)
            else:
                strangers.append((login, perm))
        if undecided:
            # Closed now, decided later: raising leaves the thread unread, so
            # the next poll asks again and a 502 does not cost a writer the round.
            raise GHError("could not read the permission of %s; asking again next poll"
                          % ", ".join(undecided))
        return False, "mentioned only by %s, without write access" % ", ".join(
            "%s (%s)" % s for s in strangers), strangers

    def _not_a_request(self, t, label, why, note, strangers, now):
        text = "%s: %s, not acted on: %s" % (label, why, note)
        if self.cfg.dry_run:
            self.say("note", text)
            return
        self.ledger.log_line("%s %s" % (iso(now), text))
        for login, perm in strangers:
            self.ledger.append_ignored({
                "owner": t["owner"], "repo": t["repo"], "number": t["number"], "pr": _pr_name(t),
                "reason": t["reason"], "by": login, "permission": perm,
                "thread_id": "%s:%s" % (t["thread_id"], login), "updated_at": t["updated_at"],
                "seen_at": iso(now)})

    def _check_prs(self, now):
        for key, rec in list(self.ledger.records.items()):
            label = label_of(rec)
            try:
                pr = self._pull(rec["owner"], rec["repo"], rec["number"])
            except (GHError, ValueError) as e:
                self.warn_once("pr:" + key, "%s: could not read the PR: %s" % (label, e))
                continue
            self.warned.discard("pr:" + key)
            closed_as = "merged" if pr.get("merged") else ("closed" if pr.get("state") == "closed" else None)
            if rec["status"] == "queued":
                if closed_as:
                    del self.ledger.records[key]
                    rec.update(status="ended", end_reason=closed_as, ended_at=now)
                    if not self.cfg.dry_run:
                        self.ledger.append_history(rec)
                    self.say("info", "%s: %s before a session opened; dropped from the queue" % (
                        label, closed_as))
                continue
            if pr.get("updated_at"):
                rec["pr_updated_at"] = parse_iso(pr["updated_at"])
            sha = (pr.get("head") or {}).get("sha")
            if sha and rec.get("head_sha") and sha != rec["head_sha"]:
                self.say("note", "%s: new commits (head %s); a re-request starts the next round" % (
                    label, sha[:7]))
            if sha:
                rec["head_sha"] = sha
            if rec["status"] == "active" and closed_as:
                self._begin_end(rec, closed_as)
            self._observe_reviews(rec, key, label)
            if rec["status"] == "active" and not rec["pending_dispatch"]:
                marks = [x for x in (rec.get("last_request_at"), rec.get("last_dispatch_at"),
                                     rec.get("last_review_at"), rec.get("pr_updated_at")) if x]
                if marks and now - max(marks) > self.cfg.idle_days * DAY:
                    self._begin_end(rec, "idle")

    def _observe_reviews(self, rec, key, label):
        if not rec.get("last_dispatch_at"):
            return
        try:
            _, _, body = self.gh.api("repos/%s/%s/pulls/%d/reviews?per_page=100" % (
                rec["owner"], rec["repo"], rec["number"]))
            reviews = json.loads(body)
        except (GHError, ValueError) as e:
            self.warn_once("reviews:" + key, "%s: could not read its reviews: %s" % (label, e))
            return
        mine = [r for r in reviews if ((r.get("user") or {}).get("login") or "").lower() == REVIEWER
                and r.get("submitted_at")]
        if not mine:
            return
        newest = max(mine, key=lambda r: parse_iso(r["submitted_at"]))
        at = parse_iso(newest["submitted_at"])
        if newest.get("id") != rec.get("last_review_id") and at >= rec["last_dispatch_at"]:
            rec["last_review_id"] = newest.get("id")
            rec["last_review_at"] = at
            self.say("info", "%s: review posted: %s" % (label, newest.get("state")))

    def _begin_end(self, rec, reason):
        rec.update(status="ending", end_reason=reason, pending_dispatch=False)
        self.say("info", "%s: %s; %s gets /save-and-exit when it is idle" % (
            label_of(rec), {"idle": "idle for %g days" % self.cfg.idle_days}.get(reason, reason),
            rec["worker"]))

    # hub ----------------------------------------------------------------
    def _roster(self):
        try:
            roster = self.hub.workers()
        except HubError as e:
            if not self.hub_down:
                self.hub_down = True
                self.say("warn", "tubemail hub unreachable (%s); no session changes until it is back" % e)
            return None
        if self.hub_down:
            self.hub_down = False
            self.say("info", "tubemail hub is back")
        return roster

    def _send(self, rec, text):
        if self.cfg.dry_run:
            return True
        try:
            self.mcp.send(rec["worker"], text)
            return True
        except HubError as e:
            self.say("warn", "%s: could not message %s: %s" % (label_of(rec), rec["worker"], e))
            return False

    # transitions --------------------------------------------------------
    def _booting(self, rec, now):
        return bool(rec.get("spawned_at")) and now - rec["spawned_at"] < self.cfg.spawn_timeout

    def _live(self, rec, now, roster):
        if rec["status"] == "ending":
            return True
        if rec["status"] != "active":
            return False
        row = roster.get(rec["worker"])
        if row and row.get("online"):
            return True
        return self._booting(rec, now) or self.spawner.pid_alive(rec["worker"])

    def _live_count(self, now, roster):
        return sum(1 for r in self.ledger.records.values() if self._live(r, now, roster))

    def _transitions(self, now, roster):
        for rec in [r for r in self.ledger.records.values() if r["status"] == "ending"]:
            self._step_ending(rec, now, roster)
        for rec in [r for r in self.ledger.records.values() if r["status"] == "active"]:
            self._step_active(rec, now, roster)
        queued = sorted((r for r in self.ledger.records.values() if r["status"] == "queued"),
                        key=lambda r: r["requested_at"])
        for rec in queued:
            if self._live_count(now, roster) >= self.cfg.max_sessions:
                break
            self._start(rec, now, roster)

    def _start(self, rec, now, roster):
        row = roster.get(rec["worker"])
        rec["status"] = "active"
        if row and row.get("online"):
            sid = find_session_for_worker(self.cfg.home, self.cfg.cwd, rec["worker"])
            rec.update(session_uuid=sid, adopted=True, spawned_at=now)
            self.say("warn", "%s: %s is already running, started by hand; using it%s" % (
                label_of(rec), rec["worker"],
                "" if sid else ", but its transcript was not found, so its model cannot be checked"))
            return
        self._spawn(rec, now, fresh=True)

    def _spawn(self, rec, now, fresh):
        resume = False
        if fresh or not rec.get("session_uuid"):
            rec["session_uuid"] = str(uuidlib.uuid4())
        else:
            resume = os.path.exists(transcript_path(self.cfg.home, self.cfg.cwd, rec["session_uuid"]))
        argv = spawn_argv(self.cfg, rec["worker"], rec["role"], rec["model_flag"],
                          rec["session_uuid"], resume)
        rec.update(spawned_at=now, spawn_attempts=rec.get("spawn_attempts", 0) + 1,
                   handshake_at=None, model=None)
        rec.get("notes", {}).pop("dormant", None)
        if not self.cfg.dry_run:
            try:
                self.spawner.spawn(argv)
            except OSError as e:
                self.say("error", "%s: could not open a terminal for %s: %s" % (
                    label_of(rec), rec["worker"], e))
                return
        self.say("info", "%s: %s %s (%s, session %s)" % (
            label_of(rec), "resumed" if resume else "opened", rec["worker"],
            rec["model_flag"], rec["session_uuid"]))

    def _step_active(self, rec, now, roster):
        row = roster.get(rec["worker"])
        if not (row and row.get("online")):
            self._offline(rec, row, now, roster)
            return
        label, worker = label_of(rec), rec["worker"]
        state = row.get("state")
        if rec.get("blocked") or rec.get("respawn"):
            return  # needs a human, or waiting for its own /exit to land
        if state == "busy":
            d = rec.get("last_dispatch_at")
            if d and now - d > self.cfg.long_review_after:
                self.note_every(rec, "busy", now, "note",
                                "%s: review still running (%d min); not interrupting" % (
                                    label, int((now - d) / 60)))
            return
        if state == "waiting_permission":
            self.note_every(rec, "permission", now, "warn",
                            "%s: %s is waiting on a permission prompt" % (label, worker))
            return
        if state != "idle" or not rec["pending_dispatch"]:
            return
        if rec.get("handshake_at") is None:
            if self._send(rec, handshake_text(rec["owner"], rec["repo"], rec["number"])):
                rec["handshake_at"] = now
            return
        model = None
        if rec.get("session_uuid"):
            model = latest_model(transcript_path(self.cfg.home, self.cfg.cwd, rec["session_uuid"]),
                                 since=rec["handshake_at"])
        if model is None:
            if now - rec["handshake_at"] > self.cfg.spawn_timeout:
                self.note_every(rec, "no-model", now, "warn",
                                "%s: %s has not answered the handshake, so its model is unknown "
                                "and the review was not sent" % (label, worker))
            return
        rec["model"] = model
        if not is_opus(model):
            if not rec["model_retried"]:
                self.say("warn", "%s: %s is running %s, not Opus; the review was not sent. "
                         "Exiting it and retrying once with %s" % (
                             label, worker, model, self.cfg.retry_model))
                if self._send(rec, "/exit"):
                    rec.update(model_retried=True, respawn="fresh", model_flag=self.cfg.retry_model)
            else:
                self.say("error", "%s: %s is still on %s after a retry with %s; the review was "
                         "not sent. It needs a human." % (label, worker, model, rec["model_flag"]))
                rec["blocked"] = "model"
            return
        if self._send(rec, dispatch_text(rec["owner"], rec["repo"], rec["number"])):
            rec.update(last_dispatch_at=now, pending_dispatch=False, spawn_attempts=0)
            self.say("info", "%s: sent %s to %s (%s)" % (
                label, dispatch_text(rec["owner"], rec["repo"], rec["number"]), worker, model))

    def _offline(self, rec, row, now, roster):
        label, worker = label_of(rec), rec["worker"]
        if self._booting(rec, now):
            return
        if self.spawner.pid_alive(worker):
            self.note_every(rec, "unregistered", now, "warn",
                            "%s: %s is running but not connected to the hub; leaving it alone" % (
                                label, worker))
            return
        if rec.get("respawn") == "fresh":
            if self._live_count(now, roster) < self.cfg.max_sessions:
                rec["respawn"] = None
                self._spawn(rec, now, fresh=True)
            return
        clean = bool(row and row.get("exited_cleanly"))
        d = rec.get("last_dispatch_at")
        if not clean and d and (rec.get("last_review_at") or 0) < d and not rec["pending_dispatch"]:
            rec["pending_dispatch"] = True
            self.say("warn", "%s: %s stopped mid-review; resuming it and sending the round again" % (
                label, worker))
        if not rec["pending_dispatch"]:
            self.note_once(rec, "dormant", "info",
                           "%s: %s exited; the next request resumes it" % (label, worker))
            return
        if rec.get("spawn_attempts", 0) >= self.cfg.max_spawn_attempts:
            self.note_once(rec, "spawn-failed", "error",
                           "%s: %s did not come up after %d attempts; it needs a human" % (
                               label, worker, rec["spawn_attempts"]))
            return
        if self._live_count(now, roster) < self.cfg.max_sessions:
            self._spawn(rec, now, fresh=False)

    def _step_ending(self, rec, now, roster):
        row = roster.get(rec["worker"])
        if not (row and row.get("online")):
            if rec.get("exit_sent_at") is None and self._booting(rec, now):
                return
            if self.spawner.pid_alive(rec["worker"]):
                self.note_every(rec, "unregistered", now, "warn",
                                "%s: %s is running but not connected to the hub; leaving it alone" % (
                                    label_of(rec), rec["worker"]))
                return
            self._finish(rec, now, clean=bool(row and row.get("exited_cleanly")))
            return
        if row.get("state") != "idle":
            return
        if rec.get("exit_sent_at") is None:
            if self._send(rec, "/save-and-exit"):
                rec.update(exit_sent_at=now, exit_sends=1)
                self.say("info", "%s: sent /save-and-exit to %s" % (label_of(rec), rec["worker"]))
        elif rec["exit_sends"] < 2 and now - rec["exit_sent_at"] > self.cfg.exit_resend_after:
            if self._send(rec, "/save-and-exit"):
                rec.update(exit_sent_at=now, exit_sends=2)
                self.say("warn", "%s: %s is still open %d min after /save-and-exit; sent it once more" % (
                    label_of(rec), rec["worker"], int(self.cfg.exit_resend_after / 60)))

    def _finish(self, rec, now, clean):
        del self.ledger.records[record_key(rec["owner"], rec["repo"], rec["number"])]
        rec.update(status="ended", ended_at=now, exited_cleanly=clean)
        if not self.cfg.dry_run:
            self.ledger.append_history(rec)
        if rec.get("exit_sent_at") and not clean:
            self.say("error", "%s: %s is gone but did not exit cleanly (%s)" % (
                label_of(rec), rec["worker"], rec["end_reason"]))
        else:
            self.say("info", "%s: ended %s (%s)" % (label_of(rec), rec["worker"], rec["end_reason"]))


# ── CLI ───────────────────────────────────────────────────────────────────

def print_status(ledger, write=print):
    if not ledger.records:
        write("no PRs tracked")
        return
    for key, r in sorted(ledger.records.items(), key=lambda kv: kv[1].get("requested_at") or 0):
        bits = [r["status"], r["worker"]]
        if r.get("pending_dispatch"):
            bits.append("round pending")
        if r.get("last_dispatch_at"):
            bits.append("last /review %s" % iso(r["last_dispatch_at"]))
        if r.get("end_reason"):
            bits.append("ending: %s" % r["end_reason"])
        if r.get("blocked"):
            bits.append("blocked: %s" % r["blocked"])
        write("%s  %s" % (label_of(r), "  ".join(bits)))


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    if "-h" in argv or "--help" in argv:
        print(__doc__.strip())
        return 0
    p = argparse.ArgumentParser(prog="jjstack-review-daemon", add_help=False)
    p.add_argument("--interval", type=int, default=120)
    p.add_argument("--max-sessions", type=int, default=4)
    p.add_argument("--idle-days", type=float, default=7)
    p.add_argument("--owners", default=",".join(DEFAULT_OWNERS))
    p.add_argument("--reconcile-every", type=int, default=15)
    p.add_argument("--model", default="opus[1m]")
    p.add_argument("--retry-model", default="claude-opus-5[1m]")
    p.add_argument("--cwd", default=".")
    p.add_argument("--hub-url", default="http://localhost:8001")
    p.add_argument("--once", action="store_true")
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("--status", action="store_true")
    args = p.parse_args(argv)
    if args.interval < 60 or args.max_sessions < 1 or args.reconcile_every < 1 or args.idle_days <= 0:
        p.error("--interval must be at least 60; --max-sessions, --reconcile-every and "
                "--idle-days must be positive")
    cwd = os.path.abspath(args.cwd)
    home = os.path.expanduser("~")
    color = _color_on()

    def out(level, text):
        print(render(level, time.strftime("%H:%M:%S ") + text, color), flush=True)

    try:
        ledger = Ledger(os.path.join(cwd, ".review-daemon"))
    except LedgerError as e:
        out("error", str(e))
        return 1
    if args.status:
        print_status(ledger)
        return 0
    env = load_env(cwd, os.environ, home)
    gh = GH(env)
    try:
        check_identity(env, gh)
    except IdentityError as e:
        out("error", str(e))
        return EXIT_IDENTITY
    owners = tuple(o.strip() for o in args.owners.split(",") if o.strip())
    claude_tm = shutil.which("claude-tm", path=env.get("PATH")) or \
        os.path.join(home, ".local", "bin", "claude-tm")
    cfg = Config(owners=owners, cwd=cwd, home=home, claude_tm=claude_tm, model=args.model,
                 retry_model=args.retry_model, max_sessions=args.max_sessions,
                 idle_days=args.idle_days, reconcile_every=args.reconcile_every,
                 interval=args.interval, dry_run=args.dry_run)
    daemon = Daemon(cfg, gh, Hub(args.hub_url, env.get("TUBEMAIL_SECRET", "")),
                    HubMCP(args.hub_url), Spawner(cwd), ledger, Clock(), out)
    out("info", "watching review requests for %s from %s; up to %d sessions; polling every %ds%s" % (
        REVIEWER, ", ".join(owners), cfg.max_sessions, cfg.interval,
        " (dry run)" if cfg.dry_run else ""))
    try:
        while True:
            daemon.poll_once()
            if args.once:
                return 0
            time.sleep(max(cfg.interval, daemon.poll_interval))
    except KeyboardInterrupt:
        out("info", "stopped; open sessions keep running and the ledger is saved")
        return 0


if __name__ == "__main__":
    sys.exit(main())
