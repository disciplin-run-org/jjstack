#!/usr/bin/env bash
# jjstack-rollover-slot — the handover artifact that decides whether a
# successor session resumes the previous session's work.
#
# WHY THIS IS A FILE AND NOT A JUDGEMENT CALL. /save-and-clear used to file a
# QM resume order whenever "multi-turn work continues past this session",
# which is true of every mid-task session, and /resume-from-clear used to
# trigger on "evidence of unfinished work". Between them, asking for a clean
# context to start a NEW task handed the successor the OLD one. Continuation
# now has exactly one carrier per session boundary and it is inspectable:
#
#   /rollover           writes the slot   (the only verb that hands work on)
#   /resume-from-clear  consumes the slot (the only verb that picks it up)
#   /save-and-clear     touches neither   (new task, same identity)
#   /save-and-exit      touches neither   (nothing resumes)
#
# The slot lives OUTSIDE the auto-memory index on purpose. A handover written
# into MEMORY.md is loaded by every later session, so a sweep that mentioned
# unfinished work could make an unrelated session resume it. Nothing indexes
# this directory; only the two verbs above read and write it.
#
# Layout:  $HOME/.claude/projects/<dashified-cwd>/rollover/<worker>.md
# Keyed on the WORKER, not the directory: iris-qa hosts three workers in one
# cwd and they must not overwrite each other's handovers.
#
# Verbs:
#   path        [--cwd DIR]                     print the slot path (no writes)
#   write       [--cwd DIR]                     stdin -> the slot; prints the path
#   status      [--cwd DIR] [--max-age-days N]  print the path of a LIVE slot, else exit 1
#   consume     [--cwd DIR]                     retire the slot; prints the path it retired
#   transcript  [--cwd DIR] [--exclude ID]...   newest session log, excluding named ids
#
# No color red anywhere — unreadable on the target terminal.
set -uo pipefail

# A handover older than this stopped being a handover and became clutter: the
# prompt hook surfaces a live slot on every prompt, so an abandoned one would
# nag forever. Overridable per call for a deliberate archaeology dig.
DEFAULT_MAX_AGE_DAYS=7

usage() {
  cat >&2 <<'USAGE'
usage: jjstack-rollover-slot [--cwd DIR] <verb> [options]

  path                            print the slot path for this cwd + worker
  write                           read the handover on stdin into the slot
  status [--max-age-days N]       print a live slot's path, else exit 1
  consume                         retire the live slot, printing its path
  transcript [--exclude ID]...    newest session log, minus the excluded ids

The worker comes from $TM_WORKER_NAME; without one the slot is the
plain-session slot for this directory.
USAGE
  exit 2
}

die() { printf 'jjstack-rollover-slot: %s\n' "$1" >&2; exit "${2:-1}"; }

CWD="$PWD"
while [ $# -gt 0 ]; do
  case "$1" in
    --cwd) [ $# -ge 2 ] || usage; CWD="$2"; shift 2 ;;
    --cwd=*) CWD="${1#--cwd=}"; shift ;;
    -h|--help) usage ;;
    *) break ;;
  esac
done
[ $# -ge 1 ] || usage
VERB="$1"; shift

# Trailing slashes would dashify into an empty final segment and key a
# different directory than the harness does for the same cwd.
while [ "${CWD%/}" != "$CWD" ] && [ "$CWD" != "/" ]; do CWD="${CWD%/}"; done

# The harness keys project state by the cwd with every slash turned into a
# dash. Deriving it the same way here is what makes `transcript` able to find
# the session logs the harness wrote.
#
# Parameter expansion rather than a sed pipeline, and a plain assignment rather
# than a command substitution: `status` runs on EVERY prompt through the
# UserPromptSubmit hook, and the answer is almost always "no handover". That
# path now forks nothing — it is two expansions and a stat.
PROJ_DIR="$HOME/.claude/projects/${CWD//\//-}"
SLOT_DIR="$PROJ_DIR/rollover"

# A worker name reaches this script from the environment, so it is untrusted
# input for a path: anything outside the safe set becomes an underscore, and a
# name that is only dots cannot become a directory traversal.
SLOT_NAME="${TM_WORKER_NAME:-}"
SLOT_NAME="${SLOT_NAME//[^A-Za-z0-9._-]/_}"
case "$SLOT_NAME" in ''|.|..) SLOT_NAME=session ;; esac
SLOT="$SLOT_DIR/$SLOT_NAME.md"

# A slot is LIVE when it exists, is not empty, and is younger than the window.
# The age test costs a fork, so it runs only once the cheap tests have already
# said there is something to age.
live_slot() {  # live_slot <max-age-days> -> 0 and prints the path
  local days="$1" hit
  [ -s "$SLOT" ] || return 1
  hit=$(find "$SLOT" -maxdepth 0 -mtime -"$days" -print -quit 2>/dev/null)
  [ -n "$hit" ] || return 1
  printf '%s\n' "$SLOT"
}

case "$VERB" in

  path)
    [ $# -eq 0 ] || usage
    printf '%s\n' "$SLOT"
    ;;

  write)
    [ $# -eq 0 ] || usage
    body=$(cat)
    # An empty handover is worse than none: it makes `status` succeed, so the
    # successor runs the resume ladder and finds nothing to resume.
    case "${body//[[:space:]]/}" in '') die "refusing to write an empty handover" ;; esac
    mkdir -p "$SLOT_DIR" || die "cannot create $SLOT_DIR"
    printf '%s\n' "$body" > "$SLOT" || die "cannot write $SLOT"
    printf '%s\n' "$SLOT"
    ;;

  status)
    days="$DEFAULT_MAX_AGE_DAYS"
    while [ $# -gt 0 ]; do
      case "$1" in
        --max-age-days) [ $# -ge 2 ] || usage; days="$2"; shift 2 ;;
        --max-age-days=*) days="${1#--max-age-days=}"; shift ;;
        *) usage ;;
      esac
    done
    case "$days" in ''|*[!0-9]*) die "--max-age-days takes a whole number of days" ;; esac
    live_slot "$days"
    ;;

  consume)
    [ $# -eq 0 ] || usage
    # Consume ignores the age window deliberately: whatever the successor was
    # told to pick up, it retires. The window governs nagging, not reading.
    [ -s "$SLOT" ] || die "no handover to consume at $SLOT"
    stamp=$(date -u +%Y%m%dT%H%M%SZ)
    # The handover is RENAMED, never deleted. The transcript it points at is
    # the authoritative record and this is the index into it; a resume that
    # goes wrong needs to be readable afterwards.
    mv "$SLOT" "${SLOT%.md}.consumed-$stamp.md" || die "cannot retire $SLOT"
    printf '%s\n' "$SLOT"
    ;;

  transcript)
    excl_file=$(mktemp) || die "cannot allocate a temp file"
    trap 'rm -f "$excl_file"' EXIT
    while [ $# -gt 0 ]; do
      case "$1" in
        --exclude) [ $# -ge 2 ] || usage; printf '%s\n' "$2" >> "$excl_file"; shift 2 ;;
        --exclude=*) printf '%s\n' "${1#--exclude=}" >> "$excl_file"; shift ;;
        *) usage ;;
      esac
    done
    [ -d "$PROJ_DIR" ] || exit 1
    newest=$(
      find "$PROJ_DIR" -maxdepth 1 -name '*.jsonl' -type f -printf '%T@\t%p\n' 2>/dev/null \
        | sort -rn \
        | while IFS=$'\t' read -r _ p; do
            base="${p##*/}"; base="${base%.jsonl}"
            grep -qxF "$base" "$excl_file" 2>/dev/null && continue
            printf '%s\n' "$p"; break
          done
    )
    [ -n "$newest" ] || exit 1
    printf '%s\n' "$newest"
    ;;

  *) usage ;;
esac
