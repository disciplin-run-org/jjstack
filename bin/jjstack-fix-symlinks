#!/usr/bin/env bash
# jjstack-fix-symlinks — re-assert jjstack symlinks at ~/.claude/skills/.
#
# For each jjstack skill, verify the entry in ~/.claude/skills/<name>/ is a
# symlink to the jjstack source. Fixes three failure modes:
#
#   1. Symlink pointing to gstack (gstack overwrote it in an auto-update)
#   2. Real directory holding a symlinked SKILL.md that points to gstack
#      (gstack's alternate install pattern)
#   3. Real directory holding a stale copy of the jjstack SKILL.md (the
#      symlink was replaced by a real file at some point — some tools write
#      through symlinks by copy-then-replace). Detected by matching the
#      SKILL.md frontmatter `name:` field against the jjstack skill's name.
#      If the name matches, treat as a stale jjstack copy and replace.
#      If the name differs or there's no frontmatter, the directory belongs
#      to someone else — skip with a warning instead of clobbering.
#
# Output: one line per fix, one line per skip-with-reason, or nothing if
# everything is already correct.

JJSTACK_DIR="${JJSTACK_DIR:-$(cd "$(dirname "$0")/.." && pwd)}"
SKILLS_DIR="$HOME/.claude/skills"

# THE LINKS POINT AT THE SERVED TREE, NOT AT THIS CHECKOUT.
#
# This script runs from jjstack-update-check, which runs in the preamble of
# almost every skill, so it is the most frequently executed writer of these
# links on the machine. Writing $JJSTACK_DIR here would re-point every link at
# the working checkout within one session of any pin being made - the pin
# would appear to work at install time and be gone by the next prompt.
# jjstack-skills-pin --resolve is the one answer both this and `setup` ask.
# The resolver is found NEXT TO THIS SCRIPT, not under $JJSTACK_DIR. Both are
# the same directory in a real install, and they are not when JJSTACK_DIR is
# overridden - which is every test, and any caller pointing this at another
# tree. Looking under $JJSTACK_DIR meant the resolver was simply absent there,
# SKILL_SRC silently fell back to the checkout, and the pin appeared to work
# everywhere except where it was being checked. It is invoked WITH the same
# JJSTACK_DIR this script is using, so the two cannot answer about different
# trees.
_PINBIN="$(dirname "$0")/jjstack-skills-pin"
SKILL_SRC="$JJSTACK_DIR"
if [ -x "$_PINBIN" ]; then
  SKILL_SRC="$(JJSTACK_DIR="$JJSTACK_DIR" "$_PINBIN" --resolve 2>/dev/null || echo "$JJSTACK_DIR")"
fi
[ -d "$SKILL_SRC/skills" ] || SKILL_SRC="$JJSTACK_DIR"
FIXED=0
SKIPPED=0

# Extract `name:` from a SKILL.md's YAML frontmatter. Prints the value or
# empty string if not found. Handles both `name: foo` and `name: "foo"`.
read_name_frontmatter() {
  local file="$1"
  [ -f "$file" ] || return
  awk '
    /^---[[:space:]]*$/ { in_fm = !in_fm; next }
    in_fm && /^name:/ {
      sub(/^name:[[:space:]]*/, "")
      gsub(/["\x27]/, "")
      sub(/[[:space:]]+$/, "")
      print
      exit
    }
  ' "$file"
}

for skill_dir in "$SKILL_SRC"/skills/*/; do
  [ ! -d "$skill_dir" ] && continue
  skill_name="$(basename "$skill_dir")"
  [ ! -f "$skill_dir/SKILL.md" ] && continue
  [ "$skill_name" = "jjstack" ] && continue

  target="$SKILLS_DIR/$skill_name"
  jj_target="$SKILL_SRC/skills/$skill_name"

  # Case 1: symlink pointing to gstack — replace
  if [ -L "$target" ]; then
    current="$(readlink "$target")"
    # A link is ours if it resolves to the tree we serve; otherwise the
    # gstack test decides. Path-spelling alone is not enough: the pin lives
    # outside any directory named jjstack, so `grep jjstack/` reads a correct
    # pinned link as a gstack one and rewrites it every run.
    if [ "$(readlink -f "$target" 2>/dev/null)" = "$(readlink -f "$jj_target" 2>/dev/null)" ]; then
      continue
    fi
    if echo "$current" | grep -q "gstack/" && ! echo "$current" | grep -q "jjstack/"; then
      ln -snf "$jj_target" "$target"
      FIXED=$((FIXED + 1))
    elif [ -n "${JJSTACK_REPIN_LINKS:-}" ]; then
      # Opt-in: move links from a previous source (a checkout, an older pin)
      # onto the served tree. Off by default so this script keeps its narrow
      # contract of repairing gstack clobbering.
      ln -snf "$jj_target" "$target"
      FIXED=$((FIXED + 1))
    fi
    continue
  fi

  # Case 2: gstack dir+symlink pattern — replace
  if [ -d "$target" ] && [ -L "$target/SKILL.md" ]; then
    inner="$(readlink "$target/SKILL.md")"
    if echo "$inner" | grep -q "gstack/"; then
      rm "$target/SKILL.md"
      rmdir "$target" 2>/dev/null || rm -rf "$target"
      ln -snf "$jj_target" "$target"
      FIXED=$((FIXED + 1))
    fi
    continue
  fi

  # Case 3: real directory with a real (non-symlink) SKILL.md.
  # Could be a stale jjstack copy (replace) or a user-custom skill that
  # happens to share a name (skip with warning — don't clobber).
  if [ -d "$target" ] && [ -f "$target/SKILL.md" ] && [ ! -L "$target/SKILL.md" ]; then
    existing_name="$(read_name_frontmatter "$target/SKILL.md")"
    jjstack_name="$(read_name_frontmatter "$skill_dir/SKILL.md")"

    if [ -n "$existing_name" ] && [ "$existing_name" = "$jjstack_name" ]; then
      # Names match → stale jjstack copy. Replace with symlink.
      rm -rf "$target"
      ln -snf "$jj_target" "$target"
      FIXED=$((FIXED + 1))
      echo "FIXED_STALE_COPY $skill_name"
    else
      # Names differ or no frontmatter → belongs to someone else. Warn.
      echo "SKIPPED_CONFLICT $skill_name (existing name='$existing_name', jjstack name='$jjstack_name')"
      SKIPPED=$((SKIPPED + 1))
    fi
    continue
  fi
done

[ "$FIXED" -gt 0 ] && echo "SYMLINKS_FIXED $FIXED"
[ "$SKIPPED" -gt 0 ] && echo "CONFLICTS $SKIPPED — see SKIPPED_CONFLICT lines above"
exit 0
