#!/usr/bin/env bash
# jjstack-review-ledger — per-repo memory of what past reviews decided.
#
# Every AI reviewer that people keep using eventually grows a memory: Greptile
# markets "learns from your team's feedback", CodeRabbit has learnings, gstack
# already carries a suppression history for Greptile's own comments
# (~/.claude/skills/gstack/review/greptile-triage.md). The mechanic is real —
# re-reporting a finding the team already dismissed is the purest form of alert
# fatigue. The vendor implementations are opaque: the memory lives on their
# server, you cannot read it, diff it, or review a change to it.
#
# This is the same mechanic with the opacity removed. The ledger is a plain
# markdown file inside the repo, so it is version controlled, reviewable in a
# PR, and greppable. And it deliberately does NOT do what the vendors do: a
# match here DEMOTES a finding into 5f's `### Demoted (prior decision)` section
# with the prior decision cited. It never drops one, and it never rescores one:
# the finding keeps its severity and confidence and only moves down the page.
# jjstack /review is tuned for recall; silently suppressing a whole class
# because someone once waved it off is exactly the failure this stack exists to
# avoid. Only `dismissed` entries demote — `fixed` and `confirmed` entries are
# history, not suppression.
#
# Usage:
#   jjstack-review-ledger --record --type TYPE --path PATTERN --category CAT
#                         [--note TEXT] [--ledger FILE] [--repo DIR]
#   jjstack-review-ledger --match --path FILE --category CAT
#                         [--ledger FILE] [--repo DIR]
#   jjstack-review-ledger --list [--ledger FILE] [--repo DIR]
#
#   TYPE  = dismissed | fixed | confirmed
#   CAT   = correctness | security | concurrency | error-handling | resource-leak
#           | test-coverage | performance | api-contract | style | type-safety
#           | dependency | other
#   PATTERN is a shell glob matched against the finding's repo-relative path.
#           It must name a PLACE, and breadth is judged on what the glob
#           actually matches IN THIS REPOSITORY — never on how it is spelled,
#           and never against a fixture. The corpus is `git ls-files` of the
#           repo the ledger belongs to, and a pattern is refused when it lands
#           in three or more distinct top-level names, or on a MAJORITY of
#           everything the repo tracks. Half the tree is not a place, however
#           few directories it is spread over. Ten synthetic probe paths are
#           applied as well, as the check that still fires when the ledger has
#           no repository behind it yet.
#
#           Every earlier version of this rule was as wide as its fixture:
#           stripping `*?/` waved through `*[a-z]*` and `[a-z]*`; measuring
#           reach against ten fictional paths waved through `*.md`, which
#           demotes 99 of this repo's 148 tracked files. Asking the repository
#           is the only form of the question that cannot be out-guessed by a
#           spelling nobody listed. The same test is applied to patterns READ
#           from the ledger, because it is meant to be hand-edited in git and a
#           merged blanket row is the same blanket.
#
#           PATTERN is also a POSITIONAL field in the record, so it carries the
#           record grammar's alphabet: printable characters only, and never the
#           `|` delimiter. A `--path` holding a newline used to write a whole
#           second, forged record — an attacker-chosen `dismissed` row out of
#           an invocation that asked for `--type fixed`.
#
#   NOTE    is stored in the printable alphabet, and that is defined by what is
#           ALLOWED, not by a list of characters to strip. A record is one
#           physical line, so any character outside the printable set (a
#           newline first of all, but equally a CR, a tab, an ESC) is escaped
#           into that alphabet using the standard `printf %b` sequences. The
#           encoding is reversible — `printf '%b'` gives back the original
#           bytes exactly — and the note is quoted back in that stored form, on
#           one line, so that a note can never forge a field boundary, a second
#           ledger row, or a line of this tool's own output.
#
# Protected categories (security, correctness, concurrency, error-handling,
# resource-leak, test-coverage) are recorded but NEVER demote — --match prints
# PROTECTED and exits 1 for them. The path glob is still consulted first: a
# record only speaks about a finding whose path it actually matches.
#
# A --match against a ledger that does not exist warns and exits 1. That is not
# the same statement as "no prior decision applies", and it is never reported as
# if it were.
#
# The `<repo>` column names the repo the LEDGER belongs to, which is what makes
# a ledger readable after it is copied or merged between repos. With --ledger and
# no --repo it is resolved from the ledger's own location, never from the cwd.
#
# Default ledger: <repo-root>/jjstack/review-ledger.md
#
# Exit: 0 recorded / listed / a demotion matched, 1 --match found nothing or
#       found no ledger, 2 usage error — an invalid type or category, a flag
#       given with no value, or an unscoped path glob — 3 repo root unresolvable.
#
# No color red anywhere — unreadable on the target terminal.
set -uo pipefail

YEL="\033[33m"; CYA="\033[96m"; GRN="\033[32m"; RST="\033[0m"

VALID_TYPES="dismissed fixed confirmed"
VALID_CATS="correctness security concurrency error-handling resource-leak test-coverage performance api-contract style type-safety dependency other"

# Greptile's suppression engine exempts a fixed list of classes from ever being
# silenced by repeated ignores — security vulnerabilities, memory leaks,
# infinite loops, null-pointer exceptions and missing input validation
# (greptile.com/docs/how-greptile-works/nitpicks). That guard is the right idea
# and it is the one part of a learning loop you cannot leave to judgment: the
# categories that most deserve suppression pressure are exactly the ones where
# a wrong suppression is a shipped incident. A dismissal in one of these is
# still RECORDED — the history stays honest — it just never demotes.
PROTECTED_CATS="security correctness concurrency error-handling resource-leak test-coverage"

MODE=""; TYPE=""; PATH_ARG=""; CATEGORY=""; NOTE=""; LEDGER=""; REPO=""

# The header IS the help. A hand-kept `sed -n 'A,Bp'` range drifts the instant a
# line is added above it — it truncated three sibling tools mid-sentence and
# leaked `set -uo pipefail` into their output — so read comment lines until the
# first non-comment line instead.
show_help() {
  awk 'NR == 1 && /^#!/ { next }
       /^#/                { sub(/^# ?/, ""); print; next }
       { exit }' "$0"
}

# ---------------------------------------------------------------------------
# Breadth: judged on what a glob MATCHES in the REAL repository.
#
# Round 1 stripped `*`, `?` and `/` and rejected whatever came out empty — a
# rule shaped exactly like the two spellings its fixture contained. Round 2
# replaced it with a measurement, which was the right idea and the wrong corpus:
# reach was measured against TEN HARD-CODED FICTIONAL PATHS that share three
# top-level names with this repo. `*.md` reaches two of those ten, passes, and
# demotes 99 of this repo's 148 tracked files. A longer fixture is the same bug
# with more paths in it.
#
# So the corpus is the repository. `git ls-files` of the repo the ledger belongs
# to IS the source of truth for "what does this glob actually reach", and two
# properties of that reach make a pattern a blanket rather than a place:
#
#   * it lands in BREADTH_LIMIT or more distinct top-level names, or
#   * it lands on a MAJORITY of everything the repo tracks. Half the tree is not
#     a place, however few directories it happens to be spread over — that is
#     what catches `[bs]*` (two top levels, 100 of 148 files).
#
# The ten synthetic probes stay as a SECONDARY check, applied as well as the
# real corpus and never instead of it. They are what still fires when the ledger
# has no repository behind it yet, and they cost nothing when it does.
BREADTH_PROBES="src/payments.py lib/util.go docs/guide.md tests/test_api.rb
.github/workflows/ci.yml vendor/thirdparty/lib.c deep/nested/tree/Widget.java
Makefile README.md go.mod"
BREADTH_LIMIT=3

# Which repo's files are the corpus: the same precedence the ledger path itself
# uses — an explicit --repo, else the ledger's own location, else the cwd. The
# walk up to the nearest EXISTING ancestor matters: on the first record the
# ledger's directory (<repo>/jjstack/) does not exist yet, and a corpus that
# comes back empty is a guard that has silently switched itself off.
corpus_ctx() {
  local d
  if [ -n "$REPO" ]; then printf '%s' "$REPO"; return; fi
  if [ -n "$LEDGER" ]; then d="$(dirname "$LEDGER")"; else d="$PWD"; fi
  while [ -n "$d" ] && [ "$d" != "/" ] && [ "$d" != "." ] && [ ! -d "$d" ]; do
    d="$(dirname "$d")"
  done
  printf '%s' "$d"
}

# Read once per process: --match calls too_broad() for every row in the file.
_CORPUS=""; _CORPUS_READ=""
real_corpus() {
  if [ -z "$_CORPUS_READ" ]; then
    _CORPUS_READ=1
    _CORPUS="$(git -C "$(corpus_ctx)" ls-files 2>/dev/null)"
  fi
  printf '%s' "$_CORPUS"
}

# reach of a glob over a newline-separated corpus on stdin:
#   "<files matched> <distinct top-level names matched>"
reach_over() {
  local pat="$1" p top seen=" " tops=0 files=0
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    # shellcheck disable=SC2254  # the glob is the point
    case "$p" in
      $pat) files=$((files + 1)); top="${p%%/*}"
            case "$seen" in
              *" $top "*) ;;
              *) seen="$seen$top "; tops=$((tops + 1)) ;;
            esac ;;
    esac
  done
  printf '%s %s' "$files" "$tops"
}

# true when the glob is a blanket rather than a place.
too_broad() {
  local pat="$1" corpus total files tops
  corpus="$(real_corpus)"
  if [ -n "$corpus" ]; then
    total=$(printf '%s\n' "$corpus" | grep -c .)
    read -r files tops < <(printf '%s\n' "$corpus" | reach_over "$pat")
    [ "$tops" -ge "$BREADTH_LIMIT" ] && return 0
    [ "$total" -gt 0 ] && [ $((files * 2)) -gt "$total" ] && return 0
  fi
  # shellcheck disable=SC2086  # the probe list is a deliberate word list
  read -r files tops < <(printf '%s\n' $BREADTH_PROBES | reach_over "$pat")
  [ "$tops" -ge "$BREADTH_LIMIT" ]
}

# ---------------------------------------------------------------------------
# The record's field alphabet.
#
# A record is ONE physical line of `|`-separated fields, so every field written
# into it has exactly two hard constraints: no line terminator, and no
# delimiter. `--note` is the LAST field and is escaped into the printable
# alphabet, which is why a pipe survives there and a newline cannot break out.
# Every OTHER free-text field is positional, so escaping cannot save it — a `|`
# would still split the row at the wrong place — and those are REFUSED instead,
# by the same positive rule: printable characters only, and not the delimiter.
#
# `--path` was the one free-text field with no rule at all. It is validated by
# too_broad(), which is a glob-match test, not a character test, so a `--path`
# carrying a newline plus tabs wrote a COMPLETE SECOND RECORD with an
# attacker-chosen date, repo, type, glob, category and note — a `dismissed` row
# that demotes, out of an invocation that asked for `--type fixed`.
field_clean() {   # 0 when $1 is safe to write as a positional field
  case "$1" in
    *[![:print:]]*) return 1 ;;
    *"|"*)          return 1 ;;
  esac
  return 0
}

# ---------------------------------------------------------------------------
# The note's alphabet, defined by what is ALLOWED.
#
# A record is ONE physical line. The round-1 fix taught the reader to rejoin
# fields 6..NF so a `|` in a note survives — a blacklist of one character, and
# a newline went straight through it: the note became a second physical line,
# --match dropped it for not having the date shape, and if that line happened to
# look like a record the note had forged a whole ledger row (verified: a note
# could plant a `security` dismissal against `src/*`).
#
# The rule is therefore positive. A note is stored in the PRINTABLE alphabet;
# every character outside it is escaped into that alphabet using the standard
# `printf %b` sequences, so the mapping is reversible and a control character
# nobody has thought of is covered by the same sentence as the one that was
# reported. Backslash is escaped first, which is what makes decoding exact.
encode_note() {
  local s="$1" out="" c i n=${#1} code
  for (( i = 0; i < n; i++ )); do
    c="${s:i:1}"
    if [ "$c" = '\' ]; then out="$out\\\\"; continue; fi
    if [[ $c == [[:print:]] ]]; then out="$out$c"; continue; fi   # ALLOWED
    case "$c" in
      $'\n') out="$out\\n" ;;
      $'\r') out="$out\\r" ;;
      $'\t') out="$out\\t" ;;
      *) printf -v code '%d' "'$c" 2>/dev/null || code=0
         code=$(( code & 255 ))
         out="$out$(printf '\\0%03o' "$code")" ;;
    esac
  done
  printf '%s' "$out"
}

set_mode() {
  if [ -n "$MODE" ]; then
    echo -e "${CYA}error${RST} pick one mode: --record, --match or --list" >&2; exit 2
  fi
  MODE="$1"
}

# A flag given with no value used to hang this script for ever: `shift 2` is a
# no-op when only one argument remains, `set -e` is off so the failure is
# swallowed, and the loop re-reads the same $1 on the next pass. An unattended
# /review step that spins instead of failing is worse than a crash — nothing
# reports, nothing times out, and the caller waits on it. Call this before every
# `shift 2` so a missing value is a clean usage error instead.
need_val() {
  [ $# -ge 2 ] || { echo -e "${CYA}error${RST} $1 requires a value" >&2; exit 2; }
}

while [ $# -gt 0 ]; do
  case "$1" in
    --record)   set_mode record; shift ;;
    --match)    set_mode match;  shift ;;
    --list)     set_mode list;   shift ;;
    --type)     need_val "$@"; TYPE="$2";     shift 2 ;;
    --path)     need_val "$@"; PATH_ARG="$2"; shift 2 ;;
    --category) need_val "$@"; CATEGORY="$2"; shift 2 ;;
    --note)     need_val "$@"; NOTE="$2";     shift 2 ;;
    --ledger)   need_val "$@"; LEDGER="$2";   shift 2 ;;
    --repo)     need_val "$@"; REPO="$2";     shift 2 ;;
    -h|--help) show_help; exit 0 ;;
    -*) echo -e "${CYA}error${RST} unknown flag: $1" >&2; exit 2 ;;
    *)  echo -e "${CYA}error${RST} unexpected arg: $1" >&2; exit 2 ;;
  esac
done

[ -z "$MODE" ] && { echo -e "${CYA}error${RST} one of --record, --match, --list is required" >&2; exit 2; }

in_set() {
  for v in $2; do [ "$1" = "$v" ] && return 0; done
  return 1
}

# Validate BEFORE touching the ledger: a typo'd category silently written is a
# suppression that can never match, and a typo'd category silently matched is a
# suppression that fires on the wrong class.
if [ "$MODE" = "record" ] || [ "$MODE" = "match" ]; then
  [ -n "$PATH_ARG" ] || { echo -e "${CYA}error${RST} --path is required for --$MODE" >&2; exit 2; }
  # --path is written into a POSITIONAL field, so it gets the record grammar's
  # alphabet, not a list of characters someone reported. A newline here forged a
  # whole second record; a `|` splits the row at the wrong place.
  if ! field_clean "$PATH_ARG"; then
    echo -e "${CYA}error${RST} --path may hold printable characters only, and no '|'" >&2
    echo -e "${YEL}why${RST}   a record is ONE line of '|'-separated fields. A path carrying a" >&2
    echo -e "${YEL}why${RST}   newline, a tab, a control character or the delimiter would write" >&2
    echo -e "${YEL}why${RST}   a second, forged record instead of naming a place." >&2
    exit 2
  fi
  [ -n "$CATEGORY" ] || { echo -e "${CYA}error${RST} --category is required for --$MODE" >&2; exit 2; }
  if ! in_set "$CATEGORY" "$VALID_CATS"; then
    echo -e "${CYA}error${RST} unknown category '$CATEGORY'" >&2
    echo -e "${YEL}valid${RST} $VALID_CATS" >&2
    exit 2
  fi
fi
if [ "$MODE" = "record" ]; then
  [ -n "$TYPE" ] || { echo -e "${CYA}error${RST} --type is required for --record" >&2; exit 2; }
  if ! in_set "$TYPE" "$VALID_TYPES"; then
    echo -e "${CYA}error${RST} unknown type '$TYPE'" >&2
    echo -e "${YEL}valid${RST} $VALID_TYPES" >&2
    exit 2
  fi
  # The category and the path glob are the two halves of the key, and only one
  # of them was checked. `--path '*'` records a dismissal that then demotes
  # every finding in that category, repo-wide and permanently — the demoted
  # section becomes the whole report, and the ledger line reads like any other
  # in a PR diff. Breadth is decided by too_broad(), on what the glob MATCHES:
  # a spelling test can only ever reject the spellings someone listed.
  if too_broad "$PATH_ARG"; then
    echo -e "${CYA}error${RST} --path '$PATH_ARG' reaches across unrelated parts of the repo" >&2
    echo -e "${YEL}why${RST}   it matches paths under $BREADTH_LIMIT or more unrelated top-level" >&2
    echo -e "${YEL}why${RST}   names, so it is a blanket, not a decision about a place in the" >&2
    echo -e "${YEL}why${RST}   code. Scope it: 'src/legacy/*', 'docs/*', 'tests/**'." >&2
    exit 2
  fi
fi

if [ -z "$LEDGER" ]; then
  [ -z "$REPO" ] && REPO="$(git rev-parse --show-toplevel 2>/dev/null)"
  if [ -z "$REPO" ] || [ ! -d "$REPO" ]; then
    echo -e "${YEL}warn${RST}  no repo root: pass --ledger or --repo, or run inside a git repo" >&2
    exit 3
  fi
  LEDGER="${REPO%/}/jjstack/review-ledger.md"
fi

# Repo slug for the record, so a ledger stays readable if it is ever merged or
# copied between repos. That is the whole point of the column, which is why it
# must describe the LEDGER's repo. It used to run git in the CWD: recording into
# project A's ledger from a shell sitting in project B stamped every row with B,
# and the one field that exists to survive a copy became the field that lies
# about it. An explicit --repo still wins — that is the caller saying which repo
# this is — but otherwise the ledger's own location decides.
slug() {
  local ctx url top
  ctx="${REPO:-$(dirname "$LEDGER")}"
  url="$(git -C "$ctx" remote get-url origin 2>/dev/null)"
  if [ -n "$url" ]; then
    url="${url%.git}"; url="${url##*:}"
    printf '%s\n' "$url" | awk -F/ '{ if (NF >= 2) print $(NF-1) "/" $NF; else print $NF }'
    return
  fi
  top="$(git -C "$ctx" rev-parse --show-toplevel 2>/dev/null)"
  basename "${top:-$ctx}"
}

# The slug is derived from a git remote URL or a directory name, which is data
# too: it lands in field 2 and gets the same positional-field alphabet as
# --path. Nothing outside it has ever been seen here, which is exactly why the
# rule is stated once and applied to every field rather than to the field that
# was reported.
safe_slug() {
  local s; s="$(slug)"
  if field_clean "$s"; then printf '%s' "$s"
  else printf '%s' "$s" | tr -c '[:print:]' '_' | tr '|' '_'; fi
}

case "$MODE" in
  record)
    mkdir -p "$(dirname "$LEDGER")" || exit 3
    if [ ! -f "$LEDGER" ]; then
      {
        echo "# jjstack review ledger"
        echo
        echo "What past /review runs decided, so the next run does not relitigate it."
        echo "One record per line:"
        echo
        echo '```'
        echo "<date> | <repo> | <dismissed|fixed|confirmed> | <path-glob> | <category> | <note>"
        echo '```'
        echo
        echo "Only \`dismissed\` records suppress, and they DEMOTE a repeat finding into"
        echo "the report's \`Demoted (prior decision)\` section with this note cited —"
        echo "they never drop it. Delete a line to retire a decision; the deletion shows"
        echo "up in the diff like any other reviewed change."
        echo
      } > "$LEDGER"
    fi
    printf '%s | %s | %s | %s | %s | %s\n' \
      "$(date +%F)" "$(safe_slug)" "$TYPE" "$PATH_ARG" "$CATEGORY" \
      "$(encode_note "${NOTE:-(no note)}")" >> "$LEDGER"
    echo -e "${GRN}recorded${RST} $TYPE $PATH_ARG [$CATEGORY] → $LEDGER"
    if [ "$TYPE" = "dismissed" ] && in_set "$CATEGORY" "$PROTECTED_CATS"; then
      echo -e "${YEL}note${RST}  '$CATEGORY' is a protected category — this record is kept as" >&2
      echo -e "${YEL}note${RST}  history but will NEVER demote a future finding." >&2
    fi
    exit 0
    ;;

  list)
    if [ ! -f "$LEDGER" ]; then
      echo -e "${YEL}warn${RST}  no ledger yet: $LEDGER" >&2
      exit 0
    fi
    grep -E '^[0-9]{4}-[0-9]{2}-[0-9]{2} \|' "$LEDGER" || true
    exit 0
    ;;

  match)
    # A missing ledger used to exit 1 in silence, which is indistinguishable
    # from "I read the ledger and no prior decision applies". A mistyped
    # --ledger path therefore reported an authoritative all-clear for the whole
    # review. --list already warns on exactly this condition; so does match now.
    if [ ! -f "$LEDGER" ]; then
      echo -e "${YEL}warn${RST}  no ledger at $LEDGER — no prior decisions were consulted" >&2
      echo -e "${YEL}warn${RST}  (this is NOT 'no prior decision applies'; check --ledger/--repo)" >&2
      exit 1
    fi
    hits=0; protected=0
    while IFS= read -r line; do
      case "$line" in
        [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]\ \|*) ;;
        *) continue ;;
      esac
      # date | repo | type | pattern | category | note
      l_type=$(printf '%s' "$line" | awk -F' *\\| *' '{print $3}')
      l_pat=$(printf  '%s' "$line" | awk -F' *\\| *' '{print $4}')
      l_cat=$(printf  '%s' "$line" | awk -F' *\\| *' '{print $5}')
      # The note is the LAST field, not the sixth: a note may legitimately
      # contain the delimiter ("safe today | revisit when we drop py38"), and
      # taking $6 alone silently dropped the condition attached to the
      # dismissal — which the skill then quotes as the whole reason. Rejoin
      # every field from 6 on so the note survives intact.
      l_note=$(printf '%s' "$line" \
        | awk -F' *\\| *' '{ n=$6; for (i=7; i<=NF; i++) n = n " | " $i; print n }')
      [ "$l_type" = "dismissed" ] || continue
      [ "$l_cat" = "$CATEGORY" ]  || continue
      # The breadth rule lives on BOTH sides of the file. --record is only half
      # the door: this ledger is designed to be hand-edited and merged in git,
      # so a blanket row can arrive without ever passing through --record. One
      # `*` row demoting the whole repo reads, in a PR diff, exactly like a
      # scoped decision. Refuse to act on it and say so — the row stays in the
      # file as history, it just never suppresses anything.
      if too_broad "$l_pat"; then
        echo -e "${YEL}warn${RST}  ignoring ledger row: pattern '$l_pat' is too broad" >&2
        echo -e "${YEL}warn${RST}  (it reaches across $BREADTH_LIMIT+ unrelated top-level names; scope it or delete it)" >&2
        continue
      fi
      # The path glob is part of the key, so it must be consulted BEFORE any
      # announcement is made about this record. It used to be tested only after
      # the PROTECTED branch had already printed and `continue`d, so a
      # dismissal recorded against `docs/*` announced itself on a security
      # finding in `src/payments.py`. The skill then tells the reviewer to cite
      # that prior dismissal in the finding body — a fabricated precedent
      # nudging the author to re-dismiss a live P0.
      # shellcheck disable=SC2254  # the glob is the point
      case "$PATH_ARG" in
        $l_pat) ;;
        *) continue ;;
      esac
      if in_set "$l_cat" "$PROTECTED_CATS"; then
        printf 'PROTECTED %s [%s] — a prior dismissal exists but this category never demotes: %s\n' \
          "$l_pat" "$l_cat" "$l_note"
        protected=$((protected + 1))
        continue
      fi
      printf 'DEMOTE %s [%s] — dismissed previously: %s\n' "$l_pat" "$l_cat" "$l_note"
      hits=$((hits + 1))
    done < "$LEDGER"
    [ "$hits" -gt 0 ] && exit 0
    exit 1
    ;;
esac
