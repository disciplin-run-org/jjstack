#!/usr/bin/env bash
# jjstack-review-ledger — the MIDDLE rung of the review memory ladder.
#
# Three stores remember what the team decided about a finding, and they are NOT
# three copies of one idea. They are an escalation ladder, and the rung is set
# by how narrow the key is:
#
#   -calibration     key = a global PATTERN CLASS   -> may only RANK
#   this file        key = path glob + category     -> may DEMOTE
#   -baseline        key = one finding INSTANCE     -> may SUPPRESS
#
# The narrower the key, the stronger the verdict. Flatten that and a global
# heuristic can silently suppress a specific P0 — which is exactly what the
# ladder exists to prevent. The cap is enforced structurally here, from
# bin/jjstack-review-vocab.tsv, not by anyone remembering the rule: a row in
# this store that claims `suppress` is rejected with exit 4.
#
# Why a per-repo memory at all: every AI reviewer that people keep using
# eventually grows one. Greptile markets "learns from your team's feedback",
# CodeRabbit has learnings, gstack already carries a suppression history for
# Greptile's own comments (~/.claude/skills/gstack/review/greptile-triage.md).
# The mechanic is real — re-reporting a finding the team already dismissed is
# the purest form of alert fatigue. The vendor implementations are opaque: the
# memory lives on their server, you cannot read it, diff it, or review a change
# to it.
#
# This is the same mechanic with the opacity removed. The store is a plain TSV
# inside the repo, so it is version controlled, reviewable in a PR, and
# greppable. TSV rather than markdown because the review value of this file IS
# its diff: one decision is one line, retiring one is a one-line deletion, and a
# script can parse it without a markdown reader. And it deliberately does NOT do
# what the vendors do: a match here DEMOTES a finding into the report's
# "Demoted (prior decision)" section with the prior decision cited. It never
# drops one, and it never hides one. jjstack /review is tuned
# for recall; silently suppressing a whole class because someone once waved it
# off is exactly the failure this stack exists to avoid. Only `dismissed`
# entries demote — `fixed` and `confirmed` entries are history, not suppression.
#
# DEMOTION IS IDEMPOTENT AND TERMINAL. Two independent mechanisms can demote the
# same finding — this store (path + category) and the calibration store's
# negative rank (global pattern class). A finding matched by both is demoted
# ONCE: still active, still printed, still carrying its own severity and
# confidence. Demotions never stack, never compound, and can never add up to a
# suppression. `--match` prints `effect=demote` on every hit precisely so that
# nothing downstream can read two hits as something stronger than one.
#
# Store format — 8 tab-separated columns under a store header:
#   #jjstack-review-store<TAB>scope=path-glob<TAB>max-effect=demote<TAB>v=1
#   ts  repo  type  effect  code  path-glob  category  note
#     type    dismissed | fixed | confirmed
#     effect  `demote` for dismissed, `none` for fixed/confirmed. Never
#             `suppress` — the scope cap rejects it.
#     code    `-` for fixed/confirmed; a reason code from the shared vocabulary
#             for dismissed (a dismissal is a decision, and a decision is explained)
#
# Usage:
#   jjstack-review-ledger --record --type TYPE --path PATTERN --category CAT
#                         [--code CODE] [--note TEXT] [--ledger FILE] [--repo DIR]
#   jjstack-review-ledger --match --path FILE --category CAT
#                         [--ledger FILE] [--repo DIR]
#   jjstack-review-ledger --list [--ledger FILE] [--repo DIR]
#   jjstack-review-ledger --validate [--ledger FILE] [--repo DIR]
#
#   TYPE  = dismissed | fixed | confirmed
#   CAT   = correctness | security | concurrency | error-handling | resource-leak
#           | test-coverage | performance | api-contract | style | type-safety
#           | dependency | other
#   PATTERN is a shell glob matched against the finding's repo-relative path.
#           It must name a PLACE. Breadth is judged on what the glob actually
#           matches, not on how it is spelled: the pattern is run against a
#           fixed corpus of unrelated probe paths, and a pattern that reaches
#           across three or more unrelated top-level names is rejected as a
#           blanket. Spelling-based rules do not survive contact — stripping
#           `*?/` and rejecting the empty remainder catches `*` and `*/*` and
#           waves through `*[a-z]*`, `[a-z]*`, `*.*`, `[!q]*` and every other
#           spelling nobody happened to list. The same test is applied to
#           patterns READ from the ledger, because the ledger is meant to be
#           hand-edited in git and a merged blanket row is the same blanket.
#
#   NOTE    is stored in the printable alphabet, and that is defined by what is
#           ALLOWED, not by a list of characters to strip. A record is one
#           physical line, so any character outside the printable set (a
#           newline first of all, but equally a CR, a tab, an ESC) is escaped
#           into that alphabet using the standard `printf %b` sequences, which
#           makes the encoding reversible: the note round-trips byte for byte
#           and can never forge a field boundary or a second ledger row.
#
# Protected categories (security, correctness, concurrency, error-handling,
# resource-leak, test-coverage) are recorded but NEVER demote — --match prints
# PROTECTED and exits 1 for them. The path glob is still consulted first: a
# record only speaks about a finding whose path it actually matches.
#
# A --match against a ledger that does not exist warns and exits 1. That is not
# the same statement as "no prior decision applies", and it is never reported as
# if it were.
#
# The `<repo>` column names the repo the LEDGER belongs to, which is what makes
# a ledger readable after it is copied or merged between repos. With --ledger and
# no --repo it is resolved from the ledger's own location, never from the cwd.
#
# Default store: <repo-root>/jjstack/review-memory/ledger.tsv
#
# Exit: 0 recorded / listed / validated / a demotion matched, 1 --match found
#       nothing or found no store, 2 usage error — an invalid type, category or
#       code, a flag given with no value, or an unscoped path glob — 3 repo root
#       unresolvable or a legacy store needs migrating, 4 a store row violates
#       the ladder.
#
# No color red anywhere — unreadable on the target terminal.
set -uo pipefail

YEL="\033[33m"; CYA="\033[96m"; GRN="\033[32m"; RST="\033[0m"

# Help is DERIVED from the leading comment block, never a hand-maintained
# `sed -n 'A,Bp'` range. A range silently drifts the moment a line is added,
# which is how sibling scripts came to truncate their help mid-sentence or spill
# `set -uo pipefail` and the raw colour definitions into it.
show_help() {
  awk 'NR == 1 && /^#!/ { next }
       /^#/                { sub(/^# ?/, ""); print; next }
       { exit }' "$0"
}

# A flag given with no value used to hang this script for ever: `shift 2` is a
# no-op when only one argument remains, `set -e` is off so the failure is
# swallowed, and the loop re-reads the same $1 on the next pass. An unattended
# /review step that spins instead of failing is worse than a crash — nothing
# reports, nothing times out, and the caller waits on it. The guard is
# `review_need_value`, sourced from jjstack-review-vocab.sh below: the bug was
# identical in every script in this family, so the fix lives in one place too.

HERE="${BASH_SOURCE[0]%/*}"
# shellcheck source=/dev/null
. "$HERE/jjstack-review-vocab.sh" || exit 3
vocab_load || exit 3

TAB=$'\t'
SCOPE="path-glob"
STORE_HEADER="#jjstack-review-store	scope=path-glob	max-effect=demote	v=1"
COL_HEADER="#ts	repo	type	effect	code	path-glob	category	note"

VALID_TYPES="dismissed fixed confirmed"
VALID_CATS="correctness security concurrency error-handling resource-leak test-coverage performance api-contract style type-safety dependency other"

# Greptile's suppression engine exempts a fixed list of classes from ever being
# silenced by repeated ignores — security vulnerabilities, memory leaks,
# infinite loops, null-pointer exceptions and missing input validation
# (greptile.com/docs/how-greptile-works/nitpicks). That guard is the right idea
# and it is the one part of a learning loop you cannot leave to judgment: the
# categories that most deserve suppression pressure are exactly the ones where
# a wrong suppression is a shipped incident. A dismissal in one of these is
# still RECORDED — the history stays honest — it just never demotes.
PROTECTED_CATS="security correctness concurrency error-handling resource-leak test-coverage"

MODE=""; TYPE=""; PATH_ARG=""; CATEGORY=""; CODE="-"; NOTE=""; LEDGER=""; REPO=""

# The header IS the help. A hand-kept `sed -n 'A,Bp'` range drifts the instant a
# line is added above it — it truncated three sibling tools mid-sentence and
# leaked `set -uo pipefail` into their output — so read comment lines until the
# first non-comment line instead.
show_help() {
  awk 'NR == 1 && /^#!/ { next }
       /^#/                { sub(/^# ?/, ""); print; next }
       { exit }' "$0"
}

# ---------------------------------------------------------------------------
# Breadth: judged on what a glob MATCHES, never on how it is spelled.
#
# The first guard stripped `*`, `?` and `/` and rejected whatever came out
# empty. That is a rule shaped exactly like the two spellings its fixture
# contained: `*[a-z]*`, `[a-z]*`, `*.*` and `[!q]*` all walked through it and
# all demote effectively every path in the repo. Adding those four to the strip
# set only moves the hole one spelling further along.
#
# So breadth is measured instead. These probes are deliberately unrelated —
# eight top-level directories that share nothing, plus three root files — and a
# pattern that reaches across THREE OR MORE of those top-level names is not
# naming a place, whatever it is written with. `src/legacy/*`, `docs/*`,
# `tests/**` and `bin/jjstack-review-*` each reach one or none.
BREADTH_PROBES="src/payments.py lib/util.go docs/guide.md tests/test_api.rb
.github/workflows/ci.yml vendor/thirdparty/lib.c deep/nested/tree/Widget.java
Makefile README.md go.mod"
BREADTH_LIMIT=3

# true when the glob reaches across BREADTH_LIMIT or more unrelated top levels.
too_broad() {
  local pat="$1" p top seen=" " n=0
  for p in $BREADTH_PROBES; do
    # shellcheck disable=SC2254  # the glob is the point
    case "$p" in
      $pat) top="${p%%/*}"
            case "$seen" in
              *" $top "*) ;;
              *) seen="$seen$top "; n=$((n + 1)) ;;
            esac ;;
    esac
  done
  [ "$n" -ge "$BREADTH_LIMIT" ]
}

# ---------------------------------------------------------------------------
# The note's alphabet, defined by what is ALLOWED.
#
# A record is ONE physical line. The round-1 fix taught the reader to rejoin
# fields 6..NF so a `|` in a note survives — a blacklist of one character, and
# a newline went straight through it: the note became a second physical line,
# --match dropped it for not having the date shape, and if that line happened to
# look like a record the note had forged a whole ledger row (verified: a note
# could plant a `security` dismissal against `src/*`).
#
# The rule is therefore positive. A note is stored in the PRINTABLE alphabet;
# every character outside it is escaped into that alphabet using the standard
# `printf %b` sequences, so the mapping is reversible and a control character
# nobody has thought of is covered by the same sentence as the one that was
# reported. Backslash is escaped first, which is what makes decoding exact.
encode_note() {
  local s="$1" out="" c i n=${#1} code
  for (( i = 0; i < n; i++ )); do
    c="${s:i:1}"
    if [ "$c" = '\' ]; then out="$out\\\\"; continue; fi
    if [[ $c == [[:print:]] ]]; then out="$out$c"; continue; fi   # ALLOWED
    case "$c" in
      $'\n') out="$out\\n" ;;
      $'\r') out="$out\\r" ;;
      $'\t') out="$out\\t" ;;
      *) printf -v code '%d' "'$c" 2>/dev/null || code=0
         code=$(( code & 255 ))
         out="$out$(printf '\\0%03o' "$code")" ;;
    esac
  done
  printf '%s' "$out"
}

set_mode() {
  if [ -n "$MODE" ]; then
    echo -e "${CYA}error${RST} pick one mode: --record, --match, --list or --validate" >&2; exit 2
  fi
  MODE="$1"
}

while [ $# -gt 0 ]; do
  case "$1" in
    --record)   set_mode record; shift ;;
    --match)    set_mode match;  shift ;;
    --list)     set_mode list;   shift ;;
    --validate) set_mode validate; shift ;;
    --type)     review_need_value "$1" $# || exit 2; TYPE="$2";     shift 2 ;;
    --path)     review_need_value "$1" $# || exit 2; PATH_ARG="$2"; shift 2 ;;
    --category) review_need_value "$1" $# || exit 2; CATEGORY="$2"; shift 2 ;;
    --code)     review_need_value "$1" $# || exit 2; CODE="$2";     shift 2 ;;
    --note)     review_need_value "$1" $# || exit 2; NOTE="$2";     shift 2 ;;
    --ledger)   review_need_value "$1" $# || exit 2; LEDGER="$2";   shift 2 ;;
    --repo)     review_need_value "$1" $# || exit 2; REPO="$2";     shift 2 ;;
    -h|--help)
      show_help
      exit 0 ;;
    -*) echo -e "${CYA}error${RST} unknown flag: $1" >&2; exit 2 ;;
    *)  echo -e "${CYA}error${RST} unexpected arg: $1" >&2; exit 2 ;;
  esac
done

[ -z "$MODE" ] && { echo -e "${CYA}error${RST} one of --record, --match, --list, --validate is required" >&2; exit 2; }

in_set() {
  for v in $2; do [ "$1" = "$v" ] && return 0; done
  return 1
}

# A row is eight tab-separated fields on one line, and free text arrives from a
# human at the command line. Left unsanitized, a value carrying a newline plus
# tabs does not corrupt its own row — it FORGES AN ENTIRE ADDITIONAL ONE, which
# then validates clean and can claim a `*` glob. A per-file dismissal silently
# becomes a repo-wide demotion: the widest escalation this store can express,
# reached from the narrowest-looking command.
#
# --note goes through encode_note() instead, which is the stronger form of the
# same rule: the note is stored in the printable alphabet and everything outside
# it is escaped REVERSIBLY, so the note cannot leave its row AND still decodes
# back to exactly what the reviewer typed. Every other free-text field takes the
# lossy form, since none of them is quoted back to a human verbatim.
tsv_clean() {
  printf '%s' "${1:-}" | tr '\t\n\r' '   ' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'
}

# Sanitize before validating, not after writing: --path is also the glob --match
# compares against, so both modes must see the same value, and an all-whitespace
# path must fail the required-field check below rather than land as an empty
# column that matches nothing.
PATH_ARG="$(tsv_clean "$PATH_ARG")"

# Validate BEFORE touching the store: a typo'd category silently written is a
# suppression that can never match, and a typo'd category silently matched is a
# suppression that fires on the wrong class.
if [ "$MODE" = "record" ] || [ "$MODE" = "match" ]; then
  [ -n "$PATH_ARG" ] || { echo -e "${CYA}error${RST} --path is required for --$MODE" >&2; exit 2; }
  [ -n "$CATEGORY" ] || { echo -e "${CYA}error${RST} --category is required for --$MODE" >&2; exit 2; }
  if ! in_set "$CATEGORY" "$VALID_CATS"; then
    echo -e "${CYA}error${RST} unknown category '$CATEGORY'" >&2
    echo -e "${YEL}valid${RST} $VALID_CATS" >&2
    exit 2
  fi
fi
if [ "$MODE" = "record" ]; then
  [ -n "$TYPE" ] || { echo -e "${CYA}error${RST} --type is required for --record" >&2; exit 2; }
  if ! in_set "$TYPE" "$VALID_TYPES"; then
    echo -e "${CYA}error${RST} unknown type '$TYPE'" >&2
    echo -e "${YEL}valid${RST} $VALID_TYPES" >&2
    exit 2
  fi
  # The category and the path glob are the two halves of the key, and only one
  # of them was checked. `--path '*'` records a dismissal that then demotes
  # every finding in that category, repo-wide and permanently — the demoted
  # section becomes the whole report, and the ledger line reads like any other
  # in a PR diff. Breadth is decided by too_broad(), on what the glob MATCHES:
  # a spelling test can only ever reject the spellings someone listed.
  if too_broad "$PATH_ARG"; then
    echo -e "${CYA}error${RST} --path '$PATH_ARG' reaches across unrelated parts of the repo" >&2
    echo -e "${YEL}why${RST}   it matches paths under $BREADTH_LIMIT or more unrelated top-level" >&2
    echo -e "${YEL}why${RST}   names, so it is a blanket, not a decision about a place in the" >&2
    echo -e "${YEL}why${RST}   code. Scope it: 'src/legacy/*', 'docs/*', 'tests/**'." >&2
    exit 2
  fi
  # Only a dismissal acts on a future finding, so only a dismissal carries an
  # effect and a reason code. History rows have effect `none`.
  if [ "$TYPE" = "dismissed" ]; then
    EFFECT="demote"
    if [ "$CODE" = "-" ]; then CODE="prior-decision"; fi
  else
    EFFECT="none"
    CODE="-"
  fi
  if [ "$CODE" != "-" ] && ! vocab_is_reason "$CODE"; then
    echo -e "${CYA}error${RST} unknown reason code '$CODE' (see bin/jjstack-review-vocab.tsv)" >&2
    echo -e "${YEL}valid${RST} $VOCAB_REASONS" >&2
    exit 2
  fi
  # The structural cap. This scope may emit at most `demote`; a `suppress` dies
  # here, before it can ever be written to the store.
  if ! vocab_check "$SCOPE" "$CODE" "$EFFECT"; then
    exit 4
  fi
fi

if [ -z "$LEDGER" ]; then
  [ -z "$REPO" ] && REPO="$(git rev-parse --show-toplevel 2>/dev/null)"
  if [ -z "$REPO" ] || [ ! -d "$REPO" ]; then
    echo -e "${YEL}warn${RST}  no repo root: pass --ledger or --repo, or run inside a git repo" >&2
    exit 3
  fi
  LEDGER="${REPO%/}/jjstack/review-memory/ledger.tsv"
  LEGACY="${REPO%/}/jjstack/review-ledger.md"
  # Migrate-vs-instruct: INSTRUCT. These stores are version controlled and their
  # whole point is that a change is a reviewed diff — a tool that silently
  # rewrote one mid-review would produce a diff nobody approved.
  if [ ! -f "$LEDGER" ] && [ -f "$LEGACY" ]; then
    echo -e "${YEL}warn${RST}  legacy markdown ledger found: $LEGACY" >&2
    echo -e "${YEL}warn${RST}  the three review memory stores now live together in" >&2
    echo -e "${YEL}warn${RST}  jjstack/review-memory/ as TSV. Migrate it, then commit the diff:" >&2
    echo -e "${YEL}warn${RST}    jjstack-review-memory-migrate --repo '${REPO%/}'" >&2
    exit 3
  fi
fi

# Repo slug for the record, so a store stays readable if it is ever merged or
# copied between repos. That is the whole point of the column, which is why it
# must describe the LEDGER's repo. It used to run git in the CWD: recording into
# project A's ledger from a shell sitting in project B stamped every row with B,
# and the one field that exists to survive a copy became the field that lies
# about it. An explicit --repo still wins — that is the caller saying which repo
# this is — but otherwise the ledger's own location decides.
slug() {
  local ctx url top
  ctx="${REPO:-$(dirname "$LEDGER")}"
  url="$(git -C "$ctx" remote get-url origin 2>/dev/null)"
  if [ -n "$url" ]; then
    url="${url%.git}"; url="${url##*:}"
    printf '%s\n' "$url" | awk -F/ '{ if (NF >= 2) print $(NF-1) "/" $NF; else print $NF }'
    return
  fi
  top="$(git -C "$ctx" rev-parse --show-toplevel 2>/dev/null)"
  basename "${top:-$ctx}"
}

# --- validate the store's ladder compliance ----------------------------------
# Runs before every read AND before every write. A hand-edited row claiming a
# stronger effect than this scope allows is the exact failure the ladder exists
# to stop, so it is caught by arithmetic on the shared vocabulary, not by trust.
validate_store() {
  local f="$1" line n=0 hdr_scope f_type f_effect f_code
  [ -f "$f" ] || return 0
  hdr_scope="$(head -n 1 "$f" | awk -F'\t' '$1 == "#jjstack-review-store" { for (i = 2; i <= NF; i++) if ($i ~ /^scope=/) { sub(/^scope=/, "", $i); print $i } }')"
  if [ -z "$hdr_scope" ]; then
    echo -e "${CYA}error${RST} $f has no #jjstack-review-store header — is it a legacy store?" >&2
    echo -e "${YEL}fix${RST}   jjstack-review-memory-migrate --repo <dir>" >&2
    return 4
  fi
  if [ "$hdr_scope" != "$SCOPE" ]; then
    echo -e "${CYA}error${RST} $f declares scope '$hdr_scope' but this tool owns scope '$SCOPE'." >&2
    echo -e "${YEL}why${RST}   the three stores are rungs of a ladder, not interchangeable files." >&2
    return 4
  fi
  # `|| [ -n "$line" ]` catches a final line with NO trailing newline. Without it
  # `read` returns non-zero on that line and the loop drops it — so a store whose
  # LAST row violates the ladder validated clean, while grep and awk, which every
  # other consumer of this file uses, saw the row perfectly well. A validator
  # that reads less of the file than its consumers certifies what it never read.
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1))
    case "$line" in ''|'#'*) continue ;; esac
    f_type="$(printf '%s' "$line" | cut -f3)"
    f_effect="$(printf '%s' "$line" | cut -f4)"
    f_code="$(printf '%s' "$line" | cut -f5)"
    if ! in_set "$f_type" "$VALID_TYPES"; then
      echo -e "${CYA}error${RST} $f:$n unknown type '$f_type'" >&2; return 4
    fi
    if ! vocab_check "$SCOPE" "$f_code" "$f_effect" 2>/dev/null; then
      echo -e "${CYA}error${RST} $f:$n effect '$f_effect' with code '$f_code' violates the ladder:" >&2
      vocab_check "$SCOPE" "$f_code" "$f_effect"
      return 4
    fi
    if [ "$f_type" = "dismissed" ] && [ "$f_code" = "-" ]; then
      echo -e "${CYA}error${RST} $f:$n a dismissal carries no reason code — a decision is explained, never silent" >&2
      return 4
    fi
  done < "$f"
  return 0
}

case "$MODE" in
  record)
    mkdir -p "$(dirname "$LEDGER")" || exit 3
    if [ ! -f "$LEDGER" ]; then
      printf '%s\n%s\n' "$STORE_HEADER" "$COL_HEADER" > "$LEDGER" || exit 3
    fi
    validate_store "$LEDGER" || exit 4
    # The slug is derived from a git remote URL, which is also outside this
    # tool's control, so it goes through the same filter as the free text.
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$(date +%F)" "$(tsv_clean "$(slug)")" "$TYPE" "$EFFECT" "$CODE" \
      "$PATH_ARG" "$CATEGORY" "$(encode_note "${NOTE:-(no note)}")" >> "$LEDGER"
    echo -e "${GRN}recorded${RST} $TYPE $PATH_ARG [$CATEGORY] effect=$EFFECT → $LEDGER"
    if [ "$TYPE" = "dismissed" ] && in_set "$CATEGORY" "$PROTECTED_CATS"; then
      echo -e "${YEL}note${RST}  '$CATEGORY' is a protected category — this record is kept as" >&2
      echo -e "${YEL}note${RST}  history but will NEVER demote a future finding." >&2
    fi
    exit 0
    ;;

  list)
    if [ ! -f "$LEDGER" ]; then
      echo -e "${YEL}warn${RST}  no ledger yet: $LEDGER" >&2
      exit 0
    fi
    validate_store "$LEDGER" || exit 4
    grep -E '^[0-9]{4}-[0-9]{2}-[0-9]{2}	' "$LEDGER" || true
    exit 0
    ;;

  validate)
    if [ ! -f "$LEDGER" ]; then
      echo -e "${YEL}warn${RST}  no ledger yet: $LEDGER" >&2
      exit 0
    fi
    validate_store "$LEDGER" || exit 4
    echo -e "${GRN}ok${RST}  $LEDGER is a valid scope=$SCOPE store (max-effect=$(vocab_scope_max "$SCOPE"))"
    exit 0
    ;;

  match)
    # A missing store used to exit 1 in silence, which is indistinguishable
    # from "I read the store and no prior decision applies". A mistyped
    # --ledger path therefore reported an authoritative all-clear for the whole
    # review. --list already warns on exactly this condition; so does match now.
    if [ ! -f "$LEDGER" ]; then
      echo -e "${YEL}warn${RST}  no ledger at $LEDGER — no prior decisions were consulted" >&2
      echo -e "${YEL}warn${RST}  (this is NOT 'no prior decision applies'; check --ledger/--repo)" >&2
      exit 1
    fi
    validate_store "$LEDGER" || exit 4
    hits=0; protected=0
    # Same reason as validate_store: the matcher must see every row the
    # validator does, or the two disagree about what the store says.
    while IFS= read -r line || [ -n "$line" ]; do
      case "$line" in
        [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]"$TAB"*) ;;
        *) continue ;;
      esac
      # ts | repo | type | effect | code | path-glob | category | note
      l_type=$(printf  '%s' "$line" | cut -f3)
      l_eff=$(printf   '%s' "$line" | cut -f4)
      l_pat=$(printf   '%s' "$line" | cut -f6)
      l_cat=$(printf   '%s' "$line" | cut -f7)
      l_note=$(printf  '%s' "$line" | cut -f8)
      [ "$l_type" = "dismissed" ] || continue
      [ "$l_cat" = "$CATEGORY" ]  || continue
      # The breadth rule lives on BOTH sides of the file. --record is only half
      # the door: this ledger is designed to be hand-edited and merged in git,
      # so a blanket row can arrive without ever passing through --record. One
      # `*` row demoting the whole repo reads, in a PR diff, exactly like a
      # scoped decision. Refuse to act on it and say so — the row stays in the
      # file as history, it just never suppresses anything.
      if too_broad "$l_pat"; then
        echo -e "${YEL}warn${RST}  ignoring ledger row: pattern '$l_pat' is too broad" >&2
        echo -e "${YEL}warn${RST}  (it reaches across $BREADTH_LIMIT+ unrelated top-level names; scope it or delete it)" >&2
        continue
      fi
      # The path glob is part of the key, so it must be consulted BEFORE any
      # announcement is made about this record. It used to be tested only after
      # the PROTECTED branch had already printed and `continue`d, so a
      # dismissal recorded against `docs/*` announced itself on a security
      # finding in `src/payments.py`. The skill then tells the reviewer to cite
      # that prior dismissal in the finding body — a fabricated precedent
      # nudging the author to re-dismiss a live P0.
      # shellcheck disable=SC2254  # the glob is the point
      case "$PATH_ARG" in
        $l_pat) ;;
        *) continue ;;
      esac
      if in_set "$l_cat" "$PROTECTED_CATS"; then
        printf 'PROTECTED %s [%s] — a prior dismissal exists but this category never demotes: %s\n' \
          "$l_pat" "$l_cat" "$l_note"
        protected=$((protected + 1))
        continue
      fi
      # `effect=demote` on every hit, deliberately. Demotion is idempotent and
      # terminal: two hits here, or a hit here plus a negative calibration rank,
      # are ONE demotion. Nothing downstream may read repetition as escalation.
      printf 'DEMOTE effect=%s %s [%s] — dismissed previously: %s\n' "$l_eff" "$l_pat" "$l_cat" "$l_note"
      hits=$((hits + 1))
    done < "$LEDGER"
    [ "$hits" -gt 0 ] && exit 0
    exit 1
    ;;
esac
