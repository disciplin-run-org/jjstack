#!/usr/bin/env python3
"""jjstack-review-baseline — accept known /review findings without losing them.

A recall-max reviewer re-run on the same repo re-reports everything it reported
last time. The naive fix is to delete the ones you already looked at, which
destroys the audit trail and hides the day one of them changes meaning. The
right fix — NVIDIA SkillSpector's — is a COMMITTED baseline: accepted findings
stay in the output, marked suppressed with a mandatory reason, and simply stop
counting as active. Re-reviews then surface only what is NEW.

Two complementary mechanisms, deliberately different in how they age:

  rules         human-authored, glob-based, DRIFT-TOLERANT. Keyed on any of
                id (the lens), path (the file), message (claim or quoted line);
                every field a rule states must match, unstated fields match
                anything. Survives line shifts and rewording — which is the
                danger: a broad rule can hide newly malicious content. Reserve
                them for deliberate, tightly-scoped policy exclusions.
  fingerprints  machine-generated SHA-256 over the finding's content,
                deliberately BRITTLE. Editing the flagged source changes the
                quote, changes the hash, and the finding comes back for review.
                This is the right default for individually accepted findings.

Fail-closed choices, all of them in the direction of showing more:
  * a mandatory non-empty `reason` on every entry — an unexplained suppression
    is indistinguishable from a bug;
  * a rule that names no matching field at all (reason only) is REJECTED
    rather than silently matching every finding — and so is one whose pattern
    is too BROAD to discriminate. Breadth is measured, never spelled: the
    pattern is compiled and run over the repository's own tracked files
    (`git ls-files`), and a rule reaching 90% or more of them is refused.
    `{"path": "*"}` is caught by that, and so are `[!@]*`, `[a-z]*` and every
    disguise nobody has written down yet, because none of them leave the
    reviewer anything to see. Override the corpus with --corpus FILE or
    $JJSTACK_REVIEW_CORPUS (one path per line) when the tool runs outside the
    checkout it is judging; with no corpus at all the guard falls back to
    refusing a pattern that pins no character anywhere;
  * `generate` EXTENDS an existing baseline: human-written rules and already
    accepted fingerprints are merged forward, never rewritten away. Pass
    --replace to deliberately start over;
  * a baseline written by a different jjstack version makes fingerprints inert
    (they cannot be trusted to still mean what they meant); rules still apply.
    Override with --allow-version-drift once you have re-read them;
  * suppressed findings are still printed, annotated, by default. Pass
    --active-only for the "just the new stuff" view.

Fingerprint inputs are lens + file + severity + message + quote — deliberately
NOT start_line, so an unrelated edit ABOVE the finding does not reactivate it,
while editing the finding's own line does.

Usage:
  jjstack-review-baseline generate <findings.jsonl|-> --reason TEXT [-o FILE]
                                   [--replace] [--corpus FILE]
  jjstack-review-baseline apply <findings.jsonl|-> --baseline FILE
                                [--active-only] [--allow-version-drift]
                                [--corpus FILE]

`apply` writes annotated JSON Lines to stdout (each finding gains a
`suppressed` field: null, or {by, reason, matched}) and a count summary to
stderr.

Exit: 0 ok, 1 (apply) at least one ACTIVE finding remains, 2 usage error or a
      missing / malformed / unsupported baseline.

No color red anywhere — unreadable on the target terminal.
"""

import fnmatch
import hashlib
import json
import os
import subprocess
import sys

YEL = "\033[33m"
CYA = "\033[96m"
GRN = "\033[32m"
RST = "\033[0m"

BASELINE_VERSION = 2
DEFAULT_BASELINE = ".jjstack-review-baseline.json"
HASH_FIELDS = ("lens", "file", "severity", "message", "quote")


def err(msg):
    print(f"{CYA}error{RST} {msg}", file=sys.stderr)


def warn(msg):
    print(f"{YEL}warn{RST}  {msg}", file=sys.stderr)


def jjstack_version():
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "VERSION")
    try:
        with open(path, encoding="utf-8") as fh:
            return fh.read().strip()
    except OSError:
        return "unknown"


# The alias GROUPS `rule_matches` resolves, in the order it resolves them: the
# first truthy alias in a group wins and the rest are ignored. Guard and matcher
# must read a rule through the SAME resolution or they drift apart — checking
# the five keys independently let `{"id": "*", "rule_id": "security"}` look
# scoped while `*` was the pattern actually applied, muting the whole repo at a
# clean exit. One helper, used by both, is the only way that cannot recur.
RULE_MATCH_GROUPS = (("id", "rule_id"), ("path", "file"), ("message",))
RULE_MATCH_KEYS = tuple(k for group in RULE_MATCH_GROUPS for k in group)


def resolve_rule_pattern(rule, group):
    """Return (winning_key, pattern) exactly as `rule_matches` reads the group.

    Mirrors `rule.get(a) or rule.get(b) or ""` then `.strip()` — including the
    case where a whitespace-only value wins and strips to nothing, which leaves
    the whole group UNSTATED for matching and must therefore read as unstated
    to the guard too.
    """
    for key in group:
        if rule.get(key):
            return key, str(rule.get(key)).strip()
    return None, ""


def stated_patterns(rule):
    """{winning_key: pattern} for every group the rule actually constrains."""
    out = {}
    for group in RULE_MATCH_GROUPS:
        key, pattern = resolve_rule_pattern(rule, group)
        if pattern:
            out[key] = pattern
    return out


# A rule may not be the review's off switch. Breadth is a MEASURED property, not
# a spelling: a pattern that leaves less than a tenth of the repository still
# visible to the reviewer discriminates nothing, whatever characters it is
# written with. 0.90 is the line; the corpus it is measured against is the real
# repository (see repo_corpus).
BREADTH_LIMIT = 0.90
PATH_KEYS = frozenset({"path", "file"})

_CORPUS_CACHE = {}


def glob_tokens(pattern):
    """Split an fnmatch pattern into its real tokens, bracket syntax included.

    Yields ("any_seq", "*") / ("any_char", "?") / ("char_class", "[...]") /
    ("literal", c). Follows fnmatch's own reading of `[`: a `!` right after it
    negates, a `]` in first position is a member, and an unterminated `[` is a
    literal bracket.
    """
    out, i, n = [], 0, len(pattern)
    while i < n:
        c = pattern[i]
        if c == "*":
            out.append(("any_seq", c))
            i += 1
        elif c == "?":
            out.append(("any_char", c))
            i += 1
        elif c == "[":
            j = i + 1
            if j < n and pattern[j] == "!":
                j += 1
            if j < n and pattern[j] == "]":
                j += 1
            while j < n and pattern[j] != "]":
                j += 1
            if j >= n:
                out.append(("literal", c))  # unterminated: a plain bracket
                i += 1
            else:
                out.append(("char_class", pattern[i : j + 1]))
                i = j + 1
        else:
            out.append(("literal", c))
            i += 1
    return out


def pins_no_character(pattern):
    """True when the pattern constrains NO position to a specific character.

    The fallback used only when there is no corpus to measure against, and
    fail-closed on purpose: `*`, `?*`, `[!@]*`, `[a-z]*` and every spelling
    nobody has thought of yet all share the property that the human named no
    character the finding must actually contain. A single literal — `b*`,
    `*.md`, `docs` — is enough to make the rule a statement about something.
    """
    return not any(kind == "literal" for kind, _ in glob_tokens(pattern))


def pattern_reach(pattern, corpus):
    """Fraction of the corpus this pattern matches, or None with no corpus."""
    if not corpus:
        return None
    hits = sum(1 for c in corpus if fnmatch.fnmatchcase(c, pattern))
    return hits / len(corpus)


def repo_corpus(explicit=None):
    """The universe a path rule's breadth is measured against.

    Source of truth, in order: an explicit --corpus file, $JJSTACK_REVIEW_CORPUS,
    then `git ls-files` in the repository being reviewed — the actual files a
    rule can hide. Nothing here is a list of paths this tool invented: a probe
    list of made-up paths measures the guard against the guard's own author,
    which is how a "semantic" breadth test becomes true by construction.

    Returns () when no corpus can be derived (not a checkout, no git); the
    caller then falls back to pins_no_character.
    """
    key = explicit or os.environ.get("JJSTACK_REVIEW_CORPUS") or ""
    if key in _CORPUS_CACHE:
        return _CORPUS_CACHE[key]
    paths = ()
    if key:
        try:
            with open(key, encoding="utf-8") as fh:
                paths = tuple(p for p in fh.read().splitlines() if p.strip())
        except OSError as exc:
            err(f"cannot read corpus {key}: {exc}")
            return None
    else:
        try:
            proc = subprocess.run(
                ["git", "ls-files"],
                capture_output=True,
                text=True,
                timeout=30,
            )
            if proc.returncode == 0:
                paths = tuple(p for p in proc.stdout.splitlines() if p.strip())
        except (OSError, subprocess.SubprocessError):
            paths = ()
    _CORPUS_CACHE[key] = paths
    return paths


def is_universal_glob(pattern, corpus=()):
    """True when a rule's pattern says nothing — DECIDED BY REACH, not spelling.

    Round 1 rejected `*`. Round 2 resolved alias pairs so a `*` could not hide
    behind a scoped sibling. Both still asked what the pattern was SPELLED with,
    so `[!@]*`, `[a-z]*` and `[a-zA-Z0-9_.-]*` walked through a guard whose whole
    purpose was to stop a rule muting the repo — and the next spelling would
    have walked through too. Adding those three to a refusal list closes three
    strings; measuring reach closes the class.

    So: compile the pattern, run it over the real repository's tracked files,
    and reject it when it covers BREADTH_LIMIT or more of them. With no corpus
    (not a checkout), fall back to pins_no_character, which is still a property
    of the pattern's structure rather than a list of banned spellings.
    """
    p = pattern.strip()
    if p == "":
        return True
    reach = pattern_reach(p, corpus)
    if reach is not None:
        return reach >= BREADTH_LIMIT
    return pins_no_character(p)


def describe_breadth(key, pattern, corpus):
    """`path='[a-z]*' reaches 132/139 tracked files` — say WHY it was refused."""
    shown = f"{key}={pattern!r}"
    if key in PATH_KEYS and corpus:
        hits = sum(1 for c in corpus if fnmatch.fnmatchcase(c, pattern))
        shown += f" reaches {hits}/{len(corpus)} tracked files"
    return shown


def fingerprint(finding):
    """Deliberately brittle content hash. Editing the source reactivates it."""
    payload = {
        "v": BASELINE_VERSION,
        **{k: str(finding.get(k, "")) for k in HASH_FIELDS},
    }
    canonical = json.dumps(payload, sort_keys=True, separators=(",", ":"))
    return "sha256:" + hashlib.sha256(canonical.encode("utf-8")).hexdigest()


def read_findings(src):
    try:
        raw = sys.stdin.read() if src == "-" else open(src, encoding="utf-8").read()
    except OSError as exc:
        err(f"cannot read {src}: {exc}")
        return None
    out = []
    for lineno, line in enumerate(raw.splitlines(), 1):
        if not line.strip():
            continue
        try:
            obj = json.loads(line)
        except json.JSONDecodeError as exc:
            err(f"{src}:{lineno} not JSON: {exc}")
            return None
        if not isinstance(obj, dict):
            err(f"{src}:{lineno} finding is not a JSON object")
            return None
        out.append(obj)
    return out


def load_baseline(path, corpus=()):
    """Return (rules, fingerprints, scanner_version) or None after reporting.

    `corpus` is the repository's tracked paths — what a path rule's breadth is
    measured against. () means "unmeasurable here"; see is_universal_glob.
    """
    try:
        with open(path, encoding="utf-8") as fh:
            data = json.load(fh)
    except OSError as exc:
        err(f"baseline unreadable: {exc}")
        return None
    except json.JSONDecodeError as exc:
        err(f"baseline is not valid JSON: {exc}")
        return None

    if not isinstance(data, dict):
        err("baseline must be a JSON object")
        return None
    if data.get("version") != BASELINE_VERSION:
        err(
            f"unsupported baseline version {data.get('version')!r} "
            f"(this tool speaks version {BASELINE_VERSION})"
        )
        return None

    rules = data.get("rules") or []
    fps = data.get("fingerprints") or []
    if not isinstance(rules, list) or not isinstance(fps, list):
        err("baseline `rules` and `fingerprints` must be lists")
        return None

    for i, r in enumerate(rules):
        if not isinstance(r, dict):
            err(f"rules[{i}] is not an object")
            return None
        if not str(r.get("reason", "")).strip():
            err(f"rules[{i}] has no reason — every suppression must be explained")
            return None
        # Resolved, not per-key: a `*` that WINS its alias group is the
        # pattern this rule will really apply, whatever its losing sibling says.
        named = stated_patterns(r)
        if not named:
            err(
                f"rules[{i}] names none of id/path/message — a rule that matches "
                "every finding is never what you meant"
            )
            return None
        if all(
            is_universal_glob(v, corpus if k in PATH_KEYS else ())
            for k, v in named.items()
        ):
            shown = ", ".join(
                describe_breadth(k, v, corpus) for k, v in sorted(named.items())
            )
            ignored = sorted((set(RULE_MATCH_KEYS) & set(r)) - set(named))
            extra = (
                f". {', '.join(ignored)} never applies: the alias shown wins"
                if ignored
                else ""
            )
            err(
                f"rules[{i}] states only universal glob(s) ({shown}) — a rule "
                f"that discriminates nothing is never what you meant{extra}"
            )
            return None

    seen = set()
    for i, f in enumerate(fps):
        if not isinstance(f, dict):
            err(f"fingerprints[{i}] is not an object")
            return None
        h = str(f.get("hash", ""))
        if not h.startswith("sha256:") or len(h) != len("sha256:") + 64:
            err(f"fingerprints[{i}] hash is not a sha256:<64 hex> digest: {h!r}")
            return None
        try:
            int(h[7:], 16)
        except ValueError:
            err(f"fingerprints[{i}] hash is not hexadecimal: {h!r}")
            return None
        if not str(f.get("reason", "")).strip():
            err(f"fingerprints[{i}] has no reason — every suppression must be explained")
            return None
        if h in seen:
            err(f"fingerprints[{i}] duplicates an earlier hash: {h}")
            return None
        seen.add(h)

    return rules, fps, str(data.get("jjstack_version", "unknown"))


def rule_matches(rule, finding):
    """Every field the rule states must match; unstated fields match anything.

    Reads the rule through `resolve_rule_pattern` — the same helper the load
    guard uses — so the pattern that is CHECKED is always the pattern that is
    APPLIED.
    """
    _, rid = resolve_rule_pattern(rule, ("id", "rule_id"))
    if rid and not fnmatch.fnmatchcase(str(finding.get("lens", "")), rid):
        return False
    _, path = resolve_rule_pattern(rule, ("path", "file"))
    if path and not fnmatch.fnmatchcase(str(finding.get("file", "")), path):
        return False
    _, msg = resolve_rule_pattern(rule, ("message",))
    if msg:
        pat = msg.lower()
        haystacks = (
            str(finding.get("message", "")).lower(),
            str(finding.get("quote", "")).lower(),
        )
        if not any(fnmatch.fnmatchcase(h, pat) for h in haystacks):
            return False
    return True


def cmd_generate(argv):
    src, out_path, reason = None, DEFAULT_BASELINE, None
    replace = False
    corpus_path = None
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--replace":
            replace = True
            i += 1
        elif a == "--corpus":
            if i + 1 >= len(argv):
                err("--corpus needs a FILE")
                return 2
            corpus_path = argv[i + 1]
            i += 2
        elif a == "--reason":
            if i + 1 >= len(argv):
                err("--reason needs TEXT")
                return 2
            reason = argv[i + 1]
            i += 2
        elif a in ("-o", "--output"):
            if i + 1 >= len(argv):
                err("-o needs a FILE")
                return 2
            out_path = argv[i + 1]
            i += 2
        elif a == "-" or not a.startswith("-"):
            if src is not None:
                err(f"unexpected arg: {a}")
                return 2
            src = a
            i += 1
        else:
            err(f"unknown flag: {a}")
            return 2

    if src is None:
        err(
            "usage: jjstack-review-baseline generate <findings.jsonl|-> "
            "--reason TEXT [-o FILE] [--replace] [--corpus FILE]"
        )
        return 2
    if reason is None or not reason.strip():
        err("--reason is mandatory — an unexplained suppression is indistinguishable from a bug")
        return 2

    # EXTEND, do not truncate. SKILL.md documents this command for "creating or
    # extending a baseline"; building the doc from scratch with `rules: []` and
    # opening "w" destroyed every human-written rule and previously accepted
    # fingerprint on the second run. Merging is the only reading of "extending"
    # that does not lose the reasons a human typed.
    corpus = repo_corpus(corpus_path)
    if corpus is None:
        return 2

    old_rules, old_fps, old_version = [], [], None
    if os.path.exists(out_path) and not replace:
        loaded = load_baseline(out_path, corpus)
        if loaded is None:
            err(
                f"refusing to overwrite {out_path}: the existing baseline did not "
                "load (see above). Fix it, or pass --replace to start fresh."
            )
            return 2
        old_rules, old_fps, old_version = loaded
        here = jjstack_version()
        if old_fps and old_version != here:
            warn(
                f"existing baseline was written by jjstack {old_version}, this is "
                f"{here} — merging re-stamps the version, which REACTIVATES those "
                f"{len(old_fps)} fingerprint(s) for `apply`. Re-read them."
            )

    findings = read_findings(src)
    if findings is None:
        return 2

    entries = list(old_fps)
    seen = {str(f.get("hash", "")) for f in old_fps}
    added = 0
    for f in findings:
        h = fingerprint(f)
        if h in seen:
            continue
        seen.add(h)
        entries.append(
            {
                "hash": h,
                "lens": f.get("lens", ""),
                "file": f.get("file", ""),
                "message": f.get("message", ""),
                "reason": reason,
            }
        )
        added += 1

    doc = {
        "version": BASELINE_VERSION,
        "jjstack_version": jjstack_version(),
        "rules": old_rules,
        "fingerprints": entries,
    }
    # Write-then-rename: a failure part-way through must not leave the caller
    # with a truncated baseline, which reads as "nothing was ever accepted".
    tmp_path = out_path + ".tmp"
    try:
        with open(tmp_path, "w", encoding="utf-8") as fh:
            json.dump(doc, fh, indent=2, sort_keys=True)
            fh.write("\n")
        os.replace(tmp_path, out_path)
    except OSError as exc:
        err(f"cannot write {out_path}: {exc}")
        try:
            os.unlink(tmp_path)
        except OSError:
            pass
        return 2

    print(
        f"{GRN}baseline{RST} +{added} new, {len(entries)} fingerprint(s), "
        f"{len(old_rules)} rule(s) kept → {out_path}",
        file=sys.stderr,
    )
    return 0


def cmd_apply(argv):
    src, bl_path = None, None
    active_only, allow_drift = False, False
    corpus_path = None
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--corpus":
            if i + 1 >= len(argv):
                err("--corpus needs a FILE")
                return 2
            corpus_path = argv[i + 1]
            i += 2
        elif a in ("-b", "--baseline"):
            if i + 1 >= len(argv):
                err("--baseline needs a FILE")
                return 2
            bl_path = argv[i + 1]
            i += 2
        elif a == "--active-only":
            active_only = True
            i += 1
        elif a == "--allow-version-drift":
            allow_drift = True
            i += 1
        elif a == "-" or not a.startswith("-"):
            if src is not None:
                err(f"unexpected arg: {a}")
                return 2
            src = a
            i += 1
        else:
            err(f"unknown flag: {a}")
            return 2

    if src is None or bl_path is None:
        err("usage: jjstack-review-baseline apply <findings.jsonl|-> --baseline FILE")
        return 2

    corpus = repo_corpus(corpus_path)
    if corpus is None:
        return 2
    loaded = load_baseline(bl_path, corpus)
    if loaded is None:
        return 2
    rules, fps, bl_version = loaded

    fp_index = {f["hash"]: f for f in fps}
    here = jjstack_version()
    if fps and bl_version != here and not allow_drift:
        warn(
            f"baseline was written by jjstack {bl_version}, this is {here} — "
            f"{len(fp_index)} fingerprint(s) treated as INERT (fail-closed). "
            "Re-read them and regenerate, or pass --allow-version-drift."
        )
        fp_index = {}

    findings = read_findings(src)
    if findings is None:
        return 2

    active = 0
    suppressed = 0
    for f in findings:
        hit = None
        h = fingerprint(f)
        if h in fp_index:
            hit = {
                "by": "fingerprint",
                "reason": fp_index[h]["reason"],
                "matched": h,
            }
        else:
            for r in rules:
                if rule_matches(r, f):
                    hit = {
                        "by": "rule",
                        "reason": r["reason"],
                        # The RESOLVED patterns. Printing every key present
                        # let a losing alias read to a human as a scoped rule.
                        "matched": json.dumps(
                            stated_patterns(r),
                            sort_keys=True,
                        ),
                    }
                    break
        out = dict(f)
        out["suppressed"] = hit
        out["fingerprint"] = h
        if hit:
            suppressed += 1
            if active_only:
                continue
        else:
            active += 1
        print(json.dumps(out, sort_keys=True))

    print(
        f"{GRN}baseline{RST} {active} active, {suppressed} suppressed "
        f"(suppressed findings never count toward the active total)",
        file=sys.stderr,
    )
    return 1 if active else 0


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0 if argv else 2
    cmd, rest = argv[0], argv[1:]
    if cmd == "generate":
        return cmd_generate(rest)
    if cmd == "apply":
        return cmd_apply(rest)
    err(f"unknown subcommand: {cmd} (expected `generate` or `apply`)")
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
