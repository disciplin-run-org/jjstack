#!/usr/bin/env bash
# jjstack-review-preflight — build the /review evidence pack before any AI runs.
#
# Orchestrates the four deterministic pre-passes and writes an index. One
# command, so the SKILL.md prompt stays prose and the logic stays testable:
#
#   1. tooling sweep      — run the real typechecker/linter/tests, and derive
#                           the "already covered, do NOT report" exclusion list
#                           from what actually ran   (jjstack-review-tooling-sweep)
#   5. test baseline      — what passes right now, so a later pass can prove
#                           nothing broke        (same script, same execution)
#   2. blast-radius map   — every changed public symbol's callers OUTSIDE the
#                           diff                 (jjstack-review-blast-radius)
#   3. intent gathering   — commit messages, PR body, linked issues
#                                                (jjstack-review-intent)
#   4. prior dismissals   — findings the user already rejected
#                                                (jjstack-review-prior-dismissals)
#
# Every sub-pass degrades gracefully: a missing tool, no PR, no review history
# is recorded as "skipped — structurally inapplicable", never as a failure.
# The pack is always written, even when every pass had nothing to say, because
# an absent artifact and an empty one mean very different things to the review.
#
# EVIDENCE-PACK.md must never claim more than the artifact it points at, and
# that holds for EVERY row, not the two a fixture happened to cover. Each pass
# writes a `*-status.env` of facts and each row is rendered from those, never
# from an exit code: rc=0 means "the pass completed", never "the pass found
# something". Deriving rows from an rc printed "baseline recorded (green)" over
# "runner: none / NO baseline exists", and later "ran — map built" plus "ran —
# claim gathered" over an empty map and an intent.md that recovered no claim.
#
# Usage:
#   jjstack-review-preflight --out DIR [--base REF] [--repo DIR]
#                            [--skip-tests] [--dry-run]
#                            [--typecheck CMD] [--lint CMD] [--test CMD]
#
#   --typecheck/--lint/--test are forwarded to the sweep; "none" disables one.
#   `--typecheck none --lint none --test none` is the documented way to review
#   a tree you do not trust, executing nothing from it.
#
# Exit: 0 pack built, 2 usage error, 3 could not build a pack at all.
#       A sub-pass that skips or finds failures does NOT fail the pack — the
#       review must continue and report what it learned.
#
# No color red anywhere — unreadable on the target terminal.
set -uo pipefail

# The ONE shared argument guard; see the file for why it is not five patches.
. "$(dirname "${BASH_SOURCE[0]}")/jjstack-review-argcheck.sh"
# The index renderer lives in its own file so every row can be driven from a
# test one status at a time; see the file for why that is structural, not a hook.
. "$(dirname "${BASH_SOURCE[0]}")/jjstack-review-index.sh"

YEL="\033[33m"; CYA="\033[96m"; GRN="\033[32m"; RST="\033[0m"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

OUT=""; REPO=""; BASE=""; BASE_GIVEN=0; DRY=0; SKIP_TESTS=0
TC_OVERRIDE=""; LINT_OVERRIDE=""; TEST_OVERRIDE=""

while [ $# -gt 0 ]; do
  case "$1" in
    --out)        review_need_value "$1" $# || exit 2; OUT="$2"; shift 2 ;;
    --repo)       review_need_value "$1" $# || exit 2; REPO="$2"; shift 2 ;;
    --base)       review_need_value "$1" $# || exit 2; BASE="$2"; BASE_GIVEN=1; shift 2 ;;
    --skip-tests) SKIP_TESTS=1; shift ;;
    # Passed straight through to the sweep. The skill tells you to review an
    # untrusted tree with `--typecheck none --lint none --test none`, and this
    # is the entry point it tells you to run — rejecting them here left the
    # documented non-executing path with no way to reach it.
    --typecheck)  review_need_value "$1" $# || exit 2; TC_OVERRIDE="$2"; shift 2 ;;
    --lint)       review_need_value "$1" $# || exit 2; LINT_OVERRIDE="$2"; shift 2 ;;
    --test)       review_need_value "$1" $# || exit 2; TEST_OVERRIDE="$2"; shift 2 ;;
    --dry-run)    DRY=1; shift ;;
    -h|--help)    sed -n '2,40p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo -e "${CYA}error${RST} unknown arg: $1" >&2; exit 2 ;;
  esac
done

[ -z "$OUT" ] && { echo -e "${CYA}error${RST} usage: $(basename "$0") --out DIR [--base REF] [--repo DIR]" >&2; exit 2; }

if [ -z "$REPO" ]; then REPO="$(git rev-parse --show-toplevel 2>/dev/null)"; fi

# `declare -A` is bash 4+. Without `set -e` it fails SILENTLY on bash 3.2 and
# degrades to an indexed array, where every string subscript collapses to index
# 0 — all five rows would report the last pass's result. Refuse loudly.
if [ "${BASH_VERSINFO[0]:-0}" -lt 4 ]; then
  echo -e "${CYA}error${RST} bash 4+ required (associative arrays); found ${BASH_VERSION:-unknown}" >&2
  exit 3
fi

# A --base this repo cannot resolve is refused HERE, before a single pass runs
# and before any artifact is written. A typo like `orgin/main` used to sail
# through: merge-base failed, `git diff` failed with its stderr discarded, and
# the pack rendered "ran — map built" and "ran — claim gathered" over an empty
# map and an intent.md asserting a fully committed change was uncommitted. Four
# passes producing misleading artifacts from one unresolvable ref.
if [ -n "$BASE_GIVEN" ]; then
  review_base_check "${REPO:-.}" "$BASE" || exit 2
fi

declare -A RC
run_pass() { # run_pass <label> <script> [args...]
  local label="$1"; shift
  local script="$1"; shift
  if [ ! -x "$HERE/$script" ]; then
    RC["$label"]=127
    echo -e "${YEL}warn${RST}  $script missing or not executable" >&2
    return 0
  fi
  "$HERE/$script" "$@"
  RC["$label"]=$?
  return 0
}

DRYFLAG=(); [ "$DRY" -eq 1 ] && DRYFLAG=(--dry-run)
REPOFLAG=(); [ -n "$REPO" ] && REPOFLAG=(--repo "$REPO")
BASEFLAG=(); [ -n "$BASE" ] && BASEFLAG=(--base "$BASE")
TESTFLAG=(); [ "$SKIP_TESTS" -eq 1 ] && TESTFLAG=(--skip-tests)
TOOLFLAG=()
[ -n "$TC_OVERRIDE" ]   && TOOLFLAG+=(--typecheck "$TC_OVERRIDE")
[ -n "$LINT_OVERRIDE" ] && TOOLFLAG+=(--lint "$LINT_OVERRIDE")
[ -n "$TEST_OVERRIDE" ] && TOOLFLAG+=(--test "$TEST_OVERRIDE")

echo "== preflight evidence pack → $OUT =="
run_pass tooling   jjstack-review-tooling-sweep     --out "$OUT" "${REPOFLAG[@]}" "${TESTFLAG[@]}" ${TOOLFLAG+"${TOOLFLAG[@]}"} "${DRYFLAG[@]}"
run_pass blast     jjstack-review-blast-radius      --out "$OUT" "${REPOFLAG[@]}" "${BASEFLAG[@]}" "${DRYFLAG[@]}"
run_pass intent    jjstack-review-intent            --out "$OUT" "${REPOFLAG[@]}" "${BASEFLAG[@]}" "${DRYFLAG[@]}"
run_pass dismissed jjstack-review-prior-dismissals  --out "$OUT" "${REPOFLAG[@]}" "${DRYFLAG[@]}"

if [ "$DRY" -eq 1 ]; then
  echo "[dry-run] would write: $OUT/EVIDENCE-PACK.md"
  exit 0
fi

mkdir -p "$OUT" || exit 3

# The pack records what each pass EXITED with, as a fact beside the facts the
# passes wrote themselves. It used to live only in a shell array inside this
# script, which is why the index could not be rendered — or tested — without
# re-running all five passes.
{
  echo "# machine-readable; consumed by jjstack-review-index.sh. Do not edit."
  for _l in tooling blast intent dismissed; do
    echo "RC_$_l=${RC[$_l]:-9}"
  done
} > "$OUT/pass-rc.env"

render_index "$OUT" "$REPO" > "$OUT/EVIDENCE-PACK.md"

echo -e "${GRN}evidence pack${RST} → $OUT/EVIDENCE-PACK.md"
exit 0
