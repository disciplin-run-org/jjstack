#!/usr/bin/env bash
# jjstack-review-tooling-sweep — run the project's own tooling BEFORE the AI review.
#
# Anthropic's /code-review tells the reviewer to skip anything "a linter or
# typechecker would catch — assume CI runs them." That is right for a PR bot
# that cannot execute anything, and wrong for a local pre-merge review that
# can just RUN them. This script runs them.
#
# It produces four artifacts, and all of them matter:
#   1. tooling-results.md — the real, deterministic failures. Free findings,
#      with zero hallucination risk and zero token cost.
#   2. exclusions.md — the "already covered by tooling, do NOT report" list
#      handed to the AI passes. Crucially, a category is excluded ONLY when the
#      tool that covers it actually ran and passed. Nothing detected means
#      nothing excluded: the AI passes are told those defects are IN SCOPE.
#      Excluding a category on the strength of a tool that never ran is how a
#      review goes quiet about the thing nobody checked.
#   3. test-baseline.md — which tests pass RIGHT NOW (pre-pass 5), so a later
#      pass can prove the diff, and gstack's auto-applied fixes, broke nothing.
#      A baseline exists ONLY when the runner reached a verdict; detected-but-
#      unrunnable and not-detected are gaps, and say so.
#   4. tooling-status.env — the same facts, per tool, machine-readable
#      (none|skipped|pass|fail|error). jjstack-review-preflight renders its
#      index from THIS, never from this script's aggregate exit code: one rc
#      cannot describe three tools, and trying made the index print
#      "baseline recorded (green)" over an artifact saying no baseline existed.
#
# A non-zero exit is not automatically a finding. "the linter found 3 issues"
# and "the linter is not installed" are different facts: exit codes 124-127 and
# 128+signal mean the tool never judged the code, so they are recorded as
# ERROR / a KNOWN GAP and the category stays IN SCOPE, never folded into the
# report as a deterministic finding.
#
# This is the "Algorithm First, Inference Last" rule applied to code review:
# never spend LLM tokens on what a compiler catches for free.
#
# Detection is best-effort and degrades gracefully — a repo with no typechecker
# is a normal repo, not an error.
#
# Usage:
#   jjstack-review-tooling-sweep --out DIR [options]
#
# Options:
#   --out DIR          where to write the artifacts (required)
#   --repo DIR         repo to sweep (default: git toplevel of cwd)
#   --typecheck CMD    override typecheck command ("none" disables)
#   --lint CMD         override lint command ("none" disables)
#   --test CMD         override test command ("none" disables)
#   --skip-tests       detect but do not run the test suite
#   --timeout SECS     per-tool timeout (default 600)
#   --dry-run          print what would run; run NO project tooling and write
#                      nothing. Detection still reads package.json and the
#                      Makefile — read-only probes that execute no repo code.
#
# Exit: 0 at least one detected tool ran and none reported failures, 1 at least
#       one tool reported failures, 2 usage error, 3 environment error (no repo),
#       nothing detected at all, or nothing that WAS detected reached a verdict
#       — neither "nothing to check" nor "nothing ran" is a pass.
#
# Re-entrancy: exports JJSTACK_REVIEW_PREFLIGHT=1 while running. If that is
# already set on entry, every detected tool is suppressed except the internal
# shell parse sweep — a project whose `make test` OR `make lint` invokes
# /review would otherwise recurse forever. Each suppressed tool is recorded as
# `skipped` with its reason, never as a pass.
#
# No color red anywhere — unreadable on the target terminal.
set -uo pipefail

YEL="\033[33m"; CYA="\033[96m"; GRN="\033[32m"; RST="\033[0m"

OUT=""; REPO=""; TIMEOUT=600; DRY=0; SKIP_TESTS=0
TC_OVERRIDE=""; LINT_OVERRIDE=""; TEST_OVERRIDE=""

while [ $# -gt 0 ]; do
  case "$1" in
    --out)        OUT="${2:-}"; shift 2 ;;
    --repo)       REPO="${2:-}"; shift 2 ;;
    --typecheck)  TC_OVERRIDE="${2:-}"; shift 2 ;;
    --lint)       LINT_OVERRIDE="${2:-}"; shift 2 ;;
    --test)       TEST_OVERRIDE="${2:-}"; shift 2 ;;
    --skip-tests) SKIP_TESTS=1; shift ;;
    --timeout)    TIMEOUT="${2:-}"; shift 2 ;;
    --dry-run)    DRY=1; shift ;;
    -h|--help)    sed -n '2,63p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo -e "${CYA}error${RST} unknown arg: $1" >&2; exit 2 ;;
  esac
done

[ -z "$OUT" ] && { echo -e "${CYA}error${RST} usage: $(basename "$0") --out DIR [--repo DIR] [--dry-run]" >&2; exit 2; }

# `declare -A` is bash 4+. Without `set -e` it fails SILENTLY on bash 3.2 (still
# the default /bin/bash on macOS) and degrades to an indexed array, where every
# string subscript collapses to index 0 — all three tools would share one
# status. Refuse loudly instead of reporting a scrambled sweep.
if [ "${BASH_VERSINFO[0]:-0}" -lt 4 ]; then
  echo -e "${CYA}error${RST} bash 4+ required (associative arrays); found ${BASH_VERSION:-unknown}" >&2
  exit 3
fi

if [ -z "$REPO" ]; then
  REPO="$(git rev-parse --show-toplevel 2>/dev/null)"
fi
if [ -z "$REPO" ] || [ ! -d "$REPO" ]; then
  echo -e "${YEL}warn${RST}  not a git repo and no --repo given — nothing to sweep" >&2
  exit 3
fi

has() { command -v "$1" >/dev/null 2>&1; }

# `--kill-after` stops a tool that ignores SIGTERM from leaving forked workers
# behind. busybox/toybox `timeout` does not have the flag, and passing it there
# would turn every tool into a spurious "could not run", so probe once.
TIMEOUT_KILL=()
if has timeout && timeout --kill-after=1s 1 true >/dev/null 2>&1; then
  TIMEOUT_KILL=(--kill-after=30s)
fi

# --- detection -------------------------------------------------------------
# Each detector echoes a shell command string, or nothing. First match wins.
# Deliberately conservative: a command we are not confident about is worse than
# no command, because a bogus failure poisons the whole evidence pack.

npm_script() {   # npm_script <name> -> "npm run <name>" when package.json has it
  [ -f "$REPO/package.json" ] || return 1
  has node || return 1
  # The path and the script name are passed as ARGV, never spliced into the JS
  # source. Interpolating them let a directory named  x');<js>;b=('  execute
  # attacker JS during plain detection, and made a plain apostrophe in a
  # legitimate directory name a silent, total npm-script detection failure.
  # require() of a .json file parses data — it runs no code from the repo.
  node -e 'const p=require(require("path").resolve(process.argv[1]));process.exit(p.scripts&&p.scripts[process.argv[2]]?0:1)' \
       "$REPO/package.json" "$1" 2>/dev/null || return 1
  echo "npm run --silent $1"
}

make_target() { # make_target <name>
  [ -f "$REPO/Makefile" ] || return 1
  grep -qE "^$1:" "$REPO/Makefile" 2>/dev/null || return 1
  has make || return 1
  echo "make $1"
}

detect_typecheck() {
  npm_script typecheck && return 0
  npm_script type-check && return 0
  if [ -f "$REPO/tsconfig.json" ] && has npx; then echo "npx --no-install tsc --noEmit"; return 0; fi
  if { [ -f "$REPO/pyproject.toml" ] || [ -f "$REPO/setup.cfg" ] || [ -f "$REPO/mypy.ini" ]; } && has mypy; then
    echo "mypy ."; return 0; fi
  if [ -f "$REPO/go.mod" ] && has go; then echo "go build ./..."; return 0; fi
  if [ -f "$REPO/Cargo.toml" ] && has cargo; then echo "cargo check --quiet"; return 0; fi
  make_target typecheck && return 0
  return 1
}

detect_lint() {
  npm_script lint && return 0
  if { [ -f "$REPO/pyproject.toml" ] || [ -f "$REPO/setup.cfg" ] || [ -f "$REPO/ruff.toml" ]; } && has ruff; then
    echo "ruff check ."; return 0; fi
  if [ -f "$REPO/.flake8" ] && has flake8; then echo "flake8"; return 0; fi
  if [ -f "$REPO/go.mod" ] && has go; then echo "go vet ./..."; return 0; fi
  if [ -f "$REPO/Cargo.toml" ] && has cargo; then echo "cargo clippy --quiet"; return 0; fi
  make_target lint && return 0
  # Shell-first repos (jjstack itself): `bash -n` over every tracked shell
  # script is a real parse-level guard and costs nothing. Last resort, so a
  # project with a proper linter always wins.
  if git -C "$REPO" ls-files 2>/dev/null | grep -qE '\.sh$|^bin/|^hooks/'; then
    echo "__shell_parse_sweep__"; return 0
  fi
  return 1
}

detect_test() {
  npm_script test && return 0
  if [ -f "$REPO/pytest.ini" ] || [ -d "$REPO/tests" ] || grep -q '\[tool.pytest' "$REPO/pyproject.toml" 2>/dev/null; then
    has pytest && { echo "pytest -q"; return 0; }
  fi
  if [ -f "$REPO/go.mod" ] && has go; then echo "go test ./..."; return 0; fi
  if [ -f "$REPO/Cargo.toml" ] && has cargo; then echo "cargo test --quiet"; return 0; fi
  [ -x "$REPO/test/smoke.sh" ] && { echo "test/smoke.sh"; return 0; }
  make_target test && return 0
  return 1
}

TC="${TC_OVERRIDE:-$(detect_typecheck || true)}"
LINT="${LINT_OVERRIDE:-$(detect_lint || true)}"
TEST="${TEST_OVERRIDE:-$(detect_test || true)}"
[ "$TC" = "none" ]   && TC=""
[ "$LINT" = "none" ] && LINT=""
[ "$TEST" = "none" ] && TEST=""

# Remember what was DETECTED before any guard clears it, so "nothing here to
# run" and "something here we chose not to run" stay distinguishable
# downstream. Every later question about a tool — the results table, kind_of,
# the baseline artifact — is answered from these two arrays, so the table and
# tooling-status.env cannot drift apart: a runner-less repo used to render
# `| test | n/a | skipped (--skip-tests) |` beside TEST_STATUS=none, printing
# "we chose not to run it" over "there is no runner".
declare -A DETCMD SKIPWHY
DETCMD[typecheck]="$TC"; DETCMD[lint]="$LINT"; DETCMD[test]="$TEST"
DETECTED=0
for _s in typecheck lint test; do
  [ -n "${DETCMD[$_s]}" ] && DETECTED=$((DETECTED + 1))
done
TEST_DETECTED="$TEST"

# Re-entrancy guard: never let a project's own tooling re-enter the review.
#
# This covered $TEST alone, which was never the whole hazard: `make lint` and an
# `npm run typecheck` that shells out re-enter exactly as readily as `make
# test`. Under re-entry EVERY detected tool is suppressed except the internal
# parse sweep, which is this script's own code and cannot recurse. Blunt on
# purpose — each suppressed tool is recorded as `skipped` with its reason, so
# nothing over-claims, and a nested review's outer sweep already ran them all.
REENTRY_NOTE=""
if [ -n "${JJSTACK_REVIEW_PREFLIGHT:-}" ]; then
  for _s in typecheck lint test; do
    [ -n "${DETCMD[$_s]}" ] || continue
    [ "${DETCMD[$_s]}" = "__shell_parse_sweep__" ] && continue
    SKIPWHY[$_s]="re-entrancy guard"
  done
  if [ -n "${SKIPWHY[typecheck]:-}${SKIPWHY[lint]:-}${SKIPWHY[test]:-}" ]; then
    REENTRY_NOTE="detected tooling NOT run: JJSTACK_REVIEW_PREFLIGHT already set (re-entrancy guard)"
  fi
  [ -n "${SKIPWHY[typecheck]:-}" ] && TC=""
  [ -n "${SKIPWHY[lint]:-}" ]      && LINT=""
  [ -n "${SKIPWHY[test]:-}" ]      && TEST=""
fi
# --skip-tests only means anything when a runner was actually detected.
[ -n "$TEST" ] && [ "$SKIP_TESTS" -eq 1 ] && SKIPWHY[test]="--skip-tests"

label() { # human name for a command, incl. the internal shell-sweep token
  case "${1:-}" in
    "")                    echo "<none detected>" ;;
    __shell_parse_sweep__) echo "bash -n over tracked shell scripts" ;;
    *)                     echo "$1" ;;
  esac
}

if [ "$DRY" -eq 1 ]; then
  echo "[dry-run] repo:      $REPO"
  echo "[dry-run] typecheck: $(label "$TC")"
  echo "[dry-run] lint:      $(label "$LINT")"
  if [ "$SKIP_TESTS" -eq 1 ]; then
    echo "[dry-run] test:      $(label "$TEST") (--skip-tests)"
  else
    echo "[dry-run] test:      $(label "$TEST")"
  fi
  [ -n "$REENTRY_NOTE" ] && echo "[dry-run] $REENTRY_NOTE"
  echo "[dry-run] would write: $OUT/{tooling-results.md,exclusions.md,test-baseline.md}"
  exit 0
fi

mkdir -p "$OUT/tooling-logs" || exit 3

export JJSTACK_REVIEW_PREFLIGHT=1

# --- execution -------------------------------------------------------------
failures=0; errors=0; passed=0
declare -A STATUS CMDS KIND

# A non-zero exit is NOT automatically a finding. "the linter found 3 issues"
# and "the linter is not installed" are different facts, and only the first
# belongs under a heading that tells the reviewer to report it. 124-127 and the
# 128+signal codes all mean the tool never got to judge the code at all, so
# they are recorded as a KNOWN GAP and leave the category IN SCOPE.
classify() { # classify <slug> <rc>
  local slug="$1" rc="$2"
  case "$rc" in
    0)   STATUS["$slug"]="pass";                                KIND["$slug"]="pass" ;;
    124) STATUS["$slug"]="ERROR(timed out after ${TIMEOUT}s)";  KIND["$slug"]="error" ;;
    125) STATUS["$slug"]="ERROR(timeout wrapper failed)";       KIND["$slug"]="error" ;;
    126) STATUS["$slug"]="ERROR(command not executable)";       KIND["$slug"]="error" ;;
    127) STATUS["$slug"]="ERROR(command not found)";            KIND["$slug"]="error" ;;
    137) STATUS["$slug"]="ERROR(killed after timeout)";         KIND["$slug"]="error" ;;
    *)   STATUS["$slug"]="FAIL(rc=$rc)";                        KIND["$slug"]="fail" ;;
  esac
  case "${KIND[$slug]}" in
    pass)  passed=$((passed + 1)) ;;
    fail)  failures=$((failures + 1)) ;;
    error) errors=$((errors + 1)) ;;
  esac
}

kind_of() { # kind_of <slug> -> none|skipped|pass|fail|error
  local slug="$1"
  if [ -n "${KIND[$slug]:-}" ]; then printf '%s\n' "${KIND[$slug]}"; return 0; fi
  # `skipped` requires BOTH a detected tool and a recorded reason for not
  # running it. Either alone is `none` — there was nothing there to skip.
  if [ -n "${DETCMD[$slug]}" ] && [ -n "${SKIPWHY[$slug]:-}" ]; then echo skipped; return 0; fi
  echo none
}

# A file is shell iff it says so — extension or shebang. Guessing by directory
# would run `bash -n` over python and report a fake parse error.
is_shell() {
  case "$1" in *.sh) return 0 ;; esac
  head -n1 "$1" 2>/dev/null | grep -qE '^#!.*(bash|/sh|env sh)'
}

run_tool() { # run_tool <slug> <command>
  local slug="$1" cmd="$2" rc log
  log="$OUT/tooling-logs/$slug.log"
  CMDS["$slug"]="$cmd"
  if [ "$cmd" = "__shell_parse_sweep__" ]; then
    CMDS["$slug"]="bash -n over tracked shell scripts"
    : > "$log"
    local list f
    list="$(mktemp)"
    git -C "$REPO" ls-files 2>/dev/null | grep -E '\.sh$|^bin/|^hooks/' > "$list"
    rc=0
    while read -r f; do
      [ -f "$REPO/$f" ] || continue
      is_shell "$REPO/$f" || continue
      if ! bash -n "$REPO/$f" 2>>"$log"; then echo "parse error: $f" >> "$log"; rc=1; fi
    done < "$list"
    rm -f "$list"
  else
    # A failed `cd` would otherwise surface as rc=1, indistinguishable from
    # "the tool found something". Check it separately so it stays a gap.
    if ! ( cd "$REPO" ) 2>/dev/null; then
      STATUS["$slug"]="ERROR(cannot enter repo dir)"; KIND["$slug"]="error"
      errors=$((errors + 1))
      echo "cannot cd into $REPO" > "$log"
      return 0
    fi
    if has timeout; then
      ( cd "$REPO" && timeout ${TIMEOUT_KILL+"${TIMEOUT_KILL[@]}"} "$TIMEOUT" bash -c "$cmd" ) > "$log" 2>&1
    else
      ( cd "$REPO" && bash -c "$cmd" ) > "$log" 2>&1
    fi
    rc=$?
  fi
  classify "$slug" "$rc"
  return 0
}

[ -n "$TC" ]   && run_tool typecheck "$TC"
[ -n "$LINT" ] && run_tool lint "$LINT"
if [ -n "$TEST" ] && [ "$SKIP_TESTS" -eq 0 ]; then run_tool test "$TEST"; fi

# --- artifact 1: real failures --------------------------------------------
{
  echo "# Deterministic tooling sweep"
  echo
  echo "Ran the project's own tooling before the AI review. Everything below was"
  echo "found by a compiler/linter/test runner, not by a model — zero"
  echo "hallucination risk, zero token cost."
  echo
  echo "- repo: \`$REPO\`"
  echo "- date: $(date +%F)"
  [ -n "$REENTRY_NOTE" ] && { echo "- note: $REENTRY_NOTE"; }
  echo
  echo "| tool | command | result |"
  echo "|------|---------|--------|"
  # Rendered from kind_of, the same function tooling-status.env is built from,
  # so the human table and the machine facts cannot disagree.
  for slug in typecheck lint test; do
    case "$(kind_of "$slug")" in
      none)    echo "| $slug | — | none detected (structurally inapplicable) |" ;;
      skipped) echo "| $slug | \`$(label "${DETCMD[$slug]}")\` | skipped (${SKIPWHY[$slug]}) |" ;;
      *)       echo "| $slug | \`${CMDS[$slug]}\` | ${STATUS[$slug]} |" ;;
    esac
  done
  echo
  for slug in typecheck lint test; do
    case "${KIND[$slug]:-}" in
      fail)
        echo "## $slug FAILED — real findings, report these"
        echo
        echo '```'
        tail -n 60 "$OUT/tooling-logs/$slug.log" 2>/dev/null
        echo '```'
        echo
        echo "Full log: \`tooling-logs/$slug.log\`"
        echo ;;
    esac
  done
  # Separate heading, deliberately: the reviewer is told to fold the section
  # above straight into the report as fact, skipping confidence scoring. A tool
  # that never ran produced no facts, so it must never land there.
  for slug in typecheck lint test; do
    case "${KIND[$slug]:-}" in
      error)
        echo "## $slug COULD NOT RUN — a KNOWN GAP, NOT a finding"
        echo
        echo "\`${CMDS[$slug]}\` → ${STATUS[$slug]}. The tool never judged the"
        echo "code, so nothing here is a deterministic finding and none of it"
        echo "may be reported as one. Carry it into the report as a gap: the"
        echo "$slug category was NOT checked and stays IN SCOPE."
        echo
        echo '```'
        tail -n 20 "$OUT/tooling-logs/$slug.log" 2>/dev/null
        echo '```'
        echo
        echo "Full log: \`tooling-logs/$slug.log\`"
        echo ;;
    esac
  done
  if [ "$failures" -eq 0 ]; then
    echo "## No deterministic failures"
    echo
    if [ "$passed" -eq 0 ]; then
      echo "Nothing ran to completion, so nothing was proven. This is an ABSENCE"
      echo "of evidence, not evidence of health — do not read it as a pass."
    else
      echo "$passed detected tool(s) ran and passed. That does NOT mean the diff"
      echo "is clean — it means the remaining defects are the ones only a"
      echo "reviewer can find."
    fi
    if [ "$errors" -gt 0 ]; then
      echo
      echo "$errors tool(s) COULD NOT RUN (see above); those categories went"
      echo "unchecked entirely."
    fi
  fi
} > "$OUT/tooling-results.md"

# --- artifact 2: exclusion list -------------------------------------------
# The load-bearing rule: exclude a category ONLY when the tool covering it
# actually ran AND passed. A tool that did not run excludes nothing.
{
  echo "# Tooling exclusion list — hand this to every AI review pass"
  echo
  echo "Categories marked COVERED were checked by real tooling that RAN and"
  echo "PASSED on this working tree. Do NOT spend a finding on them."
  echo
  echo "Categories marked IN SCOPE were NOT checked — no such tool was detected,"
  echo "or it failed. The AI passes must review them normally. Never assume CI"
  echo "covers what this sweep could not run."
  echo
  if [ "${KIND[typecheck]:-}" = "pass" ]; then
    echo "## COVERED — do NOT report (typechecker: \`${CMDS[typecheck]}\`)"
    echo
    echo "- type errors, wrong argument types, wrong arity"
    echo "- undefined names, missing/unused imports the checker flags"
    echo "- unreachable code and signature mismatches the checker flags"
  else
    echo "## IN SCOPE — no passing typechecker"
    echo
    echo "- type errors, wrong arity, signature mismatches: review these normally"
  fi
  echo
  if [ "${KIND[lint]:-}" = "pass" ]; then
    echo "## COVERED — do NOT report (linter: \`${CMDS[lint]}\`)"
    echo
    if [ "$LINT" = "__shell_parse_sweep__" ]; then
      # A parse sweep proves the scripts parse. It says nothing about style,
      # and claiming otherwise would silence a category nothing checked.
      echo "- shell syntax / parse errors, unbalanced quotes and blocks"
      echo
      echo "This was a parse sweep, NOT a style linter. Style, naming, unused"
      echo "variables and shell-specific smells (shellcheck territory) remain"
      echo "IN SCOPE — nothing checked them."
    else
      echo "- style, formatting, naming conventions enforced by that config"
      echo "- unused variables/imports, shadowing, syntax-level smells"
    fi
  else
    echo "## IN SCOPE — no passing linter"
    echo
    echo "- lint-class issues are NOT covered; still prefer real defects over"
    echo "  style nits, but do not assume a linter caught anything"
  fi
  echo
  if [ "${KIND[test]:-}" = "pass" ]; then
    echo "## COVERED — do NOT report (test suite: \`${CMDS[test]}\`)"
    echo
    echo "- \"this might be broken\" claims about behavior the suite exercises;"
    echo "  the suite is green. Report a coverage GAP instead — a behavior with"
    echo "  no test is still a finding."
  else
    echo "## IN SCOPE — no passing test suite"
    echo
    echo "- nothing was proven to work. Correctness claims get no free pass."
  fi
  echo
  echo "## Always excluded (independent of this sweep)"
  echo
  echo "- pure formatting a formatter would rewrite"
  echo "- pre-existing issues on lines the diff did not touch"
} > "$OUT/exclusions.md"

# --- artifact 3: test baseline --------------------------------------------
{
  echo "# Test baseline snapshot"
  echo
  echo "What passes RIGHT NOW, recorded before any review-driven edit. A later"
  echo "pass compares against this to prove the diff — and any fix gstack"
  echo "auto-applies — broke nothing. Without a baseline, \"tests pass\" cannot"
  echo "be distinguished from \"tests passed before too, and still miss this\"."
  echo
  # A baseline exists ONLY when the runner reached a verdict. "detected but
  # could not execute" is a gap, and rendering it like a red baseline would let
  # a later pass compare against a comparison that was never made.
  echo "- baseline: $(kind_of test)"
  if [ "${KIND[test]:-}" = "pass" ] || [ "${KIND[test]:-}" = "fail" ]; then
    echo "- runner:  \`${CMDS[test]}\`"
    echo "- result:  ${STATUS[test]}"
    echo "- captured: $(date -u +%FT%TZ)"
    echo "- head:    $(git -C "$REPO" rev-parse --short HEAD 2>/dev/null || echo unknown)"
    echo
    echo "## Runner output (tail)"
    echo
    echo '```'
    tail -n 40 "$OUT/tooling-logs/test.log" 2>/dev/null
    echo '```'
    echo
    if [ "${KIND[test]}" != "pass" ]; then
      echo "**The baseline is RED.** Failures present before the review are"
      echo "pre-existing, not diff-introduced — do not attribute them to the"
      echo "change, and do not let them mask a new failure."
    fi
  elif [ "${KIND[test]:-}" = "error" ]; then
    echo "- runner: \`${CMDS[test]}\` — ${STATUS[test]}"
    echo
    echo "The test runner was detected but COULD NOT RUN. **NO baseline"
    echo "exists**, so no later pass may claim the change \"broke nothing\" —"
    echo "that claim is unsupported here. This is a KNOWN GAP, not a red"
    echo "baseline and certainly not a green one."
    echo
    echo '```'
    tail -n 20 "$OUT/tooling-logs/test.log" 2>/dev/null
    echo '```'
  else
    echo "- runner: none"
    echo
    if [ -n "$TEST_DETECTED" ] && [ -n "${SKIPWHY[test]:-}" ]; then
      echo "Detected \`$TEST_DETECTED\` but skipped (${SKIPWHY[test]}). **NO"
      echo "baseline exists**, so no later pass may claim the change \"broke"
      echo "nothing\" — that claim is unsupported here."
    else
      echo "No test runner detected. NO baseline exists, so no later pass may"
      echo "claim the change \"broke nothing\" — that claim is unsupported here."
    fi
  fi
} > "$OUT/test-baseline.md"

# --- artifact 4: machine-readable status ----------------------------------
# The evidence-pack index used to derive every one of its rows from this
# script's single aggregate exit code — which is how "baseline recorded
# (green)" came to be printed above an artifact reading "runner: none / NO
# baseline exists". The index must never claim more than its artifacts
# support, so it reads per-tool facts from here instead of guessing from an rc.
skippedn=0
for _s in typecheck lint test; do
  [ "$(kind_of "$_s")" = "skipped" ] && skippedn=$((skippedn + 1))
done
{
  echo "# machine-readable; consumed by jjstack-review-preflight. Do not edit."
  echo "TYPECHECK_STATUS=$(kind_of typecheck)"
  echo "LINT_STATUS=$(kind_of lint)"
  echo "TEST_STATUS=$(kind_of test)"
  echo "TOOLS_DETECTED=$DETECTED"
  echo "TOOLS_PASSED=$passed"
  echo "TOOLS_SKIPPED=$skippedn"
  echo "TOOLS_FAILED=$failures"
  echo "TOOLS_ERRORED=$errors"
} > "$OUT/tooling-status.env"

echo -e "${GRN}sweep${RST} → $OUT (typecheck: $(kind_of typecheck), lint: $(kind_of lint), test: $(kind_of test))"
[ "$errors" -gt 0 ] && echo -e "${YEL}warn${RST}  $errors tool(s) COULD NOT RUN — a known gap, not a finding" >&2
[ "$failures" -gt 0 ] && { echo -e "${YEL}warn${RST}  $failures tool(s) reported failures — see tooling-results.md" >&2; exit 1; }
# Nothing detected is not a pass. Exit 3 so a caller that only reads the exit
# code cannot mistake "there was nothing to check" for "everything checked out";
# the artifacts and tooling-status.env carry the detail either way.
if [ "$DETECTED" -eq 0 ]; then
  echo -e "${YEL}warn${RST}  no typechecker, linter or test runner detected — NOTHING was checked" >&2
  exit 3
fi
# Neither is "detected, but nothing reached a verdict". The header promises 0
# means at least one detected tool RAN and none failed; when the only detected
# tool timed out, was missing, or was suppressed, nothing ran and 0 would read
# as a clean sweep to any caller that only checks the exit code.
if [ "$passed" -eq 0 ]; then
  echo -e "${YEL}warn${RST}  $DETECTED tool(s) detected but NONE ran to a verdict — NOTHING was proven" >&2
  exit 3
fi
exit 0
