#!/usr/bin/env bash
# jjstack-review-triage — turn a raw /review findings list into an audited
# triage ledger: deduped, exposure-annotated, and fully accounted for.
#
# Why this exists (the Aikido lesson, see references/vendor-lessons-aikido.md):
# a security scanner cannot delete a finding it does not like — it records a
# DISPOSITION and a REASON, and the finding stays inspectable forever. An LLM
# reviewer that simply stops mentioning a finding is indistinguishable from one
# that never found it, and nobody can audit the difference six months later.
#
# So this script enforces four invariants no prose prompt can guarantee:
#   1. NO SILENT DROP — any disposition other than `report` needs a reason code
#      from a closed vocabulary.
#   2. REACHABILITY DEPRIORITISES, IT NEVER DELETES — reason `not-reachable` is
#      legal only with `defer` or `demoted`, never `suppress`. Unreachable
#      today is reachable after the next refactor.
#   3. TOP SEVERITY IS NEVER SUPPRESSED — a P0/P1 may be deferred with a stated
#      reason, but it may not be made to disappear.
#   4. `refuted` AND `stale-api` PAIR EXCLUSIVELY — the only "this finding is
#      wrong" outcome is the one earned by external evidence (Phase 4.5b's
#      documentation lookup). Binding the two stops it becoming a general delete
#      hatch, and stops `stale-api` routing a P0/P1 past invariant 3.
#   5. A DOCUMENTARY REFUTATION MUST CARRY ITS DOCUMENT — a `refuted` row whose
#      claim holds no `http`/`https` URL is rejected. Invariant 4 bound the two
#      LABELS and checked no evidence, so `refuted` + `stale-api` + a sentence
#      of opinion bought exactly the disappearance invariant 3 denies to
#      `suppress`, while the rendered page positively asserted that a
#      documentation check had happened. §4.5b step 3 already says the doc URL
#      goes in the claim column; this is that instruction, enforced.
#
# The invariants run on the MERGED record, never on the raw row. Dedup used to
# keep the first-seen row and discard the rest, so a baseline-suppressed P3
# could ABSORB a reported P0 that shared its location and opening phrase: the
# P0's own row said `report`, so invariant 3 never fired, and the page rendered
# one suppressed P3 under a header promising nothing was dropped. Suppression
# by absorption is still suppression. A merged group therefore carries the
# HIGHEST severity of its members (and that member's claim and confidence) and
# their WEAKEST — most visible — disposition, ranked
# report < unconfirmed < demoted < defer < out-of-scope < suppress; the three
# invariants are then re-checked against the merged result, and every merge
# that raised a severity or weakened a disposition is listed in the rendered
# "Merges" section, so the collapse itself stays auditable.
#
# Everything mechanical happens here, not in the model: fingerprinting and
# dedup, corroboration counting across lenses, path-exposure classification,
# vocabulary validation, the tally, and the rendered ledger. The model supplies
# only judgment — severity, confidence, disposition, reason, claim.
#
# Input: a TSV ledger, 7 tab-separated columns; `#` comments and blanks ignored:
#   severity  confidence  path:line  lens  disposition  reason  claim
#     severity     P0 | P1 | P2 | P3
#     confidence   integer 0-100
#     path:line    file path, colon, line number (or range N-M)
#     lens         the pass that flagged it (free text, no tabs)
#     disposition  report | unconfirmed | demoted | defer | suppress |
#                  out-of-scope | refuted   (tracks the enrich-only model:
#                  `unconfirmed` and `demoted` are SHOWN sections, and no
#                  disposition here is a score threshold, because a finding is
#                  never deleted. `refuted` is the sole "this finding is WRONG"
#                  outcome and belongs to the Phase 4.5b stale-API check, which
#                  runs BEFORE Phase 5 and decides on external evidence.)
#     reason       `-` for `report`; otherwise one of:
#                  unverified prior-decision low-confidence pre-existing
#                  tool-covered style-only no-repro duplicate not-reachable
#                  accepted-risk baseline stale-api
#                  `refuted` and `stale-api` are legal ONLY with each other.
#     claim        the finding text (any further columns are rejoined)
#
# Usage:
#   jjstack-review-triage <ledger.tsv> [--out FILE] [--reconcile ADJUDICATED]
#
#   --reconcile ADJUDICATED turns the page's completeness claim into a checked
#   fact instead of a sentence. ADJUDICATED is Phase 5d's
#   `findings.adjudicated.jsonl`; every finding in it must have a ledger row at
#   the same `file:start_line`, counted per location, or nothing is rendered.
#   Without it the header states plainly that completeness was not verified —
#   a ledger of nothing but comments must not certify that nothing was dropped.
#
# Exit: 0 ledger valid and rendered, 2 usage error, 3 input missing,
#       4 validation failed (nothing rendered — fix the ledger and rerun).
#
# No color red anywhere — unreadable on the target terminal.
set -uo pipefail

YEL="\033[33m"; CYA="\033[96m"; GRN="\033[32m"; RST="\033[0m"

SRC=""
OUT=""
RECON=""

while [ $# -gt 0 ]; do
  case "$1" in
    --out) OUT="${2:-}"; shift 2 ;;
    --reconcile) RECON="${2:-}"; shift 2 ;;
    -h|--help)
      # Print the WHOLE leading comment block. A hardcoded line range silently
      # truncated the exit codes — including the exit 4 the design hinges on —
      # the moment the header grew, so the range is computed, not typed.
      awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"
      exit 0 ;;
    -*) echo -e "${CYA}error${RST} unknown flag: $1" >&2; exit 2 ;;
    *)  if [ -z "$SRC" ]; then SRC="$1"; else echo -e "${CYA}error${RST} unexpected arg: $1" >&2; exit 2; fi
        shift ;;
  esac
done

if [ -z "$SRC" ]; then
  echo -e "${CYA}error${RST} usage: $(basename "$0") <ledger.tsv> [--out FILE] [--reconcile ADJUDICATED]" >&2
  exit 2
fi

if [ ! -f "$SRC" ]; then
  echo -e "${YEL}warn${RST}  ledger not found: $SRC" >&2
  exit 3
fi

if [ -n "$RECON" ] && [ ! -f "$RECON" ]; then
  echo -e "${YEL}warn${RST}  adjudicated findings not found: $RECON" >&2
  exit 3
fi

WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT
RENDER="$WORK/ledger.md"
ERRS="$WORK/errors.txt"
LOCS="$WORK/locations.txt"
: > "$ERRS"
: > "$LOCS"

awk -F'\t' -v today="$(date +%F)" -v src="$SRC" -v render="$RENDER" -v errfile="$ERRS" \
    -v locfile="$LOCS" -v recon="$RECON" '
function fail(n, msg) { errs++; print "  line " n ": " msg >> errfile }
# Same reporter, keyed on the merged record instead of a source line — the
# violation belongs to the collapsed finding, which has no single line number.
function failmerged(loc, msg) { errs++; print "  merged " loc ": " msg >> errfile }

# Severity ranks low-to-high-number as P0..P3, so "highest severity" is the
# SMALLEST rank. Unknown severities never reach here (validated per row).
function sevrank(s) { if (s == "P0") return 0; if (s == "P1") return 1; if (s == "P2") return 2; return 3 }

# Total, order-independent sort key for the rendered page: severity first (a
# reader scans top-down), then location, then the fingerprint so no two unique
# findings can ever compare equal.
function sortkey(fp) { return sevrank(SEV_[fp]) "\x01" LOC[fp] "\x01" fp }

# How thoroughly a disposition hides a finding. Merging keeps the WEAKEST
# (smallest) rank, so a suppressed row can never swallow a reported one.
#
# The rank is READ OUT OF THE VOCABULARY LIST (DRANK, built in BEGIN from
# DISPORDER), it is not a second hand-maintained ladder. It used to be a chain
# of ifs ending in a bare `return 5`, and when `refuted` joined the vocabulary
# nobody added it here — so it fell into the default bucket and TIED with
# `suppress`. The merge test is a strict `<`, so the tie made row order decide
# which disposition survived: the same input rendered under "Refuted" or under
# "Suppressed by baseline" depending on which line came first. Deriving rank
# from the vocabulary makes an unranked disposition impossible to write.
function disprank(d) { return (d in DRANK) ? DRANK[d] : 9999 }

# A refutation is a claim about the OUTSIDE world — "current official docs say
# this code is correct" — and the only evidence that can settle it is the
# document. Without one, `refuted` is an opinion wearing a disposition that
# deletes P0s.
function hasdoc(claim) { return (claim ~ /https?:\/\/[^[:space:]]/) }

# Deterministic, order-independent lens list: two passes flagging one defect
# must render the same however the rows arrived.
function lenslist(fp,   n, parts, i, j, t, out) {
  n = split(LENSES[fp], parts, "|")
  for (i = 2; i <= n; i++) { t = parts[i]; for (j = i - 1; j >= 1 && parts[j] > t; j--) parts[j+1] = parts[j]; parts[j+1] = t }
  out = parts[1]
  for (i = 2; i <= n; i++) out = out ", " parts[i]
  return out
}

# A raw `|` in free text opens a new markdown table cell, so a claim quoting
# `a || b` renders a 9-cell row against a 7-cell header and the renderer drops
# the overflow — the finding text becomes unreadable in the committed artifact.
# GFM decodes the backslash escape before it parses cells or code spans, so
# this is safe inside backticks too.
# Built by split + concat rather than gsub: backslash handling in a gsub
# REPLACEMENT string is implementation-defined, and gawk emitted a doubled
# backslash for the obvious spelling. Concatenation has no such ambiguity.
function cellsafe(s,   n, parts, i, out) {
  n = split(s, parts, /\|/)
  out = parts[1]
  for (i = 2; i <= n; i++) out = out "\\|" parts[i]
  return out
}

# Deterministic exposure class — the code-review analogue of a security scanner
# asking "is this actually shipped to production?". It annotates blast radius;
# it never decides whether a finding is shown.
function pathclass(p,   lp) {
  lp = tolower(p)
  if (lp ~ /(^|\/)(vendor|node_modules|third_party|bower_components)\//) return "vendor"
  if (lp ~ /(^|\/)(\.venv|venv|site-packages)\//)                        return "vendor"
  if (lp ~ /(^|\/)(fixture|fixtures|testdata|__mocks__|mocks)\//)        return "fixture"
  if (lp ~ /(^|\/)(test|tests|spec|specs|__tests__)\//)                  return "test"
  if (lp ~ /_test\.|\.test\.|\.spec\.|(^|\/)test_[^\/]*$/)               return "test"
  if (lp ~ /(^|\/)(dist|build|out|target|generated)\//)                  return "generated"
  if (lp ~ /\.min\.(js|css)$|_pb2\.py$|\.pb\.go$|\.generated\./)         return "generated"
  if (lp ~ /(^|\/)(doc|docs)\/|\.(md|rst|adoc|txt)$/)                    return "docs"
  return "prod"
}

# Fingerprint: location plus the normalised head of the claim. Two lenses
# describing the same defect at the same line collapse into one finding that
# carries a corroboration count — itself a ranking signal.
function fingerprint(loc, claim,   c, w, i, k, n) {
  c = tolower(claim); gsub(/[^a-z0-9 ]/, " ", c); gsub(/  +/, " ", c); sub(/^ /, "", c)
  n = split(c, w, " "); k = ""
  for (i = 1; i <= n && i <= 8; i++) k = k w[i] " "
  return loc "|" k
}

function section(title, want,   i, fp, n) {
  n = 0
  for (i = 1; i <= uniq; i++) if (DISP_[order[i]] == want) n++
  print ""                          >> render
  print "## " title " (" n ")"      >> render
  print ""                          >> render
  if (n == 0) { print "_none_"      >> render; return }
  if (want == "report" || want == "unconfirmed" || want == "demoted") {
    print "| sev | conf | location | exposure | lenses | corrob | finding |" >> render
    print "|---|---|---|---|---|---|---|"                                    >> render
  } else {
    print "| sev | conf | location | exposure | reason | lenses | finding |" >> render
    print "|---|---|---|---|---|---|---|"                                    >> render
  }
  for (i = 1; i <= uniq; i++) {
    fp = order[i]
    if (DISP_[fp] != want) continue
    if (want == "report" || want == "unconfirmed" || want == "demoted")
      printf("| %s | %s | `%s` | %s | %s | %d | %s |\n", SEV_[fp], CONF[fp], cellsafe(LOC[fp]), CLS[fp], lenslist(fp), CORROB[fp], cellsafe(CLAIM[fp])) >> render
    else
      printf("| %s | %s | `%s` | %s | `%s` | %s | %s |\n", SEV_[fp], CONF[fp], cellsafe(LOC[fp]), CLS[fp], RSN[fp], lenslist(fp), cellsafe(CLAIM[fp])) >> render
  }
}

BEGIN {
  split("P0 P1 P2 P3", a, " ");                    for (i in a) SEV[a[i]] = 1
  # Vocabulary tracks the enrich-only verification model: a finding is never
  # deleted, so there is no score-threshold disposition. "unconfirmed" and
  # "demoted" are SHOWN sections; only the committed baseline suppresses.
  # "refuted" is the single exception and it is not a Phase 5 decision at all:
  # the Phase 4.5b stale-API check disproves a finding against current official
  # documentation, BEFORE Phase 5 runs. Without it that check had nowhere to
  # record itself — it was told to "drop the finding", the closed vocabulary had
  # no code for it, and `out-of-scope` means "never raised", which is false for a
  # finding that was raised and then disproved.
  # ONE ordered list is both the vocabulary and the ranking, so the two cannot
  # drift. Order is weakest-hiding first: a merged group keeps the member
  # earliest in this list, which is the one a reader is most likely to see.
  # `refuted` sits last on purpose — it is the strongest removal there is (the
  # finding is asserted WRONG), so a refutation may never swallow a member that
  # is still merely suppressed, deferred or reported.
  ndisp = split("report unconfirmed demoted defer out-of-scope suppress refuted", DISPORDER, " ")
  for (i = 1; i <= ndisp; i++) { DISP[DISPORDER[i]] = 1; DRANK[DISPORDER[i]] = i }
  split("unverified prior-decision low-confidence pre-existing tool-covered style-only no-repro duplicate not-reachable accepted-risk baseline stale-api", a, " ")
  for (i in a) REASON[a[i]] = 1
  errs = 0; rows = 0; uniq = 0; dupes = 0; nadv = 0; nraised = 0
}

/^[[:space:]]*$/ { next }
/^[[:space:]]*#/ { next }

{
  rows++
  if (NF < 7) { fail(NR, "expected 7 tab-separated columns, got " NF); next }

  sev = $1; conf = $2; loc = $3; lens = $4; disp = $5; rsn = $6
  claim = $7
  for (i = 8; i <= NF; i++) claim = claim " " $i
  gsub(/^[[:space:]]+|[[:space:]]+$/, "", claim)
  gsub(/^[[:space:]]+|[[:space:]]+$/, "", lens)

  bad = 0
  if (!(sev in SEV))                        { fail(NR, "unknown severity \"" sev "\" (want P0|P1|P2|P3)"); bad = 1 }
  if (conf !~ /^[0-9]+$/ || conf + 0 > 100) { fail(NR, "confidence \"" conf "\" is not an integer 0-100");  bad = 1 }
  if (loc  !~ /^[^ \t]+:[0-9]+(-[0-9]+)?$/) { fail(NR, "location \"" loc "\" is not path:line");            bad = 1 }
  if (lens == "")                           { fail(NR, "lens is empty — every finding names the pass that raised it"); bad = 1 }
  if (!(disp in DISP))                      { fail(NR, "unknown disposition \"" disp "\"");                 bad = 1 }
  if (rsn != "-" && !(rsn in REASON))       { fail(NR, "unknown reason code \"" rsn "\"");                  bad = 1 }
  if (claim == "")                          { fail(NR, "claim is empty");                                   bad = 1 }

  # INVARIANT 1 — no silent drop.
  if (disp != "report" && rsn == "-") {
    fail(NR, "disposition \"" disp "\" carries no reason code — a finding may be demoted, never dropped silently"); bad = 1
  }
  if (disp == "report" && rsn != "-") {
    fail(NR, "disposition \"report\" must carry reason \"-\", got \"" rsn "\""); bad = 1
  }
  # INVARIANT 2 — reachability deprioritises, it never deletes.
  if (rsn == "not-reachable" && disp == "suppress") {
    fail(NR, "reason \"not-reachable\" may not suppress — deprioritise with \"defer\" or \"demoted\""); bad = 1
  }
  # INVARIANT 3 — top severity is never made to disappear.
  if ((sev == "P0" || sev == "P1") && disp == "suppress") {
    fail(NR, sev " may not be suppressed — defer it with a stated reason instead"); bad = 1
  }
  # INVARIANT 4 — "refuted" and "stale-api" pair exclusively. `refuted` is the
  # only disposition that removes a finding for being WRONG, and it is earned by
  # external evidence (current official docs, §4.5b), not by judgement. Bind the
  # two so it cannot spread into a general delete hatch, and so `stale-api`
  # cannot be attached to `suppress` to route a P0/P1 around Invariant 3.
  if ((disp == "refuted") != (rsn == "stale-api")) {
    fail(NR, "\"refuted\" and reason \"stale-api\" are only legal together — got disposition \"" disp "\" with reason \"" rsn "\""); bad = 1
  }
  # INVARIANT 5 — a documentary refutation carries its document. Invariant 4
  # binds the two LABELS; on its own it checks no evidence, so two tokens and an
  # opinion ("I do not think this is real") deleted a P0 that Invariant 3
  # forbids suppressing, and the ledger then asserted a doc check that never
  # happened. The URL is not decoration: it is the whole reason `refuted` is
  # allowed to do what `suppress` may not.
  if (disp == "refuted" && !hasdoc(claim)) {
    fail(NR, "\"refuted\" needs the document it refutes with — put the current-docs http(s) URL in the claim column (§4.5b step 3)"); bad = 1
  }

  if (bad) next

  cls = pathclass(loc)
  fp  = fingerprint(loc, claim)

  # Every ACCEPTED row records its location, so --reconcile can count rows per
  # location against the Phase 5d adjudicated set. Written per row, not per
  # unique finding: two lenses on one defect are two findings upstream.
  print loc >> locfile

  if (fp in SEEN) {
    dupes++
    if (!((fp SUBSEP lens) in LSEEN)) {
      LSEEN[fp SUBSEP lens] = 1
      LENSES[fp] = LENSES[fp] "|" lens
      CORROB[fp]++
    }
    # MERGE, never drop. Keeping the first-seen row and discarding this one is
    # how a suppressed P3 absorbed a reported P0: same location, same opening
    # phrase, and row order decided which survived.
    #
    # Every field kept below is the MINIMUM of a total order over the group, so
    # the merged record is a function of the SET of rows and not of the order
    # they arrived in. The earlier version was order-dependent in three separate
    # places even where disprank differed: the surviving CLAIM was simply the
    # first-seen one among equally severe members, the lens list was in arrival
    # order, and — worst — the Merges section recorded a collapse only when a
    # LATER row beat an earlier one, so the identical two rows reported
    # `merges-raised=1` in one order and `merges-raised=0` in the other.
    #
    # Framing: (severity, -confidence, claim). The most severe member owns the
    # framing; ties break on confidence, then lexically, so there is always
    # exactly one winner.
    better = 0
    if (sevrank(sev) < sevrank(SEV_[fp])) better = 1
    else if (sevrank(sev) == sevrank(SEV_[fp])) {
      if (conf + 0 > CONF[fp] + 0) better = 1
      else if (conf + 0 == CONF[fp] + 0 && claim < CLAIM[fp]) better = 1
    }
    if (better) { SEV_[fp] = sev; CLAIM[fp] = claim; CONF[fp] = conf }
    # The WEAKEST — most visible — disposition wins, and it brings its own
    # reason with it, or invariant 1 would see `report` carrying `baseline`.
    # Rank is total, so equal rank means the identical disposition; the reason
    # is then broken lexically to keep even that corner deterministic.
    if (disprank(disp) < disprank(DISP_[fp])) {
      TALLY[DISP_[fp]]--
      DISP_[fp] = disp; RSN[fp] = rsn
      TALLY[disp]++
    } else if (disprank(disp) == disprank(DISP_[fp]) && rsn < RSN[fp]) {
      RSN[fp] = rsn
    }
    # The extremes of the group, tracked independently of arrival order. They
    # are what the Merges section reports as the "from" side, and what decides
    # whether this collapse changed anything at all.
    if (sevrank(sev) > sevrank(SEVWORST[fp])) SEVWORST[fp] = sev
    if (disprank(disp) > disprank(DISPMOST[fp])) DISPMOST[fp] = disp
    MEMBERS[fp]++
    next
  }
  SEEN[fp] = 1; order[++uniq] = fp
  SEV_[fp] = sev; CONF[fp] = conf; LOC[fp] = loc; DISP_[fp] = disp
  RSN[fp] = rsn; CLAIM[fp] = claim; CLS[fp] = cls
  LENSES[fp] = lens; LSEEN[fp SUBSEP lens] = 1; CORROB[fp] = 1
  SEVWORST[fp] = sev; DISPMOST[fp] = disp; MEMBERS[fp] = 1
  TALLY[disp]++
}

END {
  if (errs > 0) exit 4

  # The invariants ran per row on the way in; run them AGAIN on the merged
  # record, because merging is what changes the severity and disposition of a
  # finding. A per-row-only check cannot see suppression by absorption.
  # RENDER ORDER is part of the output, so it must be a function of the finding
  # SET too. `order[]` is arrival order; sort it on a total key — severity, then
  # location, then fingerprint — so two runs over the same rows in different
  # orders produce byte-identical pages. Insertion sort: portable across awks,
  # and `uniq` counts the findings in one review, not a data set.
  for (i = 2; i <= uniq; i++) {
    keyfp = order[i]; keysort = sortkey(keyfp)
    for (j = i - 1; j >= 1 && sortkey(order[j]) > keysort; j--) order[j+1] = order[j]
    order[j+1] = keyfp
  }

  for (i = 1; i <= uniq; i++) {
    fp = order[i]
    # INVARIANT 5 on the merged record: a refutation must not acquire its
    # evidence by being merged with a differently-worded row, nor lose it.
    if (DISP_[fp] == "refuted" && !hasdoc(CLAIM[fp]))
      failmerged(LOC[fp], "merged disposition \"refuted\" carries no current-docs http(s) URL — a documentary refutation must carry its document")
    # A collapse that changed severity or disposition is a decision about what
    # the reader sees, so it is recorded. Comparing the extremes of the group makes
    # that a property of the set: the same two rows used to be listed here in
    # one order and silently dropped in the other.
    if (SEVWORST[fp] != SEV_[fp] || DISPMOST[fp] != DISP_[fp]) RAISED[fp] = 1
    if (DISP_[fp] != "report" && RSN[fp] == "-")
      failmerged(LOC[fp], "merged disposition \"" DISP_[fp] "\" carries no reason code")
    if (DISP_[fp] == "report" && RSN[fp] != "-")
      failmerged(LOC[fp], "merged disposition \"report\" must carry reason \"-\", got \"" RSN[fp] "\"")
    if (RSN[fp] == "not-reachable" && DISP_[fp] == "suppress")
      failmerged(LOC[fp], "merged reason \"not-reachable\" may not suppress — deprioritise with \"defer\" or \"demoted\"")
    if ((SEV_[fp] == "P0" || SEV_[fp] == "P1") && DISP_[fp] == "suppress")
      failmerged(LOC[fp], SEV_[fp] " may not be suppressed — a merge must not absorb top severity into a suppressed row")
    # Exposure advisories are a property of the merged record too: a row that
    # only became `report` through a merge still deserves the vendor warning.
    if (DISP_[fp] == "report" && (CLS[fp] == "vendor" || CLS[fp] == "generated"))
      advisories[++nadv] = LOC[fp] " (" CLS[fp] ") is reported but is not authored here — check it is not noise"
    if (RAISED[fp]) nraised++
  }
  if (errs > 0) exit 4

  if (rows == 0 && recon == "")
    advisories[++nadv] = "source ledger holds 0 findings and was not reconciled — an empty page certifies nothing; pass --reconcile"

  print "# Review triage ledger"                                              >> render
  print ""                                                                    >> render
  print "- generated: " today                                                 >> render
  print "- source ledger: `" src "`"                                          >> render
  print "- findings in: " rows "  |  unique after dedup: " uniq "  |  duplicates collapsed: " dupes >> render
  if (recon != "") print "- reconciled against: `" recon "`"                  >> render
  print ""                                                                    >> render
  if (recon != "") {
    print "Every finding this review raised is on this page, and that is a"    >> render
    print "checked fact, not a promise: the ledger was reconciled row-for-row" >> render
    print "against the adjudicated set above, and nothing renders if a finding">> render
    print "is missing."                                                        >> render
  } else {
    print "Every finding RECORDED IN THE SOURCE LEDGER is on this page, but"   >> render
    print "completeness against Phase 5 was NOT verified — rerun with"         >> render
    print "`--reconcile {OUTPUT_DIR}/findings.adjudicated.jsonl` to make that" >> render
    print "claim machine-checked rather than asserted."                        >> render
  }
  print ""                                                                     >> render
  print "A finding may be demoted, deferred, or suppressed — but only with a"  >> render
  print "recorded reason code, never by going quiet. `exposure` is a"          >> render
  print "deterministic path classification (a blast-radius annotation, not a"  >> render
  print "filter); `corrob` is how many independent passes flagged the same"    >> render
  print "defect. Rows sharing a fingerprint MERGE — highest severity, weakest" >> render
  print "disposition — and every merge that changed either is listed below."   >> render
  print ""                                                                     >> render
  print "## Disposition tally"                                                >> render
  print ""                                                                    >> render
  print "| disposition | count |"                                             >> render
  print "|---|---|"                                                           >> render
  for (i = 1; i <= ndisp; i++) printf("| %s | %d |\n", DISPORDER[i], TALLY[DISPORDER[i]] + 0) >> render

  section("Reported — main report", "report")
  section("Unconfirmed — kept deliberately, nobody could verify at the source", "unconfirmed")
  section("Demoted (prior decision) — still active, ranked lower", "demoted")
  section("Deferred — real, out of scope for this diff", "defer")
  section("Suppressed by baseline — with a recorded reason", "suppress")
  section("Refuted — raised, then disproved against current official docs", "refuted")
  section("Out of scope — never raised, per Phase 4 emission scope", "out-of-scope")

  # The merge itself is a decision about what the reader sees, so it is on the
  # page like every other decision. Without this, a P0 rescued from a
  # suppressed P3 would look like it had simply always been reported.
  print ""                                                                     >> render
  print "## Merges — collapsed rows that changed severity or disposition (" nraised + 0 ")" >> render
  print ""                                                                     >> render
  if (nraised + 0 == 0) {
    print "_none_"                                                             >> render
  } else {
    print "| location | rows | severity | disposition | finding kept |"        >> render
    print "|---|---|---|---|---|"                                              >> render
    for (i = 1; i <= uniq; i++) {
      fp = order[i]
      if (!RAISED[fp]) continue
      printf("| `%s` | %d | %s → %s | %s → %s | %s |\n", cellsafe(LOC[fp]), MEMBERS[fp], \
             SEVWORST[fp], SEV_[fp], DISPMOST[fp], DISP_[fp], cellsafe(CLAIM[fp])) >> render
    }
  }

  print "TALLY report=" TALLY["report"] + 0 " unconfirmed=" TALLY["unconfirmed"] + 0 \
        " demoted=" TALLY["demoted"] + 0 " defer=" TALLY["defer"] + 0 \
        " suppress=" TALLY["suppress"] + 0 " out-of-scope=" TALLY["out-of-scope"] + 0 \
        " refuted=" TALLY["refuted"] + 0 \
        " unique=" uniq " collapsed=" dupes " merges-raised=" nraised + 0
  for (i = 1; i <= nadv; i++) print "ADVISORY " advisories[i]
  exit 0
}
' "$SRC" > "$WORK/tally.txt"
rc=$?

if [ "$rc" -eq 4 ]; then
  echo -e "${CYA}FAIL${RST} triage ledger is invalid — nothing rendered:" >&2
  cat "$ERRS" >&2
  exit 4
fi
if [ "$rc" -ne 0 ]; then
  echo -e "${CYA}FAIL${RST} triage render failed (awk exit $rc)" >&2
  exit 4
fi

# RECONCILIATION — the page's completeness claim, checked instead of asserted.
# "Write the complete merged set" was prose enforced nowhere: a TSV of nothing
# but comments rendered six `_none_` sections and exited 0, certifying that
# every finding was on a page listing none. Phase 5d already emits the
# adjudicated set, so the check is deterministic: count findings per
# `file:start_line` on both sides and refuse to render if the ledger is short.
if [ -n "$RECON" ]; then
  if ! RECON_ERR="$(python3 - "$RECON" "$LOCS" <<'PY'
import collections, json, sys

adj_path, loc_path = sys.argv[1], sys.argv[2]
want = collections.Counter()
problems = []
with open(adj_path, encoding="utf-8") as fh:
    for n, line in enumerate(fh, 1):
        line = line.strip()
        if not line:
            continue
        try:
            obj = json.loads(line)
        except ValueError as exc:
            problems.append(f"  {adj_path}:{n}: not JSON ({exc})")
            continue
        if not isinstance(obj, dict):
            problems.append(f"  {adj_path}:{n}: finding is not a JSON object")
            continue
        f, ln = obj.get("file"), obj.get("start_line")
        if not f or ln is None:
            problems.append(f"  {adj_path}:{n}: finding has no file/start_line to reconcile")
            continue
        want[f"{f}:{ln}"] += 1

have = collections.Counter()
with open(loc_path, encoding="utf-8") as fh:
    for line in fh:
        line = line.strip()
        if line:
            have[line] += 1

for loc, n in sorted(want.items()):
    got = have.get(loc, 0)
    if got < n:
        problems.append(
            f"  {loc}: adjudicated set has {n} finding(s), ledger has {got} row(s)"
            " — a finding left the review without a disposition"
        )
if problems:
    print("\n".join(problems))
    sys.exit(1)
PY
  )"; then
    echo -e "${CYA}FAIL${RST} ledger does not account for every adjudicated finding — nothing rendered:" >&2
    echo "$RECON_ERR" >&2
    exit 4
  fi
fi

if [ -n "$OUT" ]; then
  mkdir -p "$(dirname "$OUT")" 2>/dev/null
  cp "$RENDER" "$OUT" || exit 3
  echo -e "${GRN}ledger${RST} → $OUT"
else
  cat "$RENDER"
fi

while IFS= read -r line; do
  case "$line" in
    TALLY*)    echo -e "${GRN}${line}${RST}" ;;
    ADVISORY*) echo -e "${YEL}${line}${RST}" >&2 ;;
  esac
done < "$WORK/tally.txt"

exit 0
