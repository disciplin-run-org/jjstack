#!/usr/bin/env bash
# jjstack-review-autofix-diff — emit the code a review's fix-first step wrote.
#
# gstack's /review Step 5 is "Fix-First": it classifies findings and AUTO-APPLIES
# the ones it judges safe. That auto-applied code is a diff nobody ever reads —
# the reviewer wrote it, so no reviewer reviews it. It can be wrong, incomplete,
# or introduce a fresh bug, and today nothing looks at it before it lands.
#
# This script does the deterministic half of closing that hole: produce the
# auto-fix diff as a reviewable unit. The judgment half (re-reviewing it) is the
# skill's job. No model inference here — just git plumbing.
#
# Baseline resolution, in order:
#   1. --baseline REF          explicit
#   2. the marker written by --mark (taken before the fixing step ran). --mark
#      also snapshots the untracked files BY CONTENT, because `git stash create`
#      captures the index and the tracked worktree and ignores untracked files by
#      design — without that second half, a file the user wrote before the review
#      comes back to them as "new untracked", i.e. as a finding against their own
#      work.
#   3. HEAD                    fallback: everything uncommitted is assumed
#                              review-authored. Reported, so the caller can say
#                              so instead of silently over-claiming.
#
# Usage:
#   jjstack-review-autofix-diff [--repo DIR] [--mark]
#                               [--baseline REF] [--stat] [--dry-run]
#
# Exit: 0 diff emitted (or --mark/--dry-run ok), 2 usage error,
#       3 not a git repo or no commits, 4 no changes since baseline.
#
# Every exit above is a statement about the REPO, never about the caller's
# argv, and the only usage error is a malformed invocation. A repo shape the
# tool cannot serve exits 3 so the caller can skip the pass and say why.
#
# No color red anywhere — unreadable on the target terminal.
set -uo pipefail

YEL="\033[33m"; CYA="\033[96m"; GRN="\033[32m"; RST="\033[0m"

# Help is DERIVED from the leading comment block, never a hand-maintained
# `sed -n 'A,Bp'` range. A range silently drifts the moment a line is added,
# which is how this help came to leak `set -uo pipefail` into its own output.
show_help() {
  awk 'NR == 1 && /^#!/ { next }
       /^#/                { sub(/^# ?/, ""); print; next }
       { exit }' "$0"
}

# A flag that takes a value must GET one. `shift 2` is a silent no-op when only
# one argument remains, so the loop would spin on the same argv forever (and
# `set -e` is deliberately off here, so nothing stops it). Verified: this script
# returned 124 under `timeout 5` for `--baseline` with no value.
need_val() { # need_val <flag> <remaining argc, i.e. "$#">
  [ "$2" -ge 2 ] && return 0
  echo -e "${CYA}error${RST} $1 requires a value" >&2
  exit 2
}

REPO=""
BASELINE=""
MARK=0
STAT=0
DRY=0

while [ $# -gt 0 ]; do
  case "$1" in
    --repo)     need_val "$1" "$#"; REPO="$2"; shift 2 ;;
    --baseline) need_val "$1" "$#"; BASELINE="$2"; shift 2 ;;
    --mark)     MARK=1; shift ;;
    --stat)     STAT=1; shift ;;
    --dry-run)  DRY=1; shift ;;
    -h|--help)  show_help; exit 0 ;;
    *) echo -e "${CYA}error${RST} unexpected arg: $1" >&2; exit 2 ;;
  esac
done

[ -z "$REPO" ] && REPO="$PWD"
if [ ! -d "$REPO" ]; then
  echo -e "${CYA}error${RST} no such directory: $REPO" >&2; exit 3
fi

ROOT="$(git -C "$REPO" rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$ROOT" ]; then
  echo -e "${YEL}warn${RST}  not a git repo: $REPO" >&2
  echo -e "${YEL}warn${RST}  cannot isolate the auto-fix diff — skip this pass and say so." >&2
  exit 3
fi

# Marker lives outside the repo: it is scratch state for one review, never
# something to commit.
SLUG="$(printf '%s' "$ROOT" | tr '/' '-')"
STATE="${XDG_CACHE_HOME:-$HOME/.cache}/jjstack/review/$SLUG"
MARKER="$STATE/autofix-baseline"
UNTRACKED_SNAPSHOT="$STATE/autofix-untracked"

# "<blob-hash><TAB><path>" per record, NUL-TERMINATED.
#
# `-z` is not a nicety: core.quotePath is on by default, so plain `ls-files
# --others` hands back `"r\303\251sum\303\251.md"` for `résumé.md`. hash-object
# on that literal fails, the file drops out of the snapshot, and at diff time the
# same quoted name misses the lookup — so the USER's file is reported as new work
# the review wrote, under a header saying pre-existing files were excluded. A
# path is a byte string: read it as one.
#
# NUL between records because a path may legally contain a newline; TAB inside a
# record because a blob hash never contains one.
snapshot_untracked() {
  git -C "$ROOT" ls-files -z --others --exclude-standard | while IFS= read -r -d '' f; do
    [ -n "$f" ] || continue
    h="$(git -C "$ROOT" hash-object -- "$f" 2>/dev/null)"
    if [ -z "$h" ]; then
      # Never silent. A file missing from the snapshot comes back to the user as
      # a P1 against their own work, so say so at the moment it is dropped.
      echo -e "${YEL}warn${RST}  cannot hash untracked file — it will read as new: $f" >&2
      continue
    fi
    printf '%s\t%s\0' "$h" "$f"
  done
}

snapshot_count() { # snapshot_count <file> — RECORDS, not lines
  [ -f "$1" ] || { echo 0; return; }
  tr -dc '\0' < "$1" | wc -c | tr -d ' '
}

# The tracked half needs a commit to lean on, and `git rev-parse HEAD` on an
# unborn HEAD PRINTS the four characters "HEAD" on stdout and exits 128 — so the
# stdout of a git command is never the truth, its exit status is. `--verify
# --quiet` reports the state as emptiness, which is what the caller can test.
HEAD_COMMIT="$(git -C "$ROOT" rev-parse --verify --quiet 'HEAD^{commit}' 2>/dev/null)"
if [ -z "$HEAD_COMMIT" ]; then
  echo -e "${YEL}warn${RST}  repo has no commits — nothing to baseline against" >&2
  echo -e "${YEL}warn${RST}  cannot isolate the auto-fix diff — skip this pass and say so." >&2
  exit 3
fi

if [ "$MARK" -eq 1 ]; then
  # `git stash create` snapshots a dirty tree as a dangling commit WITHOUT
  # touching the working tree or the stash list. On a clean tree it prints
  # nothing — and, like every git command here, anything it prints is only a
  # baseline once git confirms it is a commit.
  snap="$(git -C "$ROOT" stash create 2>/dev/null | tr -d '[:space:]')"
  if [ -n "$snap" ]; then
    git -C "$ROOT" rev-parse --verify --quiet "$snap^{commit}" >/dev/null 2>&1 || snap=""
  fi
  [ -z "$snap" ] && snap="$HEAD_COMMIT"
  if [ "$DRY" -eq 1 ]; then
    echo "[dry-run] would mark baseline $snap -> $MARKER"
    exit 0
  fi
  mkdir -p "$STATE" || exit 3
  printf '%s\n' "$snap" > "$MARKER"
  snapshot_untracked > "$UNTRACKED_SNAPSHOT" || exit 3
  echo -e "${GRN}marked${RST} baseline $snap ($(snapshot_count "$UNTRACKED_SNAPSHOT") untracked file(s) snapshotted)"
  exit 0
fi

SOURCE="explicit --baseline"
FROM_MARKER=0
if [ -z "$BASELINE" ] && [ -f "$MARKER" ]; then
  BASELINE="$(tr -d '[:space:]' < "$MARKER")"
  SOURCE="marker taken before the fixing step"
  FROM_MARKER=1
fi
if [ -z "$BASELINE" ]; then
  BASELINE="HEAD"
  SOURCE="fallback HEAD (no marker) — treats ALL uncommitted work as review-authored"
fi

if ! git -C "$ROOT" rev-parse --verify --quiet "$BASELINE^{commit}" >/dev/null 2>&1; then
  echo -e "${CYA}error${RST} baseline is not a commit: $BASELINE" >&2
  exit 2
fi

# Everything below reads paths as NUL-delimited byte strings, for the same
# reason the snapshot writes them that way.
UNTRACKED=(); mapfile -d '' UNTRACKED < <(git -C "$ROOT" ls-files -z --others --exclude-standard)

# The tracked half of "what did the review touch" is `git diff <baseline>`, and
# the baseline commit already carries the user's pre-existing tracked edits,
# staged changes, deletions and the delete-half of a rename. The UNTRACKED half
# has no such commit to lean on — `git stash create` ignores untracked files by
# design — so it is diffed against the --mark snapshot here. Ignored files are
# outside both halves on purpose (--exclude-standard): build output is nobody's
# review finding.
NEW_FILES=(); CHANGED_FILES=(); GONE_FILES=(); RECLAIMED=(); PRE_COUNT=0
declare -A SNAP=()
declare -A NOW_UNTRACKED=()

# Only a snapshot that PAIRS with this baseline may be subtracted. An explicit
# --baseline names a commit, which says nothing about what was untracked then.
if [ "$FROM_MARKER" -eq 1 ] && [ -f "$UNTRACKED_SNAPSHOT" ]; then
  PRE_COUNT="$(snapshot_count "$UNTRACKED_SNAPSHOT")"
  while IFS= read -r -d '' rec; do
    [ -n "$rec" ] || continue
    SNAP["${rec#*$'\t'}"]="${rec%%$'\t'*}"
  done < "$UNTRACKED_SNAPSHOT"
  for f in "${UNTRACKED[@]}"; do
    [ -n "$f" ] || continue
    NOW_UNTRACKED["$f"]=1
    if [ -z "${SNAP[$f]+set}" ]; then
      NEW_FILES+=("$f")
    else
      now="$(git -C "$ROOT" hash-object -- "$f" 2>/dev/null)"
      [ "$now" != "${SNAP[$f]}" ] && CHANGED_FILES+=("$f")
    fi
  done
  # A snapshot path that is no longer untracked left the set one of two ways.
  for p in "${!SNAP[@]}"; do
    [ -n "${NOW_UNTRACKED[$p]+set}" ] && continue
    if [ ! -e "$ROOT/$p" ]; then
      # The review deleted a file the user had. That is the review's work too.
      GONE_FILES+=("$p")
      continue
    fi
    # ...or the user STAGED it. Staging does not turn the user's file into the
    # review's: it only moves it out of the untracked set, where the snapshot
    # can no longer speak for it. `git stash create` never captured it either,
    # so `git diff <marker>` would show the whole file as an addition. Exclude
    # it — but only while its bytes still match the snapshot, because content
    # the review changed after the marker is the review's work, tracked or not.
    now="$(git -C "$ROOT" hash-object -- "$p" 2>/dev/null)"
    [ "$now" = "${SNAP[$p]}" ] && RECLAIMED+=("$p")
  done
else
  for f in "${UNTRACKED[@]}"; do [ -n "$f" ] && NEW_FILES+=("$f"); done
fi

# ONE definition of the diff's scope, used by the name listing, the emptiness
# test and the diff itself — a second copy is a second chance to disagree.
DIFF_SCOPE=("$BASELINE")
if [ "${#RECLAIMED[@]}" -gt 0 ]; then
  DIFF_SCOPE+=(-- ".")
  for p in "${RECLAIMED[@]}"; do DIFF_SCOPE+=(":(exclude,literal)$p"); done
fi
CHANGED=(); mapfile -d '' CHANGED < <(git -C "$ROOT" diff -z --name-only "${DIFF_SCOPE[@]}" 2>/dev/null)

if [ "$DRY" -eq 1 ]; then
  echo "[dry-run] repo:     $ROOT"
  echo "[dry-run] baseline: $BASELINE ($SOURCE)"
  echo "[dry-run] tracked changes:    ${#CHANGED[@]}"
  echo "[dry-run] untracked new:      ${#NEW_FILES[@]}"
  echo "[dry-run] untracked changed:  ${#CHANGED_FILES[@]}"
  echo "[dry-run] untracked removed:  ${#GONE_FILES[@]}"
  echo "[dry-run] pre-existing untracked at the marker (excluded): $PRE_COUNT"
  echo "[dry-run] of those, staged since the marker and still unchanged: ${#RECLAIMED[@]}"
  exit 0
fi

if [ "${#CHANGED[@]}" -eq 0 ] && [ "${#NEW_FILES[@]}" -eq 0 ] \
   && [ "${#CHANGED_FILES[@]}" -eq 0 ] && [ "${#GONE_FILES[@]}" -eq 0 ]; then
  echo -e "${YEL}skip${RST}  no changes since $BASELINE — the review applied no auto-fixes."
  exit 4
fi

echo "# auto-fix diff"
echo "# repo:     $ROOT"
echo "# baseline: $BASELINE"
echo "# source:   $SOURCE"
if [ "$FROM_MARKER" -eq 1 ]; then
  echo "# untracked: $PRE_COUNT file(s) already present at the marker, excluded below"
  [ "${#RECLAIMED[@]}" -gt 0 ] && \
    echo "# untracked: ${#RECLAIMED[@]} of those staged since, still the user's — excluded from the tracked diff"
else
  echo "# untracked: no snapshot — every untracked file is listed as new"
fi
echo

if [ "${#NEW_FILES[@]}" -gt 0 ]; then
  echo "## new untracked files (not in the diff below — read them in full)"
  printf '%s\n' "${NEW_FILES[@]}"
  echo
fi

if [ "${#CHANGED_FILES[@]}" -gt 0 ]; then
  echo "## untracked files that existed at the marker and changed since (read them in full)"
  printf '%s\n' "${CHANGED_FILES[@]}"
  echo
fi

if [ "${#GONE_FILES[@]}" -gt 0 ]; then
  echo "## untracked files that existed at the marker and are now gone"
  printf '%s\n' "${GONE_FILES[@]}"
  echo
fi

if [ "${#CHANGED[@]}" -gt 0 ]; then
  echo "## tracked changes"
  if [ "$STAT" -eq 1 ]; then
    git -C "$ROOT" diff --stat "${DIFF_SCOPE[@]}"
  else
    git -C "$ROOT" diff "${DIFF_SCOPE[@]}"
  fi
fi

exit 0
