#!/usr/bin/env bash
# jjstack-capture-review-refs — snapshot gstack's durable review docs into a repo.
#
# The gstack review rubric (checklist, specialist definitions, Review Army and
# adversarial procedures) is what produces a /review's findings, but it lives
# only in the global gstack clone — which /gstack-upgrade rebuilds with
# `git reset --hard`. When the rubric changes, past findings become
# unreproducible and unauditable with no trace of why.
#
# So the jjstack /review wrapper calls this to copy the long-term-relevant docs
# into the version-controlled repo alongside the findings. Deterministic file
# I/O: an explicit allowlist, no judgment, no model inference. Build artifacts
# (*.tmpl, manifest.json) and the procedural SKILL.md are excluded — only
# reference material that stays meaningful months later is kept.
#
# Usage:
#   jjstack-capture-review-refs <dest-dir> [--gstack-review-dir DIR] [--dry-run]
#
# Exit: 0 captured (or dry-run ok), 2 usage error, 3 source dir missing.
#
# No color red anywhere — unreadable on the target terminal.
set -uo pipefail

YEL="\033[33m"; CYA="\033[96m"; GRN="\033[32m"; RST="\033[0m"

DEST=""
SRC="$HOME/.claude/skills/gstack/review"
DRY=0

while [ $# -gt 0 ]; do
  case "$1" in
    --gstack-review-dir) SRC="${2:-}"; shift 2 ;;
    --dry-run)           DRY=1; shift ;;
    -h|--help)
      sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'
      exit 0 ;;
    -*) echo -e "${CYA}error${RST} unknown flag: $1" >&2; exit 2 ;;
    *)  [ -z "$DEST" ] && DEST="$1" || { echo -e "${CYA}error${RST} unexpected arg: $1" >&2; exit 2; }
        shift ;;
  esac
done

[ -z "$DEST" ] && { echo -e "${CYA}error${RST} usage: $(basename "$0") <dest-dir> [--gstack-review-dir DIR] [--dry-run]" >&2; exit 2; }

if [ ! -d "$SRC" ]; then
  echo -e "${YEL}warn${RST}  gstack review dir not found: $SRC" >&2
  echo -e "${YEL}warn${RST}  nothing captured — is gstack installed?" >&2
  exit 3
fi

# Top-level docs worth keeping. Anything not named here is deliberately skipped.
TOP_DOCS="checklist.md design-checklist.md greptile-triage.md TODOS-format.md"

copied=0
say() { [ "$DRY" -eq 1 ] && echo "  [dry-run] $1" || echo "  $1"; }

if [ "$DRY" -eq 0 ]; then
  mkdir -p "$DEST/specialists" "$DEST/sections" || exit 3
fi

for f in $TOP_DOCS; do
  [ -f "$SRC/$f" ] || continue
  [ "$DRY" -eq 0 ] && cp "$SRC/$f" "$DEST/$f"
  say "$f"; copied=$((copied + 1))
done

# Specialist definitions and section procedures: all .md, never .tmpl.
for sub in specialists sections; do
  [ -d "$SRC/$sub" ] || continue
  for f in "$SRC/$sub"/*.md; do
    [ -f "$f" ] || continue
    case "$f" in *.tmpl) continue ;; esac
    [ "$DRY" -eq 0 ] && cp "$f" "$DEST/$sub/"
    say "$sub/$(basename "$f")"; copied=$((copied + 1))
  done
done

# Provenance: which gstack this rubric came from, so a stale snapshot is obvious.
VER="$(tr -d '[:space:]' < "$(dirname "$SRC")/VERSION" 2>/dev/null)"
COMMIT="$(git -C "$(dirname "$SRC")" rev-parse --short HEAD 2>/dev/null)"
if [ "$DRY" -eq 0 ]; then
  {
    echo "# gstack review reference snapshot"
    echo
    echo "- gstack version: ${VER:-unknown}"
    echo "- gstack commit:  ${COMMIT:-unknown}"
    echo "- captured:       $(date +%F)"
    echo "- source:         $SRC"
    echo
    echo "Durable gstack review docs, captured by the jjstack /review wrapper so"
    echo "the rubric that produced this review stays under version control."
    echo "Build artifacts (*.tmpl, manifest.json) and the procedural SKILL.md are"
    echo "excluded on purpose — only long-term reference material is kept."
    echo "Regenerate with: bin/jjstack-capture-review-refs <dest>"
  } > "$DEST/PROVENANCE.md"
fi
say "PROVENANCE.md (gstack ${VER:-unknown} @ ${COMMIT:-unknown})"

echo -e "${GRN}captured${RST} $copied doc(s) → $DEST"
exit 0
