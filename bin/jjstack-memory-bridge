#!/bin/bash
# jjstack-memory-bridge — bridge curated Claude memory files into gbrain
# as learning pages.
#
# Reads ~/.claude/projects/<slug>/memory/*.md and writes each as a JSON
# entry to ~/.gstack/projects/<slug>/learnings.jsonl, which gbrain's
# native ingest picks up.
#
# Tagging:
#   - project:<slug>            applied to every memory
#   - memory-type:<type>        from the memory file's frontmatter `type` field
#   - ecosystem:<name>          applied ONLY on explicit owner promotion:
#       * frontmatter scope: ecosystem      → ecosystem:disciplin-run
#       * frontmatter promoted: true        → ecosystem:disciplin-run
#       * frontmatter ecosystem: <name>     → ecosystem:<name>
#       * bridge invoked with --ecosystem <name>  → ecosystem:<name>
#     NEVER applied based on slug substring. Per-project memories stay
#     project-scoped until the owner explicitly promotes them.
#
# PHI / sensitive-data refusal:
#   gbrain is a single shared local vector index across all projects.
#   PHI and personal records MUST NEVER be bridged into it. The bridge
#   refuses any slug whose memory dir carries an opt-out marker:
#     * presence of `~/.claude/projects/<slug>/memory/.no-gbrain` file
#     * any memory file with frontmatter `sensitivity: phi`
#     * MEMORY.md with frontmatter `sensitivity: phi`
#   Refusal is exit code 4 with a clear message. The /groom skill
#   detects the same markers and uses a native no-gbrain path.
#
# Usage:
#   jjstack-memory-bridge --slug <project-slug>      # one project
#   jjstack-memory-bridge --all                       # every project under ~/.claude/projects/
#   jjstack-memory-bridge --self-test                 # bridge ONLY jjstack's own memory (~6 files)
#   jjstack-memory-bridge --dry-run                   # print what would be written, do not write
#   jjstack-memory-bridge --ingest                    # after writing jsonl, also call `gbrain put`
#                                                       on each entry so gbrain query finds them
#                                                       without waiting for gstack-memory-ingest.
#                                                       Requires the `gbrain` CLI on PATH.
#   jjstack-memory-bridge --ecosystem <name>          # add the ecosystem:<name> tag to every page
#                                                       bridged in this run. Use only when the
#                                                       owner of the project is explicitly
#                                                       promoting its memories ecosystem-wide
#                                                       (rare). Default is no auto-promotion;
#                                                       ecosystem: tag comes from per-memory
#                                                       frontmatter or from this flag — never
#                                                       from the slug name.
#   jjstack-memory-bridge --sync                      # after --ingest, also DELETE gbrain pages
#                                                       tagged project:<slug> that have no
#                                                       corresponding source file. Catches the
#                                                       rename/delete/merge case where --ingest
#                                                       alone leaves orphan pages polluting
#                                                       query results. Requires --ingest. Use
#                                                       this in /groom Phase 6 re-index.
#
# Idempotent: rewrites the target jsonl file each run; --ingest upserts
# each entry into gbrain (overwriting any previous version of the same
# slug).

set -uo pipefail

# ─── Parse args ──────────────────────────────────────────────────────
SLUG=""
ALL=0
SELF_TEST=0
DRY_RUN=0
INGEST=0
SYNC=0
FORCE_ECOSYSTEM=""
while [ $# -gt 0 ]; do
    case "$1" in
        --slug) SLUG="$2"; shift 2 ;;
        --all) ALL=1; shift ;;
        --self-test) SELF_TEST=1; shift ;;
        --dry-run) DRY_RUN=1; shift ;;
        --ingest) INGEST=1; shift ;;
        --sync) SYNC=1; shift ;;
        --ecosystem) FORCE_ECOSYSTEM="$2"; shift 2 ;;
        --help|-h) sed -n '2,40p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "unknown flag: $1" >&2; exit 2 ;;
    esac
done

if [ "$SYNC" = "1" ] && [ "$INGEST" = "0" ]; then
    echo "--sync requires --ingest (otherwise there's no gbrain side to sync against)" >&2
    exit 2
fi

if [ "$SELF_TEST" = "1" ]; then
    SLUG="-home-jesper-PycharmProjects-jjstack"
fi

if [ -z "$SLUG" ] && [ "$ALL" = "0" ]; then
    echo "Specify --slug <project-slug>, --all, or --self-test." >&2
    exit 2
fi

MEMORY_ROOT="$HOME/.claude/projects"
LEARNINGS_ROOT="$HOME/.gstack/projects"

# ─── Helpers ─────────────────────────────────────────────────────────

extract_frontmatter() {
    local file="$1"
    awk '/^---$/{p++; next} p==1' "$file" 2>/dev/null
}

extract_body() {
    local file="$1"
    awk '/^---$/{p++; next} p>=2' "$file" 2>/dev/null
}

field() {
    local fm="$1"
    local key="$2"
    echo "$fm" | awk -v k="$key" '
        $0 ~ "^" k ":" {
            sub("^" k ":[[:space:]]*", "")
            gsub(/^["'\'']|["'\'']$/, "")
            print
            exit
        }
    '
}

is_slug_opted_out() {
    # Defense in depth against bridging PHI into the shared gbrain index.
    # Returns 0 (true) if any opt-out marker is present in the slug's
    # memory dir; the caller MUST refuse the bridge in that case.
    #
    # Markers (any one is sufficient):
    #   1. ~/.claude/projects/<slug>/memory/.no-gbrain       — file present
    #   2. MEMORY.md frontmatter has `sensitivity: phi`
    #   3. any *.md frontmatter has `sensitivity: phi`
    local slug="$1"
    local mem_dir="$MEMORY_ROOT/$slug/memory"
    [ ! -d "$mem_dir" ] && return 1

    [ -f "$mem_dir/.no-gbrain" ] && return 0

    if [ -f "$mem_dir/MEMORY.md" ]; then
        grep -qE '^[[:space:]]*sensitivity:[[:space:]]*phi' "$mem_dir/MEMORY.md" 2>/dev/null && return 0
    fi

    grep -lE '^[[:space:]]*sensitivity:[[:space:]]*phi' "$mem_dir"/*.md 2>/dev/null | head -1 | grep -q . && return 0

    return 1
}

is_ecosystem_scope() {
    # Apply `ecosystem:<name>` tag ONLY on explicit owner promotion:
    #   - frontmatter scope: ecosystem
    #   - frontmatter promoted: true
    #   - frontmatter ecosystem: <name>   (lists the ecosystem the memory belongs to)
    # The slug-contains heuristic was wrong (disciplin-run-tm bug report 2026-05-31):
    # it auto-tagged every project-local memory in any slug containing
    # "disciplin-run", defeating the selective-promotion design in plan A2 /
    # decision #6. Project-local memories should stay project-scoped until
    # /groom's ecosystem-promotion step (or this bridge's --ecosystem flag)
    # explicitly promotes them.
    local fm="$1"
    if echo "$fm" | grep -qE '^[[:space:]]*scope:[[:space:]]*ecosystem' 2>/dev/null; then return 0; fi
    if echo "$fm" | grep -qE '^promoted:[[:space:]]*true' 2>/dev/null; then return 0; fi
    if echo "$fm" | grep -qE '^ecosystem:[[:space:]]*' 2>/dev/null; then return 0; fi
    return 1
}

# ─── Build one project's learnings.jsonl ─────────────────────────────
bridge_project() {
    local slug="$1"
    local memory_dir="$MEMORY_ROOT/$slug/memory"
    local out_dir="$LEARNINGS_ROOT/$slug"
    local out_file="$out_dir/learnings.jsonl"

    if [ ! -d "$memory_dir" ]; then
        echo "  [skip] $slug — no memory dir at $memory_dir" >&2
        return 0
    fi

    # PHI / sensitive-data refusal. Defense in depth: never bridge a slug
    # carrying an opt-out marker into the shared gbrain index.
    if is_slug_opted_out "$slug"; then
        echo "  [REFUSED] $slug — opted out of gbrain (sensitivity marker present)" >&2
        echo "  Markers checked: $memory_dir/.no-gbrain ; *.md frontmatter sensitivity: phi" >&2
        echo "  This slug's memories stay native-only. Use /groom with the no-gbrain fallback." >&2
        REFUSED_SLUGS+=("$slug")
        return 4
    fi

    local md_files
    md_files=$(find "$memory_dir" -maxdepth 1 -name "*.md" -not -name "MEMORY.md" 2>/dev/null | sort)
    if [ -z "$md_files" ]; then
        echo "  [skip] $slug — no memory files" >&2
        return 0
    fi

    local count=0
    local tmpfile
    tmpfile=$(mktemp)

    while IFS= read -r mfile; do
        [ -z "$mfile" ] && continue

        local fm body name desc memory_type ts ts_iso
        fm=$(extract_frontmatter "$mfile")
        body=$(extract_body "$mfile")

        name=$(field "$fm" "name")
        desc=$(field "$fm" "description")
        memory_type=$(echo "$fm" | awk '/^[[:space:]]*type:/{sub("^[[:space:]]*type:[[:space:]]*",""); gsub(/^["'\'']|["'\'']$/,""); print; exit}')

        if [ -z "$name" ]; then
            name=$(basename "$mfile" .md)
        fi

        ts=$(stat -c '%Y' "$mfile" 2>/dev/null || stat -f '%m' "$mfile" 2>/dev/null || echo 0)
        ts_iso=$(date -u -d "@$ts" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -r "$ts" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo "1970-01-01T00:00:00Z")

        local tags_array
        tags_array=$(jq -n --arg s "$slug" --arg t "${memory_type:-feedback}" '["project:" + $s, "memory-type:" + $t]')
        # Per-memory ecosystem promotion (frontmatter scope/promoted/ecosystem fields):
        if is_ecosystem_scope "$fm"; then
            local fm_ecosystem
            fm_ecosystem=$(echo "$fm" | grep -E '^ecosystem:' | head -1 | sed -E 's/^ecosystem:[[:space:]]*//; s/^["'\'']|["'\'']$//g')
            local eco_name="${fm_ecosystem:-disciplin-run}"
            tags_array=$(echo "$tags_array" | jq --arg e "ecosystem:$eco_name" '. + [$e]')
        fi
        # Bridge-time forced ecosystem promotion (rare; explicit owner override):
        if [ -n "$FORCE_ECOSYSTEM" ]; then
            tags_array=$(echo "$tags_array" | jq --arg e "ecosystem:$FORCE_ECOSYSTEM" '. + [$e] | unique')
        fi

        jq -nc \
            --arg name "$name" \
            --arg desc "$desc" \
            --arg body "$body" \
            --arg ts "$ts_iso" \
            --arg src "$mfile" \
            --argjson tags "$tags_array" \
            '{
              type: "learning",
              title: $name,
              description: $desc,
              content: $body,
              tags: $tags,
              captured_at: $ts,
              source_file: $src
            }' >> "$tmpfile"

        count=$((count + 1))
    done <<< "$md_files"

    if [ "$DRY_RUN" = "1" ]; then
        echo "  [dry-run] $slug — would write $count entries to $out_file"
        if [ "$count" -gt 0 ]; then
            echo "  Sample (first entry):"
            head -1 "$tmpfile" | jq '{title, tags}'
        fi
        rm -f "$tmpfile"
        return 0
    fi

    mkdir -p "$out_dir"
    mv "$tmpfile" "$out_file"
    echo "  [done] $slug — wrote $count entries to $out_file"

    # ── Direct ingest path: call gbrain put for each entry. ───────────
    if [ "$INGEST" = "1" ]; then
        if ! command -v gbrain >/dev/null 2>&1; then
            echo "  [warn] --ingest requested but gbrain CLI not on PATH; skipping ingest" >&2
            return 0
        fi
        local ok=0 fail=0
        local short_slug
        short_slug=$(echo "$slug" | sed 's|^-home-jesper-PycharmProjects-||')
        while IFS= read -r line; do
            [ -z "$line" ] && continue
            local title desc content gbslug tags_yaml page
            title=$(echo "$line" | jq -r '.title')
            desc=$(echo "$line" | jq -r '.description // empty')
            content=$(echo "$line" | jq -r '.content')
            gbslug="$short_slug/$(echo "$title" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-\|-$//g')"
            # Build YAML tag list from the JSONL tags array.
            tags_yaml=$(echo "$line" | jq -r '.tags[] | "  - " + .')
            # Build the page with YAML frontmatter (gbrain reads tags from it).
            page="---
type: learning
tags:
$tags_yaml
---

# $title

$desc

$content"
            if echo "$page" | gbrain put "$gbslug" >/dev/null 2>&1; then
                ok=$((ok + 1))
            else
                fail=$((fail + 1))
                echo "  [ingest-fail] $gbslug" >&2
            fi
        done < "$out_file"
        echo "  [ingest] $slug — ok=$ok fail=$fail"

        # ── Sync path: delete gbrain pages whose source file is gone. ────
        # Catches the rename/delete/merge case where --ingest alone leaves
        # orphans that pollute query/similarity results. Diffs the set of
        # gbrain pages tagged project:<slug> against the slugs we just put
        # in this run; anything in gbrain but not in the put-set is an
        # orphan. (Reported by iris-qa-tm during its post-groom cleanup;
        # 11 orphans had to be hand-purged with comm + gbrain delete.)
        if [ "$SYNC" = "1" ]; then
            local expected_slugs purged=0
            expected_slugs=$(mktemp)
            while IFS= read -r line; do
                [ -z "$line" ] && continue
                local title gbslug
                title=$(echo "$line" | jq -r '.title')
                gbslug="$short_slug/$(echo "$title" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-\|-$//g')"
                echo "$gbslug" >> "$expected_slugs"
            done < "$out_file"

            while IFS= read -r live_slug; do
                [ -z "$live_slug" ] && continue
                if ! grep -qFx "$live_slug" "$expected_slugs"; then
                    if gbrain delete "$live_slug" >/dev/null 2>&1; then
                        purged=$((purged + 1))
                        echo "  [orphan-purge] deleted $live_slug"
                    else
                        echo "  [orphan-purge-fail] $live_slug" >&2
                    fi
                fi
            done < <(gbrain list --tag "project:$slug" 2>/dev/null | awk -F'\t' '{print $1}')

            rm -f "$expected_slugs"
            echo "  [sync] $slug — purged=$purged"
        fi
    fi
}

# ─── Main ────────────────────────────────────────────────────────────

REFUSED_SLUGS=()

echo "jjstack-memory-bridge starting…"
echo "  memory_root:    $MEMORY_ROOT"
echo "  learnings_root: $LEARNINGS_ROOT"
[ "$DRY_RUN" = "1" ] && echo "  mode:           DRY-RUN (no writes)"
echo ""

if [ "$ALL" = "1" ]; then
    while IFS= read -r dir; do
        slug=$(basename "$dir")
        bridge_project "$slug"
    done < <(find "$MEMORY_ROOT" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | sort)
else
    bridge_project "$SLUG"
fi

echo ""
echo "Bridge complete. Next step (after gbrain install):"
echo "  gbrain query \"<a known fact from your memories>\""
echo "  Expect: returns the bridged memory as a learning page."

if [ "${#REFUSED_SLUGS[@]}" -gt 0 ]; then
    echo ""
    echo "REFUSED slugs (PHI/sensitive opt-out): ${#REFUSED_SLUGS[@]}"
    for s in "${REFUSED_SLUGS[@]}"; do echo "  - $s"; done
    echo "Use /groom with the no-gbrain fallback for these projects."
    exit 4
fi
