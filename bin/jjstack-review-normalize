#!/usr/bin/env python3
"""jjstack-review-normalize — validate and normalize /review finding structs.

A high-recall review is only usable if every finding is ACTIONABLE, and
"actionable" is a schema property, not a matter of taste. This script is the
schema gate: it reads findings as JSON Lines, rejects any that are missing a
field the reader needs, and canonicalizes the fields models get wrong.

Why each required field earns its place:
  lens         which pass emitted it — the baseline's rule-id glob keys on this
  file         where; a finding with no file cannot be looked at
  start_line   grounded location (see bin/jjstack-number-lines)
  severity     triage order
  confidence   how sure the pass is, AFTER normalization below
  message      the one-line claim, for report tables and dedup
  quote        the verbatim motivating line — an unquotable finding is unverified
  explanation  why it is wrong
  remediation  what to do about it. Requiring this AT EMISSION TIME is the
               cheap filter that removes findings nobody can act on.

Two normalizations, both deterministic and both defensive:
  * confidence — models emit 0-100 and 0.0-1.0 interchangeably. Following
    NVIDIA SkillSpector's meta-analyzer validator: a value above 2.0 is read
    as a percentage and divided by 100, then clamped into [0, 1]. The
    ambiguity band is real and unresolvable (a bare "1" could mean 1% or
    100%); the convention resolves it toward 1.0, which is the fail-closed
    direction for a review tool.
  * severity — the accepted tokens and their canonical P-level are READ from
    bin/jjstack-review-vocab.tsv (`severity` rows), not listed here. Emitted as
    P0-P3 so ranking is a plain sort. One definition, four consumers: this
    script, jjstack-pr-comment-lint's finding cap, and the declaration in
    skills/review/SKILL.md that test/smoke.sh asserts against the TSV.

An invalid finding is NEVER silently dropped: it is echoed to the invalid
stream with the reason, counted, and the exit code says so. Silent deletion is
the defect this whole change set exists to remove. Three mechanisms make that
claim true rather than aspirational:

  * NO exception raised while normalizing ONE finding may cost you the others.
    The per-finding handler catches the whole Exception class, not a list of
    types: round 1 caught (ValueError, TypeError) because the fixture was
    `"confidence": null`, and a 400-digit integer then raised OverflowError and
    aborted the run exactly as before. The failing line is recorded either way;
  * valid findings are STREAMED to stdout as they normalize (see emit()), not
    buffered until the end, so nothing already validated can be lost by a
    later line — or by a later failure of any kind;
  * an internal error gets its own exit code (3), so "the tool crashed" can
    never be misread by a caller as "some findings were malformed" (1), and it
    names the line that caused it;
  * --invalid-out is written on EVERY run, including a clean one. A file that
    keeps the last run's malformed records is worse than no file at all.

Usage:
  jjstack-review-normalize <findings.jsonl|-> [--invalid-out FILE]

Exit: 0 all findings valid, 1 at least one invalid (valid ones still emitted),
      2 usage error or unreadable input, 3 internal error (partial output).

No color red anywhere — unreadable on the target terminal.
"""

import json
import os
import sys

YEL = "\033[33m"
CYA = "\033[96m"
GRN = "\033[32m"
RST = "\033[0m"

REQUIRED = (
    "lens",
    "file",
    "start_line",
    "severity",
    "confidence",
    "message",
    "quote",
    "explanation",
    "remediation",
)

def load_severity_aliases():
    """The severity vocabulary, READ from bin/jjstack-review-vocab.tsv.

    It used to live here as a dict literal, which made this file a second
    definition of a list three other places also carry: the TSV, the PR-comment
    cap, and skills/review/SKILL.md's finding-struct table. A second copy drifts
    silently — the cap was missing HIGH/MEDIUM/LOW for exactly as long as nobody
    diffed it against this dict. Now there is one definition and the rest derive.

    Fails LOUDLY. A normalizer that quietly accepts nothing, or quietly accepts
    everything, when its vocabulary file is unreadable is worse than one that
    stops: both outcomes look like a clean run.
    """
    path = os.environ.get("JJSTACK_REVIEW_VOCAB") or os.path.join(
        os.path.dirname(os.path.abspath(__file__)), "jjstack-review-vocab.tsv"
    )
    aliases = {}
    try:
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                if not line.strip() or line.lstrip().startswith("#"):
                    continue
                cols = line.rstrip("\n").split("\t")
                if len(cols) < 3 or cols[0] != "severity":
                    continue
                aliases[cols[1].strip().upper()] = cols[2].strip()
    except OSError as exc:
        err(f"review vocabulary unreadable ({path}): {exc}")
        sys.exit(2)
    if not aliases:
        err(f"review vocabulary declares no severity rows: {path}")
        sys.exit(2)
    return aliases


SEVERITY_ALIASES = None


def err(msg):
    print(f"{CYA}error{RST} {msg}", file=sys.stderr)


def warn(msg):
    print(f"{YEL}warn{RST}  {msg}", file=sys.stderr)


def is_blank(value):
    """True for a required field carrying no content, whatever its JSON type.

    `""` is not the only way a model says nothing: `null`, `[]` and `{}` all
    reach the report as an uncheckable quote or an empty remediation, which is
    exactly what this schema gate exists to stop. A number (0 included) is
    content, so `start_line: 0` and `confidence: 0` are NOT blank.
    """
    if value is None:
        return True
    if isinstance(value, str):
        return not value.strip()
    if isinstance(value, (list, tuple, dict, set)):
        return len(value) == 0
    return False


def normalize_confidence(value):
    """0-100 or 0.0-1.0 in, 0.0-1.0 out. Raises ValueError on non-numerics.

    Type-checked BEFORE coercion on purpose: float(None) and float([]) raise
    TypeError, not ValueError, and an uncaught TypeError here aborted the whole
    run — losing every valid finding and never writing the invalid stream.
    """
    # bool is an int subclass; `"confidence": true` is nonsense, not 1.0.
    if isinstance(value, bool) or not isinstance(value, (int, float, str)):
        raise ValueError(f"confidence is not a number: {value!r}")
    try:
        conf = float(value)
    except Exception as exc:
        # The whole class, not an enumeration. Round 1 added TypeError because
        # the fixture was `null`; a 400-digit integer then raised OverflowError
        # — an ArithmeticError no guard named — and took the rest of the run
        # with it. Whatever float() refuses is simply not a confidence.
        raise ValueError(
            f"confidence is not a usable number ({type(exc).__name__}): {value!r}"
        )
    if conf != conf:  # NaN
        raise ValueError("confidence is NaN")
    if conf in (float("inf"), float("-inf")):
        raise ValueError("confidence is infinite")
    if conf > 2.0:
        conf = conf / 100.0
    return min(1.0, max(0.0, conf))


def normalize_severity(value):
    global SEVERITY_ALIASES
    if SEVERITY_ALIASES is None:
        SEVERITY_ALIASES = load_severity_aliases()
    key = str(value).strip().upper()
    if key not in SEVERITY_ALIASES:
        raise ValueError(f"unknown severity {value!r}")
    return SEVERITY_ALIASES[key]


def normalize_finding(obj):
    """Return a normalized copy. Raises ValueError naming the first problem."""
    if not isinstance(obj, dict):
        raise ValueError("finding is not a JSON object")
    missing = [f for f in REQUIRED if f not in obj]
    if missing:
        raise ValueError("missing required field(s): " + ", ".join(missing))
    blank = [f for f in REQUIRED if is_blank(obj[f])]
    if blank:
        raise ValueError("empty required field(s): " + ", ".join(blank))

    out = dict(obj)
    out["confidence"] = normalize_confidence(obj["confidence"])
    # Kept alongside because the human-facing report speaks in 0-100.
    out["confidence_100"] = int(round(out["confidence"] * 100))
    out["severity"] = normalize_severity(obj["severity"])
    try:
        out["start_line"] = int(obj["start_line"])
    except (TypeError, ValueError):
        raise ValueError(f"start_line is not an integer: {obj['start_line']!r}")
    return out


def emit(record, stream=sys.stdout):
    """Write ONE validated finding immediately.

    Streaming, not buffering: a finding that has already passed the schema gate
    must be on stdout before the next line is even read, so no later failure —
    of any kind, at any point in the run — can take it back. The pre-fix code
    appended to a list and printed after the loop, which is why one bad line
    emptied the whole run's output.
    """
    stream.write(json.dumps(record, sort_keys=True) + "\n")


def main(argv):
    src = None
    invalid_out = None
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--invalid-out":
            if i + 1 >= len(argv):
                err("--invalid-out needs a FILE")
                return 2
            invalid_out = argv[i + 1]
            i += 2
        elif a in ("-h", "--help"):
            print(__doc__)
            return 0
        elif a == "-" or not a.startswith("-"):
            if src is not None:
                err(f"unexpected arg: {a}")
                return 2
            src = a
            i += 1
        else:
            err(f"unknown flag: {a}")
            return 2

    if src is None:
        err("usage: jjstack-review-normalize <findings.jsonl|-> [--invalid-out FILE]")
        return 2

    try:
        raw = sys.stdin.read() if src == "-" else open(src, encoding="utf-8").read()
    except OSError as exc:
        err(f"cannot read {src}: {exc}")
        return 2

    # STREAM the valid ones. Buffering them until after the loop meant a single
    # bad line could take the whole run's output with it.
    n_valid, invalid = 0, []
    internal, internal_line = None, None
    try:
        for lineno, line in enumerate(raw.splitlines(), 1):
            if not line.strip():
                continue
            try:
                obj = json.loads(line)
            except json.JSONDecodeError as exc:
                invalid.append(
                    {"line": lineno, "reason": f"not JSON: {exc}", "raw": line}
                )
                continue
            try:
                out = normalize_finding(obj)
            except (ValueError, TypeError) as exc:
                # TypeError is caught with ValueError deliberately: a null or
                # list where a scalar belongs is malformed INPUT, not a crash.
                invalid.append({"line": lineno, "reason": str(exc), "raw": line})
                continue
            except Exception as exc:
                # THE CLASS, not the instance. Round 1 fixed `null` (TypeError)
                # and round 2 found the same P0 one exception type over
                # (OverflowError). Whatever goes wrong while normalizing ONE
                # finding, the other findings are not its to lose: record this
                # line, keep going, and let the exit code say the tool — not
                # the emitter — is what misbehaved.
                invalid.append(
                    {
                        "line": lineno,
                        "reason": (
                            "internal error normalizing this finding: "
                            f"{type(exc).__name__}: {exc}"
                        ),
                        "raw": line,
                    }
                )
                if internal is None:
                    internal, internal_line = exc, lineno
                continue
            emit(out)
            n_valid += 1
    except Exception as exc:  # last-resort guard: never exit 1 on a crash
        if internal is None:
            internal = exc
    finally:
        try:
            sys.stdout.flush()
        except OSError:
            pass

    if internal is not None:
        where = f"line {internal_line}" if internal_line else "the run"
        # Name the poisoning line: "something failed somewhere" is not a
        # diagnosis. The invalid stream is still written below, then exit 3 —
        # a code no caller can confuse with "some findings were malformed".
        err(
            f"internal error at {where} after {n_valid} valid finding(s): "
            f"{internal!r}"
        )

    payload = "".join(json.dumps(r, sort_keys=True) + "\n" for r in invalid)
    if invalid_out:
        # ALWAYS written, including the empty case. The skill points a fixed
        # path at this file; leaving the previous run's malformed records on
        # disk after a clean run makes it lie about the run that just finished.
        try:
            with open(invalid_out, "w", encoding="utf-8") as fh:
                fh.write(payload)
        except OSError as exc:
            err(f"cannot write {invalid_out}: {exc}")
            return 2
    elif invalid:
        sys.stderr.write(payload)

    if invalid:
        warn(
            f"{len(invalid)} malformed finding(s) NOT emitted — fix the emitter, "
            "do not delete the findings"
        )

    print(f"{GRN}normalized{RST} {n_valid} finding(s)", file=sys.stderr)
    if internal is not None:
        return 3
    return 1 if invalid else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
