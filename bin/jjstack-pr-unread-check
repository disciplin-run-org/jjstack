#!/usr/bin/env bash
# jjstack-pr-unread-check — refuse a merge while the thread has something unread.
#
# `MERGEABLE` answers whether the branches conflict. It says nothing about
# whether a review is sitting on the pull request nobody has read, and reading
# only the first is how a review gets merged over: on jjstack #29 a CAUTION
# with three blocking findings posted at 13:12 and the merge landed at 13:21,
# on a mergeability check read before the review existed.
#
# Prose could not fix that. The author side was told to "chain the read to the
# merge", but the read was `gh pr view`, which exits 0 whether or not anything
# is unread, so `read && merge` gated on nothing and looked like a gate. A
# chain needs one end that EXITS NON-ZERO. That is this file.
#
#   jjstack-pr-unread-check --pr N --repo OWNER/REPO --since <ISO-8601>
#     && gh pr merge N --repo OWNER/REPO --squash
#
# --since is the moment you last actually READ the thread, not the moment you
# last looked at the merge button.
#
# THREE surfaces are read, because they are three different surfaces with three
# different fields: an issue comment carries `createdAt`, a submitted review
# carries `submittedAt`, and a reply inside an inline review thread is neither -
# it lives on the pulls/comments endpoint and `gh pr view` does not return it at
# all. Reading fewer than all three is how an unread item hides behind a stale
# date on another surface. `updatedAt` is not used: it also moves on a push or a
# label, so it answers a different question.
#
# Exit: 0 nothing newer · 1 something is unread (it is named) · 2 usage
#       3 the thread could not be read — never mistaken for "nothing new".
set -o pipefail

CYA="\033[96m"; YEL="\033[33m"; RST="\033[0m"

PR=""; REPO=""; SINCE=""
need_value() {   # need_value FLAG VALUE
  case "${2-}" in
    ""|-*) echo -e "${CYA}error${RST} $1 needs a value" >&2; exit 2 ;;
  esac
}
while [ $# -gt 0 ]; do
  case "$1" in
    --pr)    need_value "$1" "${2-}"; PR="$2";    shift 2 ;;
    --repo)  need_value "$1" "${2-}"; REPO="$2";  shift 2 ;;
    --since) need_value "$1" "${2-}"; SINCE="$2"; shift 2 ;;
    -h|--help)
      sed -n '2,29p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo -e "${CYA}error${RST} unknown argument: $1" >&2; exit 2 ;;
  esac
done
[ -n "$PR" ] && [ -n "$REPO" ] && [ -n "$SINCE" ] || {
  echo -e "${CYA}error${RST} usage: $(basename "$0") --pr N --repo OWNER/REPO --since ISO-8601" >&2; exit 2; }

# An ISO-8601 instant, refused up front rather than compared as a string that
# happens to sort wrong. Lexical comparison IS correct for this format, which
# is why the format is required instead of accepted loosely.
case "$SINCE" in
  [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]Z) ;;
  *) echo -e "${CYA}error${RST} --since must be ISO-8601 UTC, e.g. 2026-09-09T13:12:00Z" >&2; exit 2 ;;
esac

RAW=$(gh pr view "$PR" --repo "$REPO" --json comments,reviews 2>&1) || {
  echo -e "${CYA}error${RST} could not read the thread — this is NOT 'nothing new':" >&2
  printf '%s\n' "$RAW" >&2
  exit 3
}
# A command that succeeds and prints nothing is not an empty thread; an empty
# thread is `{"comments":[],"reviews":[]}`. Without this, empty output parsed to
# an empty list and the gate said quiet - which is precisely the reading this
# file's own header promises never to make. The promise is unconditional now.
[ -n "$RAW" ] || {
  echo -e "${CYA}error${RST} the thread read returned nothing at all — NOT 'nothing new'" >&2
  exit 3
}

# The inline surface, which `gh pr view` cannot return. Its absence is not an
# error - most pull requests have none - but a failure to ASK is, and is not
# quietly folded into an empty list.
INLINE=$(gh api "repos/$REPO/pulls/$PR/comments" --jq '[.[] | {kind:"inline", who:(.user.login // "?"), at:.created_at}]' 2>&1) || {
  echo -e "${CYA}error${RST} could not read the inline review comments — NOT 'nothing new':" >&2
  printf '%s\n' "$INLINE" >&2
  exit 3
}
[ -n "$INLINE" ] || INLINE='[]'

# One list, both surfaces, each with the field it actually carries.
NEWER=$(printf '%s' "$RAW" | jq -r --arg since "$SINCE" --argjson inline "$INLINE" '
  [ (.comments[]? | {kind:"comment", who:(.author.login // "?"), at:.createdAt}),
    (.reviews[]?  | {kind:"review",  who:(.author.login // "?"), at:.submittedAt, state:.state}),
    ($inline[]?) ]
  | map(select(.at != null and .at > $since))
  | sort_by(.at)[]
  | "\(.at)  \(.kind)\(if .state then " (" + .state + ")" else "" end) by \(.who)"
' 2>/dev/null) || {
  echo -e "${CYA}error${RST} could not parse the thread" >&2; exit 3; }

if [ -n "$NEWER" ]; then
  echo -e "${YEL}unread${RST} $(printf '%s' "$NEWER" | grep -c .) item(s) on $REPO#$PR since $SINCE:" >&2
  printf '%s\n' "$NEWER" | sed 's/^/  /' >&2
  echo -e "${YEL}unread${RST} read them before merging. MERGEABLE is not unreviewed." >&2
  exit 1
fi
exit 0
