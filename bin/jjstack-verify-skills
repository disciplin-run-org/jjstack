#!/usr/bin/env bash
# jjstack-verify-skills — deterministic checks on the skill tree.
#
# Guards the failure classes that prose skills actually hit:
#   1. a SKILL.md whose frontmatter name drifts from its directory
#      (the harness keys on the directory; a mismatch loads the wrong name)
#   2. a skill that `cat`s a shared reference which does not exist
#      (silently degrades: the model reads nothing and improvises)
#   3. an installed symlink that dangles after a repo move
#   4. a shared base copy-pasted back into its callers (the drift the
#      base exists to prevent)
#   5. a skill that shadows a Claude Code built-in without declaring it,
#      or declares a shadow that no longer exists (the wrapper pattern
#      shadows gstack by design; a built-in is someone else's namespace)
#   6. a description longer than the harness keeps (the model routes on
#      what survives the cut; the cut landed inside a note once)
#   7. a built-in list older than the installed Claude Code (warn only:
#      the list is data, refreshed by bin/jjstack-builtins-refresh)
#   8. a continuation mechanism (the QM resume order, the handover slot)
#      appearing in a skill that is not allowed to resume work — the defect
#      that made /save-and-clear roll a session over instead of clearing it
#
# Scope note: a directory under skills/ with no SKILL.md is not a skill
# and is skipped — git cannot track an empty directory, so these are
# local cruft, not repo state. ~/.claude/skills/jjstack is deliberately
# the repo root (it is how references/ resolves), not a skill install.
#
# No color red anywhere — unreadable on the target terminal.
set -uo pipefail

YEL="\033[33m"; CYA="\033[96m"; GRN="\033[32m"; RST="\033[0m"
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT
fails=0

# The message can carry text lifted from a SKILL.md, so it is %s and never
# %b: `echo -e` on a contributed `shadows:` entry lets that file emit cursor
# movement and repaint this script's own FAIL line as a green one.
ok()   { printf '  %bok%b  %s\n'   "$GRN" "$RST" "$1"; }
bad()  { printf '  %bFAIL%b %s\n'  "$CYA" "$RST" "$1"; fails=$((fails + 1)); }
warn() { printf '  %bwarn%b %s\n'  "$YEL" "$RST" "$1"; }

# The description block of a SKILL.md, indentation stripped: either the
# `description: |` block up to the next top-level key or the closing ---,
# or a single `description: text` line.
desc_of() {
  awk '
    /^---$/ { if (++dash == 2) exit; next }
    /^description: *[|>]/ { f=1; next }
    /^description: /   { sub(/^description: /, ""); print; next }
    f && /^[^ ]/ { f=0 }
    f { sub(/^  /, ""); print }
  ' "$1"
}

# Real skills only: a directory is a skill iff it holds a SKILL.md.
find "$REPO/skills" -mindepth 2 -maxdepth 2 -name SKILL.md -printf '%h\n' \
  | xargs -r -n1 basename | sort > "$TMP/skills"

echo "jjstack-verify-skills — repo: $REPO"
echo "  $(wc -l < "$TMP/skills") skills"
echo
echo "== 1. frontmatter name matches directory =="
while read -r d; do
  n=$(awk '/^name:/{print $2; exit}' "$REPO/skills/$d/SKILL.md")
  if [ "$n" = "$d" ]; then ok "$d"; else bad "$d -> frontmatter name '$n'"; fi
done < "$TMP/skills"

echo "== 2. every skill -> shared-reference pointer resolves =="
grep -rhoE '~/\.claude/skills/jjstack/references/[a-z0-9-]+\.md' "$REPO/skills/" \
  | sort -u > "$TMP/refs"
while read -r p; do
  real="$REPO/references/$(basename "$p")"
  if [ -f "$real" ]; then ok "$(basename "$p")"; else bad "$p — dangling, no such reference"; fi
done < "$TMP/refs"

echo "== 3. installed symlinks resolve =="
while read -r d; do
  l="$HOME/.claude/skills/$d"
  [ -e "$l" ] || continue          # not installed is not a failure
  if [ -f "$l/SKILL.md" ]; then ok "$d"; else bad "$d installed but SKILL.md unreadable"; fi
done < "$TMP/skills"

echo "== 4. shared bases are not copy-pasted into their callers =="
# Keyed on a distinctive body marker, not the title: a skill may legitimately
# NAME a base (e.g. jj-qa's H1 mentions "QA Philosophy") without copying it.
# marker|reference
cat > "$TMP/markers" <<'MARK'
Dedup check before writing|memory-sweep.md
MARK
while IFS='|' read -r marker ref; do
  [ -n "$marker" ] || continue
  c=$(grep -rlF "$marker" "$REPO/references/" "$REPO/skills/" 2>/dev/null | wc -l)
  if [ "$c" -eq 1 ]; then ok "$ref — body lives in exactly one file"
  else bad "$ref — body marker '$marker' found in $c files; expected 1"; fi
done < "$TMP/markers"

echo "== 5. every shadowed Claude Code built-in is declared, and every declaration is live =="
# The ownership rule (README, "Whose name is it"): jjstack shadows gstack
# names by design. It may shadow a Claude Code built-in only when the
# built-in stays reachable under another name, and the skill says so:
#   shadows:
#     - "claude-code:/review -> /code-review"
# An undeclared collision FAILS. A declaration with no collision behind it
# FAILS too: the built-in was renamed or removed, and the description note
# the declaration justifies is now wrong. The list of built-ins is DATA in
# references/claude-code-builtins.txt, derived from the installed binary by
# bin/jjstack-builtins-refresh — never a comment that says "re-check".
BUILTINS="$REPO/references/claude-code-builtins.txt"
tr -d '\r' < "$BUILTINS" | sed 's/[[:space:]]*$//; s/^[[:space:]]*//' \
  | grep -vE '^(#|$)' | sort -u > "$TMP/builtins"
comm -12 "$TMP/builtins" "$TMP/skills" > "$TMP/collisions"
# declared: skill|entry
while read -r d; do
  awk -v s="$d" '
    /^---$/ { if (++dash == 2) exit; next }
    /^shadows:/ { f=1; next }
    f && /^[^ ]/ { f=0 }
    f && /^ *- / { sub(/^ *- */, ""); gsub(/"/, ""); print s "|" $0 }
  ' "$REPO/skills/$d/SKILL.md"
done < "$TMP/skills" > "$TMP/declared"

while IFS='|' read -r skill entry; do
  [ -n "$skill" ] || continue
  if ! [[ "$entry" =~ ^claude-code:/([a-z0-9-]+)\ -\>\ /([a-z0-9-]+)$ ]]; then
    bad "$skill: shadows entry '$entry' is not 'claude-code:/<name> -> /<other-name>'"; continue
  fi
  name="${BASH_REMATCH[1]}"; alt="${BASH_REMATCH[2]}"
  if [ "$name" != "$skill" ]; then
    bad "$skill declares a shadow of /$name — a skill can only shadow its own name"; continue
  fi
  if ! grep -qx "$name" "$TMP/collisions"; then
    bad "$skill declares a shadow of /$name but no such built-in is listed — stale; drop the declaration and the description note"; continue
  fi
  if ! grep -qx "$alt" "$TMP/builtins"; then
    bad "$skill says the built-in is reachable as /$alt, but /$alt is not a listed built-in"; continue
  fi
  if grep -qx "$alt" "$TMP/skills"; then
    bad "$skill says the built-in is reachable as /$alt, but jjstack shadows /$alt too"; continue
  fi
  # The note must reach the model: the alt name has to appear in the part
  # of the description the harness keeps (check 6 sets the ceiling).
  if ! desc_of "$REPO/skills/$skill/SKILL.md" | head -c 1400 | grep -qF "/$alt"; then
    bad "$skill: the description must name /$alt within its first 1400 chars — that is the only place the user learns it"; continue
  fi
  ok "$skill shadows /$name (declared; built-in reachable as /$alt)"
done < "$TMP/declared"

while read -r c; do
  [ -n "$c" ] || continue
  grep -q "^$c|" "$TMP/declared" && continue
  bad "$c shadows the Claude Code built-in /$c and does not declare it — add 'shadows:' naming the other name the built-in keeps, or rename to jj-$c"
done < "$TMP/collisions"
[ -s "$TMP/collisions" ] || ok "no skill shadows a Claude Code built-in"

echo "== 6. descriptions fit the harness =="
# Observed on Claude Code 2.1.266: a 1622-char description was cut near
# 1535, inside the sentence naming the alternate command. 1400 leaves room
# for the harness to move a little.
DESC_MAX=1400
while read -r d; do
  n=$(desc_of "$REPO/skills/$d/SKILL.md" | wc -c)
  if [ "$n" -le "$DESC_MAX" ]; then ok "$d ($n)"
  else bad "$d description is $n chars; the harness cuts near 1535 and the ceiling is $DESC_MAX"; fi
done < "$TMP/skills"

echo "== 7. the built-in list is not older than the installed Claude Code =="
listed=$(tr -d '\r' < "$BUILTINS" | sed -n 's/^# claude-code-version: *//p' | sed 's/[[:space:]]*$//' | head -1)
installed=$(claude --version 2>/dev/null | awk '{print $1}')
if [ -z "$listed" ]; then bad "$BUILTINS carries no '# claude-code-version:' header"
elif [ -z "$installed" ]; then warn "claude is not on PATH — cannot compare against list ($listed)"
elif [ "$listed" = "$installed" ]; then ok "list and installed agree ($installed)"
elif [ "$(printf '%s\n%s\n' "$listed" "$installed" | sort -V | tail -1)" = "$installed" ]; then
  warn "installed Claude Code $installed is newer than the list ($listed): bin/jjstack-builtins-refresh | diff $BUILTINS -"
else ok "list ($listed) is newer than installed ($installed)"; fi

echo "== 8. continuation mechanisms live only where a session may resume =="
# THE CLASS: /save-and-clear filed a QM resume order for any session whose
# work "continues", so a clear behaved like a rollover. Prose said which skill
# owned the handover; nothing checked it, and the prose drifted.
#
# Keyed on MECHANISMS — the QM call, the slot verbs — never on the word
# "rollover". A grep for a name survives deleting the code that name
# describes, and every skill here legitimately NAMES the others in its
# comparison table.
#
# THE PATTERNS HAVE BEEN WRONG TWICE, both times by encoding one spelling of
# an invocation rather than the invocation:
#   - fixed strings missed the documented option form, because options are
#     parsed before the verb: `…-slot --cwd DIR write` does not contain
#     `…-slot write`. A bypass planted in /save-and-clear passed every gate.
#   - a trailing `([[:space:]]|$)` then missed the BACKTICKED form, which is
#     how markdown writes a command. Three of the four real `status`
#     invocations on this tree are backticked, and the row saw only the
#     fourth. The trailing anchor is now "anything that cannot continue an
#     identifier", so a backtick, a full stop or a comma all close the verb
#     while `writeups` still does not match `write`.
#
# ONE PRIMARY PER ROW. An earlier version listed three primaries in one row
# and set `hit` if ANY matched — a disjunction, not three assertions. It could
# say "at least one of these still uses it" and never "which", so a primary
# could go dark forever behind its neighbours. Rows repeat a pattern instead,
# once per file that must carry it. A primary that CANNOT be matched by
# pattern is not listed as one: the hook reaches the script through a
# variable, so it gets its own row keyed on what it does contain. A named
# primary that cannot fire is a claim the check does not check, which is the
# thing this whole check exists to stop being acceptable.
#
# Three ways to fail:
#   leak    — a carrier outside the allowed set: the mechanism escaped
#   absent  — no carrier at all: the guard is watching something this repo no
#             longer has, and would pass forever without inspecting anything
#   hollow  — carriers exist but not the primary one: the mechanism left the
#             file that must have it and only prose about it remains. The
#             contract reference names every mechanism, so without this rule
#             deleting /rollover's slot write entirely kept the tree green.
#
# TAB-separated: pattern <TAB> the ONE file that must carry it ('-' for a row
# that is only a leak boundary) <TAB> everything else allowed to mention it.
# The patterns carry `|` themselves, so it cannot also be the separator.
V='([^A-Za-z0-9_-]|$)'          # a verb ends at anything that is not identifier
S='jjstack-rollover-slot[^;|&]*[[:space:]]'
# The shared union, used ONLY by the read-only status rows. It is deliberately
# not used by the name row below, and cannot be used by the write and consume
# rows, which carry the actual safety property and pin one skill each.
#
# Measured rather than reasoned: widening $ALL by one file and planting the
# variable form there kept check 8 green, because the NAME row is the only
# detector of that class and it was reading the same shared string. One edit
# to one variable silently widened the one row where widening is dangerous.
# The status rows are read-only, so uniformity there costs nothing.
ALL='references/rollover-handover.md bin/jjstack-rollover-slot skills/rollover/SKILL.md skills/resume-from-clear/SKILL.md hooks/shared-memory.sh'
printf '%s\t%s\t%s\n' \
  'mcp__quartermaster__qm_queue_add' \
    'skills/rollover/SKILL.md' \
    'references/rollover-handover.md' \
  "${S}write${V}" \
    'skills/rollover/SKILL.md' \
    'references/rollover-handover.md bin/jjstack-rollover-slot' \
  "${S}consume${V}" \
    'skills/resume-from-clear/SKILL.md' \
    'references/rollover-handover.md bin/jjstack-rollover-slot' \
  "${S}status${V}" \
    'skills/rollover/SKILL.md' \
    "$ALL" \
  "${S}status${V}" \
    'skills/resume-from-clear/SKILL.md' \
    "$ALL" \
  'RSLOT=.*jjstack-rollover-slot' \
    'hooks/shared-memory.sh' \
    '' \
  'jjstack-rollover-slot' \
    '-' \
    'references/rollover-handover.md bin/jjstack-rollover-slot skills/rollover/SKILL.md skills/resume-from-clear/SKILL.md hooks/shared-memory.sh' \
  > "$TMP/continuation"
# The guard is not a carrier. This file states every pattern it looks for, so
# scanning bin/ without this exclusion makes each row find itself and report a
# leak that is the check's own table — the self-pollution class.
SELF="bin/$(basename "${BASH_SOURCE[0]}")"
while IFS=$'\t' read -r pat primary allowed; do
  [ -n "$pat" ] || continue
  # CODE ROWS READ A COMMENT-STRIPPED COPY. hooks/shared-memory.sh is the one
  # file in this table that is code rather than prose, and a commented-out
  # assignment satisfied the row while the carrier it names was disabled: the
  # plain-session handover notice can be switched off and this row still says
  # the hook carries it. The suite catches that three other ways; the row
  # should not be the one claiming otherwise. Stripping `#` comments is wrong
  # for markdown (where `#` is a heading), so it is applied per-row.
  scan_root="$REPO"
  if [ "${primary%.sh}" != "$primary" ] || [ "${allowed#*.sh}" != "$allowed" ]; then
    scan_root="$TMP/nocomments"
    rm -rf "$scan_root"; mkdir -p "$scan_root"
    for d in skills references hooks bin; do
      [ -d "$REPO/$d" ] || continue
      find "$REPO/$d" -type f -print0 2>/dev/null | while IFS= read -r -d '' src; do
        rel="${src#$REPO/}"; mkdir -p "$scan_root/$(dirname "$rel")"
        case "$rel" in
          *.sh|*.py|bin/*) sed 's/#.*//' "$src" > "$scan_root/$rel" 2>/dev/null || cp "$src" "$scan_root/$rel" ;;
          *) cp "$src" "$scan_root/$rel" ;;
        esac
      done
    done
  fi
  grep -rlE "$pat" "$scan_root/skills" "$scan_root/references" "$scan_root/hooks" "$scan_root/bin" 2>/dev/null \
    | sed "s|^$scan_root/||" | grep -vxF "$SELF" | sort -u > "$TMP/carriers"
  if ! [ -s "$TMP/carriers" ]; then
    bad "'$pat' matches nothing in this repo — the guard is watching a mechanism that no longer exists; fix the mechanism or drop the row"
    continue
  fi
  # Print what was MEASURED, never the allowed list. An earlier version printed
  # the allowed list under the words "carried only by", so it named
  # hooks/shared-memory.sh as a carrier of a string that file has never
  # contained — which hid a leak for a whole review round.
  found=$(tr '\n' ' ' < "$TMP/carriers"); found="${found% }"
  stray=""; hit=""
  [ "$primary" = "-" ] && hit=n/a
  while read -r f; do
    [ -n "$f" ] || continue
    [ "$f" = "$primary" ] && hit=y
    case " $primary $allowed " in *" $f "*) ;; *) stray="${stray:+$stray, }$f" ;; esac
  done < "$TMP/carriers"
  if [ -n "$stray" ]; then
    bad "$pat is carried by $stray — only /rollover hands work to a successor; a clear or an exit that carries this makes the next session resume work nobody asked it to"
  elif [ -z "$hit" ]; then
    bad "$pat is mentioned ($found) but no longer USED in $primary — the mechanism left the file that must have it and only prose about it is left"
  else
    ok "$pat [$primary] — carried by: $found"
  fi
done < "$TMP/continuation"

echo
if [ "$fails" -eq 0 ]; then
  echo -e "${GRN}ALL CHECKS PASS${RST}"
else
  echo -e "${YEL}${fails} FAILURE(S)${RST}"
fi
exit "$fails"
