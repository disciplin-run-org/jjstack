#!/bin/bash
# jjstack setup — derived distribution for gstack
#
# Creates symlinks in ~/.claude/skills/ so jjstack skills are globally
# available in every Claude Code session. Wrapper skills replace gstack
# symlinks; new skills get fresh symlinks.
#
# Installs gstack automatically if not present (it's a dependency).
#
# Idempotent: safe to re-run after upgrades to pick up new skills.
set -euo pipefail

JJSTACK_DIR="$(cd "$(dirname "$0")" && pwd)"
SKILLS_DIR="$HOME/.claude/skills"
HOOKS_DIR="$HOME/.claude/hooks"
STATE_DIR="$HOME/.jjstack"
MANIFEST="$SKILLS_DIR/jjstack/.install-manifest"
SETTINGS_FILE="$HOME/.claude/settings.json"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
NC='\033[0m'

info()  { echo -e "${CYAN}[jjstack]${NC} $1"; }
ok()    { echo -e "${GREEN}[jjstack]${NC} $1"; }
warn()  { echo -e "${YELLOW}[jjstack]${NC} $1"; }
fail()  { echo -e "${RED}[jjstack]${NC} $1"; exit 1; }

# ─── Step 1: Ensure gstack is installed ───────────────────────
GSTACK_DIR="$SKILLS_DIR/gstack"
GSTACK_VERSION_FILE="$GSTACK_DIR/VERSION"

if [ ! -f "$GSTACK_VERSION_FILE" ]; then
  info "gstack not found — installing dependency..."
  mkdir -p "$SKILLS_DIR"
  if ! git clone https://github.com/garrytan/gstack.git "$GSTACK_DIR"; then
    fail "Failed to clone gstack. Check your network connection and try again."
  fi
  if [ -x "$GSTACK_DIR/setup" ]; then
    info "Running gstack setup..."
    (cd "$GSTACK_DIR" && ./setup)
  fi
  ok "gstack installed"
fi

GSTACK_VERSION="$(cat "$GSTACK_VERSION_FILE" | tr -d '[:space:]')"
info "Found gstack v${GSTACK_VERSION}"

# ─── Step 1b: Ensure security review dependencies are installed ──
# Anthropic official security-review (trusted, auto-updated)
ANTHROPIC_SEC_DIR="$SKILLS_DIR/anthropic-security-review"
if [ ! -d "$ANTHROPIC_SEC_DIR/.git" ]; then
  info "Anthropic security-review not found — installing..."
  if git clone https://github.com/anthropics/claude-code-security-review.git "$ANTHROPIC_SEC_DIR" 2>/dev/null; then
    ok "Anthropic security-review installed"
  else
    warn "Failed to clone Anthropic security-review. /security-review will work without it."
  fi
else
  # Auto-update: pull latest from Anthropic (trusted unconditionally)
  git -C "$ANTHROPIC_SEC_DIR" pull --ff-only -q 2>/dev/null && ok "Anthropic security-review updated" || true
fi

# Sentry security skills (trusted, auto-updated)
SENTRY_SKILLS_DIR="$SKILLS_DIR/getsentry-skills"
if [ ! -d "$SENTRY_SKILLS_DIR/.git" ]; then
  info "Sentry skills not found — installing..."
  if git clone https://github.com/getsentry/skills.git "$SENTRY_SKILLS_DIR" 2>/dev/null; then
    ok "Sentry skills installed"
  else
    warn "Failed to clone Sentry skills. /security-review will work without it."
  fi
else
  git -C "$SENTRY_SKILLS_DIR" pull --ff-only -q 2>/dev/null && ok "Sentry skills updated" || true
fi

# agamm OWASP reference (copied into jjstack, not by-reference)
OWASP_DIR="$SKILLS_DIR/jjstack/references/owasp-security"
if [ ! -f "$OWASP_DIR/SKILL.md" ]; then
  OWASP_TMP=$(mktemp -d)
  if git clone https://github.com/agamm/claude-code-owasp.git "$OWASP_TMP" 2>/dev/null; then
    mkdir -p "$OWASP_DIR"
    cp "$OWASP_TMP/.claude/skills/owasp-security/owasp-security/SKILL.md" "$OWASP_DIR/SKILL.md" 2>/dev/null || true
    rm -rf "$OWASP_TMP"
    ok "OWASP security reference installed"
  else
    warn "Failed to clone OWASP reference. /security-review will work without it."
    rm -rf "$OWASP_TMP"
  fi
fi

# ─── Step 2: Symlink jjstack repo root ────────────────────────
JJSTACK_REAL=$(cd "$JJSTACK_DIR" && pwd -P)
TARGET_REAL="$SKILLS_DIR/jjstack"
[ -e "$TARGET_REAL" ] && TARGET_REAL=$(cd "$TARGET_REAL" && pwd -P 2>/dev/null || echo "$TARGET_REAL")

if [ "$JJSTACK_REAL" = "$TARGET_REAL" ]; then
  ok "jjstack already at $SKILLS_DIR/jjstack (no symlink needed)"
elif [ -d "$SKILLS_DIR/jjstack" ] && [ ! -L "$SKILLS_DIR/jjstack" ]; then
  warn "$SKILLS_DIR/jjstack is a real directory — cannot create symlink. This is fine if you cloned jjstack directly there."
else
  ln -snf "$JJSTACK_DIR" "$SKILLS_DIR/jjstack"
  ok "Linked $SKILLS_DIR/jjstack → $JJSTACK_DIR"
fi

# ─── Step 3: Create state directory ──────────────────────────
mkdir -p "$STATE_DIR"

# ─── Step 4: Install skills ──────────────────────────────────
INSTALLED=()
REPLACED=()
SKIPPED=()
NEW=()

# Read existing manifest if present (for idempotent re-runs)
declare -A EXISTING_ORIGINALS
if [ -f "$MANIFEST" ]; then
  while IFS='|' read -r name orig_target jj_target; do
    [ -z "$name" ] && continue
    [[ "$name" == \#* ]] && continue
    EXISTING_ORIGINALS["$name"]="$orig_target"
  done < "$MANIFEST"
fi

# Build new manifest
MANIFEST_LINES=()
MANIFEST_LINES+=("# jjstack install manifest — DO NOT EDIT")
MANIFEST_LINES+=("# format: skill-name|original-target|jjstack-target")

for skill_dir in "$JJSTACK_DIR"/skills/*/; do
  [ ! -d "$skill_dir" ] && continue
  skill_name="$(basename "$skill_dir")"

  # Skip skills without a SKILL.md (empty dirs from design phase)
  if [ ! -f "$skill_dir/SKILL.md" ]; then
    continue
  fi

  # Skip the jjstack meta-skill for symlink purposes (it's accessed via jjstack/ root link)
  if [ "$skill_name" = "jjstack" ]; then
    continue
  fi

  target_link="$SKILLS_DIR/$skill_name"
  jj_target="$JJSTACK_DIR/skills/$skill_name"

  if [ -L "$target_link" ]; then
    current_target="$(readlink "$target_link")"

    if echo "$current_target" | grep -q "gstack/"; then
      # Replacing gstack symlink — save original for uninstall
      original="$current_target"
      # Check if we already have a saved original from a previous install
      if [ -n "${EXISTING_ORIGINALS[$skill_name]:-}" ]; then
        original="${EXISTING_ORIGINALS[$skill_name]}"
      fi
      ln -snf "$jj_target" "$target_link"
      MANIFEST_LINES+=("$skill_name|$original|$jj_target")
      REPLACED+=("$skill_name")
      ok "Replaced $skill_name (was gstack)"

    elif echo "$current_target" | grep -q "jjstack/"; then
      # Already points to jjstack — update in case path changed
      original="${EXISTING_ORIGINALS[$skill_name]:-}"
      ln -snf "$jj_target" "$target_link"
      MANIFEST_LINES+=("$skill_name|$original|$jj_target")
      INSTALLED+=("$skill_name")

    else
      # Points somewhere else — don't touch
      warn "SKIPPED: $skill_name already exists at $current_target. Remove it manually to use jjstack's version."
      SKIPPED+=("$skill_name")
    fi

  elif [ -d "$target_link" ] && [ -L "$target_link/SKILL.md" ]; then
    # gstack pattern: real directory with symlinked SKILL.md inside
    inner_target="$(readlink "$target_link/SKILL.md")"
    if echo "$inner_target" | grep -q "gstack/"; then
      original="$inner_target"
      if [ -n "${EXISTING_ORIGINALS[$skill_name]:-}" ]; then
        original="${EXISTING_ORIGINALS[$skill_name]}"
      fi
      rm "$target_link/SKILL.md"
      rmdir "$target_link" 2>/dev/null || rm -rf "$target_link"
      ln -snf "$jj_target" "$target_link"
      MANIFEST_LINES+=("$skill_name|$original|$jj_target")
      REPLACED+=("$skill_name")
      ok "Replaced $skill_name (was gstack dir+symlink)"
    else
      warn "SKIPPED: $skill_name has unexpected SKILL.md symlink: $inner_target"
      SKIPPED+=("$skill_name")
    fi

  elif [ -e "$target_link" ]; then
    # Real directory or file — don't touch
    warn "SKIPPED: $skill_name is a real directory/file. Remove it manually to use jjstack's version."
    SKIPPED+=("$skill_name")

  else
    # Doesn't exist — new skill
    ln -snf "$jj_target" "$target_link"
    MANIFEST_LINES+=("$skill_name||$jj_target")
    NEW+=("$skill_name")
    ok "Installed $skill_name (new)"
  fi
done

# Write manifest
printf '%s\n' "${MANIFEST_LINES[@]}" > "$MANIFEST"

# ─── Step 5: Install hooks ──────────────────────────────────
mkdir -p "$HOOKS_DIR"

HOOK_SRC="$JJSTACK_DIR/hooks/auto-approve-safe.sh"
HOOK_DST="$HOOKS_DIR/auto-approve-safe.sh"
HOOK_STATUS="skipped"

if [ -f "$HOOK_SRC" ]; then
  if [ -L "$HOOK_DST" ]; then
    # Already a symlink — update it
    ln -snf "$HOOK_SRC" "$HOOK_DST"
    HOOK_STATUS="updated"
  elif [ -f "$HOOK_DST" ]; then
    # Real file exists — check if it's identical
    if diff -q "$HOOK_SRC" "$HOOK_DST" >/dev/null 2>&1; then
      HOOK_STATUS="already installed (identical)"
    else
      warn "Hook already exists at $HOOK_DST with different content. Skipping."
      HOOK_STATUS="skipped (conflict)"
    fi
  else
    ln -snf "$HOOK_SRC" "$HOOK_DST"
    HOOK_STATUS="installed"
  fi
fi

# Inject hook config into settings.json if not present
if [ -f "$SETTINGS_FILE" ]; then
  if ! grep -q "auto-approve-safe" "$SETTINGS_FILE" 2>/dev/null; then
    if command -v jq >/dev/null 2>&1; then
      TMP_SETTINGS=$(mktemp)
      jq '.hooks.PermissionRequest = ((.hooks.PermissionRequest // []) + [{"matcher": "", "hooks": [{"type": "command", "command": "~/.claude/hooks/auto-approve-safe.sh"}]}])' "$SETTINGS_FILE" > "$TMP_SETTINGS"
      mv "$TMP_SETTINGS" "$SETTINGS_FILE"
      ok "Injected hook config into settings.json"
    else
      warn "jq not found — add the hook config to $SETTINGS_FILE manually"
    fi
  fi
elif command -v jq >/dev/null 2>&1; then
  echo '{}' | jq '.hooks.PermissionRequest = [{"matcher": "", "hooks": [{"type": "command", "command": "~/.claude/hooks/auto-approve-safe.sh"}]}]' > "$SETTINGS_FILE"
  ok "Created settings.json with hook config"
fi

# Install MCP auto-reconnect hook
RECONNECT_HOOK="$JJSTACK_DIR/hooks/mcp-reconnect.sh"
if [ -f "$SETTINGS_FILE" ] && command -v jq >/dev/null 2>&1; then
  if ! grep -q "mcp-reconnect" "$SETTINGS_FILE" 2>/dev/null; then
    TMP_SETTINGS=$(mktemp)
    jq --arg hook "$RECONNECT_HOOK" '.hooks.PostToolUseFailure = ((.hooks.PostToolUseFailure // []) + [{"matcher": "mcp__", "hooks": [{"type": "command", "command": $hook}]}])' "$SETTINGS_FILE" > "$TMP_SETTINGS"
    mv "$TMP_SETTINGS" "$SETTINGS_FILE"
    ok "Injected MCP auto-reconnect hook into settings.json"
  fi
fi

# Install prompt-injection guard hook (PreToolUse on Write/Edit of .md files)
INJECTION_HOOK_SRC="$JJSTACK_DIR/hooks/injection-guard.sh"
INJECTION_HOOK_DST="$HOOKS_DIR/injection-guard.sh"
if [ -f "$INJECTION_HOOK_SRC" ]; then
  if [ -L "$INJECTION_HOOK_DST" ]; then
    ln -snf "$INJECTION_HOOK_SRC" "$INJECTION_HOOK_DST"
  elif [ ! -e "$INJECTION_HOOK_DST" ]; then
    ln -snf "$INJECTION_HOOK_SRC" "$INJECTION_HOOK_DST"
  fi
fi
if [ -f "$SETTINGS_FILE" ] && command -v jq >/dev/null 2>&1; then
  if ! grep -q "injection-guard" "$SETTINGS_FILE" 2>/dev/null; then
    TMP_SETTINGS=$(mktemp)
    jq '.hooks.PreToolUse = ((.hooks.PreToolUse // []) + [{"matcher": "Write|Edit", "hooks": [{"type": "command", "command": "~/.claude/hooks/injection-guard.sh"}]}])' "$SETTINGS_FILE" > "$TMP_SETTINGS"
    mv "$TMP_SETTINGS" "$SETTINGS_FILE"
    ok "Injected prompt-injection guard hook into settings.json"
  fi
fi

# ─── Step 6: Install Context7 MCP server ─────────────────────
MCP_JSON="$HOME/.mcp.json"
CONTEXT7_STATUS="skipped"

# Helper: prompt user, default Y. In non-interactive mode, auto-accept.
ask_yes_no() {
  if [ -t 0 ] && [ -t 1 ]; then
    read -r -p "$1 [Y/n] " REPLY < /dev/tty
    REPLY="${REPLY:-Y}"
  else
    REPLY="Y"
  fi
  [[ "$REPLY" =~ ^[Yy]$ ]]
}

if command -v npx >/dev/null 2>&1; then
  if [ -f "$MCP_JSON" ]; then
    if grep -q "context7" "$MCP_JSON" 2>/dev/null; then
      CONTEXT7_STATUS="already installed"
    elif command -v jq >/dev/null 2>&1; then
      info "Context7 provides live library documentation lookups for AI coding."
      if ask_yes_no "  Install Context7 MCP server?"; then
        TMP_MCP=$(mktemp)
        jq '.mcpServers.context7 = {"command": "npx", "args": ["-y", "@upstash/context7-mcp"]}' "$MCP_JSON" > "$TMP_MCP"
        mv "$TMP_MCP" "$MCP_JSON"
        CONTEXT7_STATUS="installed"
        ok "Context7 added to $MCP_JSON"
      else
        CONTEXT7_STATUS="declined"
      fi
    else
      warn "jq not found — add Context7 to $MCP_JSON manually"
    fi
  else
    # No .mcp.json yet — create one with Context7
    info "Context7 provides live library documentation lookups for AI coding."
    if ask_yes_no "  Install Context7 MCP server?" && command -v jq >/dev/null 2>&1; then
      echo '{}' | jq '.mcpServers.context7 = {"command": "npx", "args": ["-y", "@upstash/context7-mcp"]}' > "$MCP_JSON"
      CONTEXT7_STATUS="installed"
      ok "Created $MCP_JSON with Context7"
    else
      CONTEXT7_STATUS="declined"
    fi
  fi
else
  warn "npx not found — Context7 requires Node.js. Install Node.js to enable live docs."
  CONTEXT7_STATUS="skipped (no npx)"
fi

# ─── Step 7: Install Anthropic Verified Plugins ──────────────
PLUGINS_DIR="$HOME/.claude/plugins"
PLUGINS_CACHE="$PLUGINS_DIR/cache/claude-plugins-official"
MARKETPLACE="$PLUGINS_DIR/marketplaces/claude-plugins-official"
INSTALLED_PLUGINS="$PLUGINS_DIR/installed_plugins.json"
ANTHROPIC_PLUGINS=("frontend-design" "code-review" "code-simplifier" "feature-dev" "ralph-loop")
PLUGINS_INSTALLED=()
PLUGINS_SKIPPED=()

if [ -d "$MARKETPLACE/plugins" ] && command -v jq >/dev/null 2>&1; then
  # Ensure installed_plugins.json exists
  if [ ! -f "$INSTALLED_PLUGINS" ]; then
    echo '{"version": 2, "plugins": {}}' > "$INSTALLED_PLUGINS"
  fi

  for plugin_name in "${ANTHROPIC_PLUGINS[@]}"; do
    plugin_key="${plugin_name}@claude-plugins-official"
    source_dir="$MARKETPLACE/plugins/$plugin_name"

    # Skip if marketplace source doesn't exist
    if [ ! -d "$source_dir" ]; then
      PLUGINS_SKIPPED+=("$plugin_name (not in marketplace)")
      continue
    fi

    # Skip if already installed
    if jq -e ".plugins[\"$plugin_key\"]" "$INSTALLED_PLUGINS" >/dev/null 2>&1; then
      PLUGINS_SKIPPED+=("$plugin_name (already installed)")
      continue
    fi

    # Copy to cache
    cache_dest="$PLUGINS_CACHE/$plugin_name/unknown"
    mkdir -p "$cache_dest"
    cp -r "$source_dir/." "$cache_dest/"

    # Make any hook scripts executable
    find "$cache_dest" -name "*.sh" -exec chmod +x {} \; 2>/dev/null || true

    # Add to installed_plugins.json
    TIMESTAMP=$(date -u +%Y-%m-%dT%H:%M:%S.000Z)
    TMP_PLUGINS=$(mktemp)
    jq --arg key "$plugin_key" \
       --arg path "$cache_dest" \
       --arg ts "$TIMESTAMP" \
       '.plugins[$key] = [{"scope": "user", "installPath": $path, "version": "unknown", "installedAt": $ts, "lastUpdated": $ts}]' \
       "$INSTALLED_PLUGINS" > "$TMP_PLUGINS"
    mv "$TMP_PLUGINS" "$INSTALLED_PLUGINS"

    # Enable in settings.json
    if [ -f "$SETTINGS_FILE" ]; then
      TMP_SETTINGS=$(mktemp)
      jq --arg key "$plugin_key" '.enabledPlugins[$key] = true' "$SETTINGS_FILE" > "$TMP_SETTINGS"
      mv "$TMP_SETTINGS" "$SETTINGS_FILE"
    fi

    PLUGINS_INSTALLED+=("$plugin_name")
    ok "Installed plugin: $plugin_name"
  done
else
  if [ ! -d "$MARKETPLACE/plugins" ]; then
    warn "Anthropic plugin marketplace not found. Install plugins manually via /plugin install."
  fi
fi

# ─── Step 8: Install statusline ──────────────────────────────
# Three cases:
#   1. No statusLine configured     → install jjstack's
#   2. jjstack statusline already   → silently update command (handles path moves)
#   3. Different statusline exists  → prompt user Y/N to overwrite, default No
STATUSLINE_SRC="$JJSTACK_DIR/bin/statusline.sh"
STATUSLINE_STATUS="skipped"
STATUSLINE_CMD="bash $STATUSLINE_SRC"

install_statusline() {
  TMP_SETTINGS=$(mktemp)
  jq --arg cmd "$STATUSLINE_CMD" '.statusLine = {"type": "command", "command": $cmd}' "$SETTINGS_FILE" > "$TMP_SETTINGS"
  mv "$TMP_SETTINGS" "$SETTINGS_FILE"
}

if [ -f "$STATUSLINE_SRC" ] && [ -f "$SETTINGS_FILE" ] && command -v jq >/dev/null 2>&1; then
  EXISTING_CMD=$(jq -r '.statusLine.command // empty' "$SETTINGS_FILE" 2>/dev/null)

  if [ -z "$EXISTING_CMD" ]; then
    install_statusline
    STATUSLINE_STATUS="installed"
    ok "Statusline installed (model, effort, git, context bar, usage/cost bar)"

  elif echo "$EXISTING_CMD" | grep -q "jjstack/bin/statusline.sh"; then
    # Already jjstack's — silently update the command in case the path changed
    if [ "$EXISTING_CMD" != "$STATUSLINE_CMD" ]; then
      install_statusline
      STATUSLINE_STATUS="updated (path refreshed)"
      ok "Statusline path refreshed"
    else
      STATUSLINE_STATUS="already installed"
    fi

  else
    # A different statusline exists — ask before clobbering
    info "An existing statusLine is configured:"
    echo "    $EXISTING_CMD"
    if ask_yes_no "  Replace it with jjstack's statusline?"; then
      install_statusline
      STATUSLINE_STATUS="installed (overwrote existing)"
      ok "Statusline replaced with jjstack's"
    else
      STATUSLINE_STATUS="skipped (kept existing)"
      warn "Kept existing statusline. Remove .statusLine from $SETTINGS_FILE to install jjstack's later."
    fi
  fi
fi

# ─── Step 9: Make scripts executable ─────────────────────────
chmod +x "$JJSTACK_DIR/bin/jjstack-update-check" 2>/dev/null || true
chmod +x "$JJSTACK_DIR/bin/statusline.sh" 2>/dev/null || true
chmod +x "$HOOK_SRC" 2>/dev/null || true

# ─── Step 9: Summary ─────────────────────────────────────────
echo ""
echo -e "${CYAN}jjstack v$(cat "$JJSTACK_DIR/VERSION" | tr -d '[:space:]') installed${NC}"
echo ""

if [ ${#REPLACED[@]} -gt 0 ]; then
  echo "  Skills (replaced gstack):"
  for s in "${REPLACED[@]}"; do echo "    $s"; done
fi

if [ ${#NEW[@]} -gt 0 ]; then
  echo "  Skills (new):"
  for s in "${NEW[@]}"; do echo "    $s"; done
fi

if [ ${#INSTALLED[@]} -gt 0 ]; then
  echo "  Skills (updated):"
  for s in "${INSTALLED[@]}"; do echo "    $s"; done
fi

if [ ${#SKIPPED[@]} -gt 0 ]; then
  echo "  Skills (skipped):"
  for s in "${SKIPPED[@]}"; do echo "    $s"; done
fi

if [ ${#PLUGINS_INSTALLED[@]} -gt 0 ]; then
  echo "  Anthropic plugins (installed):"
  for s in "${PLUGINS_INSTALLED[@]}"; do echo "    $s"; done
fi

if [ ${#PLUGINS_SKIPPED[@]} -gt 0 ]; then
  echo "  Anthropic plugins (skipped):"
  for s in "${PLUGINS_SKIPPED[@]}"; do echo "    $s"; done
fi

echo ""
echo "  Hook: auto-approve-safe.sh ($HOOK_STATUS)"
echo "  Statusline: $STATUSLINE_STATUS"
echo "  Context7: $CONTEXT7_STATUS"
echo ""
echo "  Usage: /plan-ceo-review (now uses jjstack wrapper)"
echo ""
