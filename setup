#!/bin/bash
# jjstack setup — derived distribution for gstack
#
# Creates symlinks in ~/.claude/skills/ so jjstack skills are globally
# available in every Claude Code session. Wrapper skills replace gstack
# symlinks; new skills get fresh symlinks.
#
# Installs gstack automatically if not present (it's a dependency).
#
# Idempotent: safe to re-run after upgrades to pick up new skills.
set -euo pipefail

JJSTACK_DIR="$(cd "$(dirname "$0")" && pwd)"
SKILLS_DIR="$HOME/.claude/skills"
HOOKS_DIR="$HOME/.claude/hooks"
STATE_DIR="$HOME/.jjstack"
MANIFEST="$SKILLS_DIR/jjstack/.install-manifest"
SETTINGS_FILE="$HOME/.claude/settings.json"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
NC='\033[0m'

info()  { echo -e "${CYAN}[jjstack]${NC} $1"; }
ok()    { echo -e "${GREEN}[jjstack]${NC} $1"; }
warn()  { echo -e "${YELLOW}[jjstack]${NC} $1"; }
fail()  { echo -e "${RED}[jjstack]${NC} $1"; exit 1; }

# ─── Step 1: Ensure gstack is installed ───────────────────────
GSTACK_DIR="$SKILLS_DIR/gstack"
GSTACK_VERSION_FILE="$GSTACK_DIR/VERSION"

if [ ! -f "$GSTACK_VERSION_FILE" ]; then
  info "gstack not found — installing dependency..."
  mkdir -p "$SKILLS_DIR"
  if ! git clone https://github.com/garrytan/gstack.git "$GSTACK_DIR"; then
    fail "Failed to clone gstack. Check your network connection and try again."
  fi
  if [ -x "$GSTACK_DIR/setup" ]; then
    info "Running gstack setup..."
    (cd "$GSTACK_DIR" && ./setup)
  fi
  ok "gstack installed"
fi

GSTACK_VERSION="$(cat "$GSTACK_VERSION_FILE" | tr -d '[:space:]')"
info "Found gstack v${GSTACK_VERSION}"

# ─── Step 1b: Ensure security review dependencies are installed ──
# Anthropic official security-review (trusted, auto-updated)
ANTHROPIC_SEC_DIR="$SKILLS_DIR/anthropic-security-review"
if [ ! -d "$ANTHROPIC_SEC_DIR/.git" ]; then
  info "Anthropic security-review not found — installing..."
  if git clone https://github.com/anthropics/claude-code-security-review.git "$ANTHROPIC_SEC_DIR" 2>/dev/null; then
    ok "Anthropic security-review installed"
  else
    warn "Failed to clone Anthropic security-review. /jj-security-review will work without it."
  fi
else
  # Auto-update: pull latest from Anthropic (trusted unconditionally)
  git -C "$ANTHROPIC_SEC_DIR" pull --ff-only -q 2>/dev/null && ok "Anthropic security-review updated" || true
fi

# Sentry security skills (trusted, auto-updated)
SENTRY_SKILLS_DIR="$SKILLS_DIR/getsentry-skills"
if [ ! -d "$SENTRY_SKILLS_DIR/.git" ]; then
  info "Sentry skills not found — installing..."
  if git clone https://github.com/getsentry/skills.git "$SENTRY_SKILLS_DIR" 2>/dev/null; then
    ok "Sentry skills installed"
  else
    warn "Failed to clone Sentry skills. /jj-security-review will work without it."
  fi
else
  git -C "$SENTRY_SKILLS_DIR" pull --ff-only -q 2>/dev/null && ok "Sentry skills updated" || true
fi

# agamm OWASP reference (copied into jjstack, not by-reference)
OWASP_DIR="$SKILLS_DIR/jjstack/references/owasp-security"
if [ ! -f "$OWASP_DIR/SKILL.md" ]; then
  OWASP_TMP=$(mktemp -d)
  if git clone https://github.com/agamm/claude-code-owasp.git "$OWASP_TMP" 2>/dev/null; then
    mkdir -p "$OWASP_DIR"
    cp "$OWASP_TMP/.claude/skills/owasp-security/owasp-security/SKILL.md" "$OWASP_DIR/SKILL.md" 2>/dev/null || true
    rm -rf "$OWASP_TMP"
    ok "OWASP security reference installed"
  else
    warn "Failed to clone OWASP reference. /jj-security-review will work without it."
    rm -rf "$OWASP_TMP"
  fi
fi

# ─── Step 2: Point the live skill tree at a pinned worktree ───
#
# THE LIVE TREE IS NEVER A WORKING CHECKOUT. $SKILLS_DIR/jjstack is what every
# Claude Code session on this machine loads. Linked straight at a development
# clone it serves whatever branch that clone sits on, so `git checkout`
# silently changes what every session executes and a file left mid-edit is the
# live skill. Measured: an in-flight PR branch was the machine's /review for
# hours, and a reviewer had to pin a worktree by hand to produce a verdict that
# said which reviewer produced it.
#
# This is the same argument the hook install makes below, and the same fix in
# the shape skills can afford: a copy would break the edit-and-test loop that
# skill development runs on, a detached worktree does not. SKILL_SRC is what
# gets linked from here on - the pin when there is one, the checkout when
# there cannot be one.
SKILL_SRC="$JJSTACK_DIR"
PIN_DIR="$STATE_DIR/skills-pin"
mkdir -p "$STATE_DIR"

if "$JJSTACK_DIR/bin/jjstack-skills-pin" "${JJSTACK_PIN_REF:-}"; then
  SKILL_SRC="$PIN_DIR"
else
  # exit 3 is a tarball install with no git clone to hang a worktree off; exit
  # 4 is a ref that does not exist. Both are reasons to serve the checkout
  # rather than nothing, and both are said out loud - a silent fallback here
  # would restore exactly the coupling this step removes.
  warn "Could not create a skills pin — serving $JJSTACK_DIR directly."
  warn "Every session will load whatever branch that checkout is on."
fi

JJSTACK_REAL=$(cd "$SKILL_SRC" && pwd -P)
TARGET_REAL="$SKILLS_DIR/jjstack"
[ -e "$TARGET_REAL" ] && TARGET_REAL=$(cd "$TARGET_REAL" && pwd -P 2>/dev/null || echo "$TARGET_REAL")

if [ "$JJSTACK_REAL" = "$TARGET_REAL" ]; then
  ok "jjstack already at $SKILLS_DIR/jjstack (no symlink needed)"
elif [ -d "$SKILLS_DIR/jjstack" ] && [ ! -L "$SKILLS_DIR/jjstack" ]; then
  warn "$SKILLS_DIR/jjstack is a real directory — cannot create symlink. This is fine if you cloned jjstack directly there."
else
  ln -snf "$SKILL_SRC" "$SKILLS_DIR/jjstack"
  ok "Linked $SKILLS_DIR/jjstack → $SKILL_SRC"
fi

# ─── Step 3: Create state directory ──────────────────────────
# (Step 2 already needed it for the pin; kept for the path where Step 2
# fell back before reaching its mkdir.)
mkdir -p "$STATE_DIR"

# ─── Step 4: Install skills ──────────────────────────────────
INSTALLED=()
REPLACED=()
SKIPPED=()
NEW=()

# Read existing manifest if present (for idempotent re-runs)
declare -A EXISTING_ORIGINALS
if [ -f "$MANIFEST" ]; then
  while IFS='|' read -r name orig_target jj_target; do
    [ -z "$name" ] && continue
    [[ "$name" == \#* ]] && continue
    EXISTING_ORIGINALS["$name"]="$orig_target"
  done < "$MANIFEST"
fi

# Build new manifest
MANIFEST_LINES=()
MANIFEST_LINES+=("# jjstack install manifest — DO NOT EDIT")
MANIFEST_LINES+=("# format: skill-name|original-target|jjstack-target")

# Iterate the PIN's skills, not the checkout's: the links must describe the
# tree that will be served. A skill present only in the checkout is a skill
# the pinned tree cannot load, so linking it would create a dangling entry
# the harness lists and cannot open.
for skill_dir in "$SKILL_SRC"/skills/*/; do
  [ ! -d "$skill_dir" ] && continue
  skill_name="$(basename "$skill_dir")"

  # Skip skills without a SKILL.md (empty dirs from design phase)
  if [ ! -f "$skill_dir/SKILL.md" ]; then
    continue
  fi

  # Skip the jjstack meta-skill for symlink purposes (it's accessed via jjstack/ root link)
  if [ "$skill_name" = "jjstack" ]; then
    continue
  fi

  target_link="$SKILLS_DIR/$skill_name"
  # SKILL_SRC, not JJSTACK_DIR: pinning the root link and leaving the 50
  # per-skill links pointed at the checkout would pin nothing a session
  # actually loads.
  jj_target="$SKILL_SRC/skills/$skill_name"

  if [ -L "$target_link" ]; then
    current_target="$(readlink "$target_link")"

    if echo "$current_target" | grep -q "gstack/"; then
      # Replacing gstack symlink — save original for uninstall
      original="$current_target"
      # Check if we already have a saved original from a previous install
      if [ -n "${EXISTING_ORIGINALS[$skill_name]:-}" ]; then
        original="${EXISTING_ORIGINALS[$skill_name]}"
      fi
      ln -snf "$jj_target" "$target_link"
      MANIFEST_LINES+=("$skill_name|$original|$jj_target")
      REPLACED+=("$skill_name")
      ok "Replaced $skill_name (was gstack)"

    elif echo "$current_target" | grep -q "jjstack/"; then
      # Already points to jjstack — update in case path changed
      original="${EXISTING_ORIGINALS[$skill_name]:-}"
      ln -snf "$jj_target" "$target_link"
      MANIFEST_LINES+=("$skill_name|$original|$jj_target")
      INSTALLED+=("$skill_name")

    else
      # Points somewhere else — don't touch
      warn "SKIPPED: $skill_name already exists at $current_target. Remove it manually to use jjstack's version."
      SKIPPED+=("$skill_name")
    fi

  elif [ -d "$target_link" ] && [ -L "$target_link/SKILL.md" ]; then
    # gstack pattern: real directory with symlinked SKILL.md inside
    inner_target="$(readlink "$target_link/SKILL.md")"
    if echo "$inner_target" | grep -q "gstack/"; then
      original="$inner_target"
      if [ -n "${EXISTING_ORIGINALS[$skill_name]:-}" ]; then
        original="${EXISTING_ORIGINALS[$skill_name]}"
      fi
      rm "$target_link/SKILL.md"
      rmdir "$target_link" 2>/dev/null || rm -rf "$target_link"
      ln -snf "$jj_target" "$target_link"
      MANIFEST_LINES+=("$skill_name|$original|$jj_target")
      REPLACED+=("$skill_name")
      ok "Replaced $skill_name (was gstack dir+symlink)"
    else
      warn "SKIPPED: $skill_name has unexpected SKILL.md symlink: $inner_target"
      SKIPPED+=("$skill_name")
    fi

  elif [ -e "$target_link" ]; then
    # Real directory or file — don't touch
    warn "SKIPPED: $skill_name is a real directory/file. Remove it manually to use jjstack's version."
    SKIPPED+=("$skill_name")

  else
    # Doesn't exist — new skill
    ln -snf "$jj_target" "$target_link"
    MANIFEST_LINES+=("$skill_name||$jj_target")
    NEW+=("$skill_name")
    ok "Installed $skill_name (new)"
  fi
done

# Prune links for skills that left the repo (renamed or removed). Delegated to
# bin/jjstack-prune-stale-links so the test suite can drive it against a
# fixture instead of an installer that mutates the real skills dir. The first
# version of this loop keyed on the install manifest, which is read through the
# jjstack link and does not exist on a worktree install — so it iterated zero
# times on exactly the install whose link the rename orphaned.
#
# TWO directories can back an installed link, so the prune runs for each. It
# matches a link by whether the target resolves inside the repo dir it is
# given: with the live tree pinned, links resolve into the PIN, and passing
# only $JJSTACK_DIR would match nothing and prune silently - the same no-op
# this script was extracted to prevent, one directory over. The second call
# catches links left pointing at the checkout by an install from before the
# pin existed. Both calls are idempotent and scoped to what they are given.
PRUNE_ROOTS=("$SKILL_SRC")
[ "$SKILL_SRC" != "$JJSTACK_DIR" ] && PRUNE_ROOTS+=("$JJSTACK_DIR")
for prune_root in "${PRUNE_ROOTS[@]}"; do
  PRUNED_OUT="$("$JJSTACK_DIR/bin/jjstack-prune-stale-links" "$SKILLS_DIR" "$prune_root" "$MANIFEST" 2>/dev/null)"
  if [ -n "$PRUNED_OUT" ]; then
    while IFS= read -r line; do [ -n "$line" ] && ok "Pruned $line"; done <<< "$PRUNED_OUT"
  fi
done

# Write manifest
printf '%s\n' "${MANIFEST_LINES[@]}" > "$MANIFEST"

# ─── Step 5: Install hooks and the permission policy ──────────
mkdir -p "$HOOKS_DIR"

# Back up settings before touching them. Everything below rewrites the
# permissions block wholesale, and "I'll just restore it" needs a file to
# restore from.
if [ -f "$SETTINGS_FILE" ]; then
  SETTINGS_BACKUP="$HOME/.claude/backups/settings.json.$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$(dirname "$SETTINGS_BACKUP")"
  cp "$SETTINGS_FILE" "$SETTINGS_BACKUP"
  ok "Backed up settings.json to $SETTINGS_BACKUP"
fi

# Hooks are installed BY COPY, never by symlink.
#
# They used to be symlinked into this checkout, which made the machine-wide
# permission policy whatever branch the checkout happened to sit on: a
# `git checkout` silently changed what every session on the box was allowed to
# do, and an editor left mid-edit was the live gate. A copy is a decision with
# a timestamp. test/settings-lint.sh fails if one is a symlink again.
install_hook() {
  local name="$1"
  local src="$JJSTACK_DIR/hooks/$name"
  local dst="$HOOKS_DIR/$name"
  [ -f "$src" ] || return 0
  if [ -L "$dst" ]; then
    rm -f "$dst"
    warn "Replaced symlinked hook $name with a copy"
  fi
  cp "$src" "$dst"
  chmod +x "$dst"
}

for hook in auto-approve-safe.sh permission-floor.py injection-guard.sh error-detector.sh; do
  install_hook "$hook"
done
ok "Installed hooks by copy into $HOOKS_DIR"

# Register a hook command once, appending rather than replacing: the settings
# file holds other people's hooks too, and an `=` here has wiped them before.
register_hook() {
  local event="$1" matcher="$2" command="$3" needle="$4"
  [ -f "$SETTINGS_FILE" ] || return 0
  command -v jq >/dev/null 2>&1 || return 0
  grep -q "$needle" "$SETTINGS_FILE" 2>/dev/null && return 0
  local tmp
  tmp=$(mktemp)
  jq --arg e "$event" --arg m "$matcher" --arg c "$command" \
    '.hooks[$e] = ((.hooks[$e] // []) + [{"matcher": $m, "hooks": [{"type": "command", "command": $c}]}])' \
    "$SETTINGS_FILE" > "$tmp" && mv "$tmp" "$SETTINGS_FILE"
  ok "Registered $needle on $event"
}

[ -f "$SETTINGS_FILE" ] || echo '{}' > "$SETTINGS_FILE"

# The floor: a PreToolUse DENY for the shapes no rating should be able to lift.
# deny and not ask, because deny hands Claude the reason and it reroutes inside
# the same turn, and because ask stops the session until a person answers.
register_hook PreToolUse "Bash" "~/.claude/hooks/permission-floor.py" "permission-floor"
# The audit trail, and the tubemail relay for the few requests that still reach
# a person. It decides nothing.
register_hook PermissionRequest "" "~/.claude/hooks/auto-approve-safe.sh" "auto-approve-safe"
register_hook PreToolUse "Write|Edit" "~/.claude/hooks/injection-guard.sh" "injection-guard"
register_hook PostToolUse "Bash" "~/.claude/hooks/error-detector.sh" "error-detector"
register_hook PostToolUseFailure "mcp__" "$JJSTACK_DIR/hooks/mcp-reconnect.sh" "mcp-reconnect"

# ─── Step 5b: the permission policy itself ────────────────────
#
# hooks/permissions.policy.json is the canonical policy and this applies it
# verbatim; setup invents no rule of its own, so what the machine enforces can
# be read in one file and diffed.
#
# The permissions block is REPLACED, not merged. It is a policy, and a policy
# that accretes is how the previous one reached 462 allow rules that matched
# nothing while 19 ask rules quietly prompted in every mode. The backup above
# holds the old block; settings.local.json is untouched.
POLICY_FILE="$JJSTACK_DIR/hooks/permissions.policy.json"
if [ -f "$POLICY_FILE" ] && command -v jq >/dev/null 2>&1; then
  OLD_ALLOW=$(jq '(.permissions.allow // []) | length' "$SETTINGS_FILE")
  OLD_ASK=$(jq '(.permissions.ask // []) | length' "$SETTINGS_FILE")
  TMP_SETTINGS=$(mktemp)
  # {{HOME}} is substituted here rather than baked into the file, so the policy
  # is readable as one machine-independent document and still produces the
  # absolute paths the permission matcher wants.
  if jq --slurpfile policy <(sed "s|{{HOME}}|${HOME#/}|g" "$POLICY_FILE") \
       '.permissions = $policy[0].permissions' \
       "$SETTINGS_FILE" > "$TMP_SETTINGS" && [ -s "$TMP_SETTINGS" ]; then
    mv "$TMP_SETTINGS" "$SETTINGS_FILE"
    NEW_ALLOW=$(jq '.permissions.allow | length' "$SETTINGS_FILE")
    NEW_DENY=$(jq '.permissions.deny | length' "$SETTINGS_FILE")
    ok "Applied permission policy: mode=bypassPermissions, ask=0 (was $OLD_ASK), deny=$NEW_DENY, allow=$NEW_ALLOW (was $OLD_ALLOW)"
    if [ "$OLD_ASK" -gt 0 ]; then
      echo "     $OLD_ASK ask rule(s) removed — an ask rule prompts in EVERY mode,"
      echo "     including --dangerously-skip-permissions. That was the interruption."
    fi
  else
    rm -f "$TMP_SETTINGS"
    warn "Could not apply the permission policy — settings.json left unchanged"
  fi
fi

# A stale auto-mode trust boundary is worse than none: it names a repo nobody
# works in, so every real project reads as unrecognized infrastructure.
if command -v jq >/dev/null 2>&1 && jq -e '.autoMode' "$SETTINGS_FILE" >/dev/null 2>&1; then
  TMP_SETTINGS=$(mktemp)
  jq 'del(.autoMode)' "$SETTINGS_FILE" > "$TMP_SETTINGS" && mv "$TMP_SETTINGS" "$SETTINGS_FILE"
  ok "Removed the stale autoMode environment block"
fi

# ─── Step 6: Install Context7 MCP server ─────────────────────
MCP_JSON="$HOME/.mcp.json"
CONTEXT7_STATUS="skipped"

# Helper: prompt user, default Y. In non-interactive mode, auto-accept.
ask_yes_no() {
  if [ -t 0 ] && [ -t 1 ]; then
    read -r -p "$1 [Y/n] " REPLY < /dev/tty
    REPLY="${REPLY:-Y}"
  else
    REPLY="Y"
  fi
  [[ "$REPLY" =~ ^[Yy]$ ]]
}

if command -v npx >/dev/null 2>&1; then
  if [ -f "$MCP_JSON" ]; then
    if grep -q "context7" "$MCP_JSON" 2>/dev/null; then
      CONTEXT7_STATUS="already installed"
    elif command -v jq >/dev/null 2>&1; then
      info "Context7 provides live library documentation lookups for AI coding."
      if ask_yes_no "  Install Context7 MCP server?"; then
        TMP_MCP=$(mktemp)
        jq '.mcpServers.context7 = {"command": "npx", "args": ["-y", "@upstash/context7-mcp"]}' "$MCP_JSON" > "$TMP_MCP"
        mv "$TMP_MCP" "$MCP_JSON"
        CONTEXT7_STATUS="installed"
        ok "Context7 added to $MCP_JSON"
      else
        CONTEXT7_STATUS="declined"
      fi
    else
      warn "jq not found — add Context7 to $MCP_JSON manually"
    fi
  else
    # No .mcp.json yet — create one with Context7
    info "Context7 provides live library documentation lookups for AI coding."
    if ask_yes_no "  Install Context7 MCP server?" && command -v jq >/dev/null 2>&1; then
      echo '{}' | jq '.mcpServers.context7 = {"command": "npx", "args": ["-y", "@upstash/context7-mcp"]}' > "$MCP_JSON"
      CONTEXT7_STATUS="installed"
      ok "Created $MCP_JSON with Context7"
    else
      CONTEXT7_STATUS="declined"
    fi
  fi
else
  warn "npx not found — Context7 requires Node.js. Install Node.js to enable live docs."
  CONTEXT7_STATUS="skipped (no npx)"
fi

# ─── Step 7: Install Anthropic Verified Plugins ──────────────
PLUGINS_DIR="$HOME/.claude/plugins"
PLUGINS_CACHE="$PLUGINS_DIR/cache/claude-plugins-official"
MARKETPLACE="$PLUGINS_DIR/marketplaces/claude-plugins-official"
INSTALLED_PLUGINS="$PLUGINS_DIR/installed_plugins.json"
ANTHROPIC_PLUGINS=("frontend-design" "code-review" "code-simplifier" "feature-dev" "ralph-loop")
PLUGINS_INSTALLED=()
PLUGINS_SKIPPED=()

if [ -d "$MARKETPLACE/plugins" ] && command -v jq >/dev/null 2>&1; then
  # Ensure installed_plugins.json exists
  if [ ! -f "$INSTALLED_PLUGINS" ]; then
    echo '{"version": 2, "plugins": {}}' > "$INSTALLED_PLUGINS"
  fi

  for plugin_name in "${ANTHROPIC_PLUGINS[@]}"; do
    plugin_key="${plugin_name}@claude-plugins-official"
    source_dir="$MARKETPLACE/plugins/$plugin_name"

    # Skip if marketplace source doesn't exist
    if [ ! -d "$source_dir" ]; then
      PLUGINS_SKIPPED+=("$plugin_name (not in marketplace)")
      continue
    fi

    # Skip if already installed
    if jq -e ".plugins[\"$plugin_key\"]" "$INSTALLED_PLUGINS" >/dev/null 2>&1; then
      PLUGINS_SKIPPED+=("$plugin_name (already installed)")
      continue
    fi

    # Copy to cache
    cache_dest="$PLUGINS_CACHE/$plugin_name/unknown"
    mkdir -p "$cache_dest"
    cp -r "$source_dir/." "$cache_dest/"

    # Make any hook scripts executable
    find "$cache_dest" -name "*.sh" -exec chmod +x {} \; 2>/dev/null || true

    # Add to installed_plugins.json
    TIMESTAMP=$(date -u +%Y-%m-%dT%H:%M:%S.000Z)
    TMP_PLUGINS=$(mktemp)
    jq --arg key "$plugin_key" \
       --arg path "$cache_dest" \
       --arg ts "$TIMESTAMP" \
       '.plugins[$key] = [{"scope": "user", "installPath": $path, "version": "unknown", "installedAt": $ts, "lastUpdated": $ts}]' \
       "$INSTALLED_PLUGINS" > "$TMP_PLUGINS"
    mv "$TMP_PLUGINS" "$INSTALLED_PLUGINS"

    # Enable in settings.json
    if [ -f "$SETTINGS_FILE" ]; then
      TMP_SETTINGS=$(mktemp)
      jq --arg key "$plugin_key" '.enabledPlugins[$key] = true' "$SETTINGS_FILE" > "$TMP_SETTINGS"
      mv "$TMP_SETTINGS" "$SETTINGS_FILE"
    fi

    PLUGINS_INSTALLED+=("$plugin_name")
    ok "Installed plugin: $plugin_name"
  done
else
  if [ ! -d "$MARKETPLACE/plugins" ]; then
    warn "Anthropic plugin marketplace not found. Install plugins manually via /plugin install."
  fi
fi

# ─── Step 8: Install statusline ──────────────────────────────
# Delegates to bin/jjstack-statusline-install so /jjstack-repair and
# this setup script share one code path. The helper handles the three
# cases: no statusline, already jjstack's (silent refresh), different
# statusline (interactive [y/N] prompt, default N).
STATUSLINE_HELPER="$JJSTACK_DIR/bin/jjstack-statusline-install"
STATUSLINE_STATUS="skipped"

if [ -x "$STATUSLINE_HELPER" ] && [ -f "$SETTINGS_FILE" ] && command -v jq >/dev/null 2>&1; then
  STATUSLINE_STATUS=$("$STATUSLINE_HELPER" 2>&1 | tail -n 1)
  case "$STATUSLINE_STATUS" in
    installed*|refreshed*)
      ok "Statusline: $STATUSLINE_STATUS (model, effort, git, context bar, usage/cost bar)"
      ;;
    "already installed")
      : # silent, no output from ok()
      ;;
    skipped*)
      warn "Statusline: $STATUSLINE_STATUS"
      warn "Run jjstack-statusline-install --force to overwrite."
      ;;
  esac
fi

# ─── Step 9: Make scripts executable ─────────────────────────
chmod +x "$JJSTACK_DIR/bin/jjstack-update-check" 2>/dev/null || true
chmod +x "$JJSTACK_DIR/bin/statusline.sh" 2>/dev/null || true
chmod +x "$JJSTACK_DIR/bin/jjstack-extract-triggers" 2>/dev/null || true
chmod +x "$JJSTACK_DIR/bin/jjstack-skill-miss-report" 2>/dev/null || true
chmod +x "$JJSTACK_DIR/bin/jjstack-plan" 2>/dev/null || true
chmod +x "$JJSTACK_DIR/hooks/skill-miss-detect.sh" 2>/dev/null || true
chmod +x "$JJSTACK_DIR/hooks/skill-fired-clear.sh" 2>/dev/null || true
# Every hook in the repo, rather than the one variable step 5 used to leave
# behind: that spelling broke the moment step 5 stopped tracking a single
# "the hook" and started installing a set, and under `set -u` it aborted the
# run after the policy had already been applied.
for h in "$JJSTACK_DIR"/hooks/*.sh "$JJSTACK_DIR"/hooks/*.py; do
  [ -f "$h" ] && chmod +x "$h" 2>/dev/null || true
done

# Put jjstack-plan on PATH so `! jjstack-plan ...` works in the user's terminal.
# The /plan-edit skill's display commands (view/diff) are run by the user via
# the ! prefix; a bare command keeps that friction low.
if mkdir -p "$HOME/.local/bin" 2>/dev/null; then
  ln -snf "$JJSTACK_DIR/bin/jjstack-plan" "$HOME/.local/bin/jjstack-plan" 2>/dev/null \
    && ok "PATH: jjstack-plan linked into ~/.local/bin" || true
fi

# ─── Step 10: Build skill-trigger index ──────────────────────
# Powers the skill-miss-detect hook. Re-run on every setup so newly
# installed skills are picked up.
TRIGGER_STATUS="skipped"
if [ -x "$JJSTACK_DIR/bin/jjstack-extract-triggers" ]; then
    if "$JJSTACK_DIR/bin/jjstack-extract-triggers" >/dev/null 2>&1; then
        TRIGGER_STATUS="indexed"
    else
        TRIGGER_STATUS="failed"
    fi
fi

# ─── Step 11: Summary ────────────────────────────────────────
echo ""
echo -e "${CYAN}jjstack v$(cat "$JJSTACK_DIR/VERSION" | tr -d '[:space:]') installed${NC}"
echo ""

if [ ${#REPLACED[@]} -gt 0 ]; then
  echo "  Skills (replaced gstack):"
  for s in "${REPLACED[@]}"; do echo "    $s"; done
fi

if [ ${#NEW[@]} -gt 0 ]; then
  echo "  Skills (new):"
  for s in "${NEW[@]}"; do echo "    $s"; done
fi

if [ ${#INSTALLED[@]} -gt 0 ]; then
  echo "  Skills (updated):"
  for s in "${INSTALLED[@]}"; do echo "    $s"; done
fi

if [ ${#SKIPPED[@]} -gt 0 ]; then
  echo "  Skills (skipped):"
  for s in "${SKIPPED[@]}"; do echo "    $s"; done
fi

if [ ${#PLUGINS_INSTALLED[@]} -gt 0 ]; then
  echo "  Anthropic plugins (installed):"
  for s in "${PLUGINS_INSTALLED[@]}"; do echo "    $s"; done
fi

if [ ${#PLUGINS_SKIPPED[@]} -gt 0 ]; then
  echo "  Anthropic plugins (skipped):"
  for s in "${PLUGINS_SKIPPED[@]}"; do echo "    $s"; done
fi

echo ""
echo "  Permission gate: floor + audit hook installed by copy, policy applied"
echo "  Statusline: $STATUSLINE_STATUS"
echo "  Skill-trigger index: $TRIGGER_STATUS"
echo "  Context7: $CONTEXT7_STATUS"
echo ""
echo "  Usage: /plan-ceo-review (now uses jjstack wrapper)"
echo ""
